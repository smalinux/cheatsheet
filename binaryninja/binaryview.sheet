## search
bv.find_next_data(ADDR, b"\x7fELF")   # find the next exact byte match at or after ADDR  @bytes @grep  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.find_next_data>
bv.find_all_data(START, END, DATA)    # iterate (addr, DataBuffer) of every byte match in a range  @bytes @findall  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.find_all_data>
bv.find_next_text(ADDR, "TEXT")       # find text in the disassembly/IL output after ADDR  @string @grep  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.find_next_text>
bv.find_all_text(START, END, "TEXT")  # iterate every match of text in the rendered output  @string @findall  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.find_all_text>
bv.find_next_constant(ADDR, 0xDEADBEEF)  # find the next instruction using a constant  @immediate @magic  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.find_next_constant>
bv.find_all_constant(START, END, CONST)  # iterate every use of a constant in a range  @immediate  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.find_all_constant>
bv.search("E8 ?? ?? ?? ??")           # search bytes with wildcards, YARA hex or regex, yields (addr, match)  @pattern  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.search>
bv.search("[\x20-\x7e]{8,}", mode="regex")  # search with a forced regex mode  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.search>
bv.search(PATTERN, start=A, end=B, limit=N)  # search only part of the view and stop after N hits  @range  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.search>
BinaryView.detect_search_mode(PATTERN)  # show which mode search() would use for a pattern  @debug  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.detect_search_mode>

