bv.get_linear_disassembly(SETTINGS)  # iterate linear view lines with custom DisassemblySettings  @listing  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_linear_disassembly>
LinearViewObject.language_representation(bv)  # build a linear view of pseudo C for the whole file  @decompile @export  <https://api.binary.ninja/binaryninja.lineardisassembly-module.html#binaryninja.lineardisassembly.LinearViewObject.language_representation>
LinearViewCursor(LinearViewObject.disassembly(bv))  # make a cursor that walks the linear view  @listing  <https://api.binary.ninja/binaryninja.lineardisassembly-module.html#binaryninja.lineardisassembly.LinearViewCursor>
    obj = LinearViewObject.language_representation(bv)
    cur = LinearViewCursor(obj)
    while True:
        for line in cur.lines: print(line)
        if not cur.next(): break

## events and notifications
bv.register_notification(OBJ)    # get callbacks when functions, symbols, data vars, types... change  @events @listen  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.register_notification>
    class Watch(BinaryDataNotification):
        def __init__(self):
            super().__init__(NotificationType.FunctionUpdated | NotificationType.SymbolUpdated)
        def function_updated(self, view, func): log_info(f"changed {func.name}")
        def symbol_updated(self, view, sym): log_info(f"renamed {sym.name}")
    bv.register_notification(Watch())
bv.unregister_notification(OBJ)  # stop receiving notifications  @events  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.unregister_notification>
BinaryDataNotification.data_written(view, offset, length)  # callback for patched bytes  @events @write  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryDataNotification.data_written>
BinaryDataNotification.function_added(view, func)  # callback for new functions (also function_removed)  @events  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryDataNotification.function_added>
BinaryDataNotification.data_var_added(view, var)  # callback for new data variables  @events  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryDataNotification.data_var_added>
BinaryDataNotification.type_defined(view, name, type)  # callback for new or changed types  @events  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryDataNotification.type_defined>
BinaryDataNotification.tag_added(view, tag, ref_type, auto, arch, func, addr)  # callback for new tags  @events  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryDataNotification.tag_added>
BinaryDataNotification.notification_barrier(view)  # batch callback, return ms until the next one (0 to pause)  @events  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryDataNotification.notification_barrier>
BinaryViewType.add_binaryview_initial_analysis_completion_event(CB)  # run CB(bv) when any view finishes first analysis  @events  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryViewType.add_binaryview_initial_analysis_completion_event>
BinaryViewType.add_binaryview_finalized_event(CB)  # run CB(bv) when any view finishes loading  @events @global  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryViewType.add_binaryview_finalized_event>
