title: gdb maintenance and bug reports
url:   https://sourceware.org/gdb/current/onlinedocs/gdb.html/Maintenance-Commands.html
tags:  gdb debugger maint internals bug build

## maint info
maint info sections [-all-objects] [FILTERS] # list ELF sections and addresses, filter ALLOC LOAD CODE DATA ...  @elf @objdump
maint info target-sections         # list sections the target uses
maint info breakpoints             # list breakpoints including internal ones (negative numbers)
maint info bfds                    # list open BFDs
maint info line-table [REGEX]      # dump line tables
maint info symtabs [REGEX]         # list expanded symbol tables, also psymtabs
maint info program-spaces          # list program spaces
maint info sol-threads             # list Solaris threads
maint info jit                     # list JIT objects
maint info frame-unwinders         # list frame unwinders
maint info selftests               # list self tests
maint selftest [-verbose] [FILTER] # run GDB self tests

## maint print
maint print registers [FILE]          # dump the register table
maint print raw-registers [FILE]      # dump the register table with raw values, also cooked-registers
maint print remote-registers [FILE]   # dump registers with their remote protocol numbers, also register-groups
maint print reggroups                 # list register groups
maint print architecture [FILE]       # dump the arch vector
maint print c-tdesc [FILE]            # print the target description as C, also maint print xml-tdesc
maint print dummy-frames              # list dummy frames from inferior calls
maint print objfiles [REGEX]          # dump objfile info
maint print symbols [-pc ADDR|-objfile OBJ|-source SRC] [--] [OUTFILE] # dump symbols, also psymbols msymbols
maint print statistics                # print GDB memory statistics
maint print target-stack              # show the target stack
maint print type EXPR                 # dump GDB's internal type
maint print unwind ADDR               # dump unwind info (HPPA)
maint print user-registers            # list user registers
maint print core-file-backed-mappings # list file-backed mappings of a core
maint print frame-id [LEVEL]          # print a frame id
maint print symbol-cache              # dump the symbol cache, also symbol-cache-statistics

## maint actions
maint expand-symtabs [REGEX]             # expand symbol tables
maint flush symbol-cache                 # clear a cache, also register-cache dcache source-cache bfd-cache
maint cplus first_component NAME         # print the first part of a C++ name, also maint cplus namespace
maint deprecate COMMAND [REPLACEMENT]    # mark a command deprecated, also maint undeprecate
maint dump-me                            # make GDB dump core
maint internal-error [MSG]               # trigger an internal error, also internal-warning demangler-warning
maint packet TEXT                        # send a raw packet to the remote target  @rsp
maint time 0|1                           # time each command (old)
maint space 0|1                          # show memory use after each command (old)
maint translate-address [SECTION] ADDR   # find the symbol at a section address
maint agent EXPR                         # show agent bytecode for an expression, also agent-eval agent-printf
maint check-symtabs                      # check symbol tables, also check-psymtabs and maint check xml-descriptions DIR
maint btrace packet-history              # show btrace packets, also clear-packet-history clear
maint with SETTING [VALUE] [-- CMD]      # run a command with a maint setting changed
maint canonicalize NAME                  # print a C++ name in canonical form
maint test-options require-delimiter ... # test option parsing, also unknown-is-error unknown-is-operand
maint show SETTING                       # show a maint setting

## maint settings
maint set dwarf always-disassemble on|off # always disassemble DWARF expressions
maint set dwarf max-cache-age N          # keep DWARF units cached for N reads
maint set dwarf unwinders on|off         # use DWARF unwinders
maint set catch-demangler-crashes on|off # catch crashes in the demangler
maint set profile on|off                 # profile GDB itself
maint set show-debug-regs on|off         # show hardware debug registers
maint set show-all-tib on|off            # show the whole Windows TIB
maint set target-async on|off            # use async mode for the target
maint set target-non-stop on|off|auto    # run the target in non-stop mode internally
maint set per-command time|space|symtab on|off # print statistics after every command  @performance
maint set worker-threads N|unlimited     # set how many threads GDB uses  @performance
maint set internal-error quit|corefile ask|yes|no # choose what happens on an internal error
maint set check-libthread-db on|off      # check libthread_db on load
maint set ignore-prologue-end-flag on|off # ignore the DWARF prologue_end flag
maint set gnu-source-highlight enabled on|off # use GNU Source Highlight
maint set backtrace-on-fatal-signal on|off # print GDB's own backtrace on a crash
maint set test-settings TYPE VALUE       # test settings code
maint set tui-resize-message on|off      # print a message on TUI resize
maint set libopcodes-styling enabled on|off # use libopcodes styling

## bug reports
show version                     # include the version in a bug report  @bug <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Bug-Reporting.html>
show configuration               # include the build config in a bug report  @bug
gdb -batch -ex "show version"    # print the version from the shell
https://sourceware.org/bugzilla/ # report GDB bugs here (component gdb) or to bug-gdb@gnu.org  @bug
bug report contents              # include the exact input, exact output, "set verbose on" and a minimal reproducer  @bug

## build gdb
./configure --prefix=/opt/gdb --with-python --enable-tui --with-guile --with-debuginfod # configure a GDB build  <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Installing-GDB.html>
./configure --target=arm-none-eabi # configure a cross debugger  @cross
./configure --with-system-gdbinit=/etc/gdbinit --with-system-gdbinit-dir=/etc/gdbinit.d # set the system init files
make -j$(nproc) && make install    # build and install GDB
