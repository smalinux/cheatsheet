title: gdb breakpoints
url:   https://sourceware.org/gdb/current/onlinedocs/gdb.html/Breakpoints.html
tags:  gdb debugger breakpoint watchpoint catchpoint stop

## set breakpoints
break                               # set a breakpoint at the current line  @b <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Set-Breaks.html>
break LOCATION                      # set a breakpoint at a location (see "locations")  @b @fav
break FUNCTION                      # stop when FUNCTION starts  @b
break FILE:LINE                     # stop at a line in a file  @b
break LINE                          # stop at a line in the current file  @b
break *ADDR                         # stop at an address, e.g. *0x401234  @b @address
break +N                            # stop N lines after the current line  @offset
break -N                            # stop N lines before the current line  @offset
break FUNC if X > 5                 # stop only when a condition is true  @conditional
break FILE:LINE thread N            # stop only in thread N  @thread-specific
break FUNC inferior N               # stop only in inferior N  @process
break FUNC task N                   # stop only in Ada task N
break -force-condition FUNC if COND # keep a condition even if it cannot be evaluated now
break -qualified NS::FUNC           # match the exact name only, no namespace search  @exact
break -source FILE -line N          # set a breakpoint with an explicit location
break -function FUNC -label LABEL   # set a breakpoint at a label inside a function
tbreak LOCATION                     # set a temporary breakpoint, deleted after the first hit  @tb @once
hbreak LOCATION                     # set a hardware breakpoint  @hb @rom @flash
thbreak LOCATION                    # set a temporary hardware breakpoint  @thb
rbreak REGEX                        # set breakpoints on all functions matching REGEX  @regex @many
rbreak FILE:REGEX                   # set breakpoints on matching functions in one file
rbreak ^foo_                        # set breakpoints on all functions starting with foo_
rbreak Class::.*                    # set breakpoints on all methods of a C++ class  @cpp
info breakpoints                    # list all breakpoints, watchpoints and catchpoints  @i-b @list
info breakpoints N                  # show only breakpoint N
info breakpoints N-M                # show a range of breakpoints
maint info breakpoints              # list breakpoints including GDB's internal ones  @internal
set breakpoint pending on|off|auto  # choose what to do when the location is not found yet  @shared-library @dlopen
show breakpoint pending             # show the pending breakpoint setting
set breakpoint always-inserted on   # keep breakpoints inserted while the program is stopped
set breakpoint auto-hw on|off       # let GDB use hardware breakpoints when needed
set breakpoint condition-evaluation host|target|auto # choose who evaluates breakpoint conditions
set multiple-symbols all|ask|cancel # choose what to do when a name matches several symbols  @ambiguous @overload
$bpnum                              # hold the number of the last breakpoint set  @convenience

## locations
LINENUM           # locate a line in the current file  @locspec <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Location-Specifications.html>
-OFFSET           # locate a line relative to the current line  @+OFFSET @locspec
FILENAME:LINENUM  # locate a line in a file  @locspec
FUNCTION          # locate the start of a function, after the prologue  @locspec
FUNCTION:LABEL    # locate a C label inside a function  @locspec
FILENAME:FUNCTION # locate a function in a specific file  @locspec
*ADDRESS          # locate an exact address, e.g. *0x401000 or *main+4  @locspec
'file.c'::FUNC    # quote names that have special characters  @locspec
-source FILE -function FUNC -line N -label L -qualified # give an explicit location  @locspec <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Explicit-Locations.html>
break foo         # match foo, ns::foo and A::foo unless -qualified is given  @wildcard
locspec commands  # use locations with break list until advance jump tbreak dprintf edit info-scope info-line trace

## watchpoints
watch EXPR                   # stop when the value of EXPR changes (write)  @data-breakpoint <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Set-Watchpoints.html>
watch -l EXPR                # watch the address of EXPR, good for locals leaving scope  @-location
watch VAR if VAR > 100       # stop on a change only when a condition is true  @conditional
watch VAR thread N           # watch only in thread N
watch VAR mask 0xffff00      # watch with a mask (some targets)
rwatch EXPR                  # stop when EXPR is read  @read
awatch EXPR                  # stop when EXPR is read or written  @access
info watchpoints             # list watchpoints
set can-use-hw-watchpoints 0 # force software watchpoints (very slow)
show can-use-hw-watchpoints  # show if hardware watchpoints are allowed

## catchpoints
catch throw [REGEX]       # stop when a C++ exception is thrown  @exception @cpp <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Set-Catchpoints.html>
catch rethrow [REGEX]     # stop when a C++ exception is rethrown  @exception
catch catch [REGEX]       # stop when a C++ exception is caught  @exception
tcatch EVENT              # set a temporary catchpoint
catch exception [NAME]    # stop when an Ada exception is raised  @ada
catch exception unhandled # stop on an unhandled Ada exception  @ada
catch handlers [NAME]     # stop when an Ada exception handler is entered  @ada
catch assert              # stop on a failed Ada assertion  @ada
catch exec                # stop when the program calls exec()
catch fork                # stop when the program calls fork()
catch vfork               # stop when the program calls vfork()
catch load [REGEX]        # stop when a shared library is loaded  @dlopen @so
catch unload [REGEX]      # stop when a shared library is unloaded  @dlclose @so
catch syscall             # stop at entry and return of any syscall  @system-call @strace
catch syscall NAME        # stop at a syscall by name, e.g. write  @system-call
catch syscall NUMBER      # stop at a syscall by number  @system-call
catch syscall group:GROUP # stop at a syscall group, e.g. group:network or g:file  @system-call
catch signal [SIG...]     # stop when a signal is delivered  @SIGUSR1
catch signal all          # stop on all signals, including SIGTRAP and SIGINT

## delete, disable, enable
clear                   # delete breakpoints at the current line  @remove <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Delete-Breaks.html>
clear LOCATION          # delete breakpoints at a function or file:line  @remove
delete [N...]           # delete breakpoints, all of them if no number  @d @remove
delete 2 4-6            # delete breakpoints by number and range  @d @remove
disable [N...]          # turn breakpoints off but keep them  @dis <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Disabling.html>
enable [N...]           # turn breakpoints on  @en
enable once N...        # enable breakpoints, disable them again after one hit
enable count COUNT N... # enable breakpoints for COUNT hits
enable delete N...      # enable breakpoints and delete them after one hit  @tbreak
disable N.L             # disable one location L of a multi-location breakpoint N  @location
enable N.L              # enable one location L of a multi-location breakpoint N  @location

## conditions and ignore counts
condition N EXPR        # add or change the condition of breakpoint N  @if <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Conditions.html>
condition N             # remove the condition of breakpoint N
condition -force N EXPR # keep a condition even if it cannot be evaluated now
ignore N COUNT          # skip breakpoint N the next COUNT times  @skip
info break              # show how many times each breakpoint was hit  @hit-count

## command lists
commands [N...] # run commands each time a breakpoint is hit, end with "end"  @automate @script <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Break-Commands.html>
    commands 2
      silent
      printf "x=%d\n", x
      continue
    end
commands N-M    # attach the same command list to several breakpoints
commands        # attach commands to the last breakpoint created
silent          # hide the normal stop message, first line in a command list  @quiet
$_hit_bpnum     # hold the number of the breakpoint just hit  @convenience
$_hit_locno     # hold the location number of the breakpoint just hit  @convenience

## dprintf
dprintf LOCATION,"FORMAT",ARGS...     # print a message at a location and continue, no recompile  @printf @log @trace <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Dynamic-Printf.html>
dprintf FILE:LINE,"x=%d y=%s\n", X, Y # print two variables each time a line runs  @printf
set dprintf-style gdb|call|agent      # choose who prints: GDB, a call in the program, or the agent
set dprintf-function fprintf          # set the function used with dprintf-style call
set dprintf-channel stderr            # set the first argument passed to the dprintf function
set disconnected-dprintf on|off       # keep agent dprintf running after GDB disconnects

## save and probes
save breakpoints FILE             # save all breakpoints, watchpoints, catchpoints and dprintfs to FILE  @export @persist <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Save-Breakpoints.html>
source FILE                       # restore saved breakpoints from FILE  @import @load
info probes [stap|dtrace] [PROVIDER [NAME [OBJFILE]]] # list static probes  @usdt @systemtap <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Static-Probe-Points.html>
info probes all                   # list all static probes
break -probe-stap PROVIDER:NAME   # stop at a SystemTap probe  @usdt
break -probe-dtrace PROVIDER:NAME # stop at a DTrace probe  @usdt
break -probe PROVIDER:NAME        # stop at a probe of any type  @usdt
enable probes [PROVIDER [NAME]]   # enable DTrace probes
disable probes [PROVIDER [NAME]]  # disable DTrace probes
$_probe_argc                      # hold the number of arguments of the current probe
$_probe_arg0                      # hold the first argument of the current probe, up to $_probe_arg11

## errors
Cannot insert breakpoints   # means another process debugs the target or memory is read-only, try hbreak  @error
Breakpoint address adjusted # means GDB moved the breakpoint to a valid instruction boundary  @error
