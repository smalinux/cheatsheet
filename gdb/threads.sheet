title: gdb threads, inferiors, forks
url:   https://sourceware.org/gdb/current/onlinedocs/gdb.html/Threads.html
tags:  gdb debugger thread pthread multithread process inferior fork

## inferiors
info inferiors                  # list inferiors (debugged processes), * marks the current one  @process <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Inferiors-Connections-and-Programs.html>
inferior N                      # switch to inferior N  @process
add-inferior [-copies N] [-exec FILE] [-no-connection] # create a new inferior  @process
clone-inferior [-copies N] [ID] # copy the current inferior
remove-inferiors N...           # remove exited inferiors
detach inferiors N...           # detach from inferiors
kill inferiors N...             # kill inferiors
info connections                # list target connections
info program-spaces             # list program spaces (address spaces)
set schedule-multiple on        # resume all inferiors, not only the current one
show schedule-multiple          # show if all inferiors are resumed
set follow-exec-mode new|same   # choose if exec() makes a new inferior or reuses it
$_inferior                      # hold the number of the current inferior  @convenience

## threads
info threads [ID...]              # list threads, * marks the current one, -gid shows global ids  @list <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Threads.html>
thread N                          # switch to thread N  @t @switch
thread INF.N                      # switch to thread N of inferior INF, e.g. thread 1.2
thread                            # show the current thread
thread apply all CMD              # run CMD on every thread
thread apply all bt               # show a backtrace of every thread  @deadlock @hang @fav
thread apply all -ascending bt    # show backtraces of all threads, oldest thread first
thread apply 1 3-5 CMD            # run CMD on some threads
thread apply all -s CMD           # run CMD on all threads, silent on errors and empty output
thread apply all -c CMD           # run CMD on all threads, continue after errors
thread apply all -q CMD           # run CMD on all threads without thread headers
thread apply all -- -p            # use "--" when CMD starts with "-"
taas CMD                          # run CMD on all threads silently (thread apply all -s)
tfaas CMD                         # run CMD on all frames of all threads silently
thread name NAME                  # name the current thread
thread find REGEX                 # find threads by name, id or target id  @search
set print thread-events on|off    # print "[New Thread...]" messages
set libthread-db-search-path PATH # set where GDB looks for libthread_db
set auto-load libthread-db on     # load libthread_db automatically
maint check libthread-db          # test the loaded libthread_db
break FUNC thread N               # stop only in thread N  @thread-specific
$_thread                          # hold the current thread number  @convenience
$_gthread                         # hold the current global thread number  @convenience
$_inferior_thread_count           # hold the number of live threads in the inferior  @convenience
EINTR after stop                  # expect a syscall in a stopped thread to return EINTR, programs must handle it  @syscall

## scheduling
set scheduler-locking off    # let all threads run when you step or continue  @lock <https://sourceware.org/gdb/current/onlinedocs/gdb.html/All_002dStop-Mode.html>
set scheduler-locking on     # let only the current thread run  @lock
set scheduler-locking step   # let only the current thread run while stepping, continue resumes all  @lock
set scheduler-locking replay # lock only during replay (default)  @lock
show scheduler-locking       # show the scheduler locking mode

## non-stop mode
set non-stop on     # stop only the thread that hits a stop, set before run/attach  @async <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Non_002dStop-Mode.html>
show non-stop       # show if non-stop mode is on
set target-async on # turn on async mode (old name, now the default)
continue &          # continue in the background  @async <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Background-Execution.html>
run &               # run in the background, also step & next & attach &  @async
interrupt           # stop the current thread in non-stop mode
interrupt -a        # stop all threads
continue -a         # resume all threads in non-stop mode

## observer mode
set observer on|off                 # forbid all changes to the target  @read-only <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Observer-Mode.html>
set may-write-registers off         # forbid writing registers
set may-write-memory off            # forbid writing memory
set may-insert-breakpoints off      # forbid inserting breakpoints
set may-insert-tracepoints off      # forbid inserting tracepoints
set may-insert-fast-tracepoints off # forbid inserting fast tracepoints
set may-interrupt off               # forbid interrupting the target

## forks
set follow-fork-mode parent|child # choose which process GDB follows after fork  <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Forks.html>
set follow-fork-mode child        # follow the child process after fork  @fav
set detach-on-fork on|off         # off keeps both parent and child as inferiors
show follow-fork-mode             # show which process is followed after fork
show detach-on-fork               # show if the other process is detached after fork
