bv.add_analysis_completion_event(FN)  # call FN once the next analysis run finishes  @callback @done  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.add_analysis_completion_event>
bv.set_analysis_hold(True)            # pause analysis until you release the hold  @pause  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.set_analysis_hold>
bv.max_function_size_for_analysis     # get or set the size limit that skips big functions  @toolarge @skip  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.max_function_size_for_analysis>

## patching
bv.convert_to_nop(ADDR)                # replace the instruction at ADDR with NOPs  @patch @nop  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.convert_to_nop>
bv.always_branch(ADDR)                 # turn a conditional branch into a jump  @patch @jmp  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.always_branch>
bv.never_branch(ADDR)                  # make a conditional branch never taken  @patch  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.never_branch>
bv.invert_branch(ADDR)                 # flip a conditional branch (jz to jnz)  @patch @flip  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.invert_branch>
bv.skip_and_return_value(ADDR, VALUE)  # replace a call with "return VALUE" in the register  @patch @stub  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.skip_and_return_value>
bv.arch.assemble("nop")                # assemble text to bytes, then bv.write them  @patch @asm @keystone  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture.assemble>
bv.get_instruction_length(ADDR)        # get the size of the instruction at ADDR  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_instruction_length>

## disassembly text
bv.get_disassembly(ADDR)  # get the disassembly text of one instruction  @asm @print  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_disassembly>
bv.instructions           # iterate (tokens, address) for every instruction in every function  @asm @all  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.instructions>
bv.linear_disassembly     # iterate the lines of the linear view  @listing @export  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.linear_disassembly>

## metadata (saved in the .bndb)
bv.store_metadata(KEY, VALUE)  # save a Python value (int, str, bytes, list, dict) in the database  @persist @save  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.store_metadata>
bv.query_metadata(KEY)         # read saved metadata, raises KeyError if absent  @persist @load  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.query_metadata>
bv.get_metadata(KEY, DEFAULT)  # read saved metadata or a default  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_metadata>
bv.remove_metadata(KEY)        # delete saved metadata  @delete  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.remove_metadata>
bv.session_data[KEY] = VALUE   # keep plugin data for this session only (not saved)  @cache @temp  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.session_data>

## events
bv.register_notification(OBJ)             # get callbacks when the view changes  @hook @listen  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.register_notification>
    class N(BinaryDataNotification):
        def function_added(self, view, func): print("new", func)
        def symbol_updated(self, view, sym): print("renamed", sym)
    bv.register_notification(N())
bv.unregister_notification(OBJ)           # stop change callbacks  @unhook  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.unregister_notification>
BinaryViewType.add_binaryview_initial_analysis_completion_event(FN)  # call FN(bv) after first analysis of each file  @plugin @hook  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryViewType.add_binaryview_initial_analysis_completion_event>

