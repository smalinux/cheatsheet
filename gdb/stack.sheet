title: gdb stack and frames
url:   https://sourceware.org/gdb/current/onlinedocs/gdb.html/Stack.html
tags:  gdb debugger stack frame backtrace callstack

## backtrace
backtrace                        # print the call stack  @bt @where @info-stack @callstack <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Backtrace.html>
bt N                             # print the innermost N frames  @fav
bt -N                            # print the outermost N frames
bt full                          # print the call stack with local variables  @locals
bt -full                         # print the call stack with local variables (option form)
bt -no-filters                   # print the call stack without Python frame filters
bt -hide                         # hide frames elided by frame filters
bt -past-main on                 # continue the backtrace past main() into startup code
bt -past-entry on                # continue the backtrace past the entry point
bt -entry-values no|only|preferred|if-needed|both|compact|default # choose how entry values of arguments show
bt -frame-arguments all|scalars|none|presence # choose which argument values show
bt -raw-frame-arguments on       # print arguments without pretty printers
bt -frame-info VALUE             # choose what each frame line shows
    auto | source-line | location | source-and-location | location-and-address | short-location
set backtrace past-main on       # always continue backtraces past main()
set backtrace past-entry on      # always continue backtraces past the entry point
set backtrace limit N            # limit the number of frames in a backtrace
set print frame-arguments scalars|all|none|presence # choose which argument values show in frames
set print frame-info auto|source-line|location|... # choose what each frame line shows
set print entry-values compact   # show foo@entry=... values in frames  @optimized
set print raw-frame-arguments on # print frame arguments without pretty printers
set filename-display basename|relative|absolute # choose how file names show in frames  @path

## select frames
frame                      # print the current frame  @f <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Selection.html>
frame N                    # select frame N, 0 is the innermost  @f
frame level N              # select a frame by level
frame address ADDR         # select a frame by stack address
frame function NAME        # select the innermost frame of function NAME
frame view STACK_ADDR [PC] # view a frame that is not on the current stack
up [N]                     # move N frames toward the caller (outer)  @caller
down [N]                   # move N frames toward the callee (inner)  @callee
up-silently [N]            # move toward the caller without printing
down-silently [N]          # move toward the callee without printing
select-frame N             # select a frame without printing it

## inspect frames
info frame             # show details of the selected frame: saved registers, caller, language  @info-f @inline <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Frame-Info.html>
info frame level N     # show details of the frame at level N, also address/function/view
info args              # show the arguments of the current frame  @parameters
info args -q REGEX     # show matching arguments without headers
info args -t TYPEREGEX # show arguments whose type matches
info locals            # show the local variables of all nested blocks  @variables
info locals -q REGEX   # show matching local variables without headers
info registers         # show registers as seen from the selected frame

## frame apply
frame apply all CMD       # run CMD in every frame  <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Frame-Apply.html>
frame apply N CMD         # run CMD in the innermost N frames
frame apply -N CMD        # run CMD in the outermost N frames
frame apply level 2-4 CMD # run CMD in frames by level
frame apply all -s CMD    # run CMD in every frame, silent on errors, also -c -q -past-main -past-entry
faas CMD                  # run CMD in every frame silently (frame apply all -s)

## frame filters
info frame-filter                    # list Python frame filters and their priorities  <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Frame-Filter-Management.html>
disable frame-filter DICT NAME       # disable a frame filter, DICT is global, progspace or an objfile
enable frame-filter DICT NAME        # enable a frame filter
set frame-filter priority DICT NAME PRIORITY # change the priority of a frame filter
show frame-filter priority DICT NAME # show the priority of a frame filter

## optimized code
info frame (inlined)     # show "inlined into frame N" for inline function frames  @inline <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Inline-Functions.html>
<optimized out>          # means the variable is not in a register or memory right now  @optimized
set debug entry-values 1 # debug tail-call frame detection  @tail-call <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Tail-Call-Frames.html>
