title: gdb running and stepping
url:   https://sourceware.org/gdb/current/onlinedocs/gdb.html/Running.html
tags:  gdb debugger run step next continue execution

## compile for debugging
gcc -g app.c                         # build with basic debug info (DWARF)  @compile <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Compilation.html>
gcc -g3 app.c                        # build with debug info plus preprocessor macros  @macro
gcc -g -O0 app.c                     # build with no optimization for the easiest debugging
gcc -g -O2 app.c                     # build optimized but still debuggable (harder)
gcc -ggdb3 app.c                     # build with the most GDB-specific debug info
gcc -g -fno-omit-frame-pointer app.c # keep frame pointers for better backtraces in optimized code

## start the program
run                                # start the program with the saved arguments  @r <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Starting.html>
run ARGS                           # start the program with ARGS, the shell expands * $ < >  @r
run < in.txt > out.txt             # start the program with redirected input and output  @redirect @stdin
start                              # set a temporary breakpoint on main and run  @main
start ARGS                         # start with arguments and stop at main
starti                             # stop at the very first instruction, before main  @entry @static-constructors
set exec-wrapper env 'LD_PRELOAD=libx.so' # launch the program through a wrapper  @preload
unset exec-wrapper                 # stop using an exec wrapper
show exec-wrapper                  # show the exec wrapper
target native                      # connect to the native target explicitly
disconnect                         # disconnect from the target
set disable-randomization off      # keep ASLR on, GDB turns it off by default  @aslr
show disable-randomization         # show if GDB disables ASLR  @aslr
set startup-with-shell off         # start the program directly, not through $SHELL
show startup-with-shell            # show if the program starts through the shell
set auto-connect-native-target off # stop "run" from connecting to the native target  @fav
show auto-connect-native-target    # show if "run" connects to the native target

## arguments and environment
set args ARGS             # set the arguments for the next run  <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Arguments.html>
set args                  # clear the program arguments
show args                 # show the program arguments
path DIR                  # add DIR to the front of the program's PATH  <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Environment.html>
show paths                # show the program's PATH
show environment [VAR]    # show the program's environment  @env
set environment VAR=VALUE # set an environment variable for the program, not GDB  @env @setenv
unset environment VAR     # remove an environment variable completely  @env @unsetenv

## working directory
set cwd DIR   # set the program's working directory for the next run  @chdir <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Working-Directory.html>
set cwd       # reset the program's working directory to GDB's
show cwd      # show the program's working directory
cd [DIR]      # change GDB's own working directory
pwd           # print GDB's working directory  @fav
info proc cwd # show the real working directory of the running program (Linux)

## terminal and I/O
info terminal               # show the terminal modes the program uses  @fav <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Input_002fOutput.html>
tty /dev/pts/N              # send the program's input and output to another terminal  @fav
set inferior-tty /dev/pts/N # send the program's I/O to another terminal  @tty
set inferior-tty            # send the program's I/O back to GDB's terminal
show inferior-tty           # show the program's terminal

## attach, detach, kill
attach PID # attach to a running process  <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Attach.html>
detach     # let the process continue without GDB
kill       # kill the debugged process  @k <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Kill-Process.html>
info files # show the active targets  @fav
echo 0 | sudo tee /proc/sys/kernel/yama/ptrace_scope # allow attach when Linux denies it  @permission @ptrace

## continue and step
continue [N]              # resume, N ignores this breakpoint N-1 more times  @c @fg <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Continuing-and-Stepping.html>
next [N]                  # step over one source line, do not enter calls  @n @step-over @fav
step [N]                  # step into one source line, enter calls  @s @step-into
stepi [N]                 # step one machine instruction, enter calls  @si @instruction @fav
nexti [N]                 # step one machine instruction, step over calls  @ni @instruction @fav
finish                    # run until the current function returns and print its value  @fin @return @step-out @fav
set print finish on|off   # choose if finish prints the return value
until                     # go to the next line but do not go back in loops  @u @loop
until LOCATION            # run until LOCATION or the current frame returns  @u
advance LOCATION          # run until LOCATION, also stop if the frame returns
display/i $pc             # show the current instruction after each step  @fav
set step-mode on          # step into functions without debug info
set step-mode off         # step over functions without line info (default)
show step-mode            # show the step mode
set range-stepping on|off # let gdbserver step a line range at once (faster)

## skip functions and files
skip FUNCTION              # never step into FUNCTION  <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Skipping-Over-Functions-and-Files.html>
skip -function NAME        # never step into the function NAME
skip -rfunction ^std::     # never step into functions matching a regex  @cpp @stl
skip -file FILE            # never step into any function in FILE
skip -gfile *.h            # never step into files matching a glob  @header
skip -gfile /usr/include/* # never step into system headers  @header
skip file [FILE]           # skip a file, old syntax
skip function [FUNC]       # skip a function, old syntax
info skip                  # list the skips
skip delete [N...]         # delete skips
skip enable [N...]         # enable skips
skip disable [N...]        # disable skips

## signals
info signals                            # show what GDB does with each signal: stop, print, pass  @info-handle <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Signals.html>
info signals SIGINT                     # show how GDB handles one signal
handle SIG KEYWORDS...                  # change how GDB handles a signal: stop/nostop print/noprint pass/nopass  @ignore
handle SIGUSR1 nostop noprint pass      # ignore SIGUSR1 completely  @ignore
handle SIGPIPE nostop noprint pass      # ignore SIGPIPE completely  @ignore @broken-pipe
handle SIGSEGV stop print nopass        # stop on SIGSEGV and do not give it to the program  @crash
handle 14-15 nostop                     # change several signals by number range
signal SIG                              # continue the program and deliver SIG  @send @raise <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Signaling.html>
signal 0                                # continue without delivering the pending signal
queue-signal SIG                        # queue a signal for the program, do not resume
p $_siginfo                             # show the full siginfo of the last signal
p $_siginfo._sifields._sigfault.si_addr # show the faulting address of a SIGSEGV  @crash @segfault
handle SIG (non-stop mode)              # apply to the whole program, even for a thread-specific signal  @non-stop

## assignment
set var X = 10           # change a program variable, "var" avoids clashes with GDB settings  @assign @modify <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Assignment.html>
set var ARR[2] = 5       # change an array element  @assign
set var PTR->FIELD = 'c' # change a struct field  @assign
set var $rax = 0         # change a register  @assign @register
p X = 10                 # change a variable and print it  @assign
set {int}ADDR = 4        # write an int to memory at ADDR  @poke
set var BUF = "hello"    # copy a string into a char array of the right size

## jump and return
jump LOCATION       # continue at another line, the stack is not changed  @j @goto <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Jumping.html>
jump *ADDR          # continue at an address  @j
tbreak 50 ; jump 42 # jump to line 42 and stop at line 50
set var $pc = ADDR  # move the program counter without continuing
return [EXPR]       # pop the frame and return EXPR to the caller now  @early-return <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Returning.html>

## call functions
call FUNC(ARGS)                     # call a function in the program, void results are not shown  <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Calling.html>
print FUNC(ARGS)                    # call a function in the program and print the result
call (void)free(PTR)                # call a function and ignore its result
p strlen("abc")                     # call a libc function if libc has symbols
p ((int(*)(const char*))puts)("hi") # cast a function with no debug info before calling it  @no-debug-info
set unwindonsignal on|off           # unwind the stack if a called function crashes
set unwind-on-timeout on|off        # unwind the stack if a called function times out
set direct-call-timeout N           # set the timeout in seconds for direct inferior calls
set indirect-call-timeout N         # set the timeout in seconds for indirect inferior calls
set unwind-on-terminating-exception on|off # unwind if a called function throws an uncaught C++ exception
set may-call-functions on|off       # allow or forbid all calls into the program
show may-call-functions             # show if calls into the program are allowed

## patch the executable
set write on  # open the executable and core for writing, then reload with "file"  @patch @binary <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Patching.html>
set write off # open the executable and core read-only
show write    # show if files are opened for writing
file PROG     # reload the program after "set write on"

## compile and inject code
compile code CODE                 # compile C code and run it in the program  @inject @libcc1 <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Compiling-and-Injecting-Code.html>
compile code printf("x=%d\n", x); # run a printf inside the program
compile code                      # write several lines of code to inject, end with "end"
compile file FILE                 # compile a source file and run it in the program
compile file -raw FILE            # compile a file without the GDB wrapper
compile print EXPR                # evaluate an expression with the compiler
compile print/x EXPR              # evaluate with the compiler and print in hex
set compile-args ARGS             # set extra compiler flags, default -O0 -gdwarf-4 -fPIE ...
show compile-args                 # show the compiler flags
set compile-gcc PATH              # choose which gcc compile uses
show compile-gcc                  # show which gcc compile uses

## reverse execution
reverse-continue           # run backward until a breakpoint  @rc @back <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Reverse-Execution.html>
reverse-step [N]           # step backward into functions  @rs @back
reverse-stepi              # step one instruction backward  @rsi @back
reverse-next [N]           # step backward over calls  @rn @back
reverse-nexti              # step one instruction backward over calls  @rni @back
reverse-finish             # go back to where the current function was called  @back
set exec-direction reverse # make step, next and continue go backward
set exec-direction forward # make step, next and continue go forward again
show exec-direction        # show the execution direction

## record and replay
record                                  # start recording every instruction (record full)  @rr @time-travel <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Process-Record-and-Replay.html>
record full                             # record in software, slow but works everywhere
record btrace                           # record with hardware branch tracing (Intel), no data
record btrace bts                       # record with Branch Trace Store
record btrace pt                        # record with Intel Processor Trace  @ipt
record btrace ptw                       # record with Intel PT and ptwrite support
record stop                             # stop recording and keep the process
record delete                           # delete the log after the current point
record goto begin|start|end|N           # jump to a point in the log
record instruction-history [RANGE] [/m|/r|/s|/f] # show recorded instructions (btrace)
record function-call-history [RANGE] [/l|/c|/i|/s] # show recorded function calls (btrace)
record save FILE                        # save the log to a file (record full)
record restore FILE                     # load a saved log, needs a core file
info record                             # show the recording status
set record full insn-number-max N|unlimited # limit how many instructions are recorded
set record full stop-at-limit on|off    # stop or overwrite when the record limit is hit
set record full memory-query on|off     # ask when memory cannot be recorded
set record btrace replay-memory-access read-only|read-write # allow writes during replay
set record btrace cpu auto|none|VENDOR:PROC/STEP # set the CPU for btrace errata
set record btrace bts buffer-size N     # set the BTS buffer size
set record btrace pt buffer-size N      # set the Intel PT buffer size
set record btrace pt event-tracing on|off # record Intel PT events
set record btrace pt ptwrite-filter on|off # filter ptwrite data
set record instruction-history-size N   # set how many instructions history prints
set record function-call-history-size N # set how many calls history prints

## checkpoints
checkpoint          # save a snapshot of the process (Linux, uses fork)  @bookmark @snapshot <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Checkpoint_002fRestart.html>
info checkpoints    # list snapshots
restart N           # go back to checkpoint N, keeps the same PID and addresses
delete checkpoint N # delete a snapshot
