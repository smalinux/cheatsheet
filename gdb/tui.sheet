title: gdb tui, interpreters, front ends
url:   https://sourceware.org/gdb/current/onlinedocs/gdb.html/TUI.html
tags:  gdb debugger tui layout window interface emacs dap vscode ide

## interpreters
interpreter-exec mi "-data-list-register-names" # run one MI command from the CLI  <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Interpreters.html>
interpreter-exec console "bt" # run one CLI command from MI
gdb --interpreter=mi3         # start GDB with an interpreter: mi3 mi2 mi1 console dap  @-i
new-ui INTERP TTY             # open another UI on another terminal, e.g. new-ui mi /dev/pts/5

## tui keys
Ctrl-x a # turn TUI on or off, also Ctrl-x A  @toggle <https://sourceware.org/gdb/current/onlinedocs/gdb.html/TUI-Keys.html>
Ctrl-x 1 # use a layout with one window
Ctrl-x 2 # use a layout with two windows, press again to cycle src/asm/regs
Ctrl-x o # move focus to the next window
Ctrl-x s # turn SingleKey mode on or off
Ctrl-L   # redraw the screen  @refresh
PgUp     # scroll the focused window, also PgDn Up Down Left Right
Ctrl-p   # go to the previous command when the source window has focus, also Ctrl-n Ctrl-b Ctrl-f

## singlekey mode
c # continue (SingleKey mode)  <https://sourceware.org/gdb/current/onlinedocs/gdb.html/TUI-Single-Key-Mode.html>
d # down (SingleKey mode)
f # finish (SingleKey mode)
n # next (SingleKey mode)
o # nexti (SingleKey mode)
r # run (SingleKey mode)
s # step (SingleKey mode)
i # stepi (SingleKey mode)
u # up (SingleKey mode)
v # info locals (SingleKey mode)
w # where (SingleKey mode)
q # leave SingleKey mode

## tui commands
tui enable                              # turn TUI on, also tui disable  <https://sourceware.org/gdb/current/onlinedocs/gdb.html/TUI-Commands.html>
layout src                              # show source and command windows
layout asm                              # show assembly and command windows
layout split                            # show source, assembly and command windows
layout regs                             # show registers above source or assembly  @fav
layout next                             # go to the next layout, also layout prev
layout NAME                             # use a layout you made  @tui-layout
tui new-layout NAME WINDOW WEIGHT [WINDOW WEIGHT]... # make a layout, e.g. tui new-layout mine src 2 regs 1 status 0 cmd 1
tui new-layout h {-horizontal src 1 asm 1} 2 status 0 cmd 1 # make a layout with side-by-side windows
info win                                # list the windows and their sizes
focus src|asm|regs|cmd|status|next|prev # choose which window gets the arrow keys  @fs @tui-focus
refresh                                 # redraw the screen
update                                  # move the source window to the current line
winheight NAME +N                       # grow a window, also -N or N, e.g. wh src +5  @wh @tui-window-height
winwidth NAME +N                        # change a window width  @tui-window-width
tui reg GROUP                           # show a register group: general float vector system all next prev
tabset N                                # set the tab width in the source window

## tui settings
set tui border-kind space|ascii|acs # choose the window border characters  <https://sourceware.org/gdb/current/onlinedocs/gdb.html/TUI-Configuration.html>
set tui border-mode MODE            # choose the border look: normal standout reverse half half-standout bold bold-standout
set tui active-border-mode MODE     # choose the look of the focused window border
set tui tab-width N                 # set the tab width
set tui compact-source on|off       # use a compact source window
set tui mouse-events on|off         # send mouse events to TUI windows
set tui left-margin-verbose on|off  # show more in the left margin
show tui SETTING                    # show a TUI setting

## emacs
M-x gdb     # start GDB inside Emacs (gdb-mi mode)  <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Emacs.html>
M-x gud-gdb # start GDB inside Emacs in the old text mode
C-c C-s     # step (Emacs)
C-c C-n     # next (Emacs)
C-c C-i     # stepi (Emacs)
C-c C-r     # continue (Emacs)
C-c C-f     # finish (Emacs)
C-c <       # up (Emacs)
C-c >       # down (Emacs)
C-c C-l     # show the source of the current frame (Emacs)
C-x SPC     # set a breakpoint at point in a source buffer (Emacs)
C-c C-d     # delete a breakpoint (Emacs)
C-c C-t     # set a temporary breakpoint (Emacs)

## dap
gdb -i=dap                  # start GDB as a Debug Adapter Protocol server on stdin/stdout  @vscode <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Debugger-Adapter-Protocol.html>
set debug dap-log-file FILE # log DAP traffic to a file
set debug dap-log-level 1   # set the DAP log level
launch request              # pass "program", "args", "env", "cwd", "stopAtBeginningOfMainSubprogram", "stopOnEntry"
attach request              # pass "pid" or "target" for a remote

## annotations
set annotate LEVEL # set annotations: 0 none, 1 Emacs, 2 deprecated, 3 max  <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Annotations.html>
server CMD         # run a command without changing history or repeat, e.g. server break main
