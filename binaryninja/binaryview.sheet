title: binary ninja BinaryView
url:   https://api.binary.ninja/binaryninja.binaryview-module.html
tags:  binaryninja binja bn bv binaryview python api

; bv = BinaryView. Names in UPPERCASE are placeholders.

## file info
bv.arch             # get the Architecture, e.g. x86_64  @cpu  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.arch>
bv.platform         # get the Platform (os + arch), e.g. linux-x86_64  @os  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.platform>
bv.view_type        # get the file format name: ELF, PE, Mach-O, Raw  @format  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.view_type>
bv.start            # get the lowest mapped address  @begin @base  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.start>
bv.end              # get the address one past the highest mapped byte  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.end>
bv.length           # get the size of the mapped address space  @size  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.length>
bv.entry_point      # get the entry point address  @start @main  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.entry_point>
bv.entry_function   # get the Function at the entry point  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.entry_function>
bv.entry_functions  # list all entry functions (entry, init arrays, TLS callbacks)  @ctor  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.entry_functions>
bv.image_base       # get the image base address  @base @load-address  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.image_base>
bv.endianness       # get the byte order  @endian @little @big  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.endianness>
bv.address_size     # get the pointer size in bytes  @pointer @bits  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.address_size>
bv.executable       # check if the file is an executable  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.executable>
bv.relocatable      # check if the file is position independent  @pie @pic  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.relocatable>
bv.parent_view      # get the view this one reads its bytes from (usually Raw)  @raw  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.parent_view>
bv.libraries        # list the shared libraries the file needs  @imports @dll @so  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.libraries>
bv.rebase(ADDR)     # get a new view moved to a new image base  @relocate @base  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.rebase>

## read and write bytes
bv.read(ADDR, LEN)                  # read LEN bytes at a virtual address  @memory @bytes @dump  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.read>
bv.read_int(ADDR, SIZE, sign=True)  # read an integer of SIZE bytes in the view's endianness  @number  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.read_int>
bv.read_pointer(ADDR)               # read a pointer-sized value  @deref  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.read_pointer>
bv.read_uuid(ADDR)                  # read a 16-byte UUID/GUID  @guid  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.read_uuid>
bv.write(ADDR, DATA)                # overwrite bytes at an address, returns bytes written  @patch @modify  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.write>
bv.insert(ADDR, DATA)               # insert bytes and shift the rest  @patch  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.insert>
bv.remove(ADDR, LEN)                # delete bytes and shift the rest  @patch @cut  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.remove>
bv.get_modification(ADDR, LEN)      # check which bytes were changed by the user  @patched @diff  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_modification>
br = BinaryReader(bv)               # make a stream reader with a moving offset  @parse @cursor  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryReader>
br.seek(ADDR); br.read32()          # move the reader then read 4 bytes as an int, also read8/16/64 and le/be forms  @parse  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryReader.read32>
br.read(LEN)                        # read LEN bytes from the reader and move forward  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryReader.read>
bw = BinaryWriter(bv)               # make a stream writer with a moving offset  @patch  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryWriter>
bw.seek(ADDR); bw.write32(VALUE)    # move the writer then write a 4-byte int, also write8/16/64  @patch  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryWriter.write32>
bv.typed_data_accessor(ADDR, TYPE)  # read memory as a typed value (struct fields, arrays)  @struct @parse  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.typed_data_accessor>
bv.get_entropy(ADDR, LEN)           # get Shannon entropy per block, find packed or encrypted data  @packed @compressed  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_entropy>

