bv.get_code_refs_from(ADDR)          # list addresses referenced by the instruction at ADDR  @xrefs  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_code_refs_from>
bv.get_data_refs(ADDR)               # iterate data addresses (pointers) that reference ADDR  @xrefs @to @pointer  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_data_refs>
bv.get_data_refs_from(ADDR)          # list addresses referenced by data at ADDR  @xrefs  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_data_refs_from>
