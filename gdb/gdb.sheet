title: gdb
url:   https://sourceware.org/gdb/current/onlinedocs/gdb
tags:  debugger debugging gnu gdbserver breakpoint backtrace core-dump

; GDB Cheatsheet — the complete guide to GDB
; Generated 2026-09-07 from the GDB 19 (19.0.50.20260909-git) manual. Commands marked with version-specific
; behavior may differ on older GDB releases; run `help CMD` inside your GDB to confirm.
; Based on Debugging with GDB (Tenth Edition, GDB 19.x) — https://sourceware.org/gdb/current/onlinedocs/gdb
; The notes are in simple English (B1); keywords and commands are all English.
; A `#` inside any example block = comment. GDB itself also treats `#` as a comment.

## 1. Quick Start

; This is the fastest way to start. Compile with `-g`, open GDB, set a `breakpoint`, start with `run`,
; go line by line with `next` / `step`, and see values with `print`.

gcc -g -O0 -o app app.c     # compile with debug info, no optimization
gdb ./app                   # open the program in GDB
gdb -q ./app                # same, but without the copyright banner
gdb --args ./app arg1 arg2  # pass program arguments directly
gdb ./app core              # open a core dump
gdb -p 1234                 # attach to a running process by PID

break main                  # stop when main() starts
run                         # start the program
next                        # run one line, do not enter functions
step                        # run one line, enter functions
print x                     # show the value of x
backtrace                   # show the call stack
continue                    # keep running until next stop
quit                        # exit GDB

## 2. Invocation — Starting & Quitting GDB

## 2.1 Choosing Files

; When you start `gdb` from the shell, you can give it the executable, the core file, or the PID.
; These options tell it what to read and from where.

gdb program                     # load an executable
gdb program core                # executable + core dump
gdb program 1234                # executable + attach to PID 1234
gdb -p 1234                     # attach by PID only (program name optional)
gdb ./12345                     # "./" prefix: treat as file, not PID

gdb -s file  / --symbols=file   # read symbol table from this file only
gdb -e file  / --exec=file      # use this file as the executable
gdb -se file                    # symbols AND executable from same file
gdb -c file  / --core=file      # use this core dump
gdb -x file  / --command=file   # run GDB commands from a file (custom gdb scripting) ⭐
gdb -ex 'cmd' / --eval-command  # run one GDB command (repeatable)
gdb -ix file / -iex 'cmd'       # same, but BEFORE the program is loaded
gdb -eix file / -eiex 'cmd'     # very early init, before any output
gdb -d dir   / --directory=dir  # add a source search directory
gdb -r / --readnow              # read ALL symbols now (slower start, faster later)
gdb --readnever                 # never read debug info (fast attach/dump/detach)

## 2.2 Choosing Modes

; These modes control *how* GDB works: quiet, batch, TUI, MI for IDEs, etc.

gdb -n  / -nx                  # do not read ANY init files
gdb -nh                        # skip only the home-directory init file
gdb -q  / -quiet / -silent     # no banner
gdb -batch                     # run -x/-ex commands then exit (status 0 or error)
gdb -batch-silent              # same, and no stdout at all
gdb -return-child-result       # GDB exit code = debugged program exit code
gdb -nw / -nowindows           # command line only (no GUI)
gdb -w  / -windows             # use GUI if available
gdb -cd dir                    # start with this working directory
gdb -D dir / -data-directory   # where GDB looks for its data files
gdb -f / -fullname             # Emacs-style file:line output
gdb -annotate LEVEL            # annotation level 0..3 (old front-end protocol)
gdb --args prog a b c          # everything after prog = program args (escaped)
gdb --no-escape-args prog '*'  # same, but shell chars are NOT escaped
gdb -b BPS / -baud BPS         # serial line speed for remote debugging
gdb -l SECONDS                 # remote timeout
gdb -t DEV / -tty DEV          # program stdin/stdout on this device
gdb -tui                       # start with the Text User Interface
gdb -interpreter=mi            # GDB/MI mode (for IDEs); also mi3, mi2, mi1
gdb -write                     # open exec/core read-write (= "set write on")
gdb -statistics                # print time/memory after each command
gdb -version                   # print version and exit
gdb -configuration             # print build configuration and exit
gdb -binary-output             # MS-Windows only: binary stdout/stderr
gdb -help / -h                 # list all options

## 2.3 Startup Order & Init Files

; When GDB starts, it reads init files in a fixed order. For settings you always want, put them in
; `~/.gdbinit` or `~/.config/gdb/gdbinit`. The early init file (`gdbearlyinit`) allows only `set` and
; `source` commands that control startup.

gdb startup order          # Order of startup: which init files and options GDB reads first  @gdbinit @init
   1. early init file: $XDG_CONFIG_HOME/gdb/gdbearlyinit | ~/.config/gdb/gdbearlyinit | ~/.gdbearlyinit
      (macOS: ~/Library/Preferences/gdb/gdbearlyinit)
   2. -eiex / -eix options
   3. interpreter setup
   4. system.gdbinit  and  system.gdbinit.d/*.gdb|*.py|*.scm  (alphabetical)
   5. home init file: $XDG_CONFIG_HOME/gdb/gdbinit | ~/.config/gdb/gdbinit | ~/.gdbinit
      (macOS: ~/Library/Preferences/gdb/gdbinit)
   6. -iex / -ix options
   7. command-line operands (program, core, pid)
   8. ./.gdbinit  (only if "set auto-load local-gdbinit on" and dir != home)
   9. auto-loaded scripts for the program / shared libs
   10. -ex / -x options
   11. command history file

; Useful in ~/.gdbinit
set startup-quietly on     # like -q (early-init file only)
set confirm off            # do not ask "are you sure?"
set pagination off         # no "--Type <RET>--" pauses
set print pretty on        # nice struct printing
set history save on        # keep command history between sessions ⭐⭐⭐⭐⭐
set auto-load safe-path /  # allow local .gdbinit anywhere (careful!)

## 2.4 Quitting, Shell Commands, Logging

; `quit`, `exit` or `Ctrl-d` close GDB. `Ctrl-c` does not close GDB; it only stops the running
; command. You can run shell commands from inside GDB with `shell` or `!`, and `pipe` the output of
; any command to a shell command.

quit [EXPR]     / q / exit     # exit GDB; EXPR = exit code
Ctrl-c                         # interrupt current command / running program
detach                         # release an attached process, keep GDB open

shell CMD       / !CMD         # run a shell command (no space needed after !)
make ARGS                      # same as "shell make ARGS"
pipe CMD | SHELLCMD            # send GDB command output to a shell command
| CMD | SHELLCMD               # short form of pipe
|| SHELLCMD                    # repeat last command, pipe to shell
pipe -d DELIM CMD DELIM SHELL  # custom delimiter when CMD contains "|"
p $_shell("ls -l")             # run shell from an expression, returns exit code
p $_shell_exitcode             # exit code of last shell/make/pipe
p $_shell_exitsignal           # signal that killed the last shell command

set logging enabled on|off     # start / stop logging (tee output to gdb.txt) ⭐
set logging file FILE          # default: gdb.txt
set logging overwrite on|off   # overwrite instead of append
set logging redirect on|off    # on = output goes ONLY to the file
set logging debugredirect on   # same for debug output
show logging                   # show logging settings

## 3. GDB Commands — Syntax, Completion, Help

; You can shorten any command to its first few letters if there is no confusion (`b` = `break`, `c` =
; `continue`). If you press `Enter` on an empty line, GDB repeats the last command (except dangerous
; ones like `run`). `TAB` completes the command or the symbol name. `#` = comment.

step 5                         # commands take arguments
s                              # abbreviations work when unique
<RET>                          # empty line = repeat last command (not run/attach)
Ctrl-o                         # accept line AND fetch next history line (operate-and-get-next)
; this is a comment            # from "#" to end of line is ignored

; --- Settings ---
set print elements 10          # change a setting
show print elements            # see a setting
info set                       # show ALL settings (same as "show")
print -elements 10 -- arr      # override a setting for one command
with print pretty on -- p var  # temporarily set for one command
w print elements 5             # "w" = with; no command = repeat last command
with language ada -- with print elements 10 -- p x  # nest "with"

; --- Completion ---
info bre<TAB>                  # completes to "info breakpoints"
b make_<TAB><TAB>              # list all matches
M-?                            # (ESC ?) list matches without TAB TAB
p 'func<<TAB>                  # quote ' to complete C++ templates/operators
p var.<TAB>                    # completes struct fields
set max-completions 200        # limit (0 = disable, "unlimited")
show max-completions           # show the completion limit

; --- Filenames with spaces ---
file /path/with\ spaces/prog   # escape with backslash (file, symbol-file, exec-file)
symbol-file "/path/with spaces/prog"  # or quote it
add-auto-load-safe-path /path with spaces/  # most commands take raw text, no quoting

; --- Command options ---
print -pretty -- *ptr          # "--" ends options when argument may start with "-"
p -o -p 0 -e u -- *myptr       # options abbreviate; on/off/1/0/yes/no/enable/disable
print -<TAB><TAB>              # list options of a command

; --- Help ---
help            / h            # list command classes
help CLASS                     # e.g. help breakpoints, help running, help data
help COMMAND                   # e.g. help break
apropos REGEX                  # search all commands + docs
apropos -v REGEX               # verbose, highlights matches
complete TEXT                  # list completions for TEXT (used by Emacs)
info ...        / i            # info about the PROGRAM (args, registers, ...)
show ...                       # info about GDB itself (settings)
show version                   # GDB version
show configuration             # how GDB was built
show copying / show warranty   # license text

## 4. Running Programs

## 4.1 Compiling for Debugging

; You must compile with `-g` to get debug info. `-g3` adds macros. A newer DWARF version is better.
; `-O0` makes debugging easier, but GCC also allows `-g -O2` together.

gcc -g app.c                    # basic debug info (DWARF)
gcc -g3 app.c                   # + preprocessor macro info (needed for "macro" cmds)
gcc -g -O0 app.c                # no optimization = easiest debugging
gcc -g -O2 app.c                # optimized but still debuggable (harder)
gcc -ggdb3 app.c                # max GDB-specific debug info
gcc -g -fno-omit-frame-pointer  # better backtraces in optimized code

## 4.2 Starting the Program

; `run` starts the program. `start` = temporary breakpoint on `main` + `run`. `starti` stops at the
; very first instruction (before `main`; useful for elaboration / static constructors).

run       / r                       # start the program (uses saved args)
run ARGS                            # start with these args (shell expands *, $, <, >)
run < in.txt > out.txt              # redirect program I/O
start                               # temp breakpoint at main + run
start ARGS                          # same with args
starti                              # stop at the very first instruction
set exec-wrapper env 'LD_PRELOAD=libx.so'  # launch through a wrapper program
unset exec-wrapper / show exec-wrapper  # remove / show the exec wrapper
target native                       # connect to native target explicitly
disconnect                          # disconnect from target
set disable-randomization off       # keep ASLR on (default: GDB disables ASLR)
show disable-randomization          # show whether GDB disables ASLR

set startup-with-shell off          # start program directly, not via $SHELL
show startup-with-shell             # show whether the program starts via $SHELL
set startup-with-shell on           # start the program via $SHELL (default)

set auto-connect-native-target off  # "run" will not auto-connect to native target 👍
show auto-connect-native-target     # show whether "run" auto-connects to the native target
set auto-connect-native-target on   # let "run" auto-connect to the native target (default)

## 4.3 Arguments, Environment, Working Directory, I/O

; `set args` sets the arguments for the next run. `set environment` changes env variables for the
; program only, not for GDB. `set cwd` changes the program's working directory; `cd` changes GDB's
; own. `tty` sends the program's input/output to another terminal.

set args ARGS                       # arguments for the next run
set args                            # clear arguments
set args "ab                        # multi-line arg: GDB shows ">" secondary prompt
show args                           # show the arguments for the next run

path DIR                            # add DIR to front of program's PATH
show paths                          # show the program's PATH
show environment [VAR]  / show env  # show the program's environment (or one VAR)
set environment VAR [=VALUE] / set env VAR=VALUE  # set for the PROGRAM
unset environment VAR               # remove VAR completely (not just empty)

set cwd DIR                         # program's working directory (next run)
set cwd                             # reset: inherit GDB's cwd
show cwd                            # show the program's working directory
cd [DIR]                            # change GDB's own working directory
pwd                                 # print GDB's working directory 👍
info proc cwd                       # actual cwd of the running debuggee (Linux)

info terminal                       # terminal modes the program uses 👍

show inferior-tty                   # show the terminal used for program I/O
tty /dev/pts/3                      # program I/O on another terminal ❤️
set inferior-tty /dev/pts/3         # same as tty
set inferior-tty                    # reset to GDB's terminal

## 4.4 Attach / Detach / Kill

; `attach PID` connects GDB to a running process. `detach` lets it continue without you. `kill` kills
; it. You need permission (on Linux see `ptrace_scope`).

attach PID     # attach to a running process
attach -f PID  # (some targets) force
detach         # let the process continue without GDB
kill      / k  # kill the debugged process
info files     # show active targets ⭐

; Linux: if attach is denied
echo 0 | sudo tee /proc/sys/kernel/yama/ptrace_scope  # allow ptrace attach to any own process (Linux Yama)  @permission @denied

## 5. Stopping & Continuing

## 5.1 Breakpoints — Setting

; A breakpoint stops the program at a place (location). You can put it on a function, a line, an
; address, or with a condition. `tbreak` = temporary (deleted after the first hit). `rbreak` puts
; breakpoints on all functions that match a regex. `hbreak` = hardware breakpoint.

break     / b                       # at current line (or next instruction in frame)
break LOCATION                      # see "Location Specifications" below ⭐
break main                          # at function
break file.c:42                     # file:line
break 42                            # line in current file
break *0x401234                     # at an address
break +2 / break -3                 # offset from current line
break func if x > 5                 # conditional breakpoint
break file.c:42 thread 3            # only for thread 3
break func inferior 2               # only for inferior 2
break func task 4                   # Ada task-specific
break -force-condition func if bad_cond  # keep condition even if it can't be evaluated now
break -qualified ns::func           # exact match only, no wildcard/namespace search
break -source f.c -line 10          # explicit location
break -function foo -label L1       # explicit: function + label
tbreak LOCATION  / tb               # temporary breakpoint (deleted after first hit)
hbreak LOCATION  / hb               # hardware breakpoint (needs target support)
thbreak LOCATION / thb              # temporary hardware breakpoint
rbreak REGEX                        # break on ALL functions matching regex
rbreak file.c:REGEX                 # limit to one file
rbreak ^foo_                        # all functions starting with foo_
info breakpoints / info break / i b # list all breakpoints
info breakpoints 3                  # only #3
info break 3-5                      # range of breakpoint numbers
maint info breakpoints              # includes GDB's internal breakpoints

set breakpoint pending on|off|auto  # what to do if location is not found yet
set breakpoint always-inserted on   # keep breakpoints inserted while stopped
set breakpoint auto-hw on|off       # auto choose hw breakpoints when needed
set breakpoint condition-evaluation host|target|auto  # choose who evaluates breakpoint conditions
set multiple-symbols all|ask|cancel # what to do when a name is ambiguous
show breakpoint pending             # show the pending breakpoint setting

; Location Specifications (locspec): accepted by `break`, `list`, `until`, `advance`, `jump`,
; `tbreak`, `dprintf`, `edit`, `info scope`, `info line`, `trace`...

LINENUM                             # LINESPEC: line in current file
-OFFSET / +OFFSET                   # LINESPEC: relative to current line
FILENAME:LINENUM                    # LINESPEC: file:line
FUNCTION                            # LINESPEC: start of function (after prologue)
FUNCTION:LABEL                      # LINESPEC: a C label inside the function
FILENAME:FUNCTION                   # LINESPEC: function in a specific file
*ADDRESS                            # LINESPEC: exact address, e.g. *0x401000, *main+4
'file.c'::func                      # LINESPEC: quoted when names have special chars

-source FILE  -function FUNC  -line N  -label L  -qualified  # EXPLICIT location options

break foo                           # Wildcards: "break foo" matches foo, ns::foo, A::foo unless -qualified.

## 5.2 Watchpoints

; A watchpoint stops the program when the value of an expression changes (not when it reaches a line).
; `watch` = write, `rwatch` = read, `awatch` = read or write. Hardware watchpoints are fast; software
; ones are very slow. `-l` / `-location` watches the address, not the expression (useful for locals
; that will go out of scope).

watch EXPR                    # stop when EXPR's value changes (write)
watch -l EXPR / watch -location *ptr  # watch the ADDRESS of EXPR
watch var if var > 100        # conditional watchpoint
watch var thread 2            # thread-specific
watch var mask 0xffff00       # masked watchpoint (some targets)
rwatch EXPR                   # stop when EXPR is READ
awatch EXPR                   # stop on read OR write
info watchpoints              # list watchpoints (subset of info break)
set can-use-hw-watchpoints 0  # force software watchpoints
show can-use-hw-watchpoints   # show whether hardware watchpoints are allowed

## 5.3 Catchpoints

; A catchpoint stops on an event, not a place: exception, syscall, signal, fork, library load... Very
; useful when you do not know where the code fails.

catch throw [REGEX]          # C++ exception thrown
catch rethrow [REGEX]        # C++ exception rethrown
catch catch [REGEX]          # C++ exception caught
tcatch EVENT                 # temporary catchpoint
catch exception [NAME]       # Ada exception (or all)
catch exception unhandled    # Ada unhandled exception
catch handlers [NAME]        # Ada exception handler entered
catch assert                 # Ada failed assertion
catch exec                   # program calls exec()
catch fork                   # fork()
catch vfork                  # vfork()
catch load [REGEX]           # shared library loaded
catch unload [REGEX]         # shared library unloaded
catch syscall                # ANY syscall (entry and return)
catch syscall write          # by name
catch syscall 1              # by number
catch syscall group:network  # by group (network, process, file, ...)
catch syscall g:file         # catch syscalls by group, short "g:" form
catch signal [SIG...]        # signal delivered (e.g. catch signal SIGUSR1)
catch signal all             # including SIGTRAP/SIGINT used by GDB
info breakpoints             # catchpoints are listed here too

## 5.4 Deleting, Disabling, Enabling

; `delete` removes, `disable` turns off for now, `enable once` turns on for one hit only, `enable
; delete` = becomes temporary, `enable count N` = N hits and then it turns off.

clear                             # delete breakpoints at current line
clear FUNCTION / clear file:line  # delete breakpoints at that location
delete [BPS]     / d              # delete breakpoints (all if no args, asks confirm)
delete 2 4-6                      # by number and ranges
delete bookmark N                 # (checkpoints) - see section 8
disable [BPS]    / dis            # turn off but keep
enable  [BPS]    / en             # turn on
enable once BPS                   # enable, disable again after 1 hit
enable count N BPS                # enable for N hits
enable delete BPS                 # enable, delete after 1 hit (= tbreak)
disable/enable 3.1                # a single location of multi-location bp #3

## 5.5 Conditions, Ignore Counts, Command Lists

; `condition` adds or removes a condition. `ignore N COUNT` = skip the breakpoint COUNT times.
; `commands` lets you write commands that run automatically every time the breakpoint is hit (you must
; finish with `end`). `silent` as the first command hides the normal message.

condition 2 x == 10         # add/change condition on bp 2
condition 2                 # remove condition
condition -force 2 badexpr  # keep even if it cannot be evaluated now
ignore 2 5                  # skip bp 2 the next 5 times
info break                  # shows "breakpoint already hit N times"

commands [BPS]              # attach command list (default: last bp)
    silent                       # do not print the normal stop message
    printf "x=%d\n", x
    continue                     # auto-continue
  end
commands 2-3                # same list for several breakpoints
commands                    # with no args: last breakpoint created
$bpnum                      # number of the last breakpoint set
$_hit_bpnum / $_hit_locno   # bp number / location number just hit

## 5.6 Dynamic Printf (dprintf)

; `dprintf` = a breakpoint that prints a message and continues, without stopping. Like adding `printf`
; to the code, but without recompiling. `set dprintf-style` chooses who runs the printf: GDB, the
; program itself (call), or the agent on gdbserver.

dprintf LOCATION,"FORMAT",ARGS...  # print a message at LOCATION and continue, no stop
dprintf file.c:42,"x=%d y=%s\n", x, y  # print x and y every time line 42 runs
set dprintf-style gdb|call|agent   # who does the printing
set dprintf-function fprintf       # for "call" style
set dprintf-channel stderr         # first arg for the function
set disconnected-dprintf on|off    # keep dprintf running after disconnect (agent)

## 5.7 Saving Breakpoints, Static Probes

; `save breakpoints FILE` saves all breakpoints to a file that you can `source` later. Static probes
; (SystemTap / DTrace `USDT`) are markers inside the code that you can put breakpoints on.

save breakpoints bps.gdb           # save all bps/wps/catchpoints/dprintf/tracepoints
source bps.gdb                     # restore them
info probes [stap|dtrace] [PROVIDER [NAME [OBJFILE]]]  # list static probes (SystemTap / DTrace)
info probes all                    # list probes of all types
break -probe-stap provider:name    # break on a SystemTap probe
break -probe-dtrace provider:name  # break on a DTrace probe
break -probe provider:name         # any probe type
enable/disable probes [PROVIDER [NAME]]  # DTrace probes only
$_probe_argc, $_probe_arg0..$_probe_arg11  # probe arguments
$_probe_arg0                       # first argument of the probe

## 5.8 Common Breakpoint Errors

; "Cannot insert breakpoints" usually happens because GDB did not detach correctly, or because the
; memory is read-only (use `hbreak`). "Breakpoint address adjusted" happens on some architectures when
; the address is not at the start of an instruction bundle.

Cannot insert breakpoints:      # another process debugs the target, or memory is read-only
    -> try hbreak, or "set breakpoint always-inserted", or check mem regions (section 13)
Breakpoint address adjusted...  # GDB moved the bp to a valid instruction boundary

## 6. Stepping & Skipping

## 6.1 Continuing and Stepping

; `continue` runs until the next stop. `next` runs one line and steps over function calls; `step` goes
; into functions. `finish` runs until the current function returns and prints the return value.
; `until` runs until a higher line (useful to leave loops). `advance` is like `until` but with a
; location. The `-i` versions work at the instruction level.

continue [N] / c / fg      # continue; N = ignore this bp N-1 more times
next [N]     / n           # step over (one source line, skip calls) ⭐
step [N]     / s           # step into
stepi [N]    / si          # one machine instruction, step into ⭐
nexti [N]    / ni          # one machine instruction, step over calls ⭐
finish       / fin         # run until current function returns, print value ⭐⭐⭐⭐
set print finish on|off    # print the return value on finish
until        / u           # next line, but do not go BACK in loops
until LOCATION             # run until LOCATION or current frame returns
advance LOCATION           # run until LOCATION (stops also if frame returns)
display/i $pc              # auto-show current instruction after each step ⭐

set step-mode on           # step INTO functions without debug info
set step-mode off          # (default) step OVER functions without line info
set range-stepping on|off  # let gdbserver do range stepping (faster)
show step-mode             # show the step-mode setting

## 6.2 Skipping Functions & Files

; `skip` tells `step` not to enter some functions or files (like `std::` or headers). Very useful in
; C++.

skip FUNCTION                 # never step into this function
skip -function REGEX_OR_NAME  # never step into this function
skip -rfunction ^std::        # regex on function name
skip -file FILE               # skip whole file
skip -gfile *.h               # glob on file name
skip -gfile /usr/include/*    # skip system headers
skip file [FILE]              # old syntax
skip function [FUNC]          # old syntax
info skip                     # list skips
skip delete [N...]            # delete
skip enable  [N...]           # enable skips
skip disable [N...]           # disable skips

## 7. Signals

; `info signals` shows what GDB does with each signal: stop (Stop), print (Print), pass it to the
; program (Pass). `handle` changes this. Common example: `handle SIGPIPE nostop noprint pass`. `signal
; SIG` continues the program and sends it a signal; `signal 0` continues without the signal it stopped
; for. `queue-signal` queues the signal without continuing.

info signals / info handle          # table of all signals and actions
info signals SIGINT                 # one signal
handle SIG KEYWORDS...              # change actions; SIG can be name, number, range, "all"
    # keywords: stop / nostop, print / noprint, pass / nopass (= ignore)
handle SIGUSR1 nostop noprint pass  # ignore SIGUSR1 completely
handle SIGSEGV stop print nopass    # stop and print on SIGSEGV, do not pass it to the program
handle 14-15 nostop                 # do not stop on signals 14 to 15 (range)
signal SIG                          # continue program and deliver SIG
signal 0                            # continue WITHOUT delivering the pending signal
queue-signal SIG                    # queue a signal, do not resume
$_siginfo                           # convenience var: full siginfo of last signal
p $_siginfo._sifields._sigfault.si_addr  # faulting address on SIGSEGV

; Note: `handle` on a thread-specific signal in non-stop mode applies to the whole program.

## 8. Threads, Inferiors, Forks, Checkpoints

## 8.1 Inferiors, Connections & Programs

; The inferior = the program/process GDB is debugging. GDB can debug more than one inferior at the
; same time (more than one process, maybe on different targets). Each inferior has a `program space`
; (address space) and a `connection`.

info inferiors                   # list inferiors (* = current)
inferior N                       # switch to inferior N
add-inferior [-copies N] [-exec FILE] [-no-connection]  # create new inferior
clone-inferior [-copies N] [ID]  # clone current inferior
remove-inferiors N...            # remove exited inferiors
detach inferiors N...            # detach
kill inferiors N...              # kill
info connections                 # list target connections
info program-spaces / maint info program-spaces  # list program spaces
set schedule-multiple on         # resume all inferiors, not just current
set follow-exec-mode new|same    # exec(): new inferior or reuse
show schedule-multiple           # show whether all inferiors resume together

$_inferior                       # number of current inferior
break foo inferior 2             # inferior-specific breakpoint

## 8.2 Threads

; `info threads` shows all threads. `thread N` moves you to another thread. `thread apply all bt`
; prints a backtrace of every thread. `set scheduler-locking` controls which threads move when you
; `step`. All-stop mode (default): when any thread stops, all stop. Non-stop mode: only the thread
; that stopped is stopped.

info threads [ID...]               # list threads (* = current); -gid shows global id
thread N          / t N            # switch to thread N
thread 1.2                         # inferior 1, thread 2
thread                             # show current thread
thread apply all CMD               # run CMD on every thread
thread apply all bt                # backtrace of all threads
thread apply all -ascending bt     # oldest first
thread apply 1 3-5 CMD             # on some threads
thread apply all -s CMD            # -s: silent on errors/empty output
thread apply all -c CMD            # -c: continue on error
thread apply all -q CMD            # -q: quiet (no thread header)
taas CMD                           # = thread apply all -s CMD
tfaas CMD                          # = thread apply all -s frame apply all -s CMD
thread name NAME                   # name the current thread
thread find REGEX                  # find threads by name/id/target id
thread apply all -- -p             # "--" if CMD starts with "-"

set print thread-events on|off     # print "[New Thread...]" messages
set libthread-db-search-path PATH  # where to look for libthread_db
set auto-load libthread-db on      # auto-load the matching libthread_db
maint check libthread-db           # run integrity checks on the loaded libthread_db

; --- scheduling ---
set scheduler-locking off|on|step|replay  # choose which threads run when you step / continue
    # off: all threads run when you step / continue
    # on:  only the current thread runs
    # step: only current thread runs while stepping; "continue" resumes all
    # replay: (default) like "on" only during replay
show scheduler-locking             # show the scheduler-locking mode
set schedule-multiple on|off       # resume all inferiors or only the current one

; --- all-stop vs non-stop ---
set non-stop on                    # must be set BEFORE run/attach
set pagination off                 # recommended with non-stop
set target-async on                # old name; async is the default now
show non-stop                      # show whether non-stop mode is on
continue &                         # run in the background ("&" = async)
run &  / step &  / next &  / attach &  # background versions
interrupt                          # stop the current thread (non-stop)
interrupt -a                       # stop all threads
continue -a                        # resume all threads in non-stop

break foo thread 3                 # thread-specific breakpoint
$_thread                           # current thread number
$_gthread                          # global thread number
$_inferior_thread_count            # number of threads in current inferior

; --- interrupted syscalls ---
; In all-stop, a stopped thread's syscall may return EINTR when GDB
; stops it; program should handle EINTR properly.

; --- observer mode (do not modify the target) ---
set observer on|off                # implies may-write-registers/memory off etc.
set may-write-registers off        # forbid writing registers (observer mode)
set may-write-memory off           # forbid writing memory (observer mode)
set may-insert-breakpoints off     # forbid inserting breakpoints (observer mode)
set may-insert-tracepoints off     # forbid inserting tracepoints (observer mode)
set may-insert-fast-tracepoints off  # forbid inserting fast tracepoints (observer mode)
set may-interrupt off              # forbid interrupting the program (observer mode)

## 8.3 Forks

; When the program calls `fork`, GDB follows the parent by default. `set follow-fork-mode child` makes
; it follow the child. `set detach-on-fork off` makes it keep both as inferiors.

set follow-fork-mode parent|child  # which side to follow after fork
set follow-fork-mode child         # ⭐⭐⭐⭐⭐
set detach-on-fork on|off          # off = keep both as inferiors
show follow-fork-mode              # show which side GDB follows after fork
catch fork / catch vfork / catch exec  # stop on fork / vfork / exec
set follow-exec-mode new|same      # exec(): new inferior or reuse
info inferiors                     # see both processes when detach-on-fork off

## 8.4 Checkpoints (Bookmarks)

; `checkpoint` takes a snapshot of the process (it uses fork inside). You can go back to it with
; `restart N` and try again from the same point. Linux only.

checkpoint           # save a snapshot of the process
info checkpoints     # list them
restart N            # go back to checkpoint N
delete checkpoint N  # remove
; Benefit: a restarted checkpoint keeps the same PID -> same addresses

## 9. Reverse Execution & Process Record

## 9.1 Reverse Execution

; If the target supports it (for example after `record`), you can go backward: `reverse-next`,
; `reverse-step`, `reverse-continue`... the normal commands, but in reverse. `set exec-direction
; reverse` reverses all the normal commands.

reverse-continue / rc       # run backward until a breakpoint
reverse-step [N] / rs       # step backward into functions
reverse-stepi    / rsi      # one instruction backward
reverse-next [N] / rn       # step backward over calls
reverse-nexti    / rni      # one instruction backward, step over calls
reverse-finish              # go back to where current function was called
set exec-direction reverse  # make normal step/next/continue go backward
set exec-direction forward  # make step/next/continue go forward again (default)
show exec-direction         # show the execution direction

## 9.2 Process Record and Replay

; `record` records every instruction so you can replay and go in reverse. There are 3 methods: `full`
; (software, slow but works everywhere), `btrace bts` and `btrace pt` (hardware branch tracing on
; Intel; does not record data). `record save/restore` saves the log to a file.

record                              # = record full (start recording)
record full                         # start full (software) recording
record btrace                       # hardware branch trace (Intel)
record btrace bts                   # Branch Trace Store
record btrace pt                    # Intel Processor Trace
record btrace ptw                   # PT with ptwrite support (py gdb.ptwrite)
record stop                         # stop recording, keep process
record delete                       # delete log after current point
record goto begin|start|end|N       # jump in the log
record instruction-history [RANGE] [/m|/r|/s|/f]  # btrace only
record function-call-history [RANGE] [/l|/c|/i|/s]  # show recorded function calls (btrace only)
record save FILE                    # save log to file (record full)
record restore FILE                 # load a saved log (needs core file)
info record                         # status
set record full insn-number-max N|unlimited  # max instructions kept in a full record log
set record full stop-at-limit on|off  # stop (ask) when the full record log is full
set record full memory-query on|off # ask when memory cannot be recorded
set record btrace replay-memory-access read-only|read-write  # allow memory writes during btrace replay
set record btrace cpu auto|none|VENDOR:PROC/STEP  # CPU used for btrace errata workarounds
set record btrace bts buffer-size N # BTS trace buffer size
set record btrace pt buffer-size N  # Intel PT trace buffer size
set record btrace pt event-tracing on|off  # record Intel PT events too
set record btrace pt ptwrite-filter on|off  # enable the Python ptwrite filter
set record instruction-history-size N  # how many instructions "record instruction-history" shows
set record function-call-history-size N  # how many calls "record function-call-history" shows

## 10. Examining the Stack

## 10.1 Frames & Backtraces

; Every function call has a `frame` on the stack. Frame #0 = the function we are stopped in now.
; `backtrace` prints all frames. `bt full` prints the locals too. `bt -N` prints the last N frames
; (the oldest). `up`/`down` move you between frames; `frame N` moves you to a given frame.

backtrace / bt / where / info stack  # print call stack
bt N                              # innermost N frames ⭐
bt -N                             # outermost N frames
bt full                           # with local variables
bt -full                          # same (option form)
bt -no-filters                    # ignore Python frame filters
bt -hide                          # hide frames elided by filters
bt -past-main on                  # continue past main() into startup code
bt -past-entry on                 # continue past the entry point
bt -entry-values no|only|preferred|if-needed|both|compact|default  # how to show argument values at function entry
bt -frame-arguments all|scalars|none|presence  # which argument values to print
bt -raw-frame-arguments on        # ignore pretty printers for arguments
bt -frame-info auto|source-line|location|source-and-location|location-and-address|short-location  # what to print for each frame
set backtrace past-main on        # backtraces continue past main()
set backtrace past-entry on       # backtraces continue past the entry point
set backtrace limit N             # max frames
set print frame-arguments scalars|all|none|presence  # which arguments to print in frames
set print frame-info ...          # what to print for each frame
set print entry-values ...        # how to print argument values at function entry
set print raw-frame-arguments on  # ignore pretty printers for frame arguments
set filename-display basename|relative|absolute  # how file names are shown

## 10.2 Selecting & Inspecting Frames

frame / f                   # print the current frame
frame N / f N               # select frame by level (0 = innermost)
frame level N               # select frame by level
frame address ADDR          # select by stack address
frame function NAME         # select innermost frame of function NAME
frame view STACK_ADDR [PC]  # view a frame that is not on the current stack
up [N]                      # go N frames toward the caller (outer)
down [N]                    # go N frames toward the callee (inner)
up-silently [N] / down-silently [N]  # same without printing
select-frame N              # select without printing
info frame / info f         # detailed info about selected frame
info frame level N / address A / function F / view A  # detailed info about a chosen frame
info args                   # arguments of current frame
info args -q / info args REGEX / info args -t TYPEREGEX  # filter arguments by name or type, -q quiet
info locals                 # local variables (all nested blocks)
info locals -q REGEX        # filter local variables by name, quiet
info registers              # registers as seen from this frame
frame apply all CMD         # run CMD in every frame
frame apply N CMD           # innermost N frames
frame apply -N CMD          # outermost N
frame apply level 2-4 CMD   # by level
frame apply all -s CMD      # silent errors; also -c, -q, -past-main, -past-entry
faas CMD                    # = frame apply all -s CMD

## 10.3 Frame Filters (Python)

; Frame filters are Python code that changes how the backtrace looks (hide frames or add info). These
; commands manage them.

info frame-filter               # list filters and priorities
disable frame-filter DICT NAME  # DICT: global, progspace, or objfile name
enable frame-filter DICT NAME   # enable a frame filter
set frame-filter priority DICT NAME PRIORITY  # set the priority of a frame filter
show frame-filter priority DICT NAME  # show the priority of a frame filter

## 11. Examining Source Files

## 11.1 Printing Source Lines

; `list` prints 10 lines. With no args it continues from the last place. `list -` goes back. `list
; FUNC` prints around the function. `set listsize` changes the number of lines.

list / l                  # 10 more lines (around current line first time)
list -                    # 10 lines BEFORE the last printed
list +                    # 10 lines after
list .                    # around the current location again
list LINENUM              # centered on line
list FUNCTION             # centered on function start
list file.c:42            # list lines around file.c:42
list 10,20                # range
list ,20                  # 10 lines ending at 20
list 10,                  # 10 lines starting at 10
list *0x401234            # around an address
set listsize N|unlimited  # lines per list
show listsize             # show lines per list
info source               # current source file info (compiler, dir, ...)
info line LOCATION        # address range for a source line
info line *0x401234       # which line is at this address

## 11.2 Editing, Searching, Source Directories

; `edit` opens the editor (from `$EDITOR`) at the current line. `search`/`reverse-search` search the
; file with a regex. `directory` adds places where GDB looks for source. `set substitute-path`
; replaces part of the path (when the binary was built in another place).

edit                              # open editor at current line
edit LOCATION                     # e.g. edit main, edit file.c:20
; uses $EDITOR; e.g. export EDITOR=/usr/bin/vim

search REGEX / forward-search REGEX / fo REGEX  # search forward in the source file
reverse-search REGEX / rev REGEX  # search backward in the source file

directory DIR... / dir DIR...     # add to source path (front)
directory                         # reset to default ($cdir:$cwd)
show directories                  # show the source search path
set directories DIR:DIR           # replace source path
set substitute-path FROM TO       # e.g. set substitute-path /build/src /home/me/src
unset substitute-path [FROM]      # remove a path substitution (all if no FROM)
show substitute-path              # show path substitutions
set source open on|off            # off = never read source files (headers still checked)
show source open                  # show whether GDB reads source files

## 11.3 Source and Machine Code

; `disassemble` prints the assembly. `/m` or `/s` mixes source with assembly. `/r` prints the raw
; bytes. `x/i` prints instructions from an address. `set disassembly-flavor intel` for people who
; prefer Intel syntax.

disassemble / disas               # current function
disassemble FUNC                  # disassemble this function
disassemble 0x400,0x420           # start,end
disassemble 0x400,+32             # start,+length
disassemble /m                    # mixed source+asm (source order; deprecated)
disassemble /s                    # mixed source+asm (address order; better)
disassemble /r                    # raw bytes too
disassemble /b                    # raw bytes, one byte each (for wide-insn arches)
disassemble /ri                   # raw bytes too, in the other byte order (/r + /i)
x/10i $pc                         # 10 instructions from PC
x/3i main+8                       # 3 instructions starting at main+8
display/i $pc                     # show next instruction at each stop
set disassembly-flavor intel|att  # x86 syntax
set disassembly-flavor intel      # ⭐⭐⭐⭐⭐
set disassemble-next-line on|off|auto  # show disassembly of the next line at each stop
set disassembler-options OPTS     # e.g. "no-aliases" for RISC-V
show disassembler-options         # show disassembler options
info line *$pc                    # which source line the PC is at
maint print objfiles              # (see maintenance)

## 12. Examining Data

## 12.1 print / Expressions

; `print` (or `p`) evaluates any expression in the program's language (C, C++, ...) and prints it. The
; result goes into the value history `$1, $2...`. You can use `::` to choose the scope, `@` to make an
; artificial array, casts, and function calls.

print EXPR / p EXPR / inspect EXPR  # evaluate and print an expression
print                               # print $ again (last value)
print/x EXPR                        # with format (see formats)
print -pretty -- EXPR               # with options (see below)
p var                               # print a variable
p arr[3]                            # print an array element
p *ptr                              # print what a pointer points to (dereference)
p ptr->field                        # print a struct field through a pointer
p obj.method(3)                     # call a function/method
p func(1, 2)                        # call a function and print the result
p (char)x                           # cast
p {int}0x601040                     # treat address as int
p sizeof(struct foo)                # print the size of a type
p $rip                              # registers
p $1 + $2                           # value history
p $                                 # last value; $$ = one before; $$3 = 3 before
p 'file.c'::global_var              # variable in another file
p func::static_var                  # static in a function
p ns::Class::member                 # C++ scope
p &var                              # address
p *arr@10                           # artificial array: 10 elements from arr[0]
p/x arr[0]@5                        # 5 elements from arr[0] in hex
p arr[1]@3                          # 3 elements starting at arr[1]
p $_siginfo                         # print info about the last signal
p $_exitcode                        # print the exit code of the program
p -elements 200 -- big_array        # print up to 200 elements, this command only
p -array-indexes on -- arr          # print array with [i] = indexes
p -null-stop on -- charbuf          # stop C strings at first NUL
p -object on -- *base_ptr           # print real derived type (C++)
p -vtbl on -- obj                   # print C++ virtual function tables nicely
p -static-members off -- obj        # hide C++ static members
p -union on -- u                    # print unions inside structs
p -symbol on -- ptr                 # print <symbol+off> next to pointers
p -address off -- ptr               # hide addresses
p -repeats N -- arr                 # "<repeats N times>" threshold
p -max-depth N -- deep_struct       # limit nested struct depth
p -memory-tag-violations on -- ptr  # show memory tag violations
p -nibbles on -- /t x               # group binary digits by 4
p -raw-values on -- obj             # ignore pretty printers
p -characters N -- str              # limit chars printed

## 12.2 Ambiguous Expressions & Program Variables

; If a name exists in more than one place (overloaded / templates / same name in two files), GDB
; either prints all of them or asks you, depending on `set multiple-symbols`. Variables not in the
; current frame need `::` or select the `frame` first. If the variable was optimized out you will see
; `<optimized out>`.

set multiple-symbols all|ask|cancel  # what to do when a name is ambiguous
p 'file.c'::var    # disambiguate file
p function::var    # disambiguate function-static
p 'foo(int)'       # quote overloaded C++ names
p ns::foo<int>(x)  # template function

## 12.3 Output Formats

; After `/` you put a format letter (and maybe a size). Works with `print`, `x`, `display`, `output`.

/x                # Format letters (print/FMT): hexadecimal
/d                # Format letters (print/FMT): signed decimal
/u                # Format letters (print/FMT): unsigned decimal
/o                # Format letters (print/FMT): octal
/t                # Format letters (print/FMT): binary (two)
/a                # Format letters (print/FMT): address + <symbol+off>
/c                # Format letters (print/FMT): character
/f                # Format letters (print/FMT): float
/s                # Format letters (print/FMT): string
/z                # Format letters (print/FMT): hex, zero-padded
/i                # Format letters (print/FMT): instruction (x only)
/r                # Format letters (print/FMT): raw (bypass pretty printer)

/b                # Size letters (for x command): byte (1)
/h                # Size letters (for x command): halfword (2)
/w                # Size letters (for x command): word (4)
/g                # Size letters (for x command): giant (8)

p/x 255           # 0xff
p/t 10            # 1010
p/c 65            # 65 'A'
p/d 'A'           # 65
p/a 0x401136      # 0x401136 <main+4>
p/z 5             # 0x00000005
p $xmm0.v4_float  # vector register as 4 floats
p/x $sp           # stack pointer in hex
p/s buf           # as string
p/r obj           # raw, no pretty printer
p/x -1            # 0xffffffff (width of int)
output EXPR       # print without "$N =" and newline
output/x EXPR     # print in hex without "$N =" and newline
call EXPR         # like print but void results are not shown

## 12.4 Examining Memory (x)

; `x/NFU ADDR` = examine memory. N = number of units, F = format, U = size. If you press `Enter` on an
; empty line, it continues after the last address.

x/NFU ADDR  # N units, format F, unit size U
x/4xw &var  # 4 words in hex
x/8xb ptr   # 8 bytes in hex
x/s str     # C string ⭐
x/2s str    # 2 strings
x/10i $pc   # 10 instructions
x/3xg $sp   # 3 giant (8-byte) words
x/16c buf   # 16 chars
x/2f &dbl   # 2 floats (size from type)
x/ax $sp    # address format
x &var      # default: last format used
x $sp       # examine memory at the stack pointer
$_          # last address examined
$__         # contents of last address examined
x/-4xw $sp  # negative count: memory BEFORE address

## 12.5 Memory Tagging (AArch64 MTE)

memory-tag print-logical-tag POINTER  # print the logical tag of a pointer
memory-tag print-allocation-tag ADDR  # print the allocation tag at an address
memory-tag with-logical-tag POINTER TAG  # print a pointer with a different logical tag
memory-tag set-allocation-tag ADDR LENGTH TAGS  # set allocation tags of a memory range
memory-tag check POINTER  # validate pointer tag vs allocation tag
set print memory-tag-violations on|off  # show memory tag violations when printing

## 12.6 Automatic Display

; `display EXPR` prints the expression automatically every time the program stops. Useful when you go
; with `next` and want to watch a variable.

display EXPR          # show at every stop
display/FMT EXPR      # e.g. display/x flags
display/i $pc         # next instruction
display/4xw $sp       # show 4 words at the stack pointer at every stop
undisplay N...        # remove
delete display N...   # remove auto-display expressions
disable display N...  # stop showing auto-display expressions
enable display N...   # show auto-display expressions again
info display          # list
display               # redisplay all now

## 12.7 Print Settings

; These are all the `set print ...` settings that control how output looks. Most important: `pretty`,
; `elements`, `object`, `array-indexes`, `null-stop`.

set print address on|off            # show addresses next to pointers/strings
set print symbol on|off             # show <symbol> for pointers
set print symbol-filename on        # show file:line for symbols
set print array on|off              # arrays on multiple lines
set print array-indexes on|off      # print [0] = ... indexes
set print elements N|unlimited      # max array/string elements (default 200)
set print characters N|unlimited|elements  # max string chars
set print repeats N|unlimited       # threshold for "<repeats N times>"
set print null-stop on|off          # stop C arrays of char at NUL
set print pretty on|off             # indent structs
set print raw-frame-arguments on|off  # ignore pretty printers for frame arguments
set print raw-values on|off         # bypass pretty printers
set print sevenbit-strings on|off   # print non-ASCII chars as \nnn
set print union on|off              # print unions inside structs
set print object on|off             # C++: show real (dynamic) type
set print static-members on|off     # print C++ static members
set print vtbl on|off               # print C++ virtual function tables nicely
set print demangle on|off           # C++ names
set print asm-demangle on|off       # in disassembly
set demangle-style gnu-v3|auto|...  # choose the C++ demangling style
set print pascal_static-members on|off  # print Pascal static members
set print max-depth N|unlimited     # limit nested struct depth
set print max-symbolic-offset N|unlimited  # max offset shown in <symbol+offset>
set print type methods on|off       # ptype: show methods
set print type typedefs on|off      # ptype: show typedefs
set print type nested-type-limit N|unlimited  # ptype: depth of nested types
set print type hex on|off           # sizes/offsets in hex (ptype/o)
set print inferior-events on|off    # print messages when inferiors start / exit
set print thread-events on|off      # print "[New Thread...]" messages
set print finish on|off             # print the return value on finish
set print entry-values ...          # how to print argument values at function entry
set print frame-arguments ...       # which arguments to print in frames
set print frame-info ...            # what to print for each frame
set print nibbles on|off            # group binary digits by 4
set print memory-tag-violations on|off  # show memory tag violations when printing
set print symbol-loading off|brief|full  # messages when loading symbols
show print ...                      # any of the above
show print                          # all print settings

## 12.8 Pretty Printing

; Pretty printers are Python scripts that make GDB print complex types (like `std::vector`,
; `std::map`) in a readable way. libstdc++ comes with ready printers (auto-load). These commands
; control them. `/r` skips them.

info pretty-printer [OBJECT-REGEX [NAME-REGEX]]  # list printers
disable pretty-printer [OBJECT-REGEX [NAME-REGEX]]  # disable pretty printers
enable pretty-printer [OBJECT-REGEX [NAME-REGEX]]  # enable pretty printers
disable pretty-printer global std::vector  # disable the global std::vector printer
p/r vec                            # print raw without printer
set print raw-values on            # bypass pretty printers always
python print(gdb.pretty_printers)  # global list

## 12.9 Value History & Convenience Variables

; Every `print` saves its result in `$N`. Convenience variables start with `$` and you can make your
; own (`set $i = 0`). GDB has many ready ones (`$_`, `$_exitcode`, `$bpnum`...). See section 29 for
; the full list.

p $                             # last value
p $$                            # value before last
p $$N                           # N values back
p $5                            # history entry 5
show values                     # last 10 values
show values N                   # 10 values around N
show values +                   # next 10
set $foo = 42                   # your own convenience variable
set $ptr = list_head            # store a pointer in a convenience variable
p *$ptr; set $ptr = $ptr->next  # walk a linked list (repeat with RET)
p $foo++                        # increment
show convenience / show conv    # list all convenience vars & functions
init-if-undefined $x = 0        # set only if not already set
set var x = 5                   # program variable (use "set var" to avoid clashes)

## 12.10 Convenience Functions

p $_memeq(buf1, buf2, 16)          # compare memory
p $_streq(s1, s2)                  # string equal
p $_strlen(s)                      # string length
p $_regex(s, "^ab.*")              # regex match
p $_isvoid(EXPR)                   # is void?
p $_gdb_setting_str("print elements")  # setting as string
p $_gdb_setting("print elements")  # setting as value
p $_gdb_maint_setting_str(...) / $_gdb_maint_setting(...)  # maint setting as string / value
p $_shell("cmd")                   # run shell, return exit code
p $_as_string(enum_val)            # value as string (Python)
p $_cimag(z) / $_creal(z)          # complex parts
p $_caller_is("main")              # is caller main? (also $_caller_matches, $_any_caller_is, $_any_caller_matches)
p $_caller_is("f", 2)              # check 2 frames up
help function                      # list all convenience functions

## 13. Registers, Memory, Core Files

## 13.1 Registers

; `info registers` prints the general registers. `$pc`, `$sp`, `$fp`, `$ps` are standard names on all
; architectures. `p $rax`, `p/x $eflags`. `info all-registers` prints everything (floating point,
; vector).

info registers / info reg / i r  # general registers
info registers rax rbx           # specific
info registers rip               # print only rip
info all-registers               # everything (float, vector, system)
info registers general|float|vector|system|all  # by group
maint print reggroups            # available groups
p $pc / p $sp / p $fp / p $ps    # standard names (program counter, stack ptr, frame ptr, status)
p/x $rax                         # print rax in hex
p $xmm0                          # vector register as union
p $xmm0.v4_float[0]              # first float in xmm0
p $ymm0.v8_float                 # ymm0 as 8 floats
set $rax = 0                     # write a register
set var $pc = 0x401000           # write the program counter
p $eflags                        # print the x86 flags register
info float                       # floating point unit status
info vector                      # vector unit status
x/i $pc                          # show the current instruction

## 13.2 OS Auxiliary Info, Memory Regions

; `info auxv` prints the auxiliary vector (from the kernel). `info os` gives you info from the OS like
; processes, threads, files. `mem` defines memory regions with permissions (ro/rw/wo) and cache
; attributes; useful for embedded.

info auxv                         # auxiliary vector (AT_* entries)
info os                           # list OS info types
info os processes|procgroups|threads|files|sockets|shm|semaphores|msg|modules|cpus  # print one kind of OS info

mem LOW HIGH ATTRS...             # define memory region
mem 0x1000 0x2000 ro              # read-only
mem 0x2000 0x3000 rw 8            # read-write, 8-byte access
mem auto                          # use target-provided memory map
mem 0x0 0x0 nocache               # attributes: ro rw wo 8 16 32 64 cache nocache
info mem                          # list regions
delete mem N... / disable mem N... / enable mem N...  # delete / disable / enable memory regions
set mem inaccessible-by-default on|off  # treat memory outside defined regions as not accessible
show mem inaccessible-by-default  # show the inaccessible-by-default setting

## 13.3 Copy Memory <-> File, Core Files

; `dump` saves memory or a value to a file (binary, ihex, srec, tekhex, verilog). `restore` puts it
; back into memory. `generate-core-file` (or `gcore`) makes a core dump of the running program. `core-file`
; opens a core.

dump [FORMAT] memory FILE START END  # FORMAT: binary(default) ihex srec tekhex verilog
dump [FORMAT] value FILE EXPR      # save the value of EXPR to a file
dump binary memory mem.bin 0x400000 0x401000  # save raw memory range to mem.bin
dump ihex value out.hex arr        # save arr in Intel hex format
append [binary] memory FILE START END  # append a memory range to a file
append [binary] value FILE EXPR    # append a value to a file
restore FILE [binary] [BIAS START END]  # load file into memory
restore mem.bin binary 0x400000    # load mem.bin into memory at 0x400000

generate-core-file [FILE]          # write core of running process
gcore [FILE]                       # write core of running process ❤️
set use-coredump-filter on|off     # honor /proc/PID/coredump_filter
set dump-excluded-mappings on|off  # gcore: also dump mappings marked as excluded
core FILE / core-file FILE         # load core file ❤️
core-file                          # discard core
target core FILE                   # use a core file as target
info proc mappings                 # memory map (Linux) ❤️

ulimit -c unlimited                # allow core dumps in the shell
cat /proc/sys/kernel/core_pattern  # where cores go
coredumpctl gdb                    # systemd systems

## 13.4 Character Sets, Caching, Search Memory, Value Sizes

set charset CHARSET             # both host & target
set host-charset / set target-charset / set target-wide-charset  # set one charset only
show charset                    # show the charsets
set charset UTF-8               # use UTF-8 for host and target

set remotecache on|off          # cache target memory (remote)
set stack-cache on|off          # cache stack memory
set code-cache on|off           # cache code memory
info dcache [line]              # data cache stats
maint flush dcache              # (maint) clear cache

find [/SIZE-CHAR] [/MAX-COUNT] START, END, VAL1 [, VAL2...]  # search memory between START and END
find [/SIZE-CHAR] [/MAX-COUNT] START, +LENGTH, VAL1...  # search LENGTH bytes of memory from START
find &buf[0], +100, "hello"     # search a string
find/w 0x400000, 0x500000, 0xdeadbeef  # search 4-byte value
find/1 ...                      # stop at first match (max count 1)
$_                              # address of last match
$numfound                       # number of matches

set max-value-size N|unlimited  # error if value bigger than N bytes (default 64k)
show max-value-size             # show max value size

## 14. Optimized Code, Macros

## 14.1 Inline Functions & Tail Calls

; In optimized code, inline functions appear in the backtrace as virtual frames. `step` goes into
; them, `finish` leaves them. Tail-call frames appear if the compiler recorded them (`-O2` + DWARF).
; If you see `<optimized out>`, the variable is not in a register/memory right now.

info frame                      # shows "inlined into frame N"
set debug entry-values 1        # debug tail-call detection
set print entry-values compact  # show foo@entry=... values
info locals                     # may show <optimized out>

## 14.2 C Preprocessor Macros

; If you compiled with `-g3`, GDB knows the macros. `macro expand` shows the expansion; `info macro`
; shows the definition and where it is. You can define temporary macros with `macro define`.

macro expand EXPR / macro exp  # show fully expanded expression
macro expand-once EXPR         # expand only one level
info macro [-a|-all] NAME      # definition of macro (all definitions with -a)
info macro -- -MACRO_NAME      # "--" if name starts with "-"
info macros [LOCATION]         # all macros visible at location
macro define NAME(ARGS) BODY   # user macro
macro define PI 3.14           # define an object-like macro
macro undef NAME               # remove a user macro
macro list                     # user-defined macros
p SOME_MACRO(3)                # GDB expands macros in expressions

## 15. Tracepoints

; Tracepoints collect data from the program without stopping it (useful for real-time / embedded). You
; need a target that supports it (`gdbserver` does). You define a tracepoint + `actions` that say what
; to collect, run `tstart`, the program runs, `tstop`, and then you browse the trace frames with
; `tfind`.

; --- create / delete ---
trace LOCATION / tr / tp / tracepoint  # set tracepoint
ftrace LOCATION                    # fast tracepoint (needs in-process agent)
strace LOCATION                    # static tracepoint (UST markers)
strace -m MARKER                   # by marker id
info tracepoints [N] / info tp     # list tracepoints
delete tracepoints [N...]          # delete
disable tracepoints [N...] / enable tracepoints [N...]  # disable / enable tracepoints
passcount COUNT [N]                # stop tracing after N hits
condition N EXPR                   # conditional tracepoint
trace foo if x > 3                 # conditional tracepoint

; --- trace state variables ---
tvariable $name [= EXPR]           # create trace state variable
info tvariables                    # list trace state variables
delete tvariable [$name...]        # delete trace state variables

; --- actions ---
actions [N]                        # define actions (end with "end")
    collect EXPR, EXPR...        # e.g. collect $regs, $locals, $args, $_ret, $_sdata, *ptr@10
    collect/s str                # collect as string
    teval EXPR                   # evaluate, no collect (e.g. teval $count++)
    while-stepping N / stepping N / ws N   # collect while single-stepping N times
      collect $pc
    end
  end
set default-collect EXPR...        # collect these at every tracepoint
info static-tracepoint-markers     # list UST markers

; --- run the experiment ---
tstart [NOTES]                     # start tracing
tstop [NOTES]                      # stop
tstatus                            # status
set disconnected-tracing on|off    # keep tracing after GDB disconnects
set circular-trace-buffer on|off   # overwrite oldest data when the trace buffer is full
set trace-buffer-size N|unlimited  # trace buffer size
set trace-user NAME / set trace-notes TEXT / set trace-stop-notes TEXT  # notes saved with the trace run

; --- examine collected data ---
tfind [start]                      # first frame
tfind none                         # exit trace-frame mode
tfind end                          # last
tfind / tfind next                 # next frame
tfind -                            # previous
tfind N                            # frame number N
tfind tracepoint N                 # next frame collected by tracepoint N
tfind pc ADDR                      # next frame at this PC
tfind range START, END             # next frame with PC inside the range
tfind outside START, END           # next frame with PC outside the range
tfind line [FILE:]LINE             # next frame at this source line
tdump                              # show all data of current trace frame
save tracepoints FILE              # save tracepoint definitions
$trace_frame                       # current frame number (-1 if none)
$tracepoint                        # tracepoint number of current frame
$trace_line / $trace_file / $trace_func  # line / file / function of current trace frame
$tpnum                             # last tracepoint number set
$_sdata                            # static tracepoint data

; --- trace files ---
tsave [-r] [-ctf] FILE             # save trace data (-r: remote saves; -ctf: CTF format)
target tfile FILE                  # open a saved trace file
target ctf DIR                     # open CTF trace directory

## 16. Overlays

; Overlays are an old system for embedded: parts of the code are loaded into the same memory in turns.
; GDB needs to know which overlay is "mapped" now so breakpoints work.

overlay off                         # disable overlay support
overlay manual                      # you tell GDB what is mapped
overlay map-overlay OVERLAY / overlay map OVERLAY  # tell GDB this overlay is now mapped
overlay unmap-overlay OVERLAY / overlay unmap OVERLAY  # tell GDB this overlay is no longer mapped
overlay auto                        # GDB reads _ovly_table from the program
overlay load-target / overlay load  # re-read the overlay table
overlay list-overlays / overlay list  # list overlays and mapped state
; program side: _ovly_table, _novlys, _ovly_debug_event()

## 17. Languages

; GDB understands many languages (C, C++, D, Go, Objective-C, OpenCL C, Fortran, Pascal, Rust,
; Modula-2, Ada, Asm, Minimal). It chooses the language automatically from the source file extension.
; `set language` changes it by hand (this changes the syntax of expressions).

show language                       # current working language
set language auto|local             # infer from frame (default)
set language c|c++|d|go|objective-c|opencl|fortran|pascal|rust|modula-2|ada|asm|minimal  # force a language
info frame                          # shows source language
info source                         # shows language of file
set check type on|off               # type checking
set check range on|off|warn         # range checking (Modula-2, Pascal, Ada)
show check type / show check range  # show type / range checking

; C / C++
set print demangle on               # show C++ names demangled
set overload-resolution on|off      # C++ overload resolution in expressions
p obj.*memfn                        # pointer to member
p dynamic_cast<D*>(base)            # casts: dynamic_cast, static_cast, reinterpret_cast, const_cast
p sizeof(T)                         # sizeof works on types and expressions
p ns::var                           # variable in a namespace
p this->x                           # "this" is available
info vtbl OBJ                       # print virtual table
set cp-abi auto|gnu-v3              # choose the C++ ABI
show cp-abi                         # show the C++ ABI
rbreak Class::.*                    # break on all methods

; D / Go / Rust / Objective-C
info classes [REGEX]                # Objective-C classes
info selectors [REGEX]              # Objective-C selectors
p [obj message]                     # ObjC method call in expressions
p x as u32                          # Rust cast syntax; p x.0 for tuple field
p mod::item                         # Rust paths

; Fortran
info common [NAME]                  # COMMON blocks
set fortran repack-array-slices on|off  # repack Fortran array slices into contiguous memory
p arr(1:5:2)                        # Fortran array slice
p SIZE(arr) / p LBOUND(arr) / p UBOUND(arr) / p KIND(x)  # intrinsics

; Ada
info tasks                          # Ada tasks
task N                              # switch task
task apply all CMD / task apply 1 2 -s CMD  # run CMD on Ada tasks
break LOC task N                    # Ada task-specific breakpoint
set ada print-signatures on|off     # show signatures of overloaded Ada functions
set ada trust-PAD-over-XVS on|off   # Ada: trust the PAD type over XVS (compiler workaround)
set ada source-charset CHARSET      # charset of Ada source files
catch exception / catch handlers / catch assert  # Ada exceptions, handlers, failed assertions
set print pascal_static-members     # print Pascal static members

## 18. Symbols

; These commands ask GDB about the symbol table: `whatis` = type of the expression, `ptype` = full
; definition of the type (`/o` prints offsets so you see the struct layout). `info
; functions/variables/types` search with a regex. `info scope`, `info address`, `info symbol`.

info address SYMBOL                # where is SYMBOL stored (register, static, ...)
info symbol ADDR                   # which symbol is at ADDR (e.g. main + 4 in section .text)
whatis EXPR                        # type of expression (one level)
whatis TYPE / whatis struct foo    # type name of a type (one level)
ptype EXPR / ptype TYPE            # full type definition
ptype/o struct foo                 # with offsets and sizes (struct layout, padding)
ptype/r ...                        # raw, no typedef substitution; /m no methods, /t no typedefs
ptype/x struct foo                 # offsets in hex; /d decimal
info types [REGEX]                 # types matching regex
info types -q REGEX                # quiet: no file headers
info scope LOCATION                # all variables local to a scope
info source                        # current source file info, including language
info sources [-dirname|-basename] [-- ] [REGEX]  # all source files
info functions [REGEX]             # functions (with -q, -n to skip non-debug, -t TYPEREGEX)
info functions -n ^foo             # exclude non-debugging symbols
info variables [REGEX]             # global/static variables
info variables -q -t int$ REGEX    # variables whose type matches int$, quiet
info line LOCATION                 # address range for a source line
info modules [-q] [REGEX]          # Fortran modules
info module functions / info module variables [-m MODREGEX] [-t TYPEREGEX] [REGEX]  # functions / variables in Fortran modules
info classes / info selectors      # Objective-C
info vtbl OBJ                      # C++ vtable
info set                           # all settings
set opaque-type-resolution on|off  # resolve opaque struct types when the full type is found
set print type ...                 # see print settings
maint print symbols / maint print psymbols / maint print msymbols FILE  # dump symbols / partial / minimal symbols to FILE
maint info symtabs / maint info psymtabs  # list expanded / partial symbol tables
maint expand-symtabs [REGEX]       # expand symbol tables for matching files
maint set symbol-cache-size N      # size of the symbol lookup cache
maint print symbol-cache / maint print symbol-cache-statistics / maint flush symbol-cache  # show / stats / clear the symbol cache
demangle [-l LANG] [--] NAME       # demangle a C++ (or other) mangled name
set demangle-style gnu-v3          # use the GNU v3 C++ demangling style

## 19. Altering Execution

; You can change the program while it runs: change variables (`set var`), jump to another line
; (`jump`), return from a function with a given value (`return`), call functions (`call`), or even
; change the executable itself (`set write on`). `compile` lets you write C code inside GDB that is
; compiled and injected into the program.

; --- assignment ---
set var x = 10                     # "set var" avoids clash with GDB "set" subcommands
set var arr[2] = 5                 # write an array element
set var ptr->field = 'c'           # write a struct field
set var $rax = 0                   # write a register
p x = 10                           # also assigns
set {int}0x601040 = 4              # write memory
set var buf = "hello"              # only for char arrays of the right size

; --- change control flow ---
jump LOCATION / j                  # continue at LOCATION (does not change stack!)
jump 42 / jump *0x401000           # continue at line 42 / at an address
tbreak 50 ; jump 42                # jump and stop at 50
set var $pc = 0x401000             # move PC without continuing
return [EXPR]                      # pop frame, return EXPR to caller (asks confirm)
finish                             # normal return

; --- signals ---
signal SIG / signal 0 / queue-signal SIG  # deliver / drop / queue a signal

; --- calling functions ---
call FUNC(ARGS)                    # call; void result not printed
print FUNC(ARGS)                   # call; prints result
call (void)free(ptr)               # call free(), cast to void so nothing is printed
p strlen("abc")                    # works if libc has symbols
p ((int(*)(const char*))puts)("hi")  # cast when no debug info
set unwindonsignal on|off          # unwind stack if called function crashes
set unwind-on-timeout on|off       # unwind the stack if a called function times out
set direct-call-timeout N / set indirect-call-timeout N  # seconds (threads)
set unwind-on-terminating-exception on|off  # C++ exception in called fn
set may-call-functions on|off      # off = forbid all inferior calls
show may-call-functions            # show whether inferior calls are allowed

; --- patching the executable / core ---
set write on                       # open exec and core for writing (then "file" again)
set write off                      # open exec and core read-only (default)
show write                         # show the write setting
file prog                          # reload after set write on

; --- compile & inject code (needs GCC + libcc1) ---
compile code CODE                  # compile and run C code in the inferior
compile code printf("x=%d\n", x);  # inject and run a printf in the program
compile code                       # multi-line, end with "end"
compile file FILE                  # compile a file
compile file -raw FILE             # compile a file as raw code (no wrapper function)
compile print EXPR                 # evaluate using the compiler
compile print/x EXPR               # evaluate with the compiler, print in hex
compile print --                   # ends options, as in other commands
set compile-args ARGS              # extra compiler flags (default: -O0 -gdwarf-4 -fPIE ...)
show compile-args                  # show extra compiler flags
set compile-gcc PATH               # which gcc to use
show compile-gcc                   # show which gcc is used

## 20. GDB Files, Separate Debug Info, debuginfod

## 20.1 Commands to Specify Files

; `file` sets the executable + symbols. `symbol-file` symbols only, `exec-file` executable only. `add-symbol-file`
; adds symbols at a given address (kernel modules, JIT). `info sharedlibrary` shows the
; loaded .so files. `set sysroot` is very important in remote/cross debugging so GDB finds the
; target's libs.

file [FILE]                       # executable + symbols; no arg = discard both
file -readnow FILE / file -readnever FILE  # read all symbols now / never read debug info
exec-file [FILE]                  # executable only
symbol-file [FILE] [-o OFFSET]    # symbols only
symbol-file -readnow FILE         # read all symbols now
core-file [FILE] / core FILE      # load a core file (no arg = discard)
add-symbol-file FILE [-readnow|-readnever] [-o OFF] [TEXTADDR] [-s SECTION ADDR]...  # add symbols from FILE at an address
add-symbol-file mod.ko 0xffffffffc0000000 -s .data 0xffff...  # add a kernel module's symbols at its load address
remove-symbol-file FILE / remove-symbol-file -a ADDR  # remove symbols added by add-symbol-file
add-symbol-file-from-memory ADDR  # load symbols from an ELF image in target memory (e.g. vDSO)
section SECTION ADDR              # relocate one section
info files / info target          # all files & sections in use
info sharedlibrary [REGEX] / info share / info dll  # loaded shared libs
sharedlibrary [REGEX] / share     # load symbols of shared libs now
nosharedlibrary                   # unload all shared-lib symbols
set auto-solib-add on|off         # auto load shared lib symbols
set stop-on-solib-events 0|1      # stop when a lib is loaded/unloaded
set sysroot PATH / set solib-absolute-prefix PATH  # where target libs are
set sysroot target:               # read libs from the remote target
set sysroot remote:               # older spelling of target:
set solib-search-path PATH:PATH   # extra directories for shared libraries
show sysroot / show solib-search-path  # show where target libs are looked up
set trust-readonly-sections on    # read read-only sections from exec file, not target
set exec-file-mismatch ask|warn|off  # when attach exec != file
load [FILE] [OFFSET]              # download program to target (remote/sim)

## 20.2 File Caching, Separate Debug Info

; Debug info can be in a separate file (`.debug`) using a `debug link` or `build-id`. GDB looks for it
; in `/usr/lib/debug` and the paths in `debug-file-directory`. `objcopy` splits them.

set debug-file-directory DIRS  # where to look for separate debug files
show debug-file-directory      # show where separate debug files are searched
set debug-file-directory /usr/lib/debug:/home/me/dbg  # search several directories for debug files
set build-id-verbose 0|1|2     # how much to print about build-id lookups
info sharedlibrary             # "(*)" = no debug info
maint set bfd-sharing on|off   # file caching
maint flush bfd-cache / maint info bfd  # clear / list cached BFD files

; create a separate debug file
objcopy --only-keep-debug prog prog.debug  # copy only the debug info to prog.debug
objcopy --strip-debug prog     # remove debug info from prog
objcopy --add-gnu-debuglink=prog.debug prog  # add a debug link from prog to prog.debug
; build-id style: /usr/lib/debug/.build-id/xx/yyyy....debug
readelf -n prog | grep Build   # show build-id
; MiniDebugInfo: .gnu_debugdata section (xz-compressed symtab, Fedora style)

## 20.3 Index Files (faster symbol loading)

save gdb-index [-dwarf-5] DIR    # write .gdb_index / .debug_names into DIR/FILE
set index-cache enabled on|off   # cache indexes automatically
set index-cache directory DIR    # where the index cache lives
show index-cache stats           # show index cache hits and misses
maint set dwarf-max-cache-age N  # how long to keep DWARF data cached

gdb -batch -ex "save gdb-index ." prog  # write the index file for prog into the current directory
objcopy --add-section .gdb_index=prog.gdb-index --set-section-flags .gdb_index=readonly prog  # put the index file into the binary
ld --gdb-index                   # gold linker can build it at link time

## 20.4 Errors Reading Symbols & GDB Data Files

set complaints N        # how many symbol-reading complaints to show (0 default)
show complaints         # show the complaints limit
set data-directory DIR  # where GDB's own data (python, syscalls XML) lives
show data-directory     # show GDB's data directory

## 20.5 debuginfod

; `debuginfod` is a service that downloads debug info and source files from a server automatically
; (Fedora, Debian, Ubuntu have servers). `DEBUGINFOD_URLS` must be set.

export DEBUGINFOD_URLS="https://debuginfod.ubuntu.com"  # or fedoraproject / debian

set debuginfod enabled on|off|ask  # use debuginfod or not (ask = prompt)
set debuginfod urls URLS           # debuginfod server URLs
set debuginfod verbose 0|1         # print debuginfod download progress
show debuginfod enabled / show debuginfod urls  # show debuginfod settings

## 21. Targets & Remote Debugging (gdbserver)

## 21.1 Targets

; The target = the thing GDB works with: native process, remote (gdbserver / JTAG stub), core file,
; simulator, record. `info files` shows the active targets.

target TYPE PARAMS                  # connect to a target
target native                       # local process
target core FILE                    # use a core file as target
target exec FILE                    # use an executable file as target
target remote HOST:PORT             # gdbserver / stub over TCP
target remote /dev/ttyS0            # serial
target remote | CMD                 # over a pipe
target extended-remote HOST:PORT    # extended: run/attach/restart on remote
target sim [ARGS]                   # built-in simulator
target tfile FILE / target ctf DIR  # trace files
help target                         # list available targets
info files                          # show active targets
detach / disconnect / kill          # end the session with the target
load [FILE] [OFFSET]                # download to target memory
flash-erase                         # erase flash memory (remote)
set endian big|little|auto          # byte order
show endian                         # show the byte order
set architecture ARCH / set arch    # e.g. i386:x86-64, arm, riscv:rv64
show architecture                   # show the target architecture
set osabi OSABI                     # e.g. GNU/Linux, none
show osabi                          # show the OS ABI
set gnutarget FORMAT                # BFD target format (e.g. elf32-littlearm)
set hash on|off                     # print "#" while loading (remote)
set debug remote 1                  # print remote protocol packets

## 21.2 Connecting to a Remote Target

target remote 192.168.1.10:2345     # connect to gdbserver by IP and port
target remote localhost:2345        # connect to gdbserver on this machine
target remote :2345                 # connect to gdbserver on this machine, short form
target remote tcp:HOST:PORT / udp:HOST:PORT  # connect over TCP / UDP explicitly
target remote unix:/path/socket     # Unix domain socket
target remote /dev/ttyUSB0          # serial (see set serial baud)
target extended-remote HOST:PORT    # extended: run/attach/restart on remote
set remote exec-file /path/on/target  # program to run (extended-remote)
run                                 # only in extended-remote mode
attach PID                          # remote attach (extended-remote)
monitor CMD                         # send command to gdbserver/stub
monitor help                        # list gdbserver monitor commands
monitor exit                        # stop gdbserver
monitor set debug 1                 # turn on gdbserver debug output
disconnect                          # leave gdbserver running
detach                              # detach and let program continue
set serial baud RATE / set remotebaud  # serial line speed
set serial parity none|odd|even     # serial parity
set remotetimeout SECONDS           # remote reply timeout
set remotelogfile FILE / set remotelogbase hex|octal|ascii  # log remote packets to FILE / in this base
set remote interrupt-sequence Ctrl-C|BREAK|BREAK-g  # what to send to interrupt the remote target
set remote interrupt-on-connect on|off  # interrupt the target when connecting
set remoteflow on|off               # use hardware flow control on the serial line
set remote hardware-breakpoint-limit N / hardware-watchpoint-limit N  # max hardware breakpoints / watchpoints on the target
set remote hardware-watchpoint-length-limit N  # max length of a hardware watchpoint
set remote exec-file FILE           # program to run (extended-remote)
set remote PACKET-NAME-packet on|off|auto  # e.g. set remote Z-packet off
show remote                         # all remote settings
set tcp connect-timeout SECONDS|unlimited  # how long to retry TCP connect
set tcp auto-retry on|off           # retry TCP connect if refused
set remote multiprocess-feature-packet on  # enable multiprocess support packet
set sysroot target:                 # read files from target
remote get TARGETFILE HOSTFILE      # file transfer
remote put HOSTFILE TARGETFILE      # copy a file to the target
remote delete TARGETFILE            # delete a file on the target
set remote system-call-allowed 0|1  # File-I/O extension: allow system()
show remote system-call-allowed     # show if system() is allowed

## 21.3 gdbserver

; `gdbserver` is a small program that you put on the target machine; it talks to GDB on the host.
; Useful for embedded Linux and containers. `--multi` mode keeps it running so you can run/attach many
; times.

; --- on the target ---
gdbserver :2345 ./prog args         # listen on TCP port 2345
gdbserver host:2345 ./prog          # host part is ignored
gdbserver /dev/ttyS0 ./prog         # serial
gdbserver --attach :2345 PID        # attach to running process
gdbserver --multi :2345             # extended mode, wait for GDB commands
gdbserver --once :2345 ./prog       # exit after GDB disconnects
gdbserver --debug / --remote-debug / --event-loop-debug  # gdbserver debug output
gdbserver --debug-file=FILE         # write gdbserver debug output to FILE
gdbserver --wrapper env FOO=bar -- :2345 ./prog  # start the program through a wrapper
gdbserver --disable-randomization / --no-disable-randomization  # turn ASLR off / keep ASLR on
gdbserver --startup-with-shell / --no-startup-with-shell  # start the program via the shell or directly
gdbserver --disable-packet=vCont,threads,Tthread,qC  # disable some protocol packets (testing)
gdbserver --version / --help        # print version / help

; --- on the host ---
gdb ./prog                          # same binary (with symbols)
target remote TARGET:2345           # connect from the host to gdbserver on the target
set sysroot /path/to/target/rootfs  # so libs match
b main                              # set a breakpoint at main
c                                   # gdbserver already started the program

; gdbserver monitor commands
monitor help                        # list gdbserver monitor commands
monitor set debug 0|1               # gdbserver debug output on / off
monitor set debug-format all|none|timestamp  # gdbserver debug output format
monitor set remote-debug 0|1        # gdbserver remote protocol debug on / off
monitor set event-loop-debug 0|1    # gdbserver event loop debug on / off
monitor set debug-file FILE         # write gdbserver debug output to FILE
monitor set libthread-db-search-path PATH  # where gdbserver looks for libthread_db
monitor exit                        # stop gdbserver

## 21.4 Remote Stub (bare metal)

; If you debug a board with no OS, you link a stub (like `i386-stub.c`) with the program and it talks
; to GDB with the Remote Serial Protocol. You must write `getDebugChar`, `putDebugChar`,
; `exceptionHandler`, `flush_i_cache` and call `set_debug_traps()` then `breakpoint()`.

set_debug_traps();  # in your program: install handlers (C, remote stub)
breakpoint();       # in your program: stop so GDB can connect (C, remote stub)

## 22. Configuration-Specific & Architecture Notes

; Commands for specific systems or processors. Most important for Linux: `info proc`. For Windows:
; `info dll`, `info w32`. ARM/AArch64/x86/RISC-V have their own settings.

; --- Linux / native process info ---
info proc [PID|FILE]               # process summary
info proc mappings                 # memory map
info proc stat / status / cmdline / cwd / exe / files / all  # one kind of /proc info
set procfs-trace on|off / set procfs-file FILE / proc-trace-entry ...  # Solaris procfs
info pidlist / info meminfo        # QNX Neutrino

; --- BSD ---
kvm pcb / kvm proc                 # libkvm (crash dumps)

; --- MS Windows ---
info w32 / info w32 thread-information-block  # Windows: show the Thread Information Block
set cygwin-exceptions on|off       # Windows: break on exceptions in the Cygwin DLL
set new-console on|off             # program in its own console
set new-group on|off               # Windows: program in its own process group
set shell on|off                   # Windows: start the program via the shell
set debugevents / debugexec / debugexceptions / debugmemory on|off  # Windows: debug messages for these events
info dll                           # = info sharedlibrary
set stop-on-solib-events 1         # stop when a DLL is loaded / unloaded

; --- DJGPP (DOS) ---
info dos / info dos sysinfo / gdt / ldt / idt / pde / pte / address ADDR  # DJGPP: DOS system info and descriptor tables
set com1base / com1irq ...         # DJGPP: serial port base address / IRQ

; --- Hurd ---
set signals / set sigs on|off      # Hurd: intercept signals sent to the task
set signal-thread THREAD / set sigthread  # Hurd: thread that runs signal handlers
set stopped on|off                 # Hurd: tell GDB the task is already stopped
set exceptions on|off              # Hurd: intercept exceptions
set task pause on|off / set task detach-suspend-count N / set task exception-port PORT  # Hurd: task settings
set thread pause / thread run / thread detach-suspend-count / thread exception-port ...  # Hurd: thread settings
set noninvasive on|off             # Hurd: observe without stopping the task

; --- Darwin (macOS) ---
set debug darwin N / set debug mach-o N  # Darwin: debug messages
set mach-exceptions on|off         # Darwin: catch Mach exceptions

; --- FreeBSD ---
set debug fbsd-lwp / set debug fbsd-nat  # FreeBSD: debug messages

; --- Embedded OS / processors ---
set debug arc / set debug rl78 / ...  # embedded processors: debug messages
; ARM
set arm disassembler STYLE / show arm disassembler  # ARM: disassembler register style
set arm apcs32 on|off              # ARM: 32-bit APCS mode
set arm fpu fpa|softfpa|fpa|vfp / show arm fpu  # ARM: floating point unit type
set arm abi auto|APCS|AAPCS        # ARM: calling convention
set arm fallback-mode arm|thumb|auto  # ARM: mode when no symbols say arm or thumb
set arm force-mode arm|thumb|auto  # ARM: force arm or thumb mode
set arm unwind-secure-frames on|off  # ARM: unwind from non-secure to secure frames
set debug arm 0|1                  # ARM: debug messages
target rdi / rdp                   # old Angel stubs (removed in modern GDB)
; AArch64
info registers sve / za / zt       # AArch64: SVE / SME / SME2 registers
set debug aarch64 0|1              # AArch64: debug messages
; SVE: $vg, $z0-$z31, $p0-$p15, $ffr ; SME: $svg, $svcr, $za ; SME2: $zt0
; MTE: memory-tag commands (section 12.5)
; PAC: bt shows [PAC] marker; GCS: $gcs_features_enabled etc.
; BPF
; M68k, MicroBlaze, MIPS Embedded
set mipsfpu double|single|none|auto / show mipsfpu  # MIPS: floating point unit type
set mips abi auto|o32|o64|n32|n64|eabi32|eabi64 / show mips abi  # MIPS: ABI
set mips compression mips16|micromips  # MIPS: compressed ISA
set mips mask-address on|off|auto  # MIPS: mask the top 32 bits of addresses
set remote-mips64-transfers-32bit-regs on|off  # MIPS: remote sends 32-bit registers
set debug mips 0|1                 # MIPS: debug messages
pmon CMD                           # MIPS PMON monitor
; OpenRISC 1000
; PowerPC Embedded
set powerpc vector-abi auto|generic|altivec|spe  # PowerPC: vector ABI
set powerpc soft-float on|off      # PowerPC: soft-float ABI
set powerpc exact-watchpoints on|off  # PowerPC: exact hardware watchpoints
info spu ...                       # removed
; AVR
; CRIS
set cris-version N / set cris-mode guru|normal / set cris-dwarf2-cfi on|off  # CRIS: settings
; Super-H
; x86
info registers eflags / st0-st7 / mxcsr  # x86: flags / x87 / SSE status registers
set debug x86-nat / x86-linux      # x86: debug messages
; CET (shadow stack): $pl3_ssp ; info registers pl3_ssp
; Alpha, HPPA
set debug hppa 1                   # HPPA: debug messages
maint print unwind ADDR            # HPPA unwind
; PowerPC
set debug ppc-linux / set debug xcoffread  # PowerPC: debug messages
; Sparc64 ADI
adi examine ADDR [/ N] / adi assign ADDR [/ N] VALUE  # Sparc64: read / write ADI version tags
; S12Z
; AMD GPU (ROCm)
info agents / info queues / info dispatches  # AMD GPU entities (ROCgdb)
set debug amd-dbgapi-lib log-level LEVEL  # AMD GPU: library log level
set debug amd-dbgapi on|off        # AMD GPU: debug messages
$_wave_id, $_dispatch_pos, $_dispatch_id, $_queue_id, $_agent_id  # AMD GPU vars
; RISC-V
set riscv use-compressed-breakpoints auto|on|off  # RISC-V: use 2-byte breakpoints
set debug riscv breakpoints|infcall|unwinder|gdbarch 0|1  # RISC-V: debug messages
set riscv numeric-register-names on|off  # RISC-V: show x0..x31 instead of ABI names

## 23. Controlling GDB — Settings

; Everything that controls the *look* and *behavior* of GDB itself: the prompt, history, screen size,
; colors (styling), numbers (radix), ABI, auto-load, warnings, debug output.

## 23.1 Prompt, Editing, History, Screen

set prompt (gdb-app)               # change the prompt (trailing space matters)
set prompt \033[1;31m(gdb)\033[0m  # colored prompt
show prompt                        # show the prompt
set editing on|off                 # readline line editing
show editing                       # show whether line editing is on
set history filename FILE          # default ~/.gdb_history or $GDBHISTFILE
set history save on|off            # save history on exit
set history size N|unlimited       # $GDBHISTSIZE
set history remove-duplicates N|unlimited  # drop duplicates among the last N history entries
set history expansion on|off       # "!" history expansion
show history                       # all history settings
show commands                      # last 10 commands
show commands N / show commands +  # 10 commands around N / next 10

set height N|unlimited|0           # lines per page (0 = no paging)
set width N|unlimited|0            # columns
set pagination on|off              # "--Type <RET>--"
show height / show width           # show screen size

## 23.2 Output Styling (colors)

set style enabled on|off            # colors on/off
set style sources on|off            # colorize source (uses GNU Source Highlight / pygments)
set style disassembler enabled on|off  # libopcodes colors
set style tui-current-position on|off  # style the current position in TUI
set style filename foreground COLOR # COLOR: none black red green yellow blue magenta cyan white, or 0-255, or #RRGGBB
set style filename background COLOR # file name background color
set style filename intensity normal|bold|dim  # file name intensity
set style function foreground green # function names in green
set style variable foreground cyan  # variable names in cyan
set style address foreground blue   # addresses in blue
set style title ...                 # style of titles
set style highlight ...             # matches in apropos etc.
set style metadata ...              # <optimized out> etc.
set style version ...               # style of the version number
set style tui-border foreground / tui-active-border / tui-border-style ...  # style of TUI borders
set style disassembler mnemonic|register|immediate|address|symbol|comment ...  # style of disassembly parts
set style line-number ...           # style of line numbers
set style command ...               # style of command names
set style warning-prefix TEXT / set style error-prefix TEXT  # text before warnings / errors
show style                          # all styles

## 23.3 Numbers, ABI

set radix 16                       # input AND output radix (8, 10, 16)
set input-radix 16                 # 0x not needed; careful: "10" means 16!
set output-radix 16                # print numbers in hex
show radix / show input-radix / show output-radix  # show radix settings

set osabi OSABI / show osabi       # set / show the OS ABI
set cp-abi auto|gnu-v3             # choose the C++ ABI
set coerce-float-to-double on|off  # float args to functions without prototype
set unwindonsignal ...             # unwind stack if called function crashes

## 23.4 Auto-loading

; GDB automatically loads files like `.gdbinit` in the current dir, `libthread_db`, and Python scripts
; (`prog-gdb.py`). For safety it only loads from `safe-path`. If you see the warning "File ... auto-loading
; has been declined", add the path with `add-auto-load-safe-path`.

set auto-load off                   # disable all auto-loading
set auto-load local-gdbinit on|off  # auto-load ./.gdbinit
set auto-load libthread-db on|off   # auto-load libthread_db
set auto-load gdb-scripts on|off    # OBJFILE-gdb.gdb
set auto-load python-scripts on|off # OBJFILE-gdb.py
set auto-load guile-scripts on|off  # OBJFILE-gdb.scm
set auto-load scripts-directory DIRS  # $debugdir:$datadir/auto-load
set auto-load safe-path DIRS        # trusted directories; "/" = everything
add-auto-load-safe-path DIR         # trust this directory for auto-loading
add-auto-load-scripts-directory DIR # add a directory to search for auto-load scripts
show auto-load                      # all
info auto-load                      # what was loaded / declined
info auto-load local-gdbinit / libthread-db / gdb-scripts / python-scripts / guile-scripts  # what was loaded, one kind
set debug auto-load on              # show files tried

## 23.5 Warnings, Messages, Confirmations, Debug Output

set confirm on|off                  # ask before dangerous commands
set verbose on|off                  # messages while loading symbols
set complaints N                    # how many symbol-reading complaints to show
set trace-commands on|off           # echo each command as executed (+ nesting)
set exec-done-display on|off        # "completed." after async commands
set print inferior-events on|off    # print messages when inferiors start / exit
set print thread-events on|off      # print "[New Thread...]" messages
set print symbol-loading full|brief|off  # messages when loading symbols
set suppress-cli-notifications on|off  # for front ends
set startup-quietly on              # no banner (early-init file only)
set debuginfod ...                  # debuginfod settings

set debug ...                       # internal debug output (many: infrun, remote, lin-lwp, ...)
set debug infrun 1                  # very useful for stepping/threads problems
set debug remote 1                  # print remote protocol packets
set debug lin-lwp 1                 # debug Linux threads (LWPs)
set debug frame 1                   # debug frame unwinding
set debug dwarf-read N / set debug dwarf-die N / dwarf-line N  # debug DWARF reading
set debug expression 1              # debug expression parsing
set debug symtab-create N / symbol-lookup N  # debug symbol tables / lookup
set debug target N                  # debug target calls
set debug threads 1                 # debug threads
set debug event-loop off|all|all-except-ui  # debug the event loop
set debug py-unwind / py-breakpoint / py-micmd 1  # debug Python unwinders / breakpoints / MI commands
set debug separate-debug-file 1     # debug the search for separate debug files
set debug notification / observer / overload / parser / serial / stack-cache ...  # more internal debug output
show debug                          # all debug settings
set debug timestamp on|off          # timestamps on debug output
set displaced-stepping on|off|auto  # step over breakpoints out of line
set schedule-multiple ...           # resume all inferiors or only the current one
set interactive-mode on|off|auto    # treat stdin as a terminal or not
set trace-commands on               # echo each command as executed
set unwind-on-signal ...            # unwind stack if called function crashes
set may-call-functions ...          # allow calling program functions
set stack-cache / set code-cache ...  # cache stack / code memory
set backtrace ...                   # backtrace limits (past-main, past-entry, limit)
set exec-wrapper ...                # launch through a wrapper program
set filename-display ...            # how file names are shown
set extended-prompt TEXT            # (Python) prompt with \f, \p{setting}, \w, ... substitutions
show extended-prompt                # show the extended prompt

## 24. Extending GDB — Scripts, Python, Guile

## 24.1 User-defined Commands (CLI scripting)

; You can define your own commands with `define` (they take `$arg0..$arg9`, `$argc`). There is
; `if/while/loop_break/loop_continue`. `hook-CMD` runs before a given command, `hookpost-CMD` after
; it. `source` runs a command file. `echo`, `printf`, `output` for printing.

define NAME                       # define a command (end with "end")
    if $argc == 0
      printf "usage: NAME ARG\n"
    else
      print $arg0 * 2
    end
  end
define-prefix NAME                # make NAME a prefix so you can "define NAME sub"
document NAME                     # add help text (end with "end")
    Doubles the argument.
  end
help NAME / help user-defined     # list user commands
show user [NAME]                  # show definition
dont-repeat                       # inside define: do not repeat on RET

; control flow (inside define / command files)
if EXPR ... else ... end          # run commands only if EXPR is true  @condition
while EXPR ... end                # repeat commands while EXPR is true  @loop
loop_break / loop_continue        # leave / restart the innermost while loop
$argc / $arg0 ... $arg9           # arguments (text substitution)
$_gdb_setting("...")              # read settings

; hooks
define hook-echo                  # runs BEFORE "echo"
    echo <<<---
  end
define hookpost-echo              # runs AFTER
    echo --->>>
  end
define hook-stop                  # runs every time the program stops (very useful)
    x/i $pc
  end
; hook-run, hook-continue etc. also possible

; command files
source FILE                       # run commands from file
source -v FILE                    # echo each command
source -s FILE                    # search in source path
gdb -x FILE                       # from shell
; lines starting with # are comments; errors abort the file

; output
echo TEXT\n                       # print text (\n for newline, \  for leading space)
output EXPR / output/FMT EXPR     # print value only
printf "FORMAT", ARGS...          # C-style printf; supports %s %d %x %f %c %p %%
printf "%s at %p\n", name, &name  # print a string and an address
printf "%5.2f\n", 3.14159         # print a float with width 5 and 2 decimals
printf "%ls\n", widestr           # wide strings
printf "%lld %llu\n", ...         # 64-bit
eval "FORMAT", ARGS...            # build a command from a format and run it
eval "p $%d", 5                   # -> p $5

## 24.2 Command Aliases

alias NEW = OLD                 # e.g. alias bt5 = backtrace 5
alias -a NEW = OLD              # abbreviation (not shown in help)
alias pp = print -pretty --     # alias with default args
alias spe = set print elements  # alias for a multi-word command
alias -a set print elms = set print elements  # multi-word alias
help aliases                    # list all aliases

## 24.3 Python — Commands

; GDB comes with Python built in (if it was built with it). You can write Python inline with `python`
; or in a file with `source file.py`. The `gdb` module gives you access to everything: values, types,
; frames, breakpoints, events, pretty printers, new commands, TUI windows.

python CODE              # one line (py is alias)
python                   # multi-line block: type Python lines, finish with "end"
    import gdb
    print(gdb.parse_and_eval("x"))
    end
python-interactive / pi  # interactive Python REPL
pi EXPR                  # evaluate one expression
source script.py         # run a Python file (by .py extension)
set script-extension off|soft|strict  # how to decide language by extension
set python print-stack none|message|full  # how much of a Python error to print  @traceback
set python ignore-environment on|off  # ignore PYTHON* environment variables
set python dont-write-bytecode auto|on|off  # do not write .pyc files
show python ...          # show Python settings

## 24.4 Python — API Quick Reference

import gdb                          # load the GDB Python module (already loaded inside GDB)

; --- basic ---
gdb.execute("bt", to_string=True)   # run a CLI command, get output
gdb.parse_and_eval("x + 1")         # -> gdb.Value
gdb.parameter("print elements")     # read a setting
gdb.set_parameter("print elements", 10)  # change a setting
gdb.set_convenience_variable("foo", 5) / gdb.convenience_variable("foo")  # write / read $foo
gdb.history(0)                      # value history $
gdb.add_history(value)              # add a value to the value history
gdb.history_count()                 # number of values in the history
gdb.write("text\n"), gdb.flush()    # print to the GDB console, flush output
gdb.lookup_type("struct foo")  / gdb.lookup_type("int").pointer()  # find a type / make a pointer type
gdb.lookup_symbol("main")      / gdb.lookup_global_symbol("g") / gdb.lookup_static_symbol  # find a symbol
gdb.lookup_objfile("libc.so.6")     # find a loaded object file by name
gdb.current_progspace(), gdb.progspaces(), gdb.objfiles()  # program spaces and object files
gdb.selected_inferior(), gdb.inferiors()  # current inferior / all inferiors
gdb.selected_thread(), gdb.selected_frame(), gdb.newest_frame()  # current thread / frame, frame #0
gdb.breakpoints()                   # all breakpoints
gdb.decode_line("file.c:42")        # turn a location into symtab and line
gdb.find_pc_line(pc)                # -> Symtab_and_line
gdb.block_for_pc(pc)                # code block that contains pc
gdb.current_language(), gdb.architecture_names()  # current language / all architecture names
gdb.solib_name(addr)                # shared library that contains addr
gdb.string_to_argv("a 'b c'")       # split a command argument string like the shell
gdb.post_event(callable)            # run in GDB's main thread (thread-safe)
gdb.prompt_hook = lambda cur: "> "  # change the prompt from Python
gdb.STDOUT, gdb.STDERR, gdb.STDLOG  # stream ids for gdb.write
gdb.PYTHONDIR, gdb.VERSION, gdb.HOST_CONFIG, gdb.TARGET_CONFIG  # GDB build info
gdb.interrupt()                     # like Ctrl-C
gdb.notify_mi("name", data)         # custom MI async notification
gdb.format_address(addr), gdb.current_recording()  # address as <symbol+off> / current record
gdb.rl_hooks / gdb.execute_mi("-data-evaluate-expression", "x")  # readline hooks / run an MI command

; --- exceptions ---
try: ...                            # catch GDB errors in Python
except gdb.error: ...               # generic GDB error
except gdb.MemoryError: ...         # memory could not be read  @exception
except gdb.GdbError: ...            # raise this in commands: no traceback shown
except KeyboardInterrupt: ...       # Ctrl-C was pressed

; --- Value ---
v = gdb.parse_and_eval("ptr")       # get a gdb.Value
v.type, v.address, v.is_optimized_out, v.is_lazy, v.dynamic_type  # Value attributes
v.dereference(), v.referenced_value(), v.reference_value(), v.const_value()  # follow / make references
v.cast(t), v.dynamic_cast(t), v.reinterpret_cast(t)  # cast a Value
v["field"], v[0], int(v), float(v), str(v), bool(v)  # access fields / elements, convert
v.string(encoding="utf-8", length=10)  # read a C string as Python str
    v.lazy_string(), v.format_string(format='x', pretty_structs=True)
v.fetch_lazy(), v.to_array(), v.assign(newval), v.bytes  # load now / as array / write / raw bytes
gdb.Value(5), gdb.Value(b"\x00\x01", gdb.lookup_type("short"))  # make a Value from Python data
gdb.Value.__init__(obj)             # Python int/float/str/bool -> Value

; --- Type ---
t = gdb.lookup_type("struct foo")   # get a gdb.Type
t.name, t.tag, t.code, t.sizeof, t.alignof, t.dynamic, t.objfile  # Type attributes
    t.is_scalar, t.is_signed, t.is_array_like, t.is_string_like
t.fields()  -> field.name, .type, .bitpos, .bitsize, .enumval, .artificial, .is_base_class, .parent_type  # struct fields
t.keys(), t.values(), t.items(), t["field"], "field" in t, len(t)  # Type as a dict of fields
t.strip_typedefs(), t.target(), t.pointer(), t.reference(), t.rvalue_reference()  # related types
t.array(n), t.array(lo, hi), t.vector(n), t.const(), t.volatile(), t.unqualified()  # make derived types
t.range(), t.template_argument(n)   # array range / C++ template argument
gdb.TYPE_CODE_PTR, TYPE_CODE_ARRAY, TYPE_CODE_STRUCT, TYPE_CODE_UNION, TYPE_CODE_ENUM,  # values of t.code
    TYPE_CODE_FLAGS, TYPE_CODE_FUNC, TYPE_CODE_INT, TYPE_CODE_FLT, TYPE_CODE_VOID, TYPE_CODE_RANGE,
    TYPE_CODE_STRING, TYPE_CODE_BITSTRING, TYPE_CODE_ERROR, TYPE_CODE_METHOD, TYPE_CODE_METHODPTR,
    TYPE_CODE_MEMBERPTR, TYPE_CODE_REF, TYPE_CODE_RVALUE_REF, TYPE_CODE_CHAR, TYPE_CODE_BOOL,
    TYPE_CODE_COMPLEX, TYPE_CODE_TYPEDEF, TYPE_CODE_NAMESPACE, TYPE_CODE_DECFLOAT, TYPE_CODE_INTERNAL_FUNCTION,
    TYPE_CODE_XMETHOD, TYPE_CODE_FIXED_POINT, TYPE_CODE_NAMELIST
gdb.types.get_basic_type(t), gdb.types.has_field(t, "x"), gdb.types.make_enum_dict(t), gdb.types.deep_items(t)  # gdb.types helpers
gdb.types.get_type_recognizers(), gdb.types.apply_type_recognizers(), gdb.types.register_type_printer()  # type printer helpers

; --- Pretty printer ---
class FooPrinter:                   # write a pretty printer class
    def __init__(self, val): self.val = val
    def to_string(self): return "foo(%d)" % int(self.val["x"])
    def children(self): yield "x", self.val["x"]     # optional
    def display_hint(self): return "string" | "array" | "map" | None
    def num_children(self): ...       # optional, for MI
    def child(self, n): ...           # optional
import gdb.printing                 # module to build and register pretty printers
pp = gdb.printing.RegexpCollectionPrettyPrinter("mylib")  # a collection of printers matched by type regex
pp.add_printer("foo", "^foo$", FooPrinter)  # map type regex ^foo$ to FooPrinter
gdb.printing.register_pretty_printer(gdb.current_objfile(), pp)  # or None for global
gdb.pretty_printers.append(lookup_function)  # or simple: add a lookup function to the global list
gdb.default_visualizer(value)       # the pretty printer GDB would use for value

; --- Type printer ---
class MyTypePrinter: name, enabled, instantiate() -> recognizer.recognize(type) -> str|None  # type printer shape
gdb.type_printers.append(...)  / gdb.types.register_type_printer(objfile, printer)  # register a type printer

; --- Frame filters / decorators ---
class MyFilter:  name, priority, enabled, filter(frame_iter) -> iterator of FrameDecorator  # frame filter shape
from gdb.FrameDecorator import FrameDecorator  # function(), address(), filename(), line(), frame_args(), frame_locals(), elided(), inferior_frame()
from gdb.FrameIterator import FrameIterator  # iterator over frames for frame filters
gdb.frame_filters["name"] = MyFilter()  # or progspace.frame_filters / objfile.frame_filters

; --- Unwinders ---
from gdb.unwinder import Unwinder, register_unwinder  # base class and register function for unwinders
class MyUnwinder(Unwinder):         # write a frame unwinder
    def __call__(self, pending_frame):           # pending_frame.read_register(), .create_unwind_info(frame_id), .architecture(), .level(), .pc(), .language(), .find_sal(), .block(), .function()
        ...
        unwind_info.add_saved_register("rip", val)
register_unwinder(locus, unwinder, replace=False)  # locus: None / objfile / progspace
gdb.FrameId(sp, pc)                 # frame id for create_unwind_info

; --- Xmethods (replace C++ methods with Python) ---
from gdb.xmethod import XMethod, XMethodMatcher, XMethodWorker, register_xmethod_matcher  # xmethod classes
; matcher.match(class_type, method_name) -> workers; worker.get_arg_types(), get_result_type(), __call__()

; --- Inferior / Thread ---
inf = gdb.selected_inferior()       # get the current gdb.Inferior
inf.num, inf.pid, inf.was_attached, inf.progspace, inf.connection, inf.connection_num, inf.main_name  # Inferior attributes
inf.threads(), inf.architecture(), inf.is_valid()  # threads / arch / still alive?
inf.read_memory(addr, len) -> memoryview ; inf.write_memory(addr, buf) ; inf.search_memory(addr, len, pattern)  # memory
inf.thread_from_handle(h), inf.arguments, inf.clear_env(), inf.set_env(k,v), inf.unset_env(k), inf.environment  # args / env
th = gdb.selected_thread()          # get the current gdb.InferiorThread
th.name, th.num, th.global_num, th.ptid, th.inferior, th.details, th.is_valid()  # Thread attributes
th.switch(), th.is_stopped(), th.is_running(), th.is_exited(), th.handle()  # select thread / state
gdb.InferiorThread.ptid_string      # thread ptid as a string
gdb.start_recording(method, format), gdb.current_recording(), gdb.stop_recording()  # Recordings
    rec.method, rec.format, rec.begin, rec.end, rec.replay_position, rec.instruction_history, rec.function_call_history, rec.goto(insn)

; --- Events ---
gdb.events.stop.connect(handler)    # handler(event): event.inferior_thread; BreakpointEvent.breakpoints / SignalEvent.stop_signal
gdb.events.cont / exited (event.exit_code, .inferior) / new_objfile (event.new_objfile) / free_objfile / clear_objfiles  # more events
gdb.events.new_inferior / inferior_deleted / new_thread / thread_exited / inferior_call (pre/post) / memory_changed / register_changed  # more events
gdb.events.breakpoint_created / breakpoint_modified / breakpoint_deleted / before_prompt / gdb_exiting  # more events
    connection_removed / executable_changed / new_progspace / free_progspace / tui_enabled
gdb.events.stop.disconnect(handler) # stop listening to an event

; --- Commands ---
class Hello(gdb.Command):           # write a new CLI command in Python
    """Say hello.  Usage: hello NAME"""      # docstring = help text
    def __init__(self):
        super().__init__("hello", gdb.COMMAND_USER)   # COMMAND_NONE/RUNNING/DATA/STACK/FILES/SUPPORT/STATUS/BREAKPOINTS/TRACEPOINTS/OBSCURE/MAINTENANCE/TUI/USER
    def invoke(self, arg, from_tty):
        argv = gdb.string_to_argv(arg)
        gdb.write("hello %s\n" % argv[0])
    def complete(self, text, word): return gdb.COMPLETE_SYMBOL   # or COMPLETE_NONE/FILENAME/LOCATION/COMMAND/EXPRESSION or a list
    def dont_repeat(self): ...
  Hello()
gdb.Command.__init__(self, "myprefix", gdb.COMMAND_USER, prefix=True)  # prefix command

; --- MI commands in Python ---
class MyMI(gdb.MICommand):          # write a new MI command in Python
    def __init__(self): super().__init__("-my-command")
    def invoke(self, argv): return {"result": "ok"}   # dict/list/str -> MI output
  MyMI()

; --- Parameters (set/show) ---
class MyParam(gdb.Parameter):       # write a new set/show setting in Python
    """Doc"""
    set_doc = "Set the thing"; show_doc = "Show the thing"
    def __init__(self): super().__init__("my-thing", gdb.COMMAND_DATA, gdb.PARAM_BOOLEAN)   # PARAM_INTEGER/UINTEGER/ZINTEGER/ZUINTEGER/ZUINTEGER_UNLIMITED/STRING/STRING_NOESCAPE/OPTIONAL_FILENAME/FILENAME/ENUM/AUTO_BOOLEAN/COLOR
    def get_set_string(self): return ""
    def get_show_string(self, svalue): return "value is " + svalue
  MyParam()   # then: set my-thing on / show my-thing / gdb.parameter("my-thing")

; --- Convenience functions ---
class Greet(gdb.Function):          # write a new $function in Python
    def __init__(self): super().__init__("greet")
    def invoke(self, name): return "Hi " + name.string()
  Greet()   # then: p $greet("bob")

; --- Progspace / Objfile ---
ps = gdb.current_progspace()        # get the current gdb.Progspace; its attributes and methods:
    ps.filename, ps.executable_filename, ps.symbol_file, ps.objfiles(), ps.solib_name(addr), ps.block_for_pc(pc),
    ps.find_pc_line(pc), ps.is_valid(), ps.objfile_for_address(addr), ps.pretty_printers, ps.type_printers,
    ps.frame_filters, ps.frame_unwinders, ps.missing_debug_handlers
o = gdb.lookup_objfile("prog")      # get a gdb.Objfile; its attributes and methods:
    o.filename, o.username, o.owner, o.build_id, o.progspace, o.is_file, o.is_valid(), o.add_separate_debug_file(f),
    o.lookup_global_symbol(n), o.lookup_static_symbol(n), o.pretty_printers, o.type_printers, o.frame_filters,
    o.frame_unwinders, o.xmethods
gdb.current_objfile()               # only during auto-load

; --- Frames ---
f = gdb.selected_frame()            # get the current gdb.Frame
f.name(), f.pc(), f.is_valid(), f.type(), f.unwind_stop_reason(), f.architecture(), f.language(), f.level()  # Frame info
f.block(), f.function(), f.older(), f.newer(), f.find_sal(), f.read_register("rip"), f.read_var("x"), f.select(), f.static_link()  # more Frame methods
gdb.frame_stop_reason_string(reason)  # unwind stop reason as text
gdb.NORMAL_FRAME, DUMMY_FRAME, INLINE_FRAME, TAILCALL_FRAME, SIGTRAMP_FRAME, ARCH_FRAME, SENTINEL_FRAME  # values of f.type()
gdb.FRAME_UNWIND_NO_REASON, NULL_ID, OUTERMOST, UNAVAILABLE, INNER_ID, SAME_ID, NO_SAVED_PC, MEMORY_ERROR  # values of f.unwind_stop_reason()
gdb.invalidate_cached_frames()      # drop GDB's frame cache

; --- Blocks / Symbols / Symtabs ---
b = gdb.block_for_pc(pc)            # get a gdb.Block; attributes, and "for sym in b: ..." walks its symbols
    b.start, b.end, b.function, b.superblock, b.global_block, b.static_block, b.is_global, b.is_static, b.is_valid(); for sym in b: ...
s = gdb.lookup_symbol("x")[0]       # get a gdb.Symbol; its attributes and methods:
    s.name, s.linkage_name, s.print_name, s.type, s.symtab, s.line, s.addr_class, s.needs_frame, s.is_argument,
    s.is_constant, s.is_function, s.is_variable, s.is_artificial, s.value(frame), s.is_valid()
gdb.SYMBOL_LOC_UNDEF/CONST/STATIC/REGISTER/ARG/REF_ARG/LOCAL/TYPEDEF/LABEL/BLOCK/CONST_BYTES/UNRESOLVED/OPTIMIZED_OUT/COMPUTED/REGPARM_ADDR/COMMON_BLOCK  # values of s.addr_class
gdb.SYMBOL_VAR_DOMAIN, STRUCT_DOMAIN, LABEL_DOMAIN, MODULE_DOMAIN, COMMON_BLOCK_DOMAIN, ...  # symbol domains for lookups
gdb.lookup_static_symbols("x")      # all static symbols named x
sal = gdb.find_pc_line(pc); sal.pc, sal.last, sal.line, sal.symtab, sal.is_valid()  # Symtab_and_line
st = sal.symtab; st.filename, st.objfile, st.producer, st.fullname(), st.global_block(), st.static_block(), st.linetable()  # Symtab
lt = st.linetable(); lt.line(n), lt.has_line(n), lt.source_lines(); for e in lt: e.line, e.pc  # LineTable

; --- Breakpoints ---
bp = gdb.Breakpoint("main")         # gdb.Breakpoint(spec, type=BP_BREAKPOINT, wp_class=WP_WRITE, internal=False, temporary=False, qualified=False)
gdb.Breakpoint(source="f.c", line=10, function=None, label=None)  # explicit location breakpoint
gdb.Breakpoint("x", gdb.BP_WATCHPOINT, gdb.WP_READ)  # BP_BREAKPOINT/HARDWARE_BREAKPOINT/WATCHPOINT/HARDWARE_WATCHPOINT/READ_WATCHPOINT/ACCESS_WATCHPOINT/CATCHPOINT; WP_READ/WRITE/ACCESS
bp.enabled, bp.silent, bp.pending, bp.thread, bp.inferior, bp.task, bp.ignore_count, bp.number, bp.type  # Breakpoint attributes
    bp.visible, bp.temporary, bp.hit_count, bp.location, bp.locations, bp.expression, bp.condition, bp.commands
bp.is_valid(), bp.delete()          # still exists? / delete it
class MyBP(gdb.Breakpoint):         # breakpoint that decides in Python whether to stop
    def stop(self): return int(gdb.parse_and_eval("x")) > 5   # True = stop, False = continue
bp.locations                        # -> gdb.BreakpointLocation: address, enabled, fullname, function, source, thread_groups, owner
class MyFinish(gdb.FinishBreakpoint):  # gdb.FinishBreakpoint(frame, internal=False); .return_value; stop(), out_of_scope()
    ...

; --- Lazy strings / Colors / Styles ---
ls = v.lazy_string(); ls.address, ls.length, ls.encoding, ls.type, ls.value()  # LazyString
gdb.Color("red"), gdb.Color(5), gdb.Color((255,0,0))  # make colors; attributes of a color c:
    c.is_none, c.is_direct, c.is_indexed, c.colorspace, c.index, c.components, c.escape_sequence(is_foreground)
gdb.Style(...)                      # style objects for styled output (newer API)

; --- Architecture / Registers / Disassembly ---
arch = gdb.selected_frame().architecture() ; arch.name(), arch.disassemble(start, end=None, count=None) -> [{addr, asm, length}]  # Architecture
arch.registers(reggroup=None) -> RegisterDescriptor(name) ; arch.register_groups() -> RegisterGroup(name)  # registers / groups
arch.integer_type(size, signed=True), arch.void_type()  # make basic types for this arch
from gdb.disassembler import Disassembler, DisassembleInfo, DisassemblerResult, register_disassembler  # write a disassembler in Python
    builtin_disassemble, DisassemblerTextPart, DisassemblerAddressPart, syntax_highlight

; --- Connections ---
c = inf.connection ; c.num, c.type, c.description, c.details, c.is_valid() ; gdb.RemoteTargetConnection.send_packet(b"...")  # Connection
gdb.connections()                   # all target connections

; --- TUI windows ---
class MyWin:                        # constructed with (tui_window): .width .height .title .is_valid() .erase() .write(str, full_window=False) .click?
    def __init__(self, tw): self.tw = tw; tw.title = "My"
    def render(self): self.tw.write("hello")
    def hscroll(self, n): ... ; def vscroll(self, n): ... ; def click(self, x, y, button): ... ; def close(self): ...
gdb.register_window_type("mywin", MyWin)  # register a TUI window type
    # then: tui new-layout my mywin 1 cmd 1 ; layout my

; --- Missing debug info / objfiles handlers ---
from gdb.missing_debug import MissingDebugHandler ; gdb.missing_debug.register_handler(locus, handler)  # handler(objfile) -> None|False|True|str
from gdb.missing_objfile import MissingObjfileHandler ; gdb.missing_objfile.register_handler(...)  # handler for missing objfiles
info missing-debug-handlers / enable|disable missing-debug-handler LOCUS NAME ; info missing-objfile-handlers ...  # CLI for these handlers

; --- Core files ---
gdb.selected_inferior().corefile ; inf.corefile.filename, .mapped_files(), .build_id() ...  # newer API
substitute_prompt("\\f \\p{prompt} \\w \\v \\e[1m")  ; gdb.prompt.prompt_help()  # --- gdb.prompt ---
gdb.ptwrite.register_filter_factory(f), gdb.ptwrite.get_filter()  # --- gdb.ptwrite ---

## 24.5 Python Auto-loading

; When GDB loads `prog` or `libfoo.so`, it automatically looks for `prog-gdb.py` in the same place or
; in `auto-load scripts-directory`, or for a `.debug_gdb_scripts` section inside the file.

/path/libfoo.so-gdb.py            # Looked-up names for OBJFILE = /path/libfoo.so (also -gdb.gdb, -gdb.scm)
$datadir/auto-load/path/libfoo.so-gdb.py  # Looked-up name for OBJFILE = /path/libfoo.so, in the data dir
$debugdir/path/libfoo.so-gdb.py   # Looked-up name for OBJFILE = /path/libfoo.so, in the debug dir
SECTION_SCRIPT_ID_PYTHON_FILE (1) "file.py"  # .debug_gdb_scripts section entries: a Python file name
SECTION_SCRIPT_ID_PYTHON_TEXT (4) "name\n<script text>"  # .debug_gdb_scripts section entries: inline Python text
info auto-load python-scripts [REGEX]  # list Python scripts auto-loaded (or declined)
set auto-load python-scripts off  # stop auto-loading OBJFILE-gdb.py scripts

## 24.6 Guile

; The same idea as Python but in Scheme (Guile). The API is like Python: values, types, frames,
; breakpoints, pretty printers, commands, parameters. Python is loaded first if both exist.

guile CODE / gu CODE           # one line
guile                          # multi-line Guile block, finish with "end"
    (use-modules (gdb))
    (display (value->integer (parse-and-eval "x")))
    end
guile-repl / gr                # interactive REPL
source script.scm              # run a Guile file (by .scm extension)
set guile print-stack none|message|full  # how much of a Guile error to print
info auto-load guile-scripts   # list Guile scripts auto-loaded (or declined)

(use-modules (gdb) (gdb printing) (gdb types))  # Guile: load the GDB modules
(execute "bt" #:to-string #t)  # Guile: run a CLI command, get output
(parse-and-eval "x")  (value->integer v) (value->string v) (value-type v)  # Guile: values
    (value-field v "f") (value-dereference v) (value-cast v t)
(lookup-type "int") (type-sizeof t) (type-fields t) (type-pointer t) (type-strip-typedefs t)  # Guile: types
(selected-frame) (frame-name f) (frame-pc f) (frame-read-var f "x") (frame-older f) (frame-newer f)  # Guile: frames
(make-breakpoint "main" #:type BP_BREAKPOINT) (register-breakpoint! bp)  # Guile: breakpoints
    (breakpoint-enabled? bp) (set-breakpoint-stop! bp proc)
(make-command "hello" #:command-class COMMAND_USER #:invoke (lambda (self arg from-tty) ...))  # Guile: new command
    (register-command! cmd)
(make-parameter "my-p" #:command-class COMMAND_DATA #:parameter-type PARAM_BOOLEAN ...)  # Guile: new setting
    (register-parameter! p)
(make-pretty-printer "foo" (lambda (val) ...)) (append-pretty-printer! #f pp)  # Guile: pretty printer
(current-progspace) (objfiles) (objfile-filename o) (current-objfile)  # Guile: progspace / objfiles
(lookup-symbol "x") (symbol-name s) (symbol-type s) (block-for-pc pc)  # Guile: symbols / blocks
(arch-name (current-arch)) (arch-disassemble arch pc #:count 5)  # Guile: architecture / disassemble
(open-memory #:start addr #:size n)  # Guile: memory ports
(make-iterator ...) (iterator-map ...) (iterator-filter ...)  # Guile: iterators
(make-color "red") (color-escape-sequence c #t)  # Guile: colors
(throw-user-error "msg") (catch 'gdb:error ...)  # Guile: raise / catch GDB errors

## 24.7 Auto-loading Extensions Summary

OBJFILE-gdb.gdb     # -> CLI script     (set auto-load gdb-scripts)
OBJFILE-gdb.py      # -> Python         (set auto-load python-scripts)
OBJFILE-gdb.scm     # -> Guile          (set auto-load guile-scripts)
.debug_gdb_scripts  # section: 1=python file, 3=guile file, 4=python text, 6=guile text
Multiple languages  # Python is tried first for printers/filters/etc.

## 25. Interpreters, TUI, Emacs

## 25.1 Command Interpreters

interpreter-exec mi "-data-list-register-names"  # run one MI command from CLI
interpreter-exec console "bt"  # run CLI command from MI
gdb -i=mi / gdb --interpreter=mi3 / mi2 / mi1 / console / dap  # choose the interpreter at startup
; "-interpreter-exec console ..." from MI side
new-ui INTERP TTY              # new-ui mi /dev/pts/5 : extra UI on another terminal

## 25.2 TUI (Text User Interface)

; TUI splits the terminal into windows: source, assembly, registers, command. `Ctrl-x a` opens/closes
; it. `layout` changes the arrangement. `focus` chooses which window gets the arrow keys. `tui new-layout`
; makes your own layout. `Ctrl-x s` = SingleKey mode (one letter per command).

tui enable / tui disable            # turn TUI on/off
Ctrl-x a                            # toggle TUI (also Ctrl-x A)
Ctrl-x 1                            # one window layout
Ctrl-x 2                            # two windows (cycle: src/asm/regs)
Ctrl-x o                            # change focus to next window
Ctrl-x s                            # toggle SingleKey mode
Ctrl-L                              # refresh screen
PgUp / PgDn / Up / Down / Left / Right  # scroll focused window
Ctrl-p / Ctrl-n / Ctrl-b / Ctrl-f   # command history / cursor (when cmd has focus)

layout src                          # source + command
layout asm                          # assembly + command
layout split                        # source + assembly + command
layout regs                         # registers + (source or asm) + command ⭐
layout next / layout prev           # cycle to the next / previous layout
layout NAME                         # user layout
tui new-layout NAME WINDOW WEIGHT [WINDOW WEIGHT]...  # e.g. tui new-layout mine src 2 regs 1 status 0 cmd 1
tui new-layout h {-horizontal src 1 asm 1} 2 status 0 cmd 1  # layout with source and asm side by side
tui layout NAME                     # same as layout
info win                            # list windows
focus src|asm|regs|cmd|status|next|prev / fs  # choose which window gets the arrow keys
tui focus NAME                      # same as focus
refresh                             # redraw the TUI screen
update                              # update source window to current line
winheight NAME +N / -N / N          # wh src +5
tui window height NAME N            # set the height of a window
winwidth NAME +N / tui window width NAME N  # change / set the width of a window
tui reg GROUP                       # registers window group: general, float, vector, system, all, next, prev
tui reg general                     # show general registers in the registers window
tabset N                            # tab width
set tui border-kind space|ascii|acs # characters used for window borders
set tui border-mode / active-border-mode normal|standout|reverse|half|half-standout|bold|bold-standout  # border look
set tui tab-width N                 # tab width in the source window
set tui compact-source on|off       # smaller margin in the source window
set tui mouse-events on|off         # let the mouse scroll / click TUI windows
set tui left-margin-verbose on|off  # show more info in the left margin
set style tui-current-position on   # style the current position in TUI
show tui ...                        # show TUI settings

; SingleKey mode keys (Ctrl-x s):
; c continue, d down, f finish, n next, o nexti, r run, s step, i stepi, u up, v info locals, w where, q exit SingleKey

## 25.3 Emacs

M-x gdb      # start GDB inside Emacs (gdb-mi mode)
M-x gud-gdb  # older text mode
C-c C-s      # Emacs: step
C-c C-n      # Emacs: next
C-c C-i      # Emacs: stepi
C-c C-r      # Emacs: continue
C-c C-f      # Emacs: finish
C-c <        # Emacs: up
C-c >        # Emacs: down
C-c C-l      # Emacs: refresh source
C-x SPC      # Emacs: set breakpoint at point (in a source buffer)
C-c C-d      # Emacs: delete breakpoint
C-c C-t      # Emacs: temp breakpoint

## 26. GDB/MI, DAP, Annotations, JIT, In-Process Agent

## 26.1 GDB/MI (Machine Interface)

; MI is the protocol that IDEs (VS Code, Eclipse, CLion) use to talk to GDB. Every command starts with
; `-` and can have a number token in front. The output is `^done`, `^error`, `*stopped`, `=breakpoint-created`,
; `~"console text"`... etc.

[TOKEN]-command [args]    # MI Input, e.g.  123-break-insert main
TOKEN^done[,results]      # MI Output: result records
    ^running   ^connected   ^error,msg="..."   ^exit
*running,thread-id="all"  # MI Output: async exec records
    *stopped,reason="breakpoint-hit",...
=thread-created           # MI Output: async notify records
    =thread-created  =thread-exited  =library-loaded  =breakpoint-created/modified/deleted
    =thread-group-added/started/exited  =record-started  =cmd-param-changed  =memory-changed
~"console stream"         # MI Output: stream records
    ~"console stream"   @"target stream"   &"log stream"
(gdb)                     # MI Output: <- prompt terminates each output block
*stopped,reason=          # MI Stop reasons:
    breakpoint-hit, watchpoint-trigger, read-watchpoint-trigger, access-watchpoint-trigger,
    function-finished, location-reached, watchpoint-scope, end-stepping-range, exited-signalled,
    exited, exited-normally, signal-received, solib-event, fork, vfork, syscall-entry, syscall-return, exec, no-history

; Breakpoints
-break-insert             # MI: insert a breakpoint
    -break-insert [-t] [-h] [-f] [-d] [-a] [-c COND] [-i COUNT] [-p THREAD] [--qualified] [--source F --line N --function F --label L] [LOCATION]
-break-after N COUNT  -break-condition [--force] N EXPR  -break-commands N "cmd"...  # MI: ignore count / condition / commands
-break-delete N  -break-disable N  -break-enable N  -break-info N  -break-list  # MI: delete / disable / enable / show / list
-break-passcount TP COUNT  -break-watch [-a|-r] EXPR  # MI: tracepoint pass count / watchpoint
-dprintf-insert [opts] LOCATION FORMAT ARGS  # MI: insert a dprintf
-catch-load [-t] [-d] REGEX  -catch-unload  -catch-assert  -catch-exception  -catch-handlers  # MI: catchpoints
    -catch-throw  -catch-catch  -catch-rethrow
; Program context
-exec-arguments ARGS  -environment-cd DIR  -environment-directory  -environment-path  -environment-pwd  # MI: args / cwd / paths
-inferior-tty-set TTY  -inferior-tty-show  # MI: program terminal
; Threads / inferiors
-thread-info [ID]  -thread-list-ids  -thread-select ID  # MI: threads
-list-thread-groups [--available] [--recurse 1] [GROUP]  # MI: list inferiors (thread groups)
-add-inferior [--no-connection]  -remove-inferior ID  # MI: add / remove inferior
; Ada tasks
-ada-task-info [ID]       # MI: Ada tasks
; Execution
-exec-run [--all|--thread-group N] [--start]  -exec-continue [--reverse] [--all|--thread-group N]  # MI: run / continue
-exec-next [--reverse]  -exec-next-instruction  -exec-step  -exec-step-instruction  -exec-finish [--reverse]  # MI: stepping
-exec-until [LOC]  -exec-jump LOC  -exec-return  -exec-interrupt [--all|--thread-group N]  -exec-abort  # MI: until / jump / return / interrupt
; Stack
-stack-info-frame  -stack-info-depth [MAX]  -stack-list-frames [--no-frame-filters] [LOW HIGH]  # MI: frames
-stack-list-arguments [--no-frame-filters] [--skip-unavailable] PRINT-VALUES [LOW HIGH]  # MI: frame arguments
-stack-list-locals [--no-frame-filters] [--skip-unavailable] PRINT-VALUES  # MI: local variables
-stack-list-variables ...  -stack-select-frame N  # MI: args + locals / select frame
-enable-frame-filters     # MI: use Python frame filters
; Variable objects
-var-create NAME|"-" FRAME|"*"|"@" EXPR  -var-delete [-c] NAME  -var-set-format NAME FMT  -var-show-format NAME  # MI: varobj create / delete / format
-var-info-num-children  -var-list-children [PRINT-VALUES] NAME [FROM TO]  -var-info-type  # MI: varobj children / type
    -var-info-expression  -var-info-path-expression
-var-show-attributes  -var-evaluate-expression [-f FMT] NAME  -var-assign NAME EXPR  -var-update [PRINT-VALUES] NAME|*  # MI: varobj value
-var-set-frozen NAME 0|1  -var-set-update-range NAME FROM TO  -var-set-visualizer NAME VIS  # MI: varobj update control
-enable-pretty-printing   # MI: use Python pretty printers
; Data
-data-disassemble         # MI: disassemble
    -data-disassemble [-s START -e END | -a ADDR | -f FILE -l LINE [-n LINES]] [--opcodes bytes|display|none] [--source] -- MODE(0-5)
-data-evaluate-expression EXPR  -data-list-changed-registers  -data-list-register-names [N...]  # MI: evaluate / registers
-data-list-register-values [--skip-unavailable] FMT [N...]  -data-read-memory-bytes [-o OFFSET] ADDR COUNT  # MI: register values / read memory
-data-write-memory-bytes ADDR CONTENTS [COUNT]  -data-read-memory (deprecated)  -data-write-memory (deprecated)  # MI: write memory
; Tracepoints
-trace-find MODE ...  -trace-define-variable NAME [VALUE]  -trace-frame-collected [...]  -trace-list-variables  # MI: tracepoints
-trace-save [-r] [-ctf] FILE  -trace-start  -trace-status  -trace-stop  # MI: trace run control
; Symbols
-symbol-info-functions [--include-nondebug] [--type R] [--name R] [--max-results N]  # MI: find functions
    -symbol-info-module-functions  -symbol-info-module-variables
-symbol-info-modules  -symbol-info-types  -symbol-info-variables  -symbol-list-lines FILE  # MI: modules / types / variables / lines
; Files
-file-exec-and-symbols FILE  -file-exec-file FILE  -file-list-exec-source-file  # MI: files
    -file-list-exec-source-files [--group-by-objfile] [--dirname|--basename] [--] [REGEX]
-file-list-shared-libraries [REGEX]  -file-symbol-file FILE  # MI: shared libs / symbol file
; Target
-target-attach PID|FILE  -target-detach [ID]  -target-disconnect  -target-download  -target-flash-erase  -target-select TYPE PARAMS  # MI: target
-target-file-put HOST TARGET  -target-file-get TARGET HOST  -target-file-delete TARGET  # MI: target file transfer
; Support / misc
-info-gdb-mi-command NAME  -list-features  -list-target-features  -gdb-exit  -gdb-set  -gdb-show  -gdb-version  # MI: support
-list-features  -info-ada-exceptions [REGEX]  -info-os [TYPE]  -inferior-tty-set  -interpreter-exec INTERP CMD  # MI: misc
-complete "text"  -fix-multi-location-breakpoint-output  -fix-breakpoint-script-output  # MI: completion / output fixes

## 26.2 Debugger Adapter Protocol (DAP)

; DAP is a standard protocol (from VS Code). GDB supports it with `gdb -i=dap` (needs Python). The IDE
; sends JSON requests and GDB replies.

gdb -i=dap                   # start GDB as a DAP server (stdin/stdout)
set debug dap-log-file FILE  # log DAP traffic
set debug dap-log-level 1    # how much DAP traffic to log
; launch request extra params: "program", "args", "env", "cwd", "stopAtBeginningOfMainSubprogram", "stopOnEntry"
; attach: "pid" or "target" (remote)

## 26.3 Annotations (legacy)

set annotate LEVEL  # 0 none, 1 Emacs, 2 deprecated, 3 max
; output like: ^Z^Zbreakpoint 1 ... ^Z^Zsource file:line:char:beg:addr
server break main   # "server " prefix on a command = do not affect history / repeat

## 26.4 JIT Compilation Interface

; If you have a JIT (like LLVM) that makes code at runtime, the program registers the object files
; with GDB using `__jit_debug_descriptor` and `__jit_debug_register_code()` so GDB knows the symbols.
; You can write your own reader for custom debug info.

maint info jit           # list JIT-registered objects
jit-reader-load FILE.so  # load a custom JIT debug-info reader
jit-reader-unload        # unload the custom JIT reader
set debug jit 1          # debug the JIT interface
struct jit_descriptor    # program side: what the JIT must define so GDB sees its code
    struct jit_code_entry { next_entry, prev_entry, symfile_addr, symfile_size };
    struct jit_descriptor  { version=1, action_flag (JIT_NOACTION/JIT_REGISTER_FN/JIT_UNREGISTER_FN), relevant_entry, first_entry };
    extern struct jit_descriptor __jit_debug_descriptor;
    void __attribute__((noinline)) __jit_debug_register_code(void) { asm(""); }

## 26.5 In-Process Agent (IPA)

; The IPA library (`libinproctrace.so`) is loaded inside the program to support fast tracepoints and
; static tracepoints with gdbserver.

LD_PRELOAD=libinproctrace.so ./prog  # load the agent
gdbserver :2345 ./prog  # then serve the program as usual
set agent on|off        # use the in-process agent when possible
show agent              # show the agent setting
ftrace LOCATION         # fast tracepoints need IPA

## 27. Command Line Editing & History

; GDB uses Readline (like bash). All the Emacs shortcuts work. You can make `~/.inputrc` and put `$if
; Gdb` in it for GDB-only settings. `set editing off` turns editing off, and there is a vi mode.

; Movement
C-a                             # line start
C-e                             # line end
C-f                             # forward char
C-b                             # back char
M-f                             # forward word
M-b                             # back word
C-l                             # clear screen
; Editing
C-d                             # delete char
DEL                             # backspace
C-k                             # kill to end
C-u                             # kill to start
C-w                             # kill word back
M-d                             # kill word forward
C-y                             # yank (paste)
M-y                             # yank previous kill
C-_                             # undo
C-t                             # transpose chars
M-u / M-l / M-c                 # upper/lower/capitalize word
TAB                             # complete
M-?                             # list completions
M-*                             # insert all completions
C-q / C-v                       # quoted insert
M-r                             # revert line
; History
C-p / Up                        # previous command
C-n / Down                      # next command
C-r                             # reverse search
C-s                             # forward search
M-<  / M->                      # first / last
C-o                             # accept & get next
!!  !N  !-N  !string  !?string  # history expansion (set history expansion on)
!$  !^  !*  !:N                 # word designators
^old^new^                       # quick substitution
:h :t :r :e :p :s/a/b/ :g       # modifiers

~/.inputrc                      # readline config file, e.g.:
    $if Gdb
        set editing-mode vi
        "\C-xb": "break main\n"
    $endif
    set show-all-if-ambiguous on
    set completion-ignore-case on

## 28. Maintenance Commands & Bug Reports

; `maint` commands are for people who develop GDB itself or do deep debugging. Most useful: `maint
; info sections`, `maint info breakpoints`, `maint print registers`, `maint time`, `maint set dwarf
; ...`.

maint info sections [-all-objects] [FILTERS]  # ELF sections & addresses (ALLOC LOAD CODE DATA ...)
maint info target-sections          # sections the target uses
maint info breakpoints              # incl. internal (negative numbers)
maint info bfds                     # list open BFD files
maint info line-table [REGEX]       # dump line tables
maint info symtabs / psymtabs [REGEX]  # list symbol tables
maint info program-spaces           # list program spaces
maint info sol-threads              # Solaris threads
maint info jit                      # list JIT-registered objects
maint info frame-unwinders          # list frame unwinders
maint info selftests / maint selftest [-verbose] [FILTER]  # list / run GDB self tests
maint print registers / raw-registers / cooked-registers / register-groups / remote-registers [FILE]  # dump register info
maint print reggroups               # list register groups
maint print architecture [FILE]     # dump gdbarch values
maint print c-tdesc [FILE] / maint print xml-tdesc [FILE]  # print target description as C / XML
maint print dummy-frames            # list dummy frames (inferior calls)
maint print objfiles [REGEX]        # dump object files
maint print symbols / psymbols / msymbols [-pc ADDR | -objfile OBJ | -source SRC] [--] [OUTFILE]  # dump symbols
maint print statistics              # symbol table statistics
maint print target-stack            # show the target stack
maint print type EXPR               # dump the internal type of EXPR
maint print unwind ADDR             # HPPA unwind
maint print user-registers          # list user-level registers ($pc, $sp, ...)
maint print core-file-backed-mappings  # core file mappings backed by files
maint print remote-registers        # remote register numbers and offsets
maint print frame-id [LEVEL]        # print the frame id
maint print symbol-cache / symbol-cache-statistics  # show symbol cache / stats
maint print xml-tdesc               # print target description as XML
maint expand-symtabs [REGEX]        # expand symbol tables for matching files
maint flush symbol-cache / register-cache / dcache / source-cache / bfd-cache  # clear a cache
maint cplus first_component NAME / maint cplus namespace  # C++ name parsing helpers
maint demangler-warning / maint deprecate COMMAND [REPLACEMENT] / maint undeprecate COMMAND  # demangler warning / (un)deprecate a command
maint dump-me / maint internal-error [MSG] / maint internal-warning / maint demangler-warning  # crash / raise errors for testing
maint packet TEXT                   # send raw packet to remote target
maint set dwarf always-disassemble on|off  # always disassemble DWARF expressions
maint set dwarf max-cache-age N     # how long to keep DWARF data cached
maint set dwarf unwinders on|off    # use DWARF unwinders
maint set catch-demangler-crashes on|off  # catch crashes in the demangler
maint set profile on|off            # GDB profiling
maint set show-debug-regs on|off    # show x86 debug registers
maint set show-all-tib on|off       # show the full Windows TIB
maint set target-async on|off       # async target
maint set target-non-stop on|off|auto  # non-stop target
maint set per-command time|space|symtab on|off  # stats after every command
maint set worker-threads N|unlimited  # threads GDB uses for symbol reading
maint set internal-error quit|corefile ask|yes|no  # what to do on internal error
maint set bfd-sharing on|off        # file caching
maint set check-libthread-db on|off # check libthread_db when loading
maint set ignore-prologue-end-flag on|off  # ignore DWARF prologue_end flag
maint set gnu-source-highlight enabled on|off  # use GNU Source Highlight
maint set backtrace-on-fatal-signal on|off  # print GDB backtrace on crash
maint set test-settings TYPE VALUE  # settings for testing
maint set tui-resize-message on|off # message when TUI resizes
maint set tui-left-margin-verbose ...  # verbose TUI left margin
maint set libopcodes-styling enabled on|off  # libopcodes colors
maint time 0|1                      # (old) time each command
maint space 0|1                     # (old) memory use after each command
maint translate-address [SECTION] ADDR  # find the symbol at a section address
maint agent EXPR / maint agent-eval EXPR / maint agent-printf FMT, ARGS  # show agent bytecode
maint check-psymtabs / maint check-symtabs / maint check xml-descriptions DIR  # check symbol tables / XML
maint btrace packet-history / clear-packet-history / clear  # btrace maintenance
maint with SETTING [VALUE] [-- CMD] # like "with" for maint settings
maint canonicalize NAME             # show C++ canonical name
maint test-options require-delimiter ... / unknown-is-error ... / unknown-is-operand ...  # test option parsing
maint show ...                      # any of the maint settings

; --- reporting bugs (include these) ---
show version                        # GDB version
show configuration                  # how GDB was built
gdb -batch -ex "show version"       # print GDB version from the shell
; report at https://sourceware.org/bugzilla/ (component gdb) or bug-gdb@gnu.org
; include: exact input, exact output, "set verbose on", a minimal reproducer

; --- building GDB ---
./configure --prefix=/opt/gdb --with-python --enable-tui --with-guile --with-debuginfod  # configure a GDB build
    ./configure --prefix=/opt/gdb --with-python --enable-tui --with-guile --with-debuginfod \
                --target=arm-none-eabi          # cross debugger
make -j$(nproc) && make install     # build and install GDB
./configure --with-system-gdbinit=/etc/gdbinit --with-system-gdbinit-dir=/etc/gdbinit.d  # system-wide init file / dir

## 29. Convenience Variables & Functions (Full List)

; These are all the ready `$`-variables GDB gives you. `show convenience` shows them.

$_                          # last address examined by x / info line / info breakpoints
$__                         # contents of $_
$_exitcode                  # exit code of the program
$_exitsignal                # signal that killed the program
$_exception                 # current C++ exception (at catch throw/catch)
$_ada_exception             # Ada exception address
$_probe_argc / $_probe_arg0..$_probe_arg11  # probe arguments
$_siginfo                   # extra signal info (struct)
$_tlb                       # Windows Thread Information Block
$_inferior                  # current inferior number
$_thread                    # current thread number
$_gthread                   # current global thread number
$_inferior_thread_count     # number of live threads in inferior
$_gdb_major / $_gdb_minor   # GDB version numbers
$_shell_exitcode / $_shell_exitsignal  # exit code / signal of last shell command
$_linker_namespace          # (glibc dlmopen) namespace of current location
$_active_linker_namespaces  # (glibc dlmopen) linker namespaces in use
$bpnum                      # number of last breakpoint set
$_hit_bpnum / $_hit_locno   # breakpoint / location just hit
$tpnum                      # number of last tracepoint set
$trace_frame / $tracepoint / $trace_line / $trace_file / $trace_func  # current trace frame info
$_sdata                     # static tracepoint data
$_ret                       # (tracepoints) return value
$numfound                   # matches found by "find"
$pc $sp $fp $ps             # standard registers
$_wave_id $_dispatch_pos $_dispatch_id $_queue_id $_agent_id  # AMD GPU

; Functions (help function):
$_as_string(V) $_caller_is(NAME[,N]) $_caller_matches(REGEX[,N]) $_any_caller_is $_any_caller_matches  # convenience functions: string / caller checks
$_cimag(Z) $_creal(Z) $_gdb_maint_setting(S) $_gdb_maint_setting_str(S) $_gdb_setting(S) $_gdb_setting_str(S)  # convenience functions: complex / settings
$_isvoid(E) $_memeq(A,B,N) $_regex(S,R) $_shell(CMD) $_streq(A,B) $_strlen(S)  # convenience functions: tests / strings / shell

