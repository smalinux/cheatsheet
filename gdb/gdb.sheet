k                    # Abbrev of: kill
rc / rs / rn         # Abbrev of: reverse-continue/step/next
bt / where           # Abbrev of: backtrace
f                    # Abbrev of: frame
p                    # Abbrev of: print
i                    # Abbrev of: info
x                    # Abbrev of: examine memory
i r                  # Abbrev of: info registers
l                    # Abbrev of: list
i b                  # Abbrev of: info breakpoints
wa                   # Abbrev of: watch
