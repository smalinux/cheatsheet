title: gdb os and architecture notes
url:   https://sourceware.org/gdb/current/onlinedocs/gdb.html/Configurations.html
tags:  gdb debugger arch arm aarch64 x86 riscv mips windows linux

## linux native
info proc [PID|FILE]    # show a process summary  @procfs <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Process-Information.html>
info proc mappings      # show the process memory map  @maps
info proc stat          # show /proc/PID/stat, also status cmdline cwd exe files all
info pidlist            # list processes (QNX Neutrino), also info meminfo  @qnx
set procfs-trace on|off # trace procfs calls (Solaris), also set procfs-file FILE

## bsd
kvm pcb              # select a process control block in a kernel crash dump (libkvm)  @crash
kvm proc             # select a process in a kernel crash dump (libkvm)
set debug fbsd-lwp 1 # debug FreeBSD LWP events, also set debug fbsd-nat  @freebsd

## windows
info w32                     # show MS-Windows info, e.g. info w32 thread-information-block  @tib <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Cygwin-Native.html>
info dll                     # list loaded DLLs (= info sharedlibrary)
set cygwin-exceptions on|off # stop on exceptions inside the Cygwin DLL
set new-console on|off       # run the program in its own console
set new-group on|off         # put the program in a new process group
set shell on|off             # start the program through the shell
set debugevents on|off       # print debug events, also debugexec debugexceptions debugmemory

## djgpp dos
info dos sysinfo  # show DOS system info, also gdt ldt idt pde pte address ADDR  @djgpp
set com1base ADDR # set the COM1 base address, also com1irq

## hurd
set signals on|off       # intercept signals sent to the task (Hurd)  @sigs
set signal-thread THREAD # set the thread that gets signals (Hurd)  @sigthread
set stopped on|off       # treat the task as stopped (Hurd)
set exceptions on|off    # use the task's exception port (Hurd)
set task pause on|off    # pause the task while GDB has control, also detach-suspend-count exception-port
set thread pause on|off  # pause the thread while GDB has control (Hurd)
set noninvasive on|off   # do not suspend the task (Hurd)

## darwin
set debug darwin N         # debug Darwin native code, also set debug mach-o N  @macos
set mach-exceptions on|off # catch Mach exceptions (macOS)  @macos

## arm
set arm disassembler STYLE           # choose the ARM register naming in disassembly  @arm <https://sourceware.org/gdb/current/onlinedocs/gdb.html/ARM.html>
set arm apcs32 on|off                # use 32-bit APCS
set arm fpu fpa|softfpa|vfp          # set the ARM floating point type
set arm abi auto|APCS|AAPCS          # set the ARM ABI
set arm fallback-mode arm|thumb|auto # choose ARM or Thumb when no symbols tell
set arm force-mode arm|thumb|auto    # force ARM or Thumb mode
set arm unwind-secure-frames on|off  # unwind through secure frames (Cortex-M)
set debug arm 0|1                    # print ARM debug output

## aarch64
info registers sve    # show SVE registers, also za and zt  @aarch64 @arm64 <https://sourceware.org/gdb/current/onlinedocs/gdb.html/AArch64.html>
set debug aarch64 0|1 # print AArch64 debug output
$vg                   # hold the SVE vector granule, with $z0-$z31 $p0-$p15 $ffr  @sve
$svg                  # hold the SME streaming vector granule, with $svcr $za and SME2 $zt0  @sme
[PAC] in bt           # marks a return address signed with pointer authentication  @pac

## mips
set mipsfpu double|single|none|auto   # set the MIPS FPU type  @mips <https://sourceware.org/gdb/current/onlinedocs/gdb.html/MIPS.html>
set mips abi auto|o32|o64|n32|n64|eabi32|eabi64 # set the MIPS ABI
set mips compression mips16|micromips # set the MIPS compressed ISA
set mips mask-address on|off|auto     # mask the upper 32 bits of addresses
set remote-mips64-transfers-32bit-regs on|off # send 32-bit registers on a MIPS64 remote
set debug mips 0|1                    # print MIPS debug output
pmon CMD                              # send a command to the MIPS PMON monitor

## powerpc
set powerpc vector-abi auto|generic|altivec|spe # set the PowerPC vector ABI  @ppc
set powerpc soft-float on|off        # use the soft-float ABI
set powerpc exact-watchpoints on|off # use exact hardware watchpoints
set debug ppc-linux 1                # print PowerPC Linux debug output, also set debug xcoffread

## other embedded
set cris-version N          # set the CRIS version, also cris-mode guru|normal and cris-dwarf2-cfi
set debug hppa 1            # print HPPA debug output
maint print unwind ADDR     # print the HPPA unwind info at an address
adi examine ADDR [/ N]      # show Sparc64 ADI version tags  @sparc
adi assign ADDR [/ N] VALUE # set Sparc64 ADI version tags  @sparc

## x86
info registers eflags  # show the x86 flags, also st0-st7 mxcsr  @x86 <https://sourceware.org/gdb/current/onlinedocs/gdb.html/x86.html>
info registers pl3_ssp # show the CET shadow stack pointer  @cet @shadow-stack
set debug x86-nat 1    # print x86 native debug output, also x86-linux

## amd gpu
info agents                              # list AMD GPU agents (ROCgdb), also info queues and info dispatches  @rocm @gpu
set debug amd-dbgapi-lib log-level LEVEL # set the AMD dbgapi log level
set debug amd-dbgapi on|off              # print AMD dbgapi debug output

## risc-v
set riscv use-compressed-breakpoints auto|on|off # use 2-byte compressed breakpoints  @riscv
set debug riscv breakpoints 1           # print RISC-V debug output, also infcall unwinder gdbarch
set riscv numeric-register-names on|off # show x0-x31 instead of ABI register names
