title: binary ninja plugins and workflows
url:   https://docs.binary.ninja/dev/plugins.html
tags:  binaryninja binja bn plugin command menu workflow activity background flowgraph python api

; bv = BinaryView. Names in UPPERCASE are placeholders.

## plugin layout
user_plugin_path()  # get the folder to drop a plugin folder into  @install @path  <https://api.binary.ninja/index.html#binaryninja.user_plugin_path>
PLUGIN/__init__.py  # the file Binary Ninja imports when it loads a plugin folder  @layout  <https://docs.binary.ninja/dev/plugins.html>
PLUGIN/plugin.json  # the manifest for the plugin manager (name, version, api, platforms)  @manifest @metadata  <https://docs.binary.ninja/dev/plugins.html>

## menu commands
PluginCommand.register(NAME, DESC, FN)    # add a menu command that gets FN(bv)  @menu @action @command-palette  <https://api.binary.ninja/binaryninja.plugin-module.html#binaryninja.plugin.PluginCommand.register>
    def run(bv): log_info(f"{len(bv.functions)} functions")
    PluginCommand.register("My Tools\\Count functions", "Print the function count", run)
PluginCommand.register(NAME, DESC, FN, IS_VALID)  # add a command that is only enabled when IS_VALID(bv) is True  @menu @enable  <https://api.binary.ninja/binaryninja.plugin-module.html#binaryninja.plugin.PluginCommand.register>
PluginCommand.register_for_address(NAME, DESC, FN)  # add a command that gets FN(bv, addr)  @menu @cursor  <https://api.binary.ninja/binaryninja.plugin-module.html#binaryninja.plugin.PluginCommand.register_for_address>
PluginCommand.register_for_range(NAME, DESC, FN)  # add a command that gets FN(bv, start, length)  @menu @selection  <https://api.binary.ninja/binaryninja.plugin-module.html#binaryninja.plugin.PluginCommand.register_for_range>
PluginCommand.register_for_function(NAME, DESC, FN)  # add a command that gets FN(bv, func)  @menu  <https://api.binary.ninja/binaryninja.plugin-module.html#binaryninja.plugin.PluginCommand.register_for_function>
PluginCommand.register_for_high_level_il_instruction(NAME, DESC, FN)  # add a command that gets FN(bv, hlil_instr)  @menu @hlil  <https://api.binary.ninja/binaryninja.plugin-module.html#binaryninja.plugin.PluginCommand.register_for_high_level_il_instruction>
PluginCommand.register_for_medium_level_il_function(NAME, DESC, FN)  # add a command that gets FN(bv, mlil_func)  @menu @mlil  <https://api.binary.ninja/binaryninja.plugin-module.html#binaryninja.plugin.PluginCommand.register_for_medium_level_il_function>
PluginCommand.register_for_project(NAME, DESC, FN)  # add a command that runs on a whole project  @menu  <https://api.binary.ninja/binaryninja.plugin-module.html#binaryninja.plugin.PluginCommand.register_for_project>
PluginCommand.register_global(NAME, DESC, FN)  # add a command that needs no open file  @menu @global  <https://api.binary.ninja/binaryninja.plugin-module.html#binaryninja.plugin.PluginCommand.register_global>

## background work
class Task(BackgroundTaskThread):  # run long work off the UI thread with a progress line  @thread @async @progress  <https://api.binary.ninja/binaryninja.plugin-module.html#binaryninja.plugin.BackgroundTaskThread>
    class Task(BackgroundTaskThread):
        def __init__(self, bv): super().__init__("Working...", can_cancel=True); self.bv = bv
        def run(self):
            for f in self.bv.functions:
                if self.cancelled: break
                self.progress = f"Working on {f.name}"
    Task(bv).start()
task.progress = "text"             # update the status bar text of a task  @status  <https://api.binary.ninja/binaryninja.plugin-module.html#binaryninja.plugin.BackgroundTask.progress>
task.cancelled                     # check if the user canceled the task  @stop  <https://api.binary.ninja/binaryninja.plugin-module.html#binaryninja.plugin.BackgroundTask.cancelled>
task.finish()                      # mark a task done  <https://api.binary.ninja/binaryninja.plugin-module.html#binaryninja.plugin.BackgroundTask.finish>

## workflows
Workflow("core.function.metaAnalysis").clone(NAME)  # copy the function analysis pipeline to change it  @pipeline @analysis  <https://api.binary.ninja/binaryninja.workflow-module.html#binaryninja.workflow.Workflow.clone>
Workflow("core.module.metaAnalysis").clone(NAME)  # copy the whole-binary analysis pipeline  @pipeline @module  <https://api.binary.ninja/binaryninja.workflow-module.html#binaryninja.workflow.Workflow.clone>
wf.register_activity(Activity(CONFIG_JSON, action=FN))  # add a step; FN(context) runs during analysis  @step @pass  <https://api.binary.ninja/binaryninja.workflow-module.html#binaryninja.workflow.Workflow.register_activity>
    def act(ctx): ctx.function.add_tag("Bugs", "seen")
    wf = Workflow("core.function.metaAnalysis").clone("my.wf")
    wf.register_activity(Activity(json.dumps({"name": "my.wf.tag", "title": "Tag", "description": "x",
        "eligibility": {"auto": {"default": True}}}), action=act))
    wf.insert("core.function.generateHighLevelIL", ["my.wf.tag"]); wf.register()
wf.insert(EXISTING, [NEW])                # place a step before an existing step  @order  <https://api.binary.ninja/binaryninja.workflow-module.html#binaryninja.workflow.Workflow.insert>
wf.insert_after(EXISTING, [NEW])          # place a step after an existing step  @order  <https://api.binary.ninja/binaryninja.workflow-module.html#binaryninja.workflow.Workflow.insert_after>
wf.remove(ACTIVITY)                       # drop a step from the pipeline  @disable  <https://api.binary.ninja/binaryninja.workflow-module.html#binaryninja.workflow.Workflow.remove>
wf.register()                             # make the workflow selectable  <https://api.binary.ninja/binaryninja.workflow-module.html#binaryninja.workflow.Workflow.register>
wf.show_topology()                        # draw the pipeline as a graph  @debug @visualize  <https://api.binary.ninja/binaryninja.workflow-module.html#binaryninja.workflow.Workflow.show_topology>
list(Workflow)                            # list registered workflows  <https://api.binary.ninja/binaryninja.workflow-module.html#binaryninja.workflow.Workflow>
bv.workflow, f.workflow                   # get the workflow a view or function uses  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.workflow>
load(PATH, options={"analysis.workflows.functionWorkflow": NAME})  # open a file with a custom function workflow  @select  <https://api.binary.ninja/index.html#binaryninja.load>
ctx.function, ctx.view                    # get the function and view inside an activity  <https://api.binary.ninja/binaryninja.workflow-module.html#binaryninja.workflow.AnalysisContext.function>
ctx.mlil, ctx.llil, ctx.hlil              # get the IL being built inside an activity  @rewrite  <https://api.binary.ninja/binaryninja.workflow-module.html#binaryninja.workflow.AnalysisContext.mlil>
ctx.set_mlil_function(NEW_MLIL)           # replace the MLIL from an activity  @rewrite @deobfuscate  <https://api.binary.ninja/binaryninja.workflow-module.html#binaryninja.workflow.AnalysisContext.set_mlil_function>

## flow graphs
g = FlowGraph()                           # start a custom graph  @graph @cfg @visualize  <https://api.binary.ninja/binaryninja.flowgraph-module.html#binaryninja.flowgraph.FlowGraph>
n = FlowGraphNode(g); n.lines = ["text"]  # make a graph node with text lines  @graph  <https://api.binary.ninja/binaryninja.flowgraph-module.html#binaryninja.flowgraph.FlowGraphNode.lines>
g.append(n)                               # add a node to a graph  <https://api.binary.ninja/binaryninja.flowgraph-module.html#binaryninja.flowgraph.FlowGraph.append>
a.add_outgoing_edge(BranchType.UnconditionalBranch, b)  # connect two nodes  @edge @arrow  <https://api.binary.ninja/binaryninja.flowgraph-module.html#binaryninja.flowgraph.FlowGraphNode.add_outgoing_edge>
n.highlight = HighlightStandardColor.BlueHighlightColor  # color a graph node  @color  <https://api.binary.ninja/binaryninja.flowgraph-module.html#binaryninja.flowgraph.FlowGraphNode.highlight>
g.show("Title")                           # open the graph in a new tab  @display  <https://api.binary.ninja/binaryninja.flowgraph-module.html#binaryninja.flowgraph.FlowGraph.show>
f.create_graph()                          # get the function's own graph  @cfg  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.create_graph>

## other extension points
Transform                                 # subclass to add an encoder or decoder  @plugin @codec  <https://api.binary.ninja/binaryninja.transform-module.html#binaryninja.transform.Transform>
DataRenderer                              # subclass to change how data of a type is shown in linear view  @plugin @render  <https://api.binary.ninja/binaryninja.datarender-module.html#binaryninja.datarender.DataRenderer>
class MyView(BinaryView): ...; MyView.register()  # add a new file format loader  @plugin @loader @format  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.register>
FunctionRecognizer                        # subclass to name or type functions as they are found  @plugin @signature  <https://api.binary.ninja/binaryninja.functionrecognizer-module.html#binaryninja.functionrecognizer.FunctionRecognizer>
ScriptingProvider                         # subclass to add a scripting language console  @plugin @repl  <https://api.binary.ninja/binaryninja.scriptingprovider-module.html#binaryninja.scriptingprovider.ScriptingProvider>
