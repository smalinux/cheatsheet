## rich text formatting (QTextEdit)
te.setFontWeight(QFont.Weight.Bold) / te.setFontItalic(True) / te.setFontUnderline(True)  # format the selection or what is typed next  @bold @italic  <https://doc.qt.io/qtforpython-6/PySide6/QtWidgets/QTextEdit.html#PySide6.QtWidgets.QTextEdit.setFontWeight>
te.setTextColor(QColor("red")) / te.setTextBackgroundColor(C)  # color the selection  @color  <https://doc.qt.io/qtforpython-6/PySide6/QtWidgets/QTextEdit.html#PySide6.QtWidgets.QTextEdit.setTextColor>
te.setFontFamily("Serif") / te.setFontPointSize(14) / te.setCurrentFont(F)  # change font for the selection  @font  <https://doc.qt.io/qtforpython-6/PySide6/QtWidgets/QTextEdit.html#PySide6.QtWidgets.QTextEdit.setFontPointSize>
te.setAlignment(Qt.AlignmentFlag.AlignCenter)  # align the current paragraph  @align  <https://doc.qt.io/qtforpython-6/PySide6/QtWidgets/QTextEdit.html#PySide6.QtWidgets.QTextEdit.setAlignment>
te.currentCharFormatChanged.connect(FN)  # update Bold/Italic buttons when the cursor moves  @toolbar  <https://doc.qt.io/qtforpython-6/PySide6/QtWidgets/QTextEdit.html#PySide6.QtWidgets.QTextEdit.currentCharFormatChanged>
te.mergeCurrentCharFormat(FMT)      # add format properties to the selection  @format  <https://doc.qt.io/qtforpython-6/PySide6/QtWidgets/QTextEdit.html#PySide6.QtWidgets.QTextEdit.mergeCurrentCharFormat>
fmt = QTextCharFormat(); fmt.setFontWeight(QFont.Weight.Bold); fmt.setForeground(QColor("blue"))  # build a character format  @format  <https://doc.qt.io/qtforpython-6/PySide6/QtGui/QTextCharFormat.html>
fmt.setUnderlineStyle(QTextCharFormat.UnderlineStyle.WaveUnderline); fmt.setUnderlineColor(QColor("red"))  # spell-check squiggle  @squiggle @error  <https://doc.qt.io/qtforpython-6/PySide6/QtGui/QTextCharFormat.html#PySide6.QtGui.QTextCharFormat.setUnderlineStyle>
fmt.setAnchor(True); fmt.setAnchorHref(URL)  # make text a link  @link  <https://doc.qt.io/qtforpython-6/PySide6/QtGui/QTextCharFormat.html#PySide6.QtGui.QTextCharFormat.setAnchorHref>
fmt.setToolTip("TEXT")              # show a tooltip over formatted text  @tooltip  <https://doc.qt.io/qtforpython-6/PySide6/QtGui/QTextCharFormat.html#PySide6.QtGui.QTextCharFormat.setToolTip>
