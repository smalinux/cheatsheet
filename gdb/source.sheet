title: gdb source and disassembly
url:   https://sourceware.org/gdb/current/onlinedocs/gdb.html/Source.html
tags:  gdb debugger source list disassemble assembly asm

## list source
list                     # print 10 more lines, around the current line the first time  @l <https://sourceware.org/gdb/current/onlinedocs/gdb.html/List.html>
list -                   # print 10 lines before the last printed lines
list +                   # print 10 lines after the last printed lines
list .                   # print lines around the current location again
list LINENUM             # print lines centered on a line
list FUNCTION            # print lines centered on the start of a function
list FILE:LINE           # print lines around a line in a file
list 10,20               # print a range of lines
list ,20                 # print 10 lines ending at line 20
list 10,                 # print 10 lines starting at line 10
list *ADDR               # print lines around an address
set listsize N|unlimited # set how many lines list prints
show listsize            # show how many lines list prints
info source              # show info about the current source file: compiler, dir, language
info line LOCATION       # show the address range of a source line
info line *ADDR          # show which source line is at an address  @addr2line

## edit and search
edit                       # open $EDITOR at the current line  <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Edit.html>
edit LOCATION              # open $EDITOR at a location, e.g. edit main
export EDITOR=/usr/bin/vim # choose the editor GDB opens (shell)  @nvim
search REGEX               # search forward in the source file  @forward-search @fo <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Search.html>
reverse-search REGEX       # search backward in the source file  @rev

## source path
directory DIR...             # add directories to the front of the source path  @dir <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Source-Path.html>
directory                    # reset the source path to $cdir:$cwd
show directories             # show the source path
set directories DIR:DIR      # replace the source path
set substitute-path FROM TO  # rewrite source paths, e.g. when the binary was built elsewhere  @remap @prefix-map
unset substitute-path [FROM] # remove path rewrite rules
show substitute-path         # show path rewrite rules
set source open on|off       # stop reading source files when off
show source open             # show if source files are read

## disassemble
disassemble                           # disassemble the current function  @disas @asm <https://sourceware.org/gdb/current/onlinedocs/gdb.html/Machine-Code.html>
disassemble FUNC                      # disassemble a function  @disas
disassemble START,END                 # disassemble an address range
disassemble START,+LENGTH             # disassemble LENGTH bytes from START
disassemble /m                        # mix source and asm in source order (deprecated)
disassemble /s                        # mix source and asm in address order (better)  @mixed
disassemble /r                        # show raw instruction bytes too  @opcodes @hex
disassemble /b                        # show raw bytes one by one, for wide-instruction arches
disassemble /ri                       # show raw bytes and instructions
x/10i $pc                             # disassemble 10 instructions from the PC
x/3i main+8                           # disassemble 3 instructions from an address
display/i $pc                         # show the next instruction at each stop
set disassembly-flavor intel|att      # choose x86 assembly syntax
set disassembly-flavor intel          # use Intel syntax for x86  @fav
set disassemble-next-line on|off|auto # disassemble the next line at each stop
set disassembler-options OPTS         # pass options to the disassembler, e.g. no-aliases on RISC-V
show disassembler-options             # show disassembler options
info line *$pc                        # show which source line the PC is on
