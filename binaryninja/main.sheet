## demangle module
SMA: DONE
SMA: Search: Is there more relaiable open source project for demangling?
; ------------------------------------------------------------------
; C++ (and Rust, D ...) compilers change function names into strange strings. This is called "mangling".
;   _ZN3foo3barEi          (GCC / Clang, called "GNU3" or "Itanium")   -> foo::bar(int)
;   ?testf@Foobar@@SA...   (MSVC, Windows)                             -> Foobar::testf(...)
; Demangling = turning the strange string back into a readable name (and often a type).
;
; Binja demangles symbols by itself when it loads a binary. Use this module when you have a mangled
; string from somewhere else: a string in memory, a log, a crash report, a symbol you made yourself.
;
; The result is a DemangleResult with 2 parts:
;   .type   -> a Type (often a function type), or None if only the name could be found
;   .name   -> a QualifiedName, like foo::bar  (a list of parts: ["foo", "bar"])
; You can unpack it:  t, n = demangle_any("...")
;
; Built-in demanglers (from the docs): MS, GNU3, LLVM.

demangle_any(name, config=None)                # try all demanglers. Returns DemangleResult or None           @binja @api @demangle  <file:/opt/binaryninja/python/binaryninja/demangle.py:172>
demangle_gnu3(config_or_arch, name)            # only GNU3 (GCC/Clang)                                       @binja @api @demangle  <file:/opt/binaryninja/python/binaryninja/demangle.py:340>
demangle_ms(config_or_arch, name)              # only Microsoft (MSVC)                                       @binja @api @demangle  <file:/opt/binaryninja/python/binaryninja/demangle.py:304>
demangle_llvm(name, config)                    # LLVM demangler (msvc/gnu3/rust/dlang). Gives name, no type  @binja @api @demangle  <file:/opt/binaryninja/python/binaryninja/demangle.py:272>
simplify_demangled_template_name(name)         # make long std:: template names short                       @binja @api @demangle  <file:/opt/binaryninja/python/binaryninja/demangle.py:370>
DemanglerConfig.default()                      # default options                                             @binja @api @demangle  <file:/opt/binaryninja/python/binaryninja/demangle.py:66>
DemanglerConfig.for_platform(platform, simplify)  # options for a platform (simplify = short template names) @binja @api @demangle
DemanglerConfig.for_binary_view(bv)            # options from your open binary (best in a script)            @binja @api @demangle
list(Demangler)                                # all registered demanglers                                   @binja @api @demangle  <file:/opt/binaryninja/python/binaryninja/demangle.py:429>
Demangler.register() / Demangler.promote(d)    # add your own demangler / make it the first one              @binja @api @demangle
demangle_generic(...)                          # OLD (deprecated in 5.4). Use demangle_any                   @binja @api @demangle

; Note: demangle_gnu3 and demangle_ms have an OLD way: if you give an arch (not a DemanglerConfig),
;       they return a plain tuple (type, name). If you give a DemanglerConfig, they return a DemangleResult.

; All examples run in the Binja GUI Python console (they need a license).

; --- Example 1: demangle one name
;
from binaryninja.demangle import demangle_any
r = demangle_any("?testf@Foobar@@SA?AW4foo@1@W421@@Z")
print(r.name)       # Foobar::testf
print(r.type)       # enum Foobar::foo __cdecl(enum Foobar::foo)      (from the docs)


; --- Example 2: unpack, and check for failure
;
from binaryninja.demangle import demangle_any
r = demangle_any("_ZN3foo3barEi")
if r is None:
    print("not a mangled name")
else:
    t, n = r
    print("name:", n, "| parts:", list(n), "| type:", t)


; --- Example 3: use the options of your open binary (fast in a loop)
; Make the config ONE time, then reuse it. (The docs warn: making it for every call is slow.)
;
from binaryninja.demangle import demangle_any, DemanglerConfig
cfg = DemanglerConfig.for_binary_view(bv)
for name in ["_ZN3foo3barEi", "_ZNSt6vectorIiSaIiEE9push_backEOi"]:
    r = demangle_any(name, cfg)
    print(name, "->", r.name if r else None)


; --- Example 4: find mangled strings in the binary's DATA and demangle them
; Useful for RTTI and C++ binaries: type names are stored as strings.
;
;     from binaryninja.demangle import demangle_any, DemanglerConfig
;     cfg = DemanglerConfig.for_binary_view(bv)
;     for s in bv.strings:
;         text = s.value
;         if text.startswith("_Z") or text.startswith("?"):
;             r = demangle_any(text, cfg)
;             if r:
;                 print(hex(s.start), r.name)


; --- Example 5: make long template names short
;
;     from binaryninja.demangle import simplify_demangled_template_name
;     print(simplify_demangled_template_name(
;         "std::basic_string<char, std::char_traits<char>, std::allocator<char> >"))
;     # expected: std::string


; --- Example 6: list the demanglers
;
;     from binaryninja.demangle import Demangler
;     print(list(Demangler))       # [<Demangler: MS>, <Demangler: GNU3>, <Demangler: LLVM>]   (from the docs)


; --- Example 7: your own demangler (for a custom name format)
; Imagine a packer that hides names like "OBF$main$int(int)". You teach Binja to read them.
;
;     from binaryninja.demangle import Demangler, DemangleResult
;     from binaryninja.types import QualifiedName
;
;     class ObfDemangler(Demangler):
;         name = "OBF"
;
;         def is_mangled_string(self, name):
;             return name.startswith("OBF$")
;
;         def demangle(self, name, config):
;             parts = name.split("$")              # ["OBF", "main", "int(int)"]
;             if len(parts) < 2:
;                 return None                      # None -> Binja tries the next demangler
;             return DemangleResult(None, QualifiedName([parts[1]]))   # name only, no type
;
;     ObfDemangler.register()
;
;     from binaryninja.demangle import demangle_any
;     print(demangle_any("OBF$main$int(int)").name)      # main


## deprecation module
; ------------------------------------------------------------------
; Another INTERNAL helper. Binja uses it to mark OLD API functions: "do not use this, it will be removed".
; When you call an old function, Python shows a DeprecatedWarning.
;
; Why it matters for YOU: if you see a warning like
;     DeprecatedWarning: demangle_generic is deprecated as of 5.4. Use `demangle_any` ...
; your script still works today, but you should change it to the new function.

@deprecated(deprecated_in="5.4", removed_in=None, details="Use X")  # decorator that marks a function as old      @binja @api @internal  <file:/opt/binaryninja/python/binaryninja/deprecation.py:115>
DeprecatedWarning                         # the warning you see when you call an old function               @binja @api @internal  <file:/opt/binaryninja/python/binaryninja/deprecation.py:43>
UnsupportedWarning                        # stronger: the function is already past its "removed_in" version @binja @api @internal  <file:/opt/binaryninja/python/binaryninja/deprecation.py:93>

; --- Example 1: show every deprecation warning ONE time (good when you update old scripts)
;
;     import warnings
;     from binaryninja.deprecation import DeprecatedWarning
;     warnings.simplefilter("always", DeprecatedWarning)


; --- Example 2: make deprecation warnings an ERROR (find all old calls fast)
;
;     import warnings
;     from binaryninja.deprecation import DeprecatedWarning
;     warnings.simplefilter("error", DeprecatedWarning)
;     # now every call to an old API raises an exception with the line number


; --- Example 3: find all deprecated functions in Binja's Python API
; This reads the source files. It does not need a license. Runs in normal Python.
;
;     import glob, re
;     for path in glob.glob("/opt/binaryninja/python/binaryninja/*.py"):
;         src = open(path).read()
;         for m in re.finditer(r"@deprecation\.deprecated\(([^)]*)\)\s*\n\s*def (\w+)", src):
;             print(path.split("/")[-1], m.group(2), "|", m.group(1))


; --- Example 4: use it in your OWN plugin
;
;     from binaryninja.deprecation import deprecated
;
;     @deprecated(deprecated_in="1.1", details="Use new_func instead.")
;     def old_func():
;         return 1
;
;     old_func()     # works, but shows a DeprecatedWarning
;     # real output:  DeprecatedWarning: old_func is deprecated as of 1.1. Use new_func instead.

; --- Notes
; - Example 3 and 4 were RUN (they need no license). Example 3 found 30 deprecated functions, for example:
;     demangle.py demangle_generic | deprecated_in="5.4", details="Use `demangle_any` with a `DemanglerConfig` instead."
; - Python hides DeprecationWarning by default in some places. Use Example 1 to always see them.


## downloadprovider module (DownloadProvider, DownloadInstance)
; ------------------------------------------------------------------
; Binja needs the internet for some things: updates, plugin manager, symbol servers (PDB), type libraries.
; A DownloadProvider is the code that does the HTTP requests for Binja.
;
; You can use it in your plugin to make HTTP requests. Good points:
;   - it uses Binja's proxy setting (network.httpsProxy), so it works in the same network as Binja
;   - you do not need to install "requests" in Binja's Python
;
; Built-in Python provider name: "PythonDownloadProvider" (it uses the "requests" library inside).
;
; How to use it: provider -> create_instance() -> get/post -> Response
; Response has: .status_code, .headers (dict), .content (bytes)
; The request returns None if it fails (no network ...).

DownloadProvider[name]                    # get a provider by name                                  @binja @api @net  <file:/opt/binaryninja/python/binaryninja/downloadprovider.py:291>
list(DownloadProvider)                    # all providers                                           @binja @api @net
provider.create_instance()                # make an object that can do requests                     @binja @api @net
inst.get(url, headers=None)               # HTTP GET -> Response or None                            @binja @api @net  <file:/opt/binaryninja/python/binaryninja/downloadprovider.py:245>
inst.post(url, headers, data, json)       # HTTP POST. data=bytes or dict (form), json=dict          @binja @api @net
inst.request(method, url, headers, data, json)  # any method ("GET", "POST", "DELETE" ...)          @binja @api @net  <file:/opt/binaryninja/python/binaryninja/downloadprovider.py:193>
resp.status_code / resp.headers / resp.content    # the answer                                      @binja @api @net

; BUG in the source: inst.put(...) sends "POST", not "PUT". For a real PUT, use inst.request("PUT", ...).

; All examples run in the Binja GUI Python console.

; --- Example 1: list providers
;
;     from binaryninja.downloadprovider import DownloadProvider
;     for p in DownloadProvider:
;         print(p.name)


; --- Example 2: simple GET
;
;     from binaryninja.downloadprovider import DownloadProvider
;     inst = DownloadProvider["PythonDownloadProvider"].create_instance()
;     r = inst.get("https://example.com/")
;     if r is None:
;         print("request failed")
;     else:
;         print(r.status_code, len(r.content), "bytes")
;         print(r.content[:80])


; --- Example 3: POST JSON (for example, send a hash to your own server)
;
;     from binaryninja.downloadprovider import DownloadProvider
;     inst = DownloadProvider["PythonDownloadProvider"].create_instance()
;     r = inst.post("https://httpbin.org/post", json={"sha256": "abcd..."})
;     if r:
;         print(r.status_code, r.content.decode()[:200])


; --- Example 4: real PUT (because put() has a bug)
;
;     from binaryninja.downloadprovider import DownloadProvider
;     inst = DownloadProvider["PythonDownloadProvider"].create_instance()
;     r = inst.request("PUT", "https://httpbin.org/put", headers={}, data=b"hello")
;     if r:
;         print(r.status_code)


; --- Notes
; - Always check for None. No exception is raised when the network fails.
; - If you give data AND json both, it fails (assert). Give only one.
; - data as dict is sent as a form (x-www-form-urlencoded). data as bytes is sent raw.
; - I did not run these examples.


## enums module
; ------------------------------------------------------------------
; All the fixed lists of names (enums) of the Binja API are in this one file: 122 enums.
; Examples: HighLevelILOperation, SymbolType, BranchType, SegmentFlag, InstructionTextTokenType, LogLevel ...
;
; Most are IntEnum: each name is also a NUMBER. Binja's C++ core uses the numbers.
; Some are IntFlag (like SegmentFlag, FindFlag): you can join them with |
;
; GOOD NEWS: enums works WITHOUT a license. All outputs below are REAL (I ran them).

from binaryninja.enums import *           # import all enums                                         @binja @api @enums  <file:/opt/binaryninja/python/binaryninja/enums.py>
HighLevelILOperation.HLIL_CALL            # one value                                                @binja @api @enums
X.name / X.value                          # its name (str) / its number (int)                        @binja @api @enums
HighLevelILOperation(66)                  # number -> enum value                                     @binja @api @enums
HighLevelILOperation["HLIL_CALL"]         # name -> enum value                                       @binja @api @enums
list(SymbolType)                          # all values of an enum                                    @binja @api @enums

; The enums you will use MOST:
;   LowLevelILOperation / MediumLevelILOperation / HighLevelILOperation   -> inst.operation
;   SymbolType            FunctionSymbol, ImportedFunctionSymbol, DataSymbol ...        -> sym.type
;   SegmentFlag           SegmentReadable, SegmentWritable, SegmentExecutable           -> segment rights
;   SectionSemantics      ReadOnlyCodeSectionSemantics, ReadWriteDataSectionSemantics   -> section kind
;   BranchType            TrueBranch, FalseBranch, UnconditionalBranch ...              -> edges of basic blocks
;   TypeClass             IntegerTypeClass, StructureTypeClass, PointerTypeClass ...    -> type.type_class
;   VariableSourceType    StackVariableSourceType, RegisterVariableSourceType ...       -> var.source_type
;   HighlightStandardColor  RedHighlightColor, BlueHighlightColor ...                   -> colors
;   InstructionTextTokenType  TextToken, IntegerToken ...                               -> tokens
;   LogLevel              DebugLog, InfoLog, WarningLog, ErrorLog                       -> log


; --- Example 1: name <-> number  (REAL output)
;
;     from binaryninja.enums import HighLevelILOperation
;     op = HighLevelILOperation.HLIL_CALL
;     print(op.name, op.value)                       # HLIL_CALL 66
;     print(HighLevelILOperation(66).name)           # HLIL_CALL
;     print("HLIL_CALL" in HighLevelILOperation.__members__)   # True


; --- Example 2: careful with print()  (REAL output)
; In new Python versions, print(IntEnum) shows the NUMBER, not the name.
;
;     from binaryninja.enums import SymbolType, Endianness
;     print(SymbolType.FunctionSymbol)               # 0          <- not "FunctionSymbol"!
;     print(SymbolType.FunctionSymbol.name)          # FunctionSymbol
;     print(repr(Endianness.LittleEndian))           # shows name and number
;
; Rule: use .name when you print.


; --- Example 3: flags  (REAL output)
;
;     from binaryninja.enums import SegmentFlag
;     rx = SegmentFlag.SegmentReadable | SegmentFlag.SegmentExecutable
;     print(int(rx))                                 # 5
;     print(bool(rx & SegmentFlag.SegmentExecutable))   # True


; --- Example 4: list all values  (REAL output)
;
;     from binaryninja.enums import HighlightStandardColor
;     print([c.name for c in HighlightStandardColor][:5])
;     # ['NoHighlightColor', 'BlueHighlightColor', 'GreenHighlightColor', 'CyanHighlightColor', 'RedHighlightColor']


; --- Example 5: use enums with IL (needs a binary open in the GUI)
; Count every HLIL operation in a function: which operations does it use most?
;
;     from collections import Counter
;     # bv = the binary you have open (the console gives you this variable)
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     c = Counter(i.operation.name for i in f.hlil.instructions)
;     print(c.most_common(5))


; --- Example 6: find all executable segments (needs a binary open in the GUI)
;
;     from binaryninja.enums import SegmentFlag
;     for seg in bv.segments:
;         if seg.flags & SegmentFlag.SegmentExecutable:
;             print(hex(seg.start), hex(seg.end), "executable")


; --- Example 7: list all 122 enum names  (REAL, no license needed)
;
;     import enum, binaryninja.enums as E
;     names = [n for n in dir(E) if isinstance(getattr(E, n), type) and issubclass(getattr(E, n), enum.Enum)]
;     print(len(names))                              # 122
;     print(names[:5])


; --- Notes
; - When you see a number in an error or a print, use EnumName(number).name to read it.
; - IL "commonil" classes (see commonil module) are another way to check the kind of instruction.


## exceptions module
; ------------------------------------------------------------------
; 4 small exception classes. Binja raises them when an API call fails.
; You can catch them with try / except.

RelocationWriteException                  # a relocation could not be written                        @binja @api @errors  <file:/opt/binaryninja/python/binaryninja/exceptions.py:1>
ILException                               # an IL operation failed (for example bad IL index)         @binja @api @errors  <file:/opt/binaryninja/python/binaryninja/exceptions.py:5>
ProjectException                          # a project operation failed                               @binja @api @errors  <file:/opt/binaryninja/python/binaryninja/exceptions.py:9>
ExternalLinkException                     # external library / external location operation failed     @binja @api @errors  <file:/opt/binaryninja/python/binaryninja/exceptions.py:13>

; --- Example 1: catch an IL error
;
;     from binaryninja.exceptions import ILException
;     # bv = the binary you have open (the console gives you this variable)
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     try:
;         print(f.hlil[99999])                          # an index that does not exist
;     except ILException as e:
;         print("IL error:", e)
;     except IndexError as e:
;         print("index error:", e)
;
; Note: many Binja APIs return None instead of raising. Read the docs of each function.


## extensionmanager module (RepositoryManager, Repository, Extension)
; ------------------------------------------------------------------
; This is the Python side of Binja's PLUGIN MANAGER (Plugins -> Manage Plugins in the GUI).
; With it, a script can list, install, enable, disable, and uninstall plugins.
;
;   RepositoryManager   all plugin repositories (the official one + any you add)
;   Repository          one repository (a git repo with many plugins)
;   Extension           one plugin in a repository (the source calls it "Extension")

RepositoryManager()                       # the manager                                               @binja @api @plugins  <file:/opt/binaryninja/python/binaryninja/extensionmanager.py:521>
mgr.repositories                          # list of Repository                                        @binja @api @plugins
mgr.default_repository                    # the official repository                                   @binja @api @plugins
mgr.plugins                               # dict: repo path -> list of Extension                      @binja @api @plugins
mgr.check_for_updates()                   # refresh all repositories                                  @binja @api @plugins
mgr.add_repository(url, repopath)         # add your own plugin repository                            @binja @api @plugins
repo.plugins                              # list of Extension in this repo                            @binja @api @plugins  <file:/opt/binaryninja/python/binaryninja/extensionmanager.py:462>
repo[plugin_path]                         # one plugin by its path                                    @binja @api @plugins
ext.name / ext.author / ext.version / ext.description / ext.project_url    # info              @binja @api @plugins  <file:/opt/binaryninja/python/binaryninja/extensionmanager.py:65>
ext.installed / ext.enabled / ext.update_available / ext.is_paid          # status              @binja @api @plugins
ext.install(version_id=None)              # install (latest version by default)                       @binja @api @plugins
ext.uninstall()                           # uninstall                                                 @binja @api @plugins
ext.enable(force=False) / ext.disable()   # turn on / off                                             @binja @api @plugins
ext.plugin_types                          # list of PluginType (UiPluginType, ArchitecturePluginType ...)  @binja @api @plugins

; All examples run in the Binja GUI Python console.

; --- Example 1: list all plugins in the official repository
;
;     from binaryninja.extensionmanager import RepositoryManager
;     mgr = RepositoryManager()
;     for ext in mgr.default_repository.plugins:
;         print(ext.name, "|", ext.author, "|", "installed" if ext.installed else "-")


; --- Example 2: search plugins by a word
;
;     from binaryninja.extensionmanager import RepositoryManager
;     mgr = RepositoryManager()
;     word = "deobf"
;     for ext in mgr.default_repository.plugins:
;         text = (ext.name + " " + (ext.description or "")).lower()
;         if word in text:
;             print(ext.name, "-", ext.description, "-", ext.project_url)


; --- Example 3: list installed plugins that have an update
;
;     from binaryninja.extensionmanager import RepositoryManager
;     mgr = RepositoryManager()
;     mgr.check_for_updates()
;     for ext in mgr.default_repository.plugins:
;         if ext.installed and ext.update_available:
;             print("update:", ext.name, ext.version)


; --- Example 4: install and enable a plugin by name
;
;     from binaryninja.extensionmanager import RepositoryManager
;     mgr = RepositoryManager()
;     for ext in mgr.default_repository.plugins:
;         if ext.name == "Snippets":                    # change to the plugin you want
;             print("install:", ext.install())
;             print("enable: ", ext.enable())
;
; Note: some plugins need a RESTART of Binja after install / uninstall.


; --- Notes
; - install / uninstall / enable change your Binja setup. Check the plugin before you install it.
; - ext.dependencies shows the Python packages a plugin needs.
; - I did not run these examples.


## externallibrary module (ExternalLibrary, ExternalLocation)
; ------------------------------------------------------------------
; A program calls functions from other libraries: printf from libc.so, CreateFileW from kernel32.dll.
; In your binary these are IMPORTS. Binja only sees the name; the real code is in another file.
;
; ExternalLibrary   = "this binary uses library X" (for example "libc.so.6").
;                     It can be linked to a real file in a Binja PROJECT (backing_file).
; ExternalLocation  = a link: "this import symbol in my binary -> that symbol / address in library X".
;
; Why: in a project with many files (exe + its dlls), you can jump from the import in the exe
; to the real function in the dll. Binja follows the link.

bv.get_external_libraries()                               # list of ExternalLibrary                   @binja @api @extlib  <file:/opt/binaryninja/python/binaryninja/binaryview.py:11152>
bv.get_external_library(name)                             # one library, or None                      @binja @api @extlib
bv.add_external_library(name, backing_file=None)          # add a library                             @binja @api @extlib  <file:/opt/binaryninja/python/binaryninja/binaryview.py:11115>
bv.remove_external_library(name)                          # remove it                                 @binja @api @extlib
bv.get_external_locations()                               # list of ExternalLocation                  @binja @api @extlib  <file:/opt/binaryninja/python/binaryninja/binaryview.py:11213>
bv.get_external_location(symbol)                          # the link of one import symbol             @binja @api @extlib
bv.add_external_location(symbol, library, target_symbol, target_address)   # make a link              @binja @api @extlib  <file:/opt/binaryninja/python/binaryninja/binaryview.py:11171>
bv.remove_external_location(symbol)                       # remove a link                             @binja @api @extlib
lib.name / lib.backing_file                               # name / ProjectFile (or None)              @binja @api @extlib  <file:/opt/binaryninja/python/binaryninja/externallibrary.py:31>
loc.source_symbol                                         # the import symbol in your binary          @binja @api @extlib  <file:/opt/binaryninja/python/binaryninja/externallibrary.py:82>
loc.library                                               # the ExternalLibrary                       @binja @api @extlib
loc.target_symbol / loc.has_target_symbol                 # name in the library                       @binja @api @extlib
loc.target_address / loc.has_target_address              # address in the library                    @binja @api @extlib

; All examples run in the Binja GUI Python console.
; bv = the binary you have open (the console gives you this variable).

; --- Example 1: which libraries does my binary use?
;
;     for lib in bv.get_external_libraries():
;         print(lib.name, "| file:", lib.backing_file)


; --- Example 2: list all import links
;
;     for loc in bv.get_external_locations():
;         lib = loc.library.name if loc.library else "?"
;         target = loc.target_symbol if loc.has_target_symbol else hex(loc.target_address) if loc.has_target_address else "?"
;         print(loc.source_symbol.name, "->", lib, target)


; --- Example 3: link an import to a library by hand
; For example: the import "my_decrypt" really lives in "libsecret.so", at symbol "decrypt_v2".
;
;     lib = bv.get_external_library("libsecret.so") or bv.add_external_library("libsecret.so")
;     sym = bv.get_symbols_by_name("my_decrypt")[0]
;     loc = bv.add_external_location(sym, lib, "decrypt_v2", None)
;     print(loc.library.name, loc.target_symbol)


; --- Notes
; - backing_file is only useful inside a Binja project (the library file must be in the project).
; - Errors here raise ExternalLinkException (see exceptions module).
; - I did not run these examples.


## fileaccessor module (FileAccessor)
; ------------------------------------------------------------------
; A FileAccessor is a "fake file" that YOU write in Python.
; Binja asks it: "how long are you?", "give me N bytes at offset X", "write these bytes at offset X".
; Your class answers. The data can come from anywhere: memory, a network, a live process, a generator.
;
; You write a class with 3 methods:
;   get_length()            -> int: the size
;   read(offset, length)    -> bytes (can be shorter, or None)
;   write(offset, data)     -> int: how many bytes you wrote
;
; Where Binja uses it:
;   bv.add_memory_region(name, start, source=MyAccessor())   -> a "RemoteMemoryRegion": Binja reads from your class
;   bv.save(MyAccessor())                                    -> Binja writes the patched binary INTO your class

FileAccessor                              # base class you inherit from                              @binja @api @file  <file:/opt/binaryninja/python/binaryninja/fileaccessor.py:29>
bv.add_memory_region(name, start, source) # add a memory region. source can be a FileAccessor         @binja @api @file  <file:/opt/binaryninja/python/binaryninja/binaryview.py:3048>
bv.save(dest)                             # save the binary (with patches) to a path or FileAccessor   @binja @api @file  <file:/opt/binaryninja/python/binaryninja/binaryview.py:5556>

; All examples run in the Binja GUI Python console.
; bv = the binary you have open (the console gives you this variable).

; --- Example 1: save the patched binary into MEMORY (not to disk)
; Good when you want the bytes in Python, to hash them or send them.
;
;     import hashlib
;     from binaryninja.fileaccessor import FileAccessor
;
;     class MemoryFile(FileAccessor):
;         def __init__(self):
;             super().__init__()                    # IMPORTANT: always call this
;             self.data = bytearray()
;         def get_length(self):
;             return len(self.data)
;         def read(self, offset, length):
;             return bytes(self.data[offset:offset + length])
;         def write(self, offset, data):
;             end = offset + len(data)
;             if end > len(self.data):
;                 self.data.extend(b"\x00" * (end - len(self.data)))
;             self.data[offset:end] = data
;             return len(data)
;
;     out = MemoryFile()
;     print(bv.save(out))                           # True
;     print(len(out.data), hashlib.sha256(out.data).hexdigest())


; --- Example 2: a memory region that comes from your Python code
; Here: a 0x1000-byte region full of a pattern. In real life it can read from a debugger or a dump.
;
;     from binaryninja.fileaccessor import FileAccessor
;     from binaryninja.enums import SegmentFlag
;
;     class PatternRegion(FileAccessor):
;         def __init__(self, size):
;             super().__init__()
;             self.size = size
;         def get_length(self):
;             return self.size
;         def read(self, offset, length):
;             return bytes((offset + i) & 0xff for i in range(length))   # 00 01 02 03 ...
;         def write(self, offset, data):
;             return 0                              # read-only
;
;     ok = bv.add_memory_region("pattern", 0x10000000, PatternRegion(0x1000),
;                               SegmentFlag.SegmentReadable)
;     print(ok, bv.read(0x10000000, 8))             # b'\x00\x01\x02\x03\x04\x05\x06\x07'


; --- Example 3: map memory from a LIVE Linux process (read only)
; Read a heap or stack region of a running process into Binja. You need permission (same user + ptrace allowed).
;
;     from binaryninja.fileaccessor import FileAccessor
;     from binaryninja.enums import SegmentFlag
;
;     class ProcMem(FileAccessor):
;         def __init__(self, pid, start, size):
;             super().__init__()
;             self.f = open(f"/proc/{pid}/mem", "rb")
;             self.start, self.size = start, size
;         def get_length(self):
;             return self.size
;         def read(self, offset, length):
;             self.f.seek(self.start + offset)
;             return self.f.read(length)
;         def write(self, offset, data):
;             return 0
;
;     # take start/size from: cat /proc/<pid>/maps
;     pid, start, size = 1234, 0x555555559000, 0x21000
;     bv.add_memory_region("heap", start, ProcMem(pid, start, size), SegmentFlag.SegmentReadable)


; --- Notes
; - Always call super().__init__() in your __init__. It connects your methods to Binja.
; - If read/write raise an exception, Binja logs it and uses 0 bytes. Look at the Log window.
; - A RemoteMemoryRegion is "ephemeral": the data is not stored in the .bndb.
; - I did not run these examples.


## filemetadata module (FileMetadata, SaveSettings, NavigationHandler)
; ------------------------------------------------------------------
; FileMetadata = information about the OPEN FILE (not about the code inside it).
; You get it with bv.file.
;
; It knows:
;   - the file names (filename, original_filename, display_name)
;   - is it saved? modified? is it a .bndb?
;   - the UNDO / REDO history
;   - the current position (offset) and navigation in the GUI
;   - session_data: a dict where your plugin can keep data while Binja is open
;   - all the views of the file: "Raw", "ELF", "PE" ... (one file can have many views)
;
; Many of these are also on bv directly (bv.undo(), bv.navigate(), bv.undoable_transaction() ...).

bv.file                                    # the FileMetadata of this binary                          @binja @api @file  <file:/opt/binaryninja/python/binaryninja/filemetadata.py:120>
f.filename                                 # path of the open file (.bndb or binary)                   @binja @api @file
f.original_filename                        # path of the ORIGINAL binary (useful when a .bndb is open) @binja @api @file
f.display_name                             # short name for the UI (no folders)                       @binja @api @file
f.modified / f.saved                       # changed since last save? / saved?                        @binja @api @file
f.has_database                             # True if it is backed by a .bndb                          @binja @api @file
f.database                                 # the Database (see database module), or None              @binja @api @file
f.offset                                   # current address in the GUI. You can set it               @binja @api @file
f.navigate(view_name, addr)                # go to an address in a view ("Linear:ELF", "Graph:ELF" ...) @binja @api @file  <file:/opt/binaryninja/python/binaryninja/filemetadata.py:603>
f.raw                                      # the "Raw" view: the file bytes as they are on disk        @binja @api @file  <file:/opt/binaryninja/python/binaryninja/filemetadata.py:302>
f.existing_views                           # names of all views of this file, like ['Raw', 'ELF']     @binja @api @file
f.get_view_of_type(name)                   # one view by name                                         @binja @api @file
f.session_data                             # dict for your plugin. Lost when Binja closes             @binja @api @file  <file:/opt/binaryninja/python/binaryninja/filemetadata.py:340>
f.undoable_transaction()                   # "with" block: all changes = ONE undo step; error -> revert @binja @api @undo  <file:/opt/binaryninja/python/binaryninja/filemetadata.py:376>
f.begin_undo_actions() -> id               # start recording changes                                  @binja @api @undo
f.commit_undo_actions(id)                  # save them as one undo step                               @binja @api @undo
f.revert_undo_actions(id)                  # cancel them                                              @binja @api @undo
f.undo() / f.redo()                        # undo / redo                                              @binja @api @undo
f.undo_entries / f.redo_entries            # the history lists                                        @binja @api @undo
f.create_database(path, progress, settings) # save as .bndb                                           @binja @api @db
f.save_auto_snapshot(progress, settings)   # save again into the .bndb                                @binja @api @db
SaveSettings().set_option(SaveOption.X)    # options for saving: RemoveUndoData, TrimSnapshots, PurgeOriginalFilenamePath  @binja @api @db  <file:/opt/binaryninja/python/binaryninja/filemetadata.py:82>
f.close()                                  # close the file (in headless scripts)                     @binja @api @file

; All examples run in the Binja GUI Python console.
; bv = the binary you have open (the console gives you this variable).

; --- Example 1: info about the open file
;
;     f = bv.file
;     print("file:     ", f.filename)
;     print("original: ", f.original_filename)
;     print("database: ", f.has_database, "| modified:", f.modified)
;     print("views:    ", f.existing_views)


; --- Example 2: Raw view vs. parsed view
; The ELF/PE view shows memory (virtual addresses). The Raw view shows the file bytes (file offsets).
;
;     raw = bv.file.raw
;     print(raw.read(0, 4))                         # b'\x7fELF'  for an ELF file (file offset 0)
;     print(bv.read(bv.start, 4))                   # bytes at the first VIRTUAL address


; --- Example 3: one undo step for many changes (safe patching)
; If something goes wrong inside the block, ALL changes are reverted.
;
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     with bv.file.undoable_transaction():
;         f.name = "main_renamed"
;         bv.set_comment_at(f.start, "renamed by my script")
;     # Ctrl+Z in the GUI (or bv.file.undo()) now reverts BOTH changes together


; --- Example 4: undo by hand (begin / commit / revert)
;
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     state = bv.file.begin_undo_actions()
;     f.name = "test_name"
;     keep = False                                     # decide here
;     if keep:
;         bv.file.commit_undo_actions(state)
;     else:
;         bv.file.revert_undo_actions(state)          # name goes back
;     print(f.name)


; --- Example 5: move the GUI to an address
;
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     view_name = "Linear:" + bv.view_type             # for example "Linear:ELF"
;     bv.file.navigate(view_name, f.start)
;     print(hex(bv.file.offset))


; --- Example 6: keep data for your plugin while Binja is open
;
;     sd = bv.file.session_data
;     sd["visited"] = sd.get("visited", 0) + 1         # works like a dict
;     print("script run", sd["visited"], "times on this file")


; --- Example 7: save a SMALL .bndb (no undo history, no old snapshots)
; Good before you send a .bndb to someone.
;
;     from binaryninja.filemetadata import SaveSettings
;     from binaryninja.enums import SaveOption
;     s = SaveSettings()
;     s.set_option(SaveOption.RemoveUndoData)
;     s.set_option(SaveOption.TrimSnapshots)
;     s.set_option(SaveOption.PurgeOriginalFilenamePath)   # hide your local path
;     print(bv.file.create_database("/tmp/clean.bndb", None, s))


; --- Notes
; - bv.file.raw is very useful when you need FILE OFFSETS (headers, overlays, data after the last section).
; - session_data is NOT saved. Use bv.store_metadata (metadata module) to save data in the .bndb.
; - undoable_transaction reverts on ANY exception, then raises the exception again.
; - I did not run these examples.


## firmwareninja module (FirmwareNinja)
; ------------------------------------------------------------------
; ULTIMATE EDITION ONLY. Tools for FIRMWARE (code for small devices: routers, IoT, microcontrollers).
;
; Firmware is hard because:
;   - there is often no header (no ELF/PE), so you do not know where code and data are
;   - the code talks to HARDWARE through special addresses (MMIO = memory-mapped I/O),
;     for example: writing to 0x40011000 sends a byte on the UART
;
; FirmwareNinja helps with:
;   1. Find code / data / padding / compressed parts with ENTROPY (how "random" the bytes are)
;   2. Find all instructions that read/write memory that is NOT in the file (MMIO and RAM)
;   3. Guess the BOARD: compare these accesses with known boards and their devices
;   4. Reference trees: "who uses this device / address?"
;   5. Store your own devices and relationships in the .bndb

FirmwareNinja(bv)                                       # make the helper for your binary                       @binja @api @firmware  <file:/opt/binaryninja/python/binaryninja/firmwareninja.py:433>
fwn.get_sections_from_entropy(block_size=4096)          # list of FirmwareNinjaSection: .type .start .size .entropy  @binja @api @firmware  <file:/opt/binaryninja/python/binaryninja/firmwareninja.py:572>
fwn.get_function_memory_accesses()                      # (slow) list of FirmwareNinjaFunctionMemoryAccesses     @binja @api @firmware  <file:/opt/binaryninja/python/binaryninja/firmwareninja.py:627>
fwn.store_function_memory_accesses(fma)                 # save the result in the .bndb (do not run again)        @binja @api @firmware
fwn.query_function_memory_accesses()                    # load the saved result                                  @binja @api @firmware
fwn.boards                                              # names of known boards for this CPU                     @binja @api @firmware
fwn.get_devices_for_board(name)                         # list of FirmwareNinjaDevice: .name .start .size .info   @binja @api @firmware
fwn.get_board_device_accesses(fma)                      # boards sorted by how many of their devices are used    @binja @api @firmware  <file:/opt/binaryninja/python/binaryninja/firmwareninja.py:725>
fwn.get_reference_tree(location, fma, value=None)       # tree of who uses a device/section/function/address     @binja @api @firmware  <file:/opt/binaryninja/python/binaryninja/firmwareninja.py:767>
fwn.store_custom_device(name, start, size, info)        # save your own device                                   @binja @api @firmware
fwn.user_devices / fwn.remove_custom_device(name)       # list / remove your devices                             @binja @api @firmware
fwn.relationships / add_relationship / remove_relationship_by_guid   # links between binaries                    @binja @api @firmware

; FirmwareNinjaSectionType:      CodeSectionType, DataSectionType, CompressionSectionType, PaddingSectionType
; FirmwareNinjaMemoryAccessType: NoMemoryAccessType, ReadMemoryAccessType, WriteMemoryAccessType

; All examples run in the Binja GUI Python console, Ultimate edition.
; bv = the binary you have open (the console gives you this variable).

; --- Example 1: find code, data, compressed parts with entropy
;
;     from binaryninja.firmwareninja import FirmwareNinja
;     fwn = FirmwareNinja(bv)
;     for s in fwn.get_sections_from_entropy(block_size=2048):
;         print(s.type.name, hex(s.start), hex(s.size), round(s.entropy, 3))
;
; Entropy near 1.0 = compressed or encrypted. Low = padding or simple data.


; --- Example 2: find MMIO accesses (and save them, because it is slow)
;
;     from binaryninja.firmwareninja import FirmwareNinja
;     fwn = FirmwareNinja(bv)
;     fma = fwn.query_function_memory_accesses()      # try saved result first
;     if not fma:
;         fma = fwn.get_function_memory_accesses()
;         fwn.store_function_memory_accesses(fma)
;     for item in fma[:10]:
;         for a in item.accesses:
;             print(item.function.name, hex(a.instr_address), a.type.name, a.mem_address)


; --- Example 3: which board is this firmware for?
;
;     from binaryninja.firmwareninja import FirmwareNinja
;     fwn = FirmwareNinja(bv)
;     fma = fwn.query_function_memory_accesses() or fwn.get_function_memory_accesses()
;     for b in fwn.get_board_device_accesses(fma)[:5]:
;         print(b.board_name, "total:", b.total, "unique devices:", b.unique)
;     # docs example: FirmwareNinjaDeviceAccesses(board_name='stm32mp157c-dhcom-picoitx', total=414, unique=2)


; --- Example 4: list the devices of a board, and name them in your binary
;
;     from binaryninja.firmwareninja import FirmwareNinja
;     fwn = FirmwareNinja(bv)
;     board = fwn.boards[0]                           # or a board name from Example 3
;     for d in fwn.get_devices_for_board(board):
;         print(d.name, hex(d.start), hex(d.size), d.info)


; --- Example 5: who uses this device? (reference tree)
;
;     from binaryninja.firmwareninja import FirmwareNinja
;     fwn = FirmwareNinja(bv)
;     fma = fwn.query_function_memory_accesses() or fwn.get_function_memory_accesses()
;     fwn.store_custom_device("UART1", 0x40011000, 0x400, "my UART")
;     dev = [d for d in fwn.user_devices if d.name == "UART1"][0]
;     root = fwn.get_reference_tree(dev, fma)
;
;     def show(node, depth=0):
;         print("  " * depth, node.object)
;         for child in node.children:
;             show(child, depth + 1)
;     show(root)


; --- Notes
; - Ultimate edition only (the decorators module adds this note to the docs).
; - get_function_memory_accesses is SLOW on big firmware. Store the result.
; - For Section or Device, fma can NOT be None in get_reference_tree (it raises ValueError).
; - Load firmware at the RIGHT base address first (see basedetection module), or the MMIO addresses will be wrong.
; - I did not run these examples.


## flowgraph module (FlowGraph, FlowGraphNode, FlowGraphEdge, EdgeStyle)
; ------------------------------------------------------------------
; A FlowGraph is a picture of boxes (nodes) and arrows (edges), like the Graph View of a function.
; With this module you can:
;   1. READ the graph of a function (its nodes, lines, edges)
;   2. DRAW YOUR OWN graph and show it in a new tab: call graphs, state machines, decrypted control flow ...
;
; Words:
;   FlowGraph       the whole picture
;   FlowGraphNode   one box. It has text lines and outgoing edges.
;   FlowGraphEdge   one arrow: .type (BranchType) .source .target
;   EdgeStyle       how the arrow looks: line style, width, color
;
; GOOD NEWS: building a graph works WITHOUT a license (I tested it). Only SHOWING it needs the GUI.

FlowGraph()                                  # a new empty graph                                         @binja @api @graph  <file:/opt/binaryninja/python/binaryninja/flowgraph.py:379>
FlowGraphNode(graph)                         # a new box for this graph                                  @binja @api @graph  <file:/opt/binaryninja/python/binaryninja/flowgraph.py:87>
node.lines = ["a", "b"]                      # text of the box (list of str or DisassemblyTextLine)      @binja @api @graph  <file:/opt/binaryninja/python/binaryninja/flowgraph.py:197>
graph.append(node)                           # add the box. Returns its index (0, 1, 2 ...)              @binja @api @graph
node.add_outgoing_edge(BranchType.X, other, style=None)   # arrow from node to other                    @binja @api @graph  <file:/opt/binaryninja/python/binaryninja/flowgraph.py:313>
node.outgoing_edges / node.incoming_edges    # list of FlowGraphEdge                                     @binja @api @graph
node.highlight = HighlightStandardColor.X    # color the box                                             @binja @api @graph
node.basic_block                             # the basic block of this box (for function graphs)         @binja @api @graph
graph.nodes / graph.node_count / graph[i]    # the boxes                                                 @binja @api @graph
show_graph_report(title, graph)              # show the graph in a new tab (GUI). From binaryninja.interaction   @binja @api @graph
graph.show(title)                            # same thing                                                @binja @api @graph
graph.layout_and_wait()                      # compute positions (x, y, width, height) and wait          @binja @api @graph
func.create_graph(FunctionGraphType.X)       # graph of a function (disassembly, LLIL, MLIL, HLIL ...)   @binja @api @graph  <file:/opt/binaryninja/python/binaryninja/function.py:2321>
EdgeStyle(EdgePenStyle.X, width, ThemeColor.Y)   # arrow look                                           @binja @api @graph  <file:/opt/binaryninja/python/binaryninja/flowgraph.py:63>

; --- Example 1: build a small graph  (REAL output, no license needed)
;
;     from binaryninja.flowgraph import FlowGraph, FlowGraphNode
;     from binaryninja.enums import BranchType
;     g = FlowGraph()
;     a = FlowGraphNode(g); a.lines = ["start"]
;     b = FlowGraphNode(g); b.lines = ["left"]
;     c = FlowGraphNode(g); c.lines = ["right"]
;     print(g.append(a), g.append(b), g.append(c))   # 0 1 2
;     a.add_outgoing_edge(BranchType.TrueBranch, b)  # green arrow in the GUI
;     a.add_outgoing_edge(BranchType.FalseBranch, c) # red arrow in the GUI
;     print(g.node_count)                            # 3
;     print([(e.type.name, e.target.lines[0].tokens[0].text) for e in a.outgoing_edges])
;     # [('TrueBranch', 'left'), ('FalseBranch', 'right')]
;
; To SHOW it (in the GUI):  from binaryninja.interaction import show_graph_report; show_graph_report("My graph", g)


; --- Example 2: careful with multi-line text  (REAL output)
;     node.lines = "line1\nline2"          -> 2 lines   (a str is split on \n)
;     node.lines = ["line1\nline2"]        -> 1 line with a \n inside (NOT split)
; Rule: give a list, one item per line:  node.lines = ["line1", "line2"]


; --- Example 3: draw the CALL GRAPH of a function (who does main call?)
; Runs in the Binja GUI Python console. bv = the binary you have open.
;
;     from binaryninja.flowgraph import FlowGraph, FlowGraphNode
;     from binaryninja.enums import BranchType
;     from binaryninja.interaction import show_graph_report
;
;     root_func = bv.get_functions_by_name("main")[0]          # pick a function by name
;     g = FlowGraph()
;     nodes = {}
;     def node_for(f):
;         if f.start not in nodes:
;             n = FlowGraphNode(g)
;             n.lines = [f"{f.name}  @ {f.start:#x}"]
;             g.append(n)
;             nodes[f.start] = n
;         return nodes[f.start]
;
;     def walk(f, depth):
;         if depth == 0:
;             return
;         for callee in f.callees:
;             new = callee.start not in nodes
;             node_for(f).add_outgoing_edge(BranchType.UnconditionalBranch, node_for(callee))
;             if new:
;                 walk(callee, depth - 1)
;
;     node_for(root_func)
;     walk(root_func, 3)                                   # 3 levels deep
;     show_graph_report("Call graph of main", g)


; --- Example 4: read the HLIL graph of a function
;
;     from binaryninja.enums import FunctionGraphType
;     f = bv.get_functions_by_name("main")[0]              # pick a function by name
;     g = f.create_graph(FunctionGraphType.HighLevelILFunctionGraph)
;     g.layout_and_wait()
;     for i, node in enumerate(g.nodes):
;         print(f"--- node {i}  ({node.x},{node.y})  edges -> {len(node.outgoing_edges)}")
;         for line in node.lines:
;             print("   ", line)


; --- Example 5: color boxes and use a dashed arrow
;
;     from binaryninja.flowgraph import FlowGraph, FlowGraphNode, EdgeStyle
;     from binaryninja.enums import BranchType, EdgePenStyle, ThemeColor, HighlightStandardColor
;     from binaryninja.interaction import show_graph_report
;     g = FlowGraph()
;     a = FlowGraphNode(g); a.lines = ["check_password()"]; a.highlight = HighlightStandardColor.BlueHighlightColor
;     b = FlowGraphNode(g); b.lines = ["win()"];            b.highlight = HighlightStandardColor.GreenHighlightColor
;     g.append(a); g.append(b)
;     style = EdgeStyle(EdgePenStyle.DashLine, 2, ThemeColor.AddressColor)
;     a.add_outgoing_edge(BranchType.UserDefinedBranch, b, style)
;     show_graph_report("styled", g)


; --- Notes
; - The graph must have ONE start node, and every other node must be reachable from it by arrows.
;   Separate parts, or nodes only reachable "backwards", are not drawn correctly (the source says this).
; - create_graph waits for analysis. Inside a workflow activity use func.create_graph_immediate.
; - Examples 3-5 were not run (they need the GUI).


## function module (Function, DisassemblySettings, DisassemblyTextLine, DisassemblyTextRenderer)
; ------------------------------------------------------------------
; Function = ONE function in the binary. This is one of the modules you will use the MOST.
; Get one with:
;   bv.functions                         all functions
;   bv.get_functions_by_name("main")     list of functions with this name
;   bv.get_function_at(addr)             the function that STARTS at addr (or None)
;   bv.get_functions_containing(addr)    list of functions that CONTAIN addr
;   current_function                     the function open in the GUI (console only)
;
; The module is very big (4384 lines). Below: the most useful parts, grouped by topic.

; --- Basic info
func.name                                  # name. You can set it: func.name = "decrypt"               @binja @api @function  <file:/opt/binaryninja/python/binaryninja/function.py:523>
func.start                                 # start address                                            @binja @api @function
func.lowest_address / func.highest_address # first / last address                                    @binja @api @function
func.address_ranges                        # list of ranges (a function can have holes)               @binja @api @function
func.total_bytes                           # size (sum of all blocks)                                 @binja @api @function
func.symbol / func.is_exported / func.auto # symbol / exported? / found by Binja (True) or by you    @binja @api @function
func.arch / func.platform / func.view      # CPU / platform / the BinaryView                         @binja @api @function
func.is_thunk                              # True if it only jumps to another function                @binja @api @function
func.can_return                            # False for exit(), abort() ... (you can set it)           @binja @api @function
func.comment                               # comment of the whole function (you can set it)           @binja @api @function

; --- Type, parameters, variables
func.type                                  # FunctionType. Set it with a string: func.type = "int f(char* s, int n)"   @binja @api @function  <file:/opt/binaryninja/python/binaryninja/function.py:1210>
func.return_type                           # return type                                              @binja @api @function
func.parameter_vars                        # parameter variables                                      @binja @api @function
func.calling_convention                    # see callingconvention module                             @binja @api @function
func.vars                                  # all variables                                            @binja @api @function
func.stack_layout                          # stack variables                                          @binja @api @function
func.get_variable_by_name(name)            # one variable                                             @binja @api @function
func.create_user_var(var, type, name)      # rename / retype a variable                               @binja @api @function
func.merge_vars(target, sources) / split_var(var)   # join variables / split one                     @binja @api @function

; --- Code: blocks, IL, text
func.basic_blocks                          # assembly basic blocks                                    @binja @api @function  <file:/opt/binaryninja/python/binaryninja/function.py:687>
func.instructions                          # generator of (tokens, address) for every instruction     @binja @api @function
func.llil / func.mlil / func.hlil          # the IL functions                                         @binja @api @function
func.lifted_il / func.mmlil                # lifted IL / mapped MLIL                                  @binja @api @function
func.*_if_available                        # same, but None if not ready (does not wait)              @binja @api @function
func.pseudo_c                              # Pseudo C representation                                  @binja @api @function
func.get_llil_at(addr) / func.get_llils_at(addr)   # LLIL at an address                                @binja @api @function
func.get_basic_block_at(addr)              # block that contains addr                                 @binja @api @function
func.create_graph(FunctionGraphType.X)     # graph of the function (see flowgraph module)             @binja @api @function

; --- Calls and references
func.callees / func.callee_addresses       # functions it calls                                       @binja @api @function  <file:/opt/binaryninja/python/binaryninja/function.py:3386>
func.callers                               # functions that call it                                   @binja @api @function
func.call_sites                            # call instructions inside it (ReferenceSource: .address)  @binja @api @function
func.caller_sites                          # call instructions that call it                           @binja @api @function
func.is_call_instruction(addr)             # True if addr is a call                                   @binja @api @function
func.get_parameter_at(addr, None, i)       # value of parameter i at a call (dataflow)                @binja @api @function
func.add_user_code_ref(from, to)           # add a cross-reference by hand (for indirect calls)       @binja @api @function
func.set_user_indirect_branches(src, [(arch, addr)...])   # tell Binja where a jump table goes       @binja @api @function

; --- Data flow (values of registers / stack)
func.get_reg_value_at(addr, "rdi")         # value of a register BEFORE the instruction               @binja @api @dataflow  <file:/opt/binaryninja/python/binaryninja/function.py:2041>
func.get_reg_value_after(addr, "rax")      # value AFTER the instruction                              @binja @api @dataflow
func.get_stack_contents_at(addr, offset, size)   # value on the stack                                 @binja @api @dataflow
func.get_regs_read_by(addr) / get_regs_written_by(addr)   # registers used                           @binja @api @dataflow
func.get_constants_referenced_by(addr)     # constants in an instruction                              @binja @api @dataflow
func.set_user_var_value(var, def_addr, PossibleValueSet.constant(5))   # tell Binja a value -> dead branches removed  @binja @api @dataflow  <file:/opt/binaryninja/python/binaryninja/function.py:3205>

; --- Marks: comments, tags, colors, display
func.set_comment_at(addr, text) / func.get_comment_at(addr)   # comments                             @binja @api @function
func.comments                              # dict addr -> comment                                     @binja @api @function
func.add_tag(tag_type_name, data, addr=None)   # tag (no addr = tag on the whole function)            @binja @api @tags  <file:/opt/binaryninja/python/binaryninja/function.py:841>
func.tags / func.get_function_tags()       # tags in the function / tags on the function              @binja @api @tags
func.set_user_instr_highlight(addr, color) # color an instruction                                     @binja @api @function
func.set_int_display_type(addr, value, operand, IntegerDisplayType.X)   # show a number as hex/char/decimal ...  @binja @api @function
func.store_metadata(key, value) / query_metadata(key)   # save your data on the function (in .bndb)   @binja @api @metadata

; --- Analysis control
func.reanalyze() / func.analyze()          # ask Binja to analyze again (does not wait)               @binja @api @function
func.analysis_skipped / func.too_large     # skipped because too big?                                 @binja @api @function
func.analysis_skipped = False              # force analysis of a big function                         @binja @api @function

; All examples run in the Binja GUI Python console.
; bv = the binary you have open (the console gives you this variable).

; --- Example 1: overview of all functions
;
;     for f in bv.functions:
;         print(f"{f.start:#x}  {f.name:30}  size={f.total_bytes:5}  blocks={len(f.basic_blocks):3}  callers={len(f.callers)}")


; --- Example 2: biggest functions first (good place to start RE)
;
;     big = sorted(bv.functions, key=lambda f: f.total_bytes, reverse=True)
;     for f in big[:10]:
;         print(f.name, f.total_bytes)


; --- Example 3: rename a function and set its type
;
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     f.name = "real_main"
;     f.type = "int real_main(int argc, char** argv)"
;     print(f.type)


; --- Example 4: print all instructions with addresses
;
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     for tokens, addr in f.instructions:
;         print(hex(addr), "".join(t.text for t in tokens))


; --- Example 5: callers and callees
;
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     print("calls:     ", [c.name for c in f.callees])
;     print("called by: ", [c.name for c in f.callers])
;     for ref in f.call_sites:
;         print("call at", hex(ref.address))


; --- Example 6: what is the first argument of every call to a function? (dataflow)
; Example: find every call to "system" and print the value in rdi (x86_64 Linux) at the call.
;
;     for target in bv.get_functions_by_name("system"):
;         for ref in bv.get_code_refs(target.start):
;             caller = ref.function
;             v = caller.get_reg_value_at(ref.address, "rdi")
;             print(hex(ref.address), caller.name, v)
;     # v can be <const 0x402010> (a known address) or <undetermined>


; --- Example 7: comment, tag and color an address
;
;     from binaryninja.enums import HighlightStandardColor
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     addr = f.start
;     f.set_comment_at(addr, "entry of main")
;     if bv.get_tag_type("Important") is None:
;         bv.create_tag_type("Important", "⭐")
;     f.add_tag("Important", "check this", addr)       # address tag
;     f.add_tag("Important", "main logic")             # function tag (no addr)
;     f.set_user_instr_highlight(addr, HighlightStandardColor.RedHighlightColor)


; --- Example 8: show a constant as a character in the GUI
; Change "cmp eax, 0x41" to "cmp eax, 'A'".
;
;     from binaryninja.enums import IntegerDisplayType
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     addr = 0x401150                                  # address of the instruction with the number
;     f.set_int_display_type(addr, 0x41, 1, IntegerDisplayType.CharacterConstant)   # operand 1


; --- Example 9: tell Binja the value of a variable (dataflow)
; Tell Binja a variable is always 5. Then the HLIL removes branches that are never taken.
;
;     from binaryninja.variable import PossibleValueSet
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     inst = f.mlil[0]                                 # first MLIL instruction, must be a SET_VAR
;     var = inst.dest
;     f.set_user_var_value(var, inst.address, PossibleValueSet.constant(5))


; --- Example 10: one undo step for many renames
;
;     with bv.undoable_transaction():
;         for f in bv.functions:
;             if f.name.startswith("sub_") and len(f.callees) == 0:
;                 f.name = "leaf_" + f.name[4:]


; --- Example 11: make the text of a function with your own settings
;
;     from binaryninja.function import DisassemblySettings
;     from binaryninja.enums import DisassemblyOption, FunctionGraphType
;     s = DisassemblySettings()
;     s.set_option(DisassemblyOption.ShowAddress, True)
;     s.set_option(DisassemblyOption.ShowOpcode, True)
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     g = f.create_graph(FunctionGraphType.NormalFunctionGraph, s)
;     g.layout_and_wait()
;     for node in g.nodes:
;         for line in node.lines:
;             print(line)


; --- Notes
; - func.hlil (and llil, mlil) WAIT for analysis. In a workflow or in a loop over many functions,
;   *_if_available is faster: it gives None if not ready.
; - add_tag does nothing if the tag type does not exist. Create it first with bv.create_tag_type(name, icon).
; - get_function_at(addr) needs the START address. For an address inside, use get_functions_containing(addr).
; - Many "set_auto_*" functions are for plugins/analysis. As a user, use the "user" versions (they are saved and undoable).
; - I did not run these examples.


## functionrecognizer module (FunctionRecognizer)
; ------------------------------------------------------------------
; A FunctionRecognizer is your code that LOOKS AT EVERY NEW FUNCTION during analysis.
; Binja calls it with the function's LLIL (and MLIL). Your code checks a pattern.
; If it knows the function, it can rename it, set its type, add a tag ... and return True.
;
; Use cases:
;   - name small wrapper functions automatically ("this function only calls malloc" -> "malloc_wrapper")
;   - mark functions that only "return 0" / "return 1"
;   - find crypto, string functions, stack-protector checks by a known IL pattern
;
; How:
;   1. Inherit FunctionRecognizer
;   2. Write recognize_low_level_il(self, data, func, il)   and/or   recognize_medium_level_il(...)
;        data = the BinaryView, func = the Function, il = its LLIL or MLIL function
;   3. Return True if you recognized it, False if not
;   4. Register: MyRec.register_global()  (all CPUs)   or   MyRec.register_arch(arch)  (one CPU)

FunctionRecognizer                         # base class                                                @binja @api @analysis  <file:/opt/binaryninja/python/binaryninja/functionrecognizer.py:33>
recognize_low_level_il(data, func, il)     # your check on LLIL. Return True/False                      @binja @api @analysis  <file:/opt/binaryninja/python/binaryninja/functionrecognizer.py:66>
recognize_medium_level_il(data, func, il)  # your check on MLIL. Return True/False                      @binja @api @analysis  <file:/opt/binaryninja/python/binaryninja/functionrecognizer.py:80>
MyRec.register_global()                    # use for all architectures                                  @binja @api @analysis
MyRec.register_arch(Architecture["x86_64"])  # use for one architecture                                 @binja @api @analysis

; IMPORTANT: register BEFORE you open the binary (a recognizer only sees functions analyzed after it is registered).
; Best place: a plugin file in your Binja plugins folder, so it loads at startup.

; --- Example 1: name functions that only "return <constant>"
;
;     from binaryninja.functionrecognizer import FunctionRecognizer
;     from binaryninja.enums import MediumLevelILOperation as Op
;
;     class ReturnConstRecognizer(FunctionRecognizer):
;         def recognize_medium_level_il(self, data, func, il):
;             insts = list(il.instructions)
;             if len(insts) != 1:
;                 return False
;             i = insts[0]
;             if i.operation != Op.MLIL_RET or len(i.src) != 1:
;                 return False
;             val = i.src[0]
;             if val.operation != Op.MLIL_CONST:
;                 return False
;             if func.name.startswith("sub_"):          # do not change names from symbols
;                 func.name = f"return_{val.constant}_{func.start:x}"
;             return True
;
;     ReturnConstRecognizer.register_global()


; --- Example 2: name wrappers that only call ONE other function
; A wrapper: one call, nothing else important. Name it "<callee>_wrapper".
;
;     from binaryninja.functionrecognizer import FunctionRecognizer
;     from binaryninja.commonil import Call
;
;     class WrapperRecognizer(FunctionRecognizer):
;         def recognize_medium_level_il(self, data, func, il):
;             insts = list(il.instructions)
;             if len(insts) > 3:                       # small functions only
;                 return False
;             calls = [i for i in insts if isinstance(i, Call)]
;             if len(calls) != 1:
;                 return False
;             dest = calls[0].dest
;             if not hasattr(dest, "constant"):
;                 return False
;             target = data.get_function_at(dest.constant)
;             if target and func.name.startswith("sub_") and not target.name.startswith("sub_"):
;                 func.name = target.name + "_wrapper"
;                 return True
;             return False
;
;     WrapperRecognizer.register_global()


; --- Example 3: tag functions with a magic constant (LLIL)
; Tag every function that uses the TEA constant 0x9e3779b9.
;
;     from binaryninja.functionrecognizer import FunctionRecognizer
;     from binaryninja.commonil import Constant
;
;     class TeaRecognizer(FunctionRecognizer):
;         def recognize_low_level_il(self, data, func, il):
;             for inst in il.instructions:
;                 for c in inst.traverse(lambda x: x.constant if isinstance(x, Constant) else None):
;                     if c is not None and (c & 0xffffffff) == 0x9e3779b9:
;                         if data.get_tag_type("Crypto") is None:
;                             data.create_tag_type("Crypto", "🔐")
;                         func.add_tag("Crypto", "TEA constant 0x9e3779b9")
;                         return True
;             return False
;
;     TeaRecognizer.register_global()


; --- Notes
; - Your code runs for EVERY function, during analysis, maybe in many threads. Keep it FAST and simple.
; - An exception in your code is logged; analysis continues (the source catches it and returns False).
; - Only one instance of your class is made (cls._instance), even if you register many times.
; - I did not run these examples.


## highlevelil module (HLIL: HighLevelILFunction, HighLevelILInstruction, 150+ instruction classes)
; ------------------------------------------------------------------
; HLIL = High Level IL. It is the code you see in the decompiler view, close to C.
; HLIL is a TREE (AST: abstract syntax tree):
;     if (x > 5)              -> HighLevelILIf
;         foo(x, "hi")        ->   condition = HighLevelILCmpSgt(x, 5)
;                             ->   true = HighLevelILCall(dest=foo, params=[x, "hi"])
; Every node is a HighLevelILInstruction. Its class tells you the kind: HighLevelILCall, HighLevelILIf ...
; Its operation is an enum: HighLevelILOperation.HLIL_CALL ...
;
; Get it:   func.hlil  (HighLevelILFunction)
; Loop:     for inst in func.hlil.instructions        (top-level statements only)
;           func.hlil.traverse(callback)              (EVERY node, also inside expressions)
;
; See also: commonil module (labels like Call, Constant), enums module (HighLevelILOperation).

; --- HighLevelILFunction (hf = func.hlil)
hf.instructions                            # generator of top-level statements                       @binja @api @hlil  <file:/opt/binaryninja/python/binaryninja/highlevelil.py:2929>
hf.root                                    # the root of the tree (one big block)                    @binja @api @hlil
hf[i]                                      # instruction by index                                    @binja @api @hlil
hf.basic_blocks                            # HLIL basic blocks                                       @binja @api @hlil
hf.traverse(cb, *args)                     # call cb on EVERY node; yields the non-None results      @binja @api @hlil  <file:/opt/binaryninja/python/binaryninja/highlevelil.py:2858>
hf.ssa_form / hf.non_ssa_form              # SSA version / normal version                            @binja @api @hlil
hf.mlil                                    # the MLIL this HLIL was made from                        @binja @api @hlil
hf.source_function                         # the Function                                            @binja @api @hlil
hf.get_var_definitions(var) / get_var_uses(var)   # where a variable is written / read              @binja @api @hlil
hf.get_expr(index)                         # expression by expression index                         @binja @api @hlil
hf.replace_expr(old, new) / hf.const(...) / hf.add(...) ...   # build / change HLIL (only in workflows / lifting)  @binja @api @hlil

; --- HighLevelILInstruction (i)
i.operation                                # HighLevelILOperation enum, like HLIL_CALL                @binja @api @hlil
i.address                                  # address in the binary                                    @binja @api @hlil
i.instr_index / i.expr_index               # index of the statement / of this expression              @binja @api @hlil
i.operands / i.detailed_operands           # the children (detailed: with names and types)            @binja @api @hlil  <file:/opt/binaryninja/python/binaryninja/highlevelil.py:825>
i.lines / i.tokens / str(i)                # text                                                     @binja @api @hlil
i.parent / i.instr                         # parent node / the statement it is in                     @binja @api @hlil
i.vars / i.vars_read / i.vars_written      # variables used                                           @binja @api @hlil
i.value / i.possible_values                # known value (dataflow)                                   @binja @api @hlil
i.expr_type                                # the C type of this expression                            @binja @api @hlil
i.mlil / i.llil                            # same code in MLIL / LLIL                                 @binja @api @hlil
i.ssa_form                                 # SSA version                                              @binja @api @hlil
i.traverse(cb)                             # walk this node and its children                          @binja @api @hlil  <file:/opt/binaryninja/python/binaryninja/highlevelil.py:832>
i.prefix_operands / i.postfix_operands     # all operands flat, in tree order                         @binja @api @hlil
HighLevelILInstruction.show_hlil_hierarchy()   # GUI: draw the class tree of all HLIL classes          @binja @api @hlil

; --- The classes you see most (and their fields)
;   HighLevelILIf          .condition .true .false
;   HighLevelILWhile       .condition .body           (also DoWhile)
;   HighLevelILFor         .init .condition .update .body
;   HighLevelILSwitch      .condition .default .cases
;   HighLevelILRet         .src (list)
;   HighLevelILVarInit     .dest (variable) .src       ->  int x = ...
;   HighLevelILAssign      .dest (expression) .src     ->  x = ... / *p = ...
;   HighLevelILCall        .dest (who is called) .params (list)
;   HighLevelILVar         .var
;   HighLevelILDeref       .src                         ->  *src
;   HighLevelILConst       .constant
;   HighLevelILConstPtr    .constant  .string           ->  pointer to data (maybe a string)
;   HighLevelILImport      .constant                    ->  imported function/data address
;   HighLevelILAdd, Sub, Mul, Xor ...   .left .right
;   HighLevelILCmpE, CmpNe, CmpSlt ...  .left .right

; All examples run in the Binja GUI Python console.
; bv = the binary you have open (the console gives you this variable).

; --- Example 1: print the HLIL of a function with addresses
;
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     for inst in f.hlil.instructions:
;         print(hex(inst.address), inst)


; --- Example 2: see the tree of one statement
;
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     def show(node, depth=0):
;         print("  " * depth + f"{node.operation.name}: {node}")
;         for name, value, kind in node.detailed_operands:
;             if hasattr(value, "operation"):
;                 show(value, depth + 1)
;             elif isinstance(value, list):
;                 for v in value:
;                     if hasattr(v, "operation"):
;                         show(v, depth + 1)
;     show(list(f.hlil.instructions)[0])


; --- Example 3: find ALL calls in a function (also hidden inside expressions)
;
;     from binaryninja.highlevelil import HighLevelILCall
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     def is_call(i):
;         if isinstance(i, HighLevelILCall):
;             return i
;     for call in f.hlil.traverse(is_call):
;         print(hex(call.address), call.dest, "args:", [str(p) for p in call.params])


; --- Example 4: find calls to printf where the FORMAT is not a constant (format string bug!)
;
;     from binaryninja.highlevelil import HighLevelILCall, HighLevelILConstPtr
;     targets = {f.start for f in bv.functions if f.name in ("printf", "sprintf", "fprintf", "syslog")}
;     fmt_index = {"printf": 0, "sprintf": 1, "fprintf": 1, "syslog": 1}
;     def bad_format(i):
;         if isinstance(i, HighLevelILCall) and hasattr(i.dest, "constant") and i.dest.constant in targets:
;             name = bv.get_function_at(i.dest.constant).name
;             idx = fmt_index[name]
;             if len(i.params) > idx and not isinstance(i.params[idx], HighLevelILConstPtr):
;                 return i
;     for f in bv.functions:
;         for hit in f.hlil.traverse(bad_format):
;             print(f.name, hex(hit.address), hit)


; --- Example 5: list all string constants used in a function
;
;     from binaryninja.highlevelil import HighLevelILConstPtr
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     def get_str(i):
;         if isinstance(i, HighLevelILConstPtr) and i.string is not None:
;             return i.string
;     for s in f.hlil.traverse(get_str):
;         print(s)


; --- Example 6: every if-condition in a function
;
;     from binaryninja.highlevelil import HighLevelILIf
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     for i in f.hlil.traverse(lambda x: x if isinstance(x, HighLevelILIf) else None):
;         print(hex(i.address), "if", i.condition)


; --- Example 7: where is a variable written and read?
;
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     v = f.hlil.source_function.vars[0]               # pick a variable (or f.get_variable_by_name("x"))
;     print("var:", v)
;     for d in f.hlil.get_var_definitions(v):
;         print("  written:", hex(d.address), d)
;     for u in f.hlil.get_var_uses(v):
;         print("  read:   ", hex(u.address), u)


; --- Example 8: from HLIL back to assembly
;
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     inst = list(f.hlil.instructions)[0]
;     print("HLIL:", inst)
;     print("MLIL:", inst.mlil)
;     print("LLIL:", inst.llil)
;     print("asm: ", bv.get_disassembly(inst.address))


; --- Example 9: count operations (what kind of code is this?)
;
;     from collections import Counter
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     c = Counter(f.hlil.traverse(lambda x: x.operation.name))
;     print(c.most_common(10))


; --- Notes
; - hf.instructions = top level only. A call inside "x = foo()" is found only with traverse.
; - traverse yields only results that are NOT None. Return None to skip a node.
; - str(inst) gives the text. inst.lines gives text with formatting tokens.
; - The class names map to operations: HighLevelILCall <-> HLIL_CALL.
; - Building / changing HLIL (const, add, replace_expr ...) is for workflows (see workflow module).
; - I did not run these examples.


## highlight module (HighlightColor)
; ------------------------------------------------------------------
; HighlightColor = a COLOR for instructions, basic blocks and graph nodes in the GUI.
; 3 kinds (style):
;   Standard  one of Binja's colors: Red, Blue, Green, Cyan, Magenta, Yellow, Orange, White, Black
;   Mixed     a mix of 2 standard colors (mix = 0..255)
;   Custom    your own RGB color
; All 3 can have alpha (0..255) = how strong / transparent.
;
; GOOD NEWS: works WITHOUT a license. Outputs below are REAL.

HighlightColor(HighlightStandardColor.RedHighlightColor)      # standard color                     @binja @api @color  <file:/opt/binaryninja/python/binaryninja/highlight.py:28>
HighlightColor(color, alpha=128)                              # half transparent                    @binja @api @color
HighlightColor(red=255, green=128, blue=0)                    # custom RGB                          @binja @api @color
HighlightColor(color=A, mix_color=B, mix=128)                 # mix of A and B                      @binja @api @color
func.set_user_instr_highlight(addr, color)                    # color one instruction               @binja @api @color
block.set_user_highlight(color)                               # color a basic block                 @binja @api @color  <file:/opt/binaryninja/python/binaryninja/basicblock.py:801>
node.highlight = color                                        # color a flow graph node             @binja @api @color
; Note: these functions also take a plain HighlightStandardColor (no HighlightColor needed).

; --- Example 1: make colors  (REAL output)
;
;     from binaryninja.highlight import HighlightColor
;     from binaryninja.enums import HighlightStandardColor as C
;     print(HighlightColor(C.RedHighlightColor))                  # <color: red>
;     print(HighlightColor(C.RedHighlightColor, alpha=128))       # <color: red, alpha 128>
;     print(HighlightColor(red=0xff, green=0x80, blue=0))         # <color: #ff8000>
;     print(HighlightColor(color=C.BlueHighlightColor, mix_color=C.GreenHighlightColor, mix=128))
;                                                                 # <color: mix blue to green factor 128>


; --- Example 2: color every block of a function that calls a dangerous function
; Runs in the GUI. bv = the binary you have open.
;
;     from binaryninja.highlight import HighlightColor
;     from binaryninja.enums import HighlightStandardColor as C
;     danger = {"strcpy", "gets", "sprintf", "system"}
;     red = HighlightColor(C.RedHighlightColor, alpha=96)
;     for f in bv.functions:
;         for bb in f.basic_blocks:
;             for tokens, addr in [(t, a) for t, a in f.instructions if bb.start <= a < bb.end]:
;                 text = "".join(t.text for t in tokens)
;                 if any(name in text for name in danger):
;                     bb.set_user_highlight(red)
;                     break


; --- Example 3: color the path of a trace (addresses from a debugger log)
;
;     from binaryninja.enums import HighlightStandardColor as C
;     trace = [0x401136, 0x40113a, 0x401140]           # your executed addresses
;     for addr in trace:
;         for f in bv.get_functions_containing(addr):
;             f.set_user_instr_highlight(addr, C.GreenHighlightColor)


; --- Notes
; - "user" highlights are saved and undoable. "auto" highlights are for plugins and can be replaced by analysis.
; - To remove a color: set HighlightStandardColor.NoHighlightColor.


## interaction module (reports, input dialogs, message boxes, progress)
; ------------------------------------------------------------------
; Talk to the USER from your script:
;   - SHOW things: text, markdown, HTML, a graph, many reports in tabs
;   - ASK things: a string, a number, an address, a choice, a file, a checkbox, a full form
;   - message boxes, open a URL, a progress bar
;
; Works in the GUI (pop-up windows) AND in headless / command line (prints, reads stdin).
; REAL test without license: markdown_to_html works; show_markdown_report prints the plaintext version;
; get_text_line_input reads from stdin (returns None if no input).

; --- Show
show_plain_text_report(title, text)                # text in a new tab                                  @binja @api @ui  <file:/opt/binaryninja/python/binaryninja/interaction.py:1138>
show_markdown_report(title, md, plaintext="")      # markdown in a new tab                              @binja @api @ui
show_html_report(title, html, plaintext="")        # HTML in a new tab                                  @binja @api @ui
show_graph_report(title, graph)                    # FlowGraph in a new tab (see flowgraph module)      @binja @api @ui
show_report_collection(title, ReportCollection)    # many reports together                              @binja @api @ui
markdown_to_html(md)                               # convert markdown to HTML                           @binja @api @ui
show_message_box(title, text, buttons, icon)       # message box -> MessageBoxButtonResult              @binja @api @ui  <file:/opt/binaryninja/python/binaryninja/interaction.py:1519>
open_url(url)                                      # open in the web browser                            @binja @api @ui

; --- Ask (each returns None if the user cancels)
get_text_line_input(prompt, title)                 # -> bytes/str                                       @binja @api @ui  <file:/opt/binaryninja/python/binaryninja/interaction.py:1223>
get_int_input(prompt, title)                       # -> int                                             @binja @api @ui
get_address_input(prompt, title)                   # -> int (accepts symbols and expressions)           @binja @api @ui
get_choice_input(prompt, title, ["a", "b"])        # -> index of the choice (int)                       @binja @api @ui
get_large_choice_input(prompt, title, choices)     # -> index, for long lists (with search)             @binja @api @ui
get_open_filename_input(prompt, ext="")            # -> path                                            @binja @api @ui
get_save_filename_input(prompt, ext, default_name) # -> path                                            @binja @api @ui
get_directory_name_input(prompt, default_name)     # -> path                                            @binja @api @ui
get_checkbox_input(prompt, title, default)         # -> 0/1                                             @binja @api @ui
get_form_input([fields...], title)                 # MANY inputs in one dialog -> True/False            @binja @api @ui  <file:/opt/binaryninja/python/binaryninja/interaction.py:1452>
run_progress_dialog(title, can_cancel, task)       # run task in background with a progress bar         @binja @api @ui  <file:/opt/binaryninja/python/binaryninja/interaction.py:1546>

; --- Form fields (for get_form_input). After the dialog, read field.result
;   "text"               a label (a plain str)
;   None                 a separator (empty line)
;   TextLineField(prompt)                MultilineTextField(prompt)
;   IntegerField(prompt)                 AddressField(prompt, view=bv, current_address=...)
;   ChoiceField(prompt, ["a", "b"])      -> result = index
;   OpenFileNameField(prompt)  SaveFileNameField(prompt)  DirectoryNameField(prompt)
;   CheckboxField(prompt, default)       (the docs table says "CheckboxFormField", but the class is CheckboxField)


; --- Example 1: show a markdown report of all functions
; Runs in the GUI. bv = the binary you have open.
;
;     from binaryninja.interaction import show_markdown_report
;     lines = ["# Functions", "", "| address | name | size |", "|---|---|---|"]
;     for f in sorted(bv.functions, key=lambda f: -f.total_bytes)[:30]:
;         lines.append(f"| `{f.start:#x}` | {f.name} | {f.total_bytes} |")
;     show_markdown_report("Biggest functions", "\n".join(lines))


; --- Example 2: ask for an address and go there
;
;     from binaryninja.interaction import get_address_input
;     addr = get_address_input("Where do you want to go?", "Jump")
;     if addr is not None:
;         bv.file.navigate("Linear:" + bv.view_type, addr)


; --- Example 3: a small form
;
;     from binaryninja.interaction import get_form_input, TextLineField, IntegerField, ChoiceField, CheckboxField
;     name  = TextLineField("Function prefix")
;     size  = IntegerField("Minimum size")
;     mode  = ChoiceField("Mode", ["rename", "tag only"])
;     dry   = CheckboxField("Dry run", False)
;     if get_form_input(["Rename settings", None, name, size, mode, dry], "My plugin"):
;         print(name.result, size.result, mode.result, dry.result)
;     else:
;         print("cancelled")


; --- Example 4: yes / no question
;
;     from binaryninja.interaction import show_message_box
;     from binaryninja.enums import MessageBoxButtonSet, MessageBoxIcon, MessageBoxButtonResult
;     r = show_message_box("Confirm", "Rename 120 functions?",
;                          MessageBoxButtonSet.YesNoButtonSet, MessageBoxIcon.QuestionIcon)
;     if r == MessageBoxButtonResult.YesButton:
;         print("yes")


; --- Example 5: long work with a progress bar the user can cancel
;
;     from binaryninja.interaction import run_progress_dialog
;     funcs = list(bv.functions)
;     result = []
;     def task(progress):
;         for i, f in enumerate(funcs):
;             if not progress(i, len(funcs)):          # False = user pressed Cancel
;                 return
;             result.append((f.name, len(list(f.hlil.instructions))))
;     finished = run_progress_dialog("Counting HLIL", True, task)
;     print("finished" if finished else "cancelled", len(result))


; --- Example 6: many reports in one window
;
;     from binaryninja.interaction import ReportCollection, PlainTextReport, MarkdownReport, show_report_collection
;     rc = ReportCollection()
;     rc.append(PlainTextReport("Strings", "\n".join(s.value for s in list(bv.strings)[:100])))
;     rc.append(MarkdownReport("Summary", f"# {bv.file.display_name}\n\n{len(bv.functions)} functions"))
;     show_report_collection("My analysis", rc)


; --- Example 7: markdown to HTML  (REAL, no license needed)
;
;     from binaryninja.interaction import markdown_to_html
;     print(markdown_to_html("# Hi\n- a\n- **b**"))
;     # <h1>Hi</h1>
;     # <ul>
;     # <li>a</li>
;     # <li><strong>b</strong></li>
;     # </ul>


; --- Notes
; - Always check for None (cancel) after an input function.
; - In headless mode, reports PRINT their plaintext version. Give a plaintext argument to markdown/html reports.
; - show_message_box uses Qt: simple HTML works, links are not clickable.
; - For complex UIs, use PySide (binaryninjaui module).
; - Examples 1-6 were not run (they need the GUI).


## languagerepresentation module (LanguageRepresentationFunction, ...FunctionType, HighLevelILTokenEmitter)
; ------------------------------------------------------------------
; A "language representation" = a way to SHOW HLIL as source code of some language.
; "Pseudo C" is one. "Pseudo Rust" and "Pseudo Python" (an official example plugin) are others.
; The HLIL is the same; only the TEXT is different.
;
; You use this module to:
;   1. GET the decompiled text of a function in a language (for example: export all Pseudo C to a file)
;   2. MAKE your own language (a plugin). The official example is a full "Pseudo Python" (1400 lines).
;
; The classes:
;   LanguageRepresentationFunctionType   the language itself ("Pseudo C"). Registered by name.
;   LanguageRepresentationFunction       one function shown in that language. Makes the text lines.
;   HighLevelILTokenEmitter              the "pen" that writes tokens: text, (, ), {, }, new lines, indentation, scopes.

func.pseudo_c                                          # Pseudo C of a function (LanguageRepresentationFunction)   @binja @api @lang  <file:/opt/binaryninja/python/binaryninja/function.py:1186>
func.language_representation("Pseudo C")               # same, by language name                                    @binja @api @lang
list(LanguageRepresentationFunctionType)               # all languages                                             @binja @api @lang  <file:/opt/binaryninja/python/binaryninja/languagerepresentation.py:685>
lr.get_linear_lines(func.hlil.root, settings=None)     # text lines of the WHOLE function (linear view style)     @binja @api @lang  <file:/opt/binaryninja/python/binaryninja/languagerepresentation.py:577>
lr.get_expr_text(hlil_instr, settings)                 # text lines of one HLIL expression                         @binja @api @lang  <file:/opt/binaryninja/python/binaryninja/languagerepresentation.py:549>
lr.get_block_lines(hlil_block, settings)               # text lines of one HLIL basic block                        @binja @api @lang
lang_type.function_type_tokens(func, settings)         # the prototype line, like "int main(int argc)"             @binja @api @lang
/opt/binaryninja/examples/python/pseudo_python.py      # official example: a full new language                     @binja @example @lang  <file:/opt/binaryninja/examples/python/pseudo_python.py>

; --- To make your own language (from the official example):
;   class MyFunction(LanguageRepresentationFunction):
;       perform_init_token_emitter(emitter)      -> options: emitter.brace_requirement = BraceRequirement.BracesNotAllowed ...
;       perform_begin_lines(instr, tokens)        -> tokens at the start of the function
;       perform_end_lines(instr, tokens)          -> tokens at the end
;       perform_get_expr_text(instr, tokens, settings, precedence, statement)   -> MUST write: text for EVERY HLIL operation
;   class MyType(LanguageRepresentationFunctionType):
;       language_name = "My Lang"
;       create(arch, owner, hlil)  -> return MyFunction(self, arch, owner, hlil)
;       function_type_tokens(func, settings) -> [DisassemblyTextLine(...)]   the prototype
;   MyType().register()

; --- HighLevelILTokenEmitter (tokens) – the most used methods
;   tokens.append(InstructionTextToken(type, text))   tokens.append_open_paren() / append_close_paren()
;   tokens.new_line()   tokens.increase_indent()   tokens.decrease_indent()
;   tokens.begin_scope(ScopeType.BlockScopeType)  ...  tokens.end_scope(ScopeType.BlockScopeType)
;   with tokens.expr(instr):  ...                     -> links the tokens to the HLIL expression (click / highlight)

; All examples run in the Binja GUI Python console.
; bv = the binary you have open (the console gives you this variable).

; --- Example 1: print the Pseudo C of a function
;
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     pc = f.pseudo_c
;     for line in pc.get_linear_lines(f.hlil.root):
;         print(line)


; --- Example 2: export Pseudo C of ALL functions to one file
;
;     with open("/tmp/decompiled.c", "w") as out:
;         for f in bv.functions:
;             pc = f.pseudo_c
;             if pc is None:
;                 continue
;             out.write(f"// {f.name} @ {f.start:#x}\n")
;             for line in pc.get_linear_lines(f.hlil.root):
;                 out.write(str(line) + "\n")
;             out.write("\n")


; --- Example 3: list the languages you have
;
;     from binaryninja.languagerepresentation import LanguageRepresentationFunctionType
;     for lt in LanguageRepresentationFunctionType:
;         print(lt.name)


; --- Example 4: same function in two languages
;
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     for name in ["Pseudo C", "Pseudo Rust"]:
;         lr = f.language_representation(name)
;         if lr is None:
;             print(name, "not available")
;             continue
;         print("=====", name)
;         for line in lr.get_linear_lines(f.hlil.root):
;             print(line)


; --- Example 5: a tiny language skeleton (each statement = its HLIL text, as comments)
; Only to learn the structure. A real language must handle every HLIL operation (see pseudo_python.py).
;
;     from binaryninja import (LanguageRepresentationFunction, LanguageRepresentationFunctionType,
;                              InstructionTextToken, InstructionTextTokenType, DisassemblyTextLine,
;                              HighLevelILOperation)
;
;     class CommentFunc(LanguageRepresentationFunction):
;         def perform_get_expr_text(self, instr, tokens, settings, precedence, statement=False):
;             with tokens.expr(instr):
;                 if instr.operation == HighLevelILOperation.HLIL_BLOCK:
;                     for stmt in instr.body:
;                         self.perform_get_expr_text(stmt, tokens, settings, precedence, True)
;                         tokens.new_line()
;                 else:
;                     tokens.append(InstructionTextToken(InstructionTextTokenType.CommentToken, "// " + str(instr)))
;
;     class CommentType(LanguageRepresentationFunctionType):
;         language_name = "Comment Lang"
;         def create(self, arch, owner, hlil):
;             return CommentFunc(self, arch, owner, hlil)
;         def function_type_tokens(self, func, settings):
;             t = [InstructionTextToken(InstructionTextTokenType.TextToken, f"// function {func.name}")]
;             return [DisassemblyTextLine(t, func.start)]
;
;     CommentType().register()
;     # In the GUI: choose "Comment Lang" in the language menu of the decompiler view.


; --- Notes
; - pseudo_c can be None if HLIL is not ready. pseudo_c_if_available does not wait.
; - get_linear_lines(f.hlil.root) gives the whole function. Each line is a DisassemblyTextLine: str(line) = text.
; - Your perform_get_expr_text is called a LOT. Keep it fast.
; - I did not run these examples.


## lineardisassembly module (LinearViewObject, LinearViewCursor, LinearDisassemblyLine)
; ------------------------------------------------------------------
; The Linear View in the GUI shows the WHOLE binary as one long list of lines:
; data, functions, comments, IL ... from the first address to the last.
; This module lets a script WALK that list, line by line, exactly like the GUI shows it.
;
; Why: export the whole listing to a text file, search in the rendered text, make a diff between versions.
;
;   LinearViewObject    WHAT to show: disassembly / LLIL / MLIL / HLIL / Pseudo C / data only,
;                       for the whole binary, or for one function only
;   LinearViewCursor    a position in that list. Move with next() / previous() / seek_to_address(addr)
;   LinearDisassemblyLine   one line: .type, .function, .block, .contents (DisassemblyTextLine). str(line) = text

LinearViewObject.disassembly(bv, settings)                 # whole binary as assembly                       @binja @api @linear  <file:/opt/binaryninja/python/binaryninja/lineardisassembly.py:303>
LinearViewObject.hlil(bv, settings)                        # whole binary as HLIL (also llil, mlil, mmlil ...)  @binja @api @linear
LinearViewObject.language_representation(bv, settings, "Pseudo C")   # whole binary as Pseudo C            @binja @api @linear
LinearViewObject.data_only(bv, settings)                   # only data (no code)                            @binja @api @linear
LinearViewObject.single_function_hlil(func, settings)      # ONE function (also single_function_disassembly ...) @binja @api @linear  <file:/opt/binaryninja/python/binaryninja/lineardisassembly.py:484>
LinearViewCursor(obj)                                      # cursor at the start                            @binja @api @linear  <file:/opt/binaryninja/python/binaryninja/lineardisassembly.py:512>
cursor.lines                                               # lines of the current object                    @binja @api @linear
cursor.next() / cursor.previous()                          # move. Returns False at the end                 @binja @api @linear
cursor.after_end / cursor.before_begin                     # True when you passed the end / the start       @binja @api @linear
cursor.seek_to_address(addr) / seek_to_begin() / seek_to_end()   # jump                                   @binja @api @linear
cursor.current_object                                      # the LinearViewObject at the cursor             @binja @api @linear
line.type                                                  # LinearDisassemblyLineType (CodeDisassemblyLineType, DataVariableLineType ...)  @binja @api @linear
line.function / line.block / line.contents                 # function, basic block, text line               @binja @api @linear

; All examples run in the Binja GUI Python console.
; bv = the binary you have open (the console gives you this variable).

; --- Example 1: export the WHOLE binary as HLIL text (like the GUI linear view)
;
;     from binaryninja.lineardisassembly import LinearViewObject, LinearViewCursor
;     from binaryninja.function import DisassemblySettings
;     obj = LinearViewObject.hlil(bv, DisassemblySettings())
;     cur = LinearViewCursor(obj)
;     with open("/tmp/all_hlil.txt", "w") as out:
;         while not cur.after_end:
;             for line in cur.lines:
;                 out.write(str(line) + "\n")
;             cur.next()


; --- Example 2: one function as assembly text, with addresses
;
;     from binaryninja.lineardisassembly import LinearViewObject, LinearViewCursor
;     from binaryninja.function import DisassemblySettings
;     from binaryninja.enums import DisassemblyOption
;     s = DisassemblySettings()
;     s.set_option(DisassemblyOption.ShowAddress, True)
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     cur = LinearViewCursor(LinearViewObject.single_function_disassembly(f, s))
;     while not cur.after_end:
;         for line in cur.lines:
;             print(line)
;         cur.next()


; --- Example 3: start at an address and print the next 40 lines
;
;     from binaryninja.lineardisassembly import LinearViewObject, LinearViewCursor
;     from binaryninja.function import DisassemblySettings
;     cur = LinearViewCursor(LinearViewObject.disassembly(bv, DisassemblySettings()))
;     cur.seek_to_address(bv.entry_point)
;     count = 0
;     while not cur.after_end and count < 40:
;         for line in cur.lines:
;             print(line.type.name, "|", line)
;             count += 1
;         cur.next()


; --- Example 4: search the rendered Pseudo C text of the whole binary
;
;     from binaryninja.lineardisassembly import LinearViewObject, LinearViewCursor
;     from binaryninja.function import DisassemblySettings
;     obj = LinearViewObject.language_representation(bv, DisassemblySettings(), "Pseudo C")
;     cur = LinearViewCursor(obj)
;     while not cur.after_end:
;         for line in cur.lines:
;             if "password" in str(line).lower():
;                 fn = line.function.name if line.function else "-"
;                 print(fn, "|", line)
;         cur.next()


; --- Notes
; - Walking the whole binary can be SLOW on big files (it renders everything). Use single_function_* when you can.
; - HLIL / Pseudo C lines need analysis to be finished.
; - I did not run these examples.


## lineformatter module (LineFormatter, LineFormatterSettings)
; ------------------------------------------------------------------
; A LineFormatter REFORMATS lines of HLIL / Pseudo C text after they are made.
; Example jobs: wrap long lines, align comments, change indentation.
; Binja has a default one. A language (see languagerepresentation module) can give its own
; with its "line_formatter" property.
;
; How to make one:
;   class MyFormatter(LineFormatter):
;       formatter_name = "my_formatter"
;       def format_lines(self, in_lines, settings):  -> return a NEW list of DisassemblyTextLine
;   MyFormatter().register()
;
; LineFormatterSettings has: hlil, desired_line_length, minimum_content_length, tab_width, language_name,
;                            comment_start_string ("//"), comment_end_string, annotation_start_string, annotation_end_string

LineFormatter                              # base class                                               @binja @api @lang  <file:/opt/binaryninja/python/binaryninja/lineformatter.py:139>
format_lines(in_lines, settings)           # your method: lines in -> lines out                       @binja @api @lang  <file:/opt/binaryninja/python/binaryninja/lineformatter.py:227>
list(LineFormatter) / LineFormatter[name]  # all formatters / one by name                             @binja @api @lang
LineFormatterSettings.default(None, func.hlil)   # default settings for a function                    @binja @api @lang  <file:/opt/binaryninja/python/binaryninja/lineformatter.py:38>

; --- Example 1: list formatters and use the default one by hand
; Runs in the GUI. bv = the binary you have open.
;
;     from binaryninja.lineformatter import LineFormatter, LineFormatterSettings
;     print([lf.name for lf in LineFormatter])
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     lines = f.pseudo_c.get_linear_lines(f.hlil.root)
;     settings = LineFormatterSettings.default(None, f.hlil)
;     settings.desired_line_length = 60                 # wrap earlier
;     fmt = list(LineFormatter)[0]
;     for line in fmt.format_lines(lines, settings):
;         print(line)


; --- Example 2: a formatter that removes empty lines
;
;     from binaryninja.lineformatter import LineFormatter
;     class NoEmptyLines(LineFormatter):
;         formatter_name = "no_empty_lines"
;         def format_lines(self, in_lines, settings):
;             return [l for l in in_lines if str(l).strip() != ""]
;     NoEmptyLines().register()
;     # To use it: return it from the line_formatter property of your LanguageRepresentationFunctionType.


; --- Notes
; - format_lines must return DisassemblyTextLine objects (keep the tokens, do not return plain strings).
; - I did not run these examples.


## log module (log_info, log_warn, log_error, Logger ...)
; ------------------------------------------------------------------
; Write messages to Binja's LOG window (View -> Log in the GUI), or to stdout / a file in scripts.
; Better than print() in plugins: messages have a LEVEL and a LOGGER NAME, so you can filter them,
; and print() output from a plugin can be hard to find.
;
; Levels (LogLevel enum, from low to high): DebugLog, InfoLog, WarningLog, ErrorLog, AlertLog
;   AlertLog also opens a pop-up in the GUI.
;
; GOOD NEWS: works WITHOUT a license. Outputs below are REAL.

log_info(text, logger="")                  # info message (logger = a name, like your plugin name)  @binja @api @log  <file:/opt/binaryninja/python/binaryninja/log.py:82>
log_debug / log_warn / log_error / log_alert   # other levels                                     @binja @api @log
log(level, text, logger)                   # any level                                             @binja @api @log  <file:/opt/binaryninja/python/binaryninja/log.py:42>
log_error_for_exception(text)              # message + the current exception's stack trace          @binja @api @log  <file:/opt/binaryninja/python/binaryninja/log.py:212>
log_*_with_traceback(text)                 # message + the current stack (no exception needed)     @binja @api @log
Logger(session_id, name)                   # a named logger object: lg.log_info(...)               @binja @api @log  <file:/opt/binaryninja/python/binaryninja/log.py:366>
bv.create_logger(name)                     # a logger tied to one open file (session)              @binja @api @log
log_to_stdout(LogLevel.X)                  # print log messages >= level to stdout (headless)      @binja @api @log  <file:/opt/binaryninja/python/binaryninja/log.py:318>
log_to_stderr(LogLevel.X)                  # same, to stderr                                       @binja @api @log
log_to_file(LogLevel.X, path, append=False)  # same, to a file                                     @binja @api @log  <file:/opt/binaryninja/python/binaryninja/log.py:345>
close_logs()                               # close log files                                       @binja @api @log
redirect_output_to_log()                   # send Python print() to Binja's log                    @binja @api @log

; --- Example 1: basic logging in a headless script  (REAL output)
;
;     from binaryninja.log import log_to_stdout, log_info, log_warn, log_debug
;     from binaryninja.enums import LogLevel
;     log_to_stdout(LogLevel.DebugLog)                # show everything from Debug up
;     log_info("hello info")
;     log_warn("a warning", "MyPlugin")
;     log_debug("debug msg")
;     # [0:136595211157632 Default  info] hello info
;     # [0:136595211157632 MyPlugin  warn] a warning
;     # [0:136595211157632 Default debug] debug msg
;     # format: [session:thread  logger  level] message


; --- Example 2: a named logger for your plugin  (REAL output)
;
;     from binaryninja.log import Logger, log_to_stdout
;     from binaryninja.enums import LogLevel
;     log_to_stdout(LogLevel.InfoLog)
;     lg = Logger(0, "MyLogger")                      # 0 = global session
;     lg.log_error("error from logger")
;     # [0:... MyLogger error] error from logger
;
; In the GUI, prefer: lg = bv.create_logger("MyPlugin")  -> messages are linked to that file's tab.


; --- Example 3: log an exception with its stack trace  (REAL output)
;
;     from binaryninja.log import log_error_for_exception, log_to_stdout
;     from binaryninja.enums import LogLevel
;     log_to_stdout(LogLevel.InfoLog)
;     try:
;         1 / 0
;     except Exception:
;         log_error_for_exception("division failed")
;     # [0:... Default error] division failed
;     # Traceback (most recent call last): ...
;     # ZeroDivisionError: division by zero


; --- Example 4: log to a file  (REAL output)
;
;     from binaryninja.log import log_to_file, log_info, close_logs
;     from binaryninja.enums import LogLevel
;     log_to_file(LogLevel.InfoLog, "/tmp/bnlog.txt", False)   # False = overwrite
;     log_info("to file too")
;     close_logs()
;     # /tmp/bnlog.txt contains:  [0:... Default  info] to file too


; --- Example 5: use the log in a plugin loop (GUI)
;
;     from binaryninja.log import Logger
;     # bv = the binary you have open (the console gives you this variable)
;     lg = bv.create_logger("FuncScanner")
;     for f in bv.functions:
;         if f.analysis_skipped:
;             lg.log_warn(f"skipped: {f.name} at {f.start:#x}")
;     lg.log_info("scan done")


; --- Notes
; - In the GUI, the log window can filter by level and by logger name. Always give your plugin a logger name.
; - log_to_stdout is needed in HEADLESS scripts; without it you may see nothing.
; - log_to_file only gets messages logged AFTER you call it.


## lowlevelil module (LLIL: LowLevelILFunction, LowLevelILInstruction, ...)
; ------------------------------------------------------------------
; LLIL = Low Level IL. The FIRST IL level: very close to the CPU instructions,
; but the same language for ALL CPUs (x86, ARM, MIPS ...).
;     asm:   mov eax, [ebp-0x4]
;     LLIL:  eax = [ebp - 4].d
; It still talks about REGISTERS, FLAGS and the STACK (push/pop). No variables, no types yet (that is MLIL).
;
; You use LLIL for:
;   1. Reading: register-level analysis that works for every CPU (one script, all architectures).
;   2. WRITING: when you make an Architecture plugin (a "lifter"), you turn each instruction into LLIL.
;      Binja then makes MLIL and HLIL from it automatically.
;
; There are 2 forms before LLIL:  func.lifted_il (raw, straight from the lifter, with all flags)
;                                 func.llil      (cleaned: flags resolved, dead code removed)
; Like HLIL, LLIL is a tree of instructions; same API style (operation, operands, traverse ...).

; --- LowLevelILFunction (lf = func.llil)
lf.instructions / lf[i] / len(list(lf.instructions))   # statements                                 @binja @api @llil  <file:/opt/binaryninja/python/binaryninja/lowlevelil.py:3512>
lf.basic_blocks                                        # LLIL basic blocks                          @binja @api @llil
lf.traverse(cb)                                        # every node                                 @binja @api @llil  <file:/opt/binaryninja/python/binaryninja/lowlevelil.py:3517>
lf.ssa_form                                            # SSA form: every register write gets a version (eax#1, eax#2)  @binja @api @llil
lf.regs / lf.flags                                     # registers / flags used                     @binja @api @llil
lf.get_instructions_at(addr)                           # LLIL indexes for an address                @binja @api @llil
lf.mlil / lf.mmlil                                     # next level                                 @binja @api @llil
func.get_llil_at(addr) / func.get_llils_at(addr)       # LLIL instruction(s) at an address          @binja @api @llil

; --- LowLevelILInstruction (i)
i.operation / i.address / i.size / i.instr_index       # basics                                     @binja @api @llil
i.operands / i.detailed_operands                       # children                                   @binja @api @llil
i.get_reg_value(reg) / i.get_reg_value_after(reg)      # value of a register here (dataflow)        @binja @api @dataflow  <file:/opt/binaryninja/python/binaryninja/lowlevelil.py:900>
i.get_possible_reg_values(reg)                         # all possible values (path-sensitive)       @binja @api @dataflow
i.get_flag_value(flag) / i.get_stack_contents(offset, size)   # flags / stack                       @binja @api @dataflow
i.value / i.possible_values                            # value of this expression                   @binja @api @dataflow
i.mlil / i.mlils / i.hlil / i.hlils                    # same code in higher levels                 @binja @api @llil
i.ssa_form                                             # SSA version                                @binja @api @llil
i.copy_to(dest_il)                                     # copy this expression into another IL       @binja @api @llil

; --- Classes you see most (and their fields)
;   LowLevelILSetReg     .dest (register) .src          eax = ...
;   LowLevelILReg        .src (register)                eax
;   LowLevelILLoad       .src (address)                 [addr].d
;   LowLevelILStore      .dest (address) .src           [addr].d = ...
;   LowLevelILPush       .src                           push(...)
;   LowLevelILPop                                       pop
;   LowLevelILCall       .dest                          call(...)
;   LowLevelILJump       .dest                          jump(...)
;   LowLevelILIf         .condition .true .false (instruction indexes)
;   LowLevelILGoto       .dest (instruction index)
;   LowLevelILRet        .dest
;   LowLevelILSyscall                                   syscall
;   LowLevelILIntrinsic  .output .intrinsic .params     special CPU instruction (cpuid, rdtsc ...)
;   LowLevelILConst / ConstPtr  .constant
;   LowLevelILAdd, Sub, Xor ... .left .right

; --- Building LLIL (in a lifter: Architecture.get_instruction_low_level_il(data, addr, il))
;   il.append(il.set_reg(4, "eax", il.const(4, 0)))                       # eax = 0
;   il.append(il.set_reg(4, "eax", il.add(4, il.reg(4, "eax"), il.const(4, 1))))   # eax = eax + 1
;   il.append(il.store(4, il.reg(4, "esp"), il.reg(4, "ebx")))           # [esp].d = ebx
;   il.append(il.push(4, il.reg(4, "ebp")))                               # push(ebp)
;   il.append(il.call(il.const_pointer(4, 0x401000)))                     # call(0x401000)
;   il.append(il.ret(il.pop(4)))                                          # return pop
;   il.append(il.unimplemented())                                         # "I can not lift this"
; Each builder returns an ExpressionIndex. Only il.append(...) adds a STATEMENT.

; All examples run in the Binja GUI Python console.
; bv = the binary you have open (the console gives you this variable).

; --- Example 1: print LLIL next to assembly
;
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     for i in f.llil.instructions:
;         print(f"{i.address:#x}  {bv.get_disassembly(i.address):35}  |  {i}")


; --- Example 2: every memory WRITE in a function (works for any CPU)
;
;     from binaryninja.lowlevelil import LowLevelILStore
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     for i in f.llil.instructions:
;         if isinstance(i, LowLevelILStore):
;             print(hex(i.address), "write", i.size, "bytes to", i.dest, "=", i.src)


; --- Example 3: value of a register before every call (dataflow, any CPU)
;
;     from binaryninja.lowlevelil import LowLevelILCall
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     reg = f.calling_convention.int_arg_regs[0]       # first argument register (rdi, x0, a0 ...)
;     for i in f.llil.instructions:
;         if isinstance(i, LowLevelILCall):
;             print(hex(i.address), i.dest, reg, "=", i.get_reg_value(reg))


; --- Example 4: find all syscalls and the syscall number
;
;     from binaryninja.lowlevelil import LowLevelILSyscall
;     num_reg = {"x86_64": "rax", "x86": "eax", "aarch64": "x8", "armv7": "r7"}.get(bv.arch.name, "rax")
;     for f in bv.functions:
;         for i in f.llil.instructions:
;             if isinstance(i, LowLevelILSyscall):
;                 print(f.name, hex(i.address), "syscall", i.get_reg_value(num_reg))


; --- Example 5: SSA form – who wrote this register value?
;
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     ssa = f.llil.ssa_form
;     for i in ssa.instructions:
;         print(i.instr_index, i)                        # registers have versions: rax#1, rax#2 ...


; --- Example 6: lifted IL vs LLIL (see what Binja cleaned)
;
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     print("lifted:", len(list(f.lifted_il.instructions)), "| llil:", len(list(f.llil.instructions)))
;     for i in list(f.lifted_il.instructions)[:15]:
;         print(" lifted", i)


; --- Notes
; - LLIL If/Goto use INSTRUCTION INDEXES as targets (.true / .false / .dest), not addresses.
; - "temp" registers (temp0, temp1 ...) are made by the lifter for complex instructions.
; - For a lifter: always append something for each instruction, or use il.unimplemented().
; - I did not run these examples.


## mainthread module (run code on the main thread or on worker threads)
; ------------------------------------------------------------------
; Binja has:
;   - ONE main thread: in the GUI it is the UI thread. It draws the windows.
;   - a POOL of worker threads: they do analysis and background jobs.
;
; Rules:
;   - Touch the GUI (Qt widgets, UIContext ...) ONLY on the main thread.
;   - Do LONG work on a worker, or the GUI freezes while your code runs.
;
; 3 worker queues, from high to low priority: interactive > priority > normal.
; A lower queue runs only when the higher queues are empty.
;
; REAL test (headless, no license): get_worker_thread_count() = 19 on this machine.
; In headless mode is_main_thread() returned True even inside a worker job (there is no UI thread).

execute_on_main_thread(func)               # run func on the main thread, do not wait                  @binja @api @threads  <file:/opt/binaryninja/python/binaryninja/mainthread.py:42>
execute_on_main_thread_and_wait(func)      # run func on the main thread and WAIT until it ends         @binja @api @threads  <file:/opt/binaryninja/python/binaryninja/mainthread.py:62>
worker_enqueue(func, name="")              # run func on a worker (normal priority)                     @binja @api @threads  <file:/opt/binaryninja/python/binaryninja/mainthread.py:79>
worker_priority_enqueue(func, name="")     # higher priority                                            @binja @api @threads
worker_interactive_enqueue(func, name="")  # highest priority (user is waiting)                         @binja @api @threads
get_worker_thread_count() / set_worker_thread_count(n)   # size of the worker pool                     @binja @api @threads
is_main_thread()                           # True if your code runs on the main thread                  @binja @api @threads

; --- Example 1: check threads  (REAL output, headless)
;
;     from binaryninja.mainthread import is_main_thread, get_worker_thread_count
;     print("main?", is_main_thread(), "workers:", get_worker_thread_count())
;     # main? True workers: 19


; --- Example 2: long work on a worker, then show the result on the main thread (GUI)
; bv = the binary you have open (the console gives you this variable).
;
;     from binaryninja.mainthread import worker_enqueue, execute_on_main_thread
;     from binaryninja.interaction import show_plain_text_report
;
;     def job():
;         lines = []
;         for f in bv.functions:                          # slow part: on the worker
;             lines.append(f"{f.name}: {len(list(f.hlil.instructions))} HLIL statements")
;         text = "\n".join(lines)
;         execute_on_main_thread(lambda: show_plain_text_report("HLIL sizes", text))   # GUI part: main thread
;
;     worker_enqueue(job, "count hlil")


; --- Example 3: wait for a main-thread result
;
;     from binaryninja.mainthread import execute_on_main_thread_and_wait
;     result = {}
;     def ask():
;         from binaryninja.interaction import get_int_input
;         result["n"] = get_int_input("How many?", "Question")
;     execute_on_main_thread_and_wait(ask)
;     print(result["n"])


; --- Notes
; - Do NOT call execute_on_main_thread_and_wait FROM the main thread for long jobs: the GUI freezes.
; - For long jobs with a progress text in the status bar, BackgroundTaskThread (plugin module) is better.
; - worker jobs are native threads; Python's GIL still applies, so pure-Python work is not faster in parallel.


## mediumlevelil module (MLIL: MediumLevelILFunction, MediumLevelILInstruction, ...)
; ------------------------------------------------------------------
; MLIL = Medium Level IL. The level BETWEEN LLIL and HLIL.
;   LLIL  talks about registers and the stack:   rax = [rbp - 8]
;   MLIL  talks about VARIABLES and has TYPES:    rax_1 = var_10
;         calls have real parameters:             rax_2 = strlen(var_10)
;   HLIL  adds if/while/for and removes dead code (looks like C)
;
; MLIL is the BEST level for DATA FLOW (where does this value come from? where does it go?):
; it has variables, it keeps every statement (HLIL may merge/remove some), and it has a strong SSA form.
; Many bug-finding scripts use MLIL SSA.
;
; Also: func.mmlil = "mapped MLIL": closer to LLIL, keeps memory stores that MLIL removes.

; --- MediumLevelILFunction (mf = func.mlil)
mf.instructions / mf[i] / mf.basic_blocks              # statements / blocks                          @binja @api @mlil  <file:/opt/binaryninja/python/binaryninja/mediumlevelil.py:3850>
mf.traverse(cb)                                        # every node                                   @binja @api @mlil
mf.vars / mf.aliased_vars                              # variables / variables whose address is taken @binja @api @mlil  <file:/opt/binaryninja/python/binaryninja/mediumlevelil.py:6889>
mf.get_var_definitions(var) / mf.get_var_uses(var)     # where written / read                         @binja @api @mlil  <file:/opt/binaryninja/python/binaryninja/mediumlevelil.py:6728>
mf.ssa_form                                            # SSA: each write = new version (var_10#1, #2) @binja @api @ssa
mf.get_ssa_var_definition(ssa_var)                     # THE one instruction that wrote this version   @binja @api @ssa  <file:/opt/binaryninja/python/binaryninja/mediumlevelil.py:6654>
mf.get_ssa_var_uses(ssa_var)                           # all instructions that read it                @binja @api @ssa
mf.get_ssa_var_value(ssa_var)                          # known value of it                            @binja @api @ssa
mf.is_var_live_at(var, instr)                          # is the variable still used later?            @binja @api @mlil
mf.llil / mf.hlil / mf.source_function                 # other levels / the Function                  @binja @api @mlil

; --- MediumLevelILInstruction (i)
i.operation / i.address / i.instr_index / i.operands / i.detailed_operands   # basics                @binja @api @mlil
i.vars_read / i.vars_written / i.vars_address_taken    # variables                                    @binja @api @mlil
i.value / i.possible_values                            # dataflow value                               @binja @api @dataflow
i.get_var_for_reg(reg)                                 # which MLIL variable holds this register here  @binja @api @mlil
i.get_reg_value(reg)                                   # value of a register here                     @binja @api @dataflow
i.branch_dependence                                    # which if-branches must be taken to reach here @binja @api @mlil  <file:/opt/binaryninja/python/binaryninja/mediumlevelil.py:713>
i.expr_type                                            # type                                         @binja @api @mlil
i.ssa_form / i.non_ssa_form                            # SSA <-> normal                               @binja @api @ssa
i.llil / i.hlil                                        # other levels                                 @binja @api @mlil

; --- Classes you see most (and their fields)
;   MediumLevelILSetVar       .dest (Variable) .src            x = ...
;   MediumLevelILSetVarField  .dest .offset .src               x.field = ...
;   MediumLevelILVar          .src (Variable)                  x
;   MediumLevelILLoad         .src                             [addr]
;   MediumLevelILStore        .dest .src                       [addr] = ...
;   MediumLevelILCall         .output (list of vars) .dest .params      a, b = f(x, y)
;   MediumLevelILTailcall     .output .dest .params
;   MediumLevelILSyscall      .output .params
;   MediumLevelILIf           .condition .true .false (instruction indexes)
;   MediumLevelILRet          .src (list)
;   MediumLevelILConst / ConstPtr  .constant  (ConstPtr has .string)
;   MediumLevelILAddressOf    .src (Variable)                  &x
;   SSA versions add _SSA:  MediumLevelILSetVarSsa (.dest is an SSAVariable: .var and .version), MediumLevelILVarPhi ...

; All examples run in the Binja GUI Python console.
; bv = the binary you have open (the console gives you this variable).

; --- Example 1: MLIL with variables
;
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     for i in f.mlil.instructions:
;         print(i.instr_index, hex(i.address), i, "| reads:", i.vars_read, "| writes:", i.vars_written)


; --- Example 2: all calls with their parameters (any CPU)
;
;     from binaryninja.mediumlevelil import MediumLevelILCall
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     for i in f.mlil.instructions:
;         if isinstance(i, MediumLevelILCall):
;             print(hex(i.address), i.dest, [str(p) for p in i.params], "->", i.output)


; --- Example 3: SSA – where did this parameter come from? (backward slice, 1 level)
; For every call to "system": is its argument a constant, or does it come from somewhere else?
;
;     from binaryninja.mediumlevelil import MediumLevelILCallSsa, MediumLevelILVarSsa
;     for target in bv.get_functions_by_name("system"):
;         for caller in target.callers:
;             ssa = caller.mlil.ssa_form
;             for i in ssa.instructions:
;                 if isinstance(i, MediumLevelILCallSsa) and getattr(i.dest, "constant", None) == target.start:
;                     arg = i.params[0]
;                     if isinstance(arg, MediumLevelILVarSsa):
;                         d = ssa.get_ssa_var_definition(arg.src)
;                         print(caller.name, hex(i.address), "arg from:", d)
;                     else:
;                         print(caller.name, hex(i.address), "arg:", arg)


; --- Example 4: follow a value FORWARD (all uses of a variable)
;
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     ssa = f.mlil.ssa_form
;     first_param = f.parameter_vars[0]                # first parameter
;     from binaryninja.mediumlevelil import SSAVariable
;     sv = SSAVariable(first_param, 0)                 # version 0 = the value at function entry
;     for use in ssa.get_ssa_var_uses(sv):
;         print(hex(use.address), use)


; --- Example 5: which conditions must be true to reach an instruction?
;
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     inst = list(f.mlil.instructions)[-1]             # for example the last statement
;     for idx, dep in inst.branch_dependence.items():
;         print("needs", f.mlil[idx], "->", dep.name)  # TrueBranchDependent / FalseBranchDependent


; --- Example 6: variables whose address is taken (often buffers passed to other functions)
;
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     for v in f.mlil.aliased_vars:
;         print(v, v.type)


; --- Notes
; - Use MLIL SSA for data flow. Each SSA variable has ONE definition: easy to walk backward.
; - .output of a call is a list (a call can return in 2 registers).
; - Phi nodes (MediumLevelILVarPhi) appear where paths join: x#3 = phi(x#1, x#2).
; - I did not run these examples.


## metadata module (Metadata + store_metadata / query_metadata)
; ------------------------------------------------------------------
; Metadata = YOUR OWN DATA saved inside the .bndb, next to the analysis.
; Example: your plugin's results, a list of "checked" functions, a config, notes, a decryption key.
; Save it with bv.store_metadata(key, value); read it with bv.query_metadata(key).
; Functions have the same API: func.store_metadata(...) -> data saved on ONE function.
;
; Allowed value types: int, bool, str, bytes, float, list, tuple, dict (and Metadata). Nested is OK.
; NOT allowed: any other Python object (ValueError).
;
; Store flags (MetadataStoreFlag):
;   MetadataStorePersistent            saved in the .bndb (else: only in memory, lost on close)
;   MetadataStoreMarksAnalysisChanged  marks the file as "modified"
;   default = Persistent | MarksAnalysisChanged
;   MetadataStoreEphemeral (0)         memory only, does not mark the file modified (good for caches)
;
; GOOD NEWS: the Metadata class works WITHOUT a license. Outputs below are REAL.

bv.store_metadata(key, value, flags=...)   # save                                                     @binja @api @metadata  <file:/opt/binaryninja/python/binaryninja/binaryview.py:10892>
bv.query_metadata(key)                     # read. Raises KeyError if missing                         @binja @api @metadata  <file:/opt/binaryninja/python/binaryninja/binaryview.py:10841>
bv.get_metadata(key, default=None)         # read like dict.get (no error)                            @binja @api @metadata  <file:/opt/binaryninja/python/binaryninja/binaryview.py:10864>
bv.remove_metadata(key)                    # delete                                                   @binja @api @metadata
bv.metadata                                # dict of ALL keys (also keys from Binja / other plugins)  @binja @api @metadata
func.store_metadata / query_metadata / get_metadata / remove_metadata / metadata   # same, per function  @binja @api @metadata
Metadata(value)                            # wrap a Python value                                      @binja @api @metadata  <file:/opt/binaryninja/python/binaryninja/metadata.py:31>
md.value / md.type / md.is_dict ...        # back to Python / its type                                @binja @api @metadata
md.get_json_string()                       # as JSON text                                             @binja @api @metadata

; --- Example 1: the Metadata class  (REAL output, no license)
;
;     from binaryninja.metadata import Metadata
;     m = Metadata({"a": 1, "b": [1, 2, "x"], "c": b"\x00\x01", "d": 1.5, "e": True})
;     print(m.is_dict, m["b"], m.get("zzz", "default"))   # True [1, 2, 'x'] default
;     print(m.value)        # {'a': 1, 'b': [1, 2, 'x'], 'c': b'\x00\x01', 'd': 1.5, 'e': True}
;     print(m.get_json_string())
;     # {"a": 1, "b": [1, 2, "x"], "c": "AAE=\n", "d": 1.500000, "e": true}   <- bytes become base64 (with a \n!)
;     arr = Metadata([1, 2]); arr.append(3); print(arr.value)          # [1, 2, 3]
;     print(Metadata(-5, signed=True).value)                           # -5
;     Metadata(object())    # ValueError: ... is not a supported type: int, bool, str, bytes, float, list, tuple, dict, or Metadata


; --- Example 2: save and load your plugin's results (GUI)
; bv = the binary you have open (the console gives you this variable).
;
;     results = {"checked": [], "notes": {}}
;     for f in bv.functions:
;         if len(f.callers) == 0:
;             results["checked"].append(f.start)
;     results["notes"]["main"] = "starts the server"
;     bv.store_metadata("myplugin.results", results)
;     # ... later (even after closing and reopening the .bndb):
;     data = bv.get_metadata("myplugin.results", {})
;     print(len(data.get("checked", [])), data.get("notes"))


; --- Example 3: data on ONE function
;
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     f.store_metadata("reviewed", True)
;     f.store_metadata("score", 7)
;     print(f.get_metadata("reviewed"), f.get_metadata("score"))
;     reviewed = [x.name for x in bv.functions if x.get_metadata("reviewed")]
;     print("reviewed functions:", reviewed)


; --- Example 4: a cache that is NOT saved and does not mark the file modified
;
;     from binaryninja.enums import MetadataStoreFlag
;     bv.store_metadata("myplugin.cache", {"tmp": 1}, MetadataStoreFlag.MetadataStoreEphemeral)


; --- Example 5: see what other plugins (and Binja) stored
;
;     for key in bv.metadata:
;         print(key)


; --- Notes
; - Use a PREFIX in your keys ("myplugin.xxx"), so you do not overwrite other plugins.
; - query_metadata raises KeyError; get_metadata returns a default. Prefer get_metadata.
; - Dict KEYS must be str.
; - Big data (MBs) makes the .bndb big and slow. Store only what you need.
; - session_data (filemetadata module) is the in-memory alternative for Python objects.


## platform module (Platform)
; ------------------------------------------------------------------
; Platform = OPERATING SYSTEM + CPU. Examples: "linux-x86_64", "windows-x86", "mac-aarch64", "efi-x86_64".
; (Architecture = only the CPU. Platform = CPU + OS rules.)
;
; A platform knows:
;   - the calling conventions (default, cdecl, stdcall, fastcall, syscall convention)
;   - the system calls: number -> name + type   (Linux: 59 -> execve)
;   - the OS types and functions it knows (from type libraries / headers)
;   - how to parse C type declarations for this OS + CPU
;
; Get it:  bv.platform      func.platform      Platform["linux-x86_64"]      list(Platform)

list(Platform)                             # all platforms                                             @binja @api @platform  <file:/opt/binaryninja/python/binaryninja/platform.py:77>
Platform["linux-x86_64"]                   # one platform by name                                     @binja @api @platform
Platform.os_list                           # all OS names: linux, windows, mac ...                    @binja @api @platform
Platform.get_list(os, arch)                # platforms for an OS (and CPU)                            @binja @api @platform
p.name / p.arch / p.address_size           # basics                                                   @binja @api @platform
p.default_calling_convention               # see callingconvention module                             @binja @api @platform
p.system_call_convention                   # calling convention of syscalls                           @binja @api @platform  <file:/opt/binaryninja/python/binaryninja/platform.py:462>
p.system_calls                             # dict: number -> (name, type)                             @binja @api @platform  <file:/opt/binaryninja/python/binaryninja/platform.py:547>
p.get_system_call_name(n) / get_system_call_type(n)   # one syscall                                 @binja @api @platform
p.types / p.functions / p.variables        # known types / function prototypes / globals              @binja @api @platform
p.get_type_by_name(n) / get_function_by_name(n)       # one known type / prototype                    @binja @api @platform
p.type_libraries                           # type libraries for this platform (see typelibrary)       @binja @api @platform
p.parse_types_from_source(src)             # parse C declarations -> types, variables, functions     @binja @api @platform  <file:/opt/binaryninja/python/binaryninja/platform.py:678>
p.parse_types_from_source_file(path)       # same, from a .h file                                     @binja @api @platform
p.get_related_platform(arch)               # e.g. linux-armv7 <-> linux-thumb2                        @binja @api @platform

; All examples need a license (GUI console or headless with license).

; --- Example 1: list platforms for one OS
;
;     from binaryninja import Platform
;     print(Platform.os_list)
;     for p in Platform.get_list("linux"):
;         print(p.name, p.arch.name, p.address_size)


; --- Example 2: what is the platform of my binary?
; bv = the binary you have open (the console gives you this variable).
;
;     p = bv.platform
;     print(p.name, "| default cc:", p.default_calling_convention, "| syscall cc:", p.system_call_convention)


; --- Example 3: syscall number -> name (great for shellcode)
;
;     from binaryninja import Platform
;     p = Platform["linux-x86_64"]
;     for n in [0, 1, 2, 59, 60]:
;         print(n, p.get_system_call_name(n), p.get_system_call_type(n))
;     # expected: 0 read, 1 write, 2 open, 59 execve, 60 exit


; --- Example 4: find syscalls in the binary and name them
;
;     from binaryninja.lowlevelil import LowLevelILSyscall
;     p = bv.platform
;     reg = p.system_call_convention.int_arg_regs[0] if p.system_call_convention else "rax"
;     for f in bv.functions:
;         for i in f.llil.instructions:
;             if isinstance(i, LowLevelILSyscall):
;                 v = i.get_reg_value("rax")             # x86_64 Linux: number is in rax
;                 if hasattr(v, "value"):
;                     print(f.name, hex(i.address), v.value, p.get_system_call_name(v.value))


; --- Example 5: parse C declarations for this platform
;
;     from binaryninja import Platform
;     p = Platform["linux-x86_64"]
;     r = p.parse_types_from_source("struct pkt { int len; char data[64]; };\nint send_pkt(struct pkt* p);\n")
;     print(r.types)        # {'pkt': <type: struct pkt>}
;     print(r.functions)    # {'send_pkt': <type: int32_t(struct pkt* p)>}
;     # then: bv.define_user_type("pkt", r.types["pkt"])


; --- Example 6: look up a known function prototype
;
;     p = bv.platform
;     print(p.get_function_by_name("memcpy"))
;     print(len(p.types), "types,", len(p.functions), "functions known")


; --- Notes
; - Shellcode / raw files have NO platform. Set one: bv.platform = Platform["linux-x86_64"] (then functions get calling conventions).
; - parse_types_from_source can not use types from your bv. For that use bv.parse_type_string (see typeparser module).
; - The platform list depends on your Binja version and plugins.
; - I did not run these examples.


## plugin module (PluginCommand, BackgroundTaskThread, BackgroundTask, PluginCommandContext)
; ------------------------------------------------------------------
; This is how you make your script a REAL PLUGIN: a menu item in Binja (Plugins menu + right-click menu
; + command palette Ctrl+P). And how you run long jobs with a progress text in the status bar.
;
; Where to put the file: your Binja plugins folder (GUI: Plugins -> Open Plugin Folder).
; A plugin = a .py file or a folder with __init__.py. It runs when Binja starts.
;
; Register functions — choose by WHAT your action needs:
;   register(name, desc, action(bv))                                  whole binary
;   register_for_address(name, desc, action(bv, addr))                one address (cursor)
;   register_for_range(name, desc, action(bv, addr, length))          a selection
;   register_for_function(name, desc, action(bv, func))               current function
;   register_for_high_level_il_instruction(name, desc, action(bv, inst))  HLIL line under cursor
;   (also: _low_level_il_function / _instruction, _medium_level_il_function / _instruction, _high_level_il_function)
;   register_global(name, desc, action())                             no binary needed
;   register_for_project(name, desc, action(project))                 a project
; Optional last argument: is_valid(...) -> True/False   (same arguments; False = menu item is grey)
;
; Name with "\\" makes a sub-menu:  "My Tools\\Find crypto"

PluginCommand.register(name, desc, action, is_valid=None)       # menu item for the whole binary        @binja @api @plugin  <file:/opt/binaryninja/python/binaryninja/plugin.py:463>
PluginCommand.register_for_address(...)                         # menu item with address                @binja @api @plugin  <file:/opt/binaryninja/python/binaryninja/plugin.py:499>
PluginCommand.register_for_function(...)                        # menu item with function               @binja @api @plugin  <file:/opt/binaryninja/python/binaryninja/plugin.py:571>
PluginCommand.register_for_range(...)                           # menu item with selection              @binja @api @plugin
PluginCommand.register_for_high_level_il_instruction(...)       # menu item with HLIL instruction       @binja @api @plugin
PluginCommand.get_valid_list(PluginCommandContext(bv))          # dict name -> command you can run now  @binja @api @plugin  <file:/opt/binaryninja/python/binaryninja/plugin.py:875>
cmd.execute(ctx)                                                # run another plugin from a script      @binja @api @plugin
BackgroundTaskThread(text, can_cancel)                          # long job in a thread + status bar text @binja @api @plugin  <file:/opt/binaryninja/python/binaryninja/plugin.py:1184>
task.progress = "text"                                          # update the status bar                 @binja @api @plugin
task.cancelled                                                  # True if the user pressed cancel       @binja @api @plugin
task.start() / task.join()                                      # start / wait                          @binja @api @plugin

; --- Example 1: a simple plugin (save as ~/.binaryninja/plugins/count_funcs.py)
;
;     from binaryninja import PluginCommand
;     from binaryninja.interaction import show_message_box
;
;     def count(bv):
;         show_message_box("Count", f"{len(bv.functions)} functions")
;
;     PluginCommand.register("My Tools\\Count functions", "Show how many functions", count)


; --- Example 2: action on the current function
;
;     from binaryninja import PluginCommand
;     from binaryninja.log import log_info
;
;     def callers_of(bv, func):
;         for c in func.callers:
;             log_info(f"{func.name} is called by {c.name}", "MyTools")
;
;     PluginCommand.register_for_function("My Tools\\List callers", "Log the callers", callers_of)


; --- Example 3: action on an address, only valid inside a function
;
;     from binaryninja import PluginCommand
;
;     def comment_here(bv, addr):
;         for f in bv.get_functions_containing(addr):
;             f.set_comment_at(addr, "checked")
;
;     def valid(bv, addr):
;         return len(bv.get_functions_containing(addr)) > 0
;
;     PluginCommand.register_for_address("My Tools\\Mark checked", "Comment 'checked'", comment_here, valid)


; --- Example 4: a long job that does not freeze the GUI, and can be cancelled
;
;     from binaryninja import PluginCommand
;     from binaryninja.plugin import BackgroundTaskThread
;     from binaryninja.log import log_info
;
;     class ScanTask(BackgroundTaskThread):
;         def __init__(self, bv):
;             super().__init__("Scanning...", can_cancel=True)
;             self.bv = bv
;         def run(self):
;             funcs = list(self.bv.functions)
;             for n, f in enumerate(funcs):
;                 if self.cancelled:
;                     log_info("scan cancelled", "MyTools")
;                     return
;                 self.progress = f"Scanning {n+1}/{len(funcs)}: {f.name}"
;                 _ = f.hlil                                # slow part
;             log_info("scan done", "MyTools")
;
;     def start_scan(bv):
;         ScanTask(bv).start()
;
;     PluginCommand.register("My Tools\\Scan all", "Scan every function", start_scan)


; --- Example 5: run ANOTHER plugin from a headless script
;
;     import binaryninja
;     from binaryninja.plugin import PluginCommand, PluginCommandContext
;     with binaryninja.load("/bin/ls") as bv:
;         ctx = PluginCommandContext(bv)
;         cmds = PluginCommand.get_valid_list(ctx)
;         print(list(cmds)[:20])                        # names you can run
;         # cmds["BinExport"].execute(ctx)              # docs example


; --- Notes
; - Exceptions in your action are caught and logged (look at the Log window).
; - Do NOT do long work directly in the action: use BackgroundTaskThread (Example 4).
; - GUI work from a BackgroundTaskThread must go through execute_on_main_thread (mainthread module).
; - I did not run these examples.


