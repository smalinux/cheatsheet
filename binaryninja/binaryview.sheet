bv.is_offset_readable(ADDR)          # check whether ADDR is readable  @permission @r  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.is_offset_readable>
bv.is_offset_writable(ADDR)          # check whether ADDR is writable  @permission @w  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.is_offset_writable>
bv.is_offset_executable(ADDR)        # check whether ADDR is executable  @permission @x @code  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.is_offset_executable>
bv.is_offset_backed_by_file(ADDR)    # check whether ADDR has file bytes (not .bss)  @zero  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.is_offset_backed_by_file>
bv.is_offset_code_semantics(ADDR)    # check whether ADDR is in a code section  @text  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.is_offset_code_semantics>
bv.is_offset_extern_semantics(ADDR)  # check whether ADDR is in an extern section  @import  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.is_offset_extern_semantics>
bv.is_offset_readonly_semantics(ADDR)  # check whether ADDR is in a read-only data section  @rodata @const  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.is_offset_readonly_semantics>
bv.get_next_valid_offset(ADDR)       # get the next mapped address at or after ADDR  @skip @gap  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_next_valid_offset>
bv.mapped_address_ranges             # list mapped address ranges  @memory  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.mapped_address_ranges>
bv.backed_address_ranges             # list address ranges backed by file data  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.backed_address_ranges>

