bv.get_callees(ADDR)                 # list addresses called by the call at ADDR  @xrefs @calls  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_callees>
bv.get_code_refs_for_type("struct_name")  # iterate code that uses a type  @xrefs  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_code_refs_for_type>
bv.get_code_refs_for_type_field("struct_name", OFFSET)  # iterate code that touches one struct field  @xrefs @member  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_code_refs_for_type_field>
bv.get_data_refs_for_type("struct_name")  # list data addresses typed with a type  @xrefs  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_data_refs_for_type>
bv.get_type_refs_for_type("struct_name")  # list other types that use a type  @xrefs  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_type_refs_for_type>
bv.add_user_data_ref(FROM, TO)       # add a manual data xref  @xrefs  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.add_user_data_ref>
