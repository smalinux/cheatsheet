title: nvim
url:   https://www.lazyvim.org/keymaps
tags:  neovim vim lazyvim editor keymaps keybindings shortcuts config

; My Neovim setup: LazyVim + my own plugins, leader key is `,`.
; Config:   ~/dotfiles/packages/nvim/.config/nvim  (stowed to ~/.config/nvim)
; Defaults: ~/.local/share/nvim/lazy/LazyVim/lua/lazyvim/
; Press `,` and wait: which-key shows every leader key. `,sk` searches all keymaps.

; ===============  basics
## basics
; The few things that make this setup different from plain LazyVim.
,                           # leader key (also localleader)  @mapleader
<leader>?                   # show keymaps of this buffer (which-key)  @help
<leader>sk                  # search every keymap by name  @find @keys
:ReloadConfig               # reload my config/ and plugins/ lua modules without restart  @source @refresh
:F                          # print the full real path of the current file  @realpath @filename @where
<F12>                       # delete (close) the current buffer  @bd @close
p                           # (visual) paste over selection without yanking the replaced text  @register
<leader>l                   # open the Lazy plugin manager  @plugins
<leader>qq                  # quit all  @exit
<C-s>                       # save file (normal, insert, visual)  @write

## basics-behavior
; Things that happen on their own. Good to know, so they do not surprise you.
nvim                        # with no args: restores the last session of this dir  @persistence @session @restore
cwd follows the buffer      # on BufEnter nvim cds to the project root of the file  @chdir @root
explorer follows the buffer # the open snacks explorer re-roots to the current file's project  @tree
shada                       # remembers the last 1000 files for <leader>fr  @oldfiles @recent @history
undofile                    # undo history survives restarts, kept in ~/.vim/undodir  @persistent-undo
no swap, no backup          # swapfile, backup and writebackup are off  @swp
vim.g.autoformat = false    # no format on save (except C files with a clang-format-style line)  @formatting
mouse = n                   # mouse works only in normal mode
listchars                   # tabs →, spaces ·, eol ↲ are always visible  @whitespace @invisible
colorcolumn = 80            # line at column 80, textwidth 80, gq wraps at 80  @wrap
tabstop=4 shiftwidth=4      # real tabs (noexpandtab), cindent on  @indent
spell                       # only on in git commit messages; toggle with <leader>us  @spelling
<leader>uC                  # pick a colorscheme with preview (default: gruvbox)  @theme

; ===============  files
## files-find
; Find and open files. Telescope is the picker; <leader>ff uses fzf for speed.
<leader><space>             # find files in the project root  @open @search
<leader>fF                  # find files in cwd
<leader>ff                  # find files under / with fzf (whole disk, fast)  @everything @fd
<leader>fg                  # find git files
<leader>fr                  # recent files (last 1000)  @oldfiles @history
<leader>fR                  # recent files in cwd
<leader>fc                  # find a file in the nvim config  @dotfiles
<leader>fn                  # new empty file
<leader>e                   # file explorer at project root (snacks)  @tree @sidebar
<leader>E                   # file explorer at cwd
gx                          # open path or URL under cursor with the system app  @browser @link

## files-search-text
; Grep and search inside files. Note: sg / sG are swapped vs LazyVim.
<leader>/                   # grep in project root  @rg @ripgrep
<leader>sg                  # grep in cwd  @rg @ripgrep
<leader>sG                  # grep in project root  @rg @ripgrep
<leader>sw                  # grep word under cursor (or selection) in root  @find-usages
<leader>sW                  # grep word under cursor (or selection) in cwd
<leader>sb                  # search lines of this buffer  @fuzzy
<leader>sr                  # search and replace across files (grug-far)  @replace @refactor @sed
<leader>sR                  # resume the last picker  @reopen
<leader>s"                  # show registers  @clipboard @paste
<leader>sc                  # command history  @:history
<leader>:                   # command history
<leader>s/                  # search history
<leader>sh                  # search help pages  @docs
<leader>sM                  # search man pages
<leader>sm                  # jump to a mark
<leader>sj                  # jumplist
<leader>so                  # search options
<leader>sH                  # search highlight groups  @colors
<leader>sa                  # search autocommands
<leader>sC                  # search commands

; ===============  buffers
## buffers
H                           # previous buffer  @tab @bufferline
L                           # next buffer
[b                          # previous buffer
]b                          # next buffer
[B                          # move buffer left in the bufferline
]B                          # move buffer right in the bufferline
<leader>,                   # switch buffer (picker)
<leader>fb                  # list buffers
<leader>bb                  # switch to the other (alternate) buffer  @#
<leader>bd                  # delete buffer  @close
<leader>bo                  # delete all other buffers  @close-others
<leader>bD                  # delete buffer and its window
<leader>bp                  # pin / unpin buffer
<leader>bP                  # delete all non-pinned buffers
<leader>bl                  # delete buffers to the left
<leader>br                  # delete buffers to the right

## windows
; <C-h/j/k/l> are vim-tmux-navigator: they also jump into tmux panes.
<C-h>                       # go to left window or tmux pane  @split @navigate
<C-j>                       # go to lower window or tmux pane
<C-k>                       # go to upper window or tmux pane
<C-l>                       # go to right window or tmux pane
<C-\>                       # go to previous window or tmux pane
<leader>-                   # split window below  @horizontal
<leader>|                   # split window right  @vertical
<leader>wd                  # close window  @delete
<leader>wm                  # zoom (maximize) window toggle  @fullscreen
<C-Up>                      # taller window  @resize
<C-Down>                    # shorter window  @resize
<C-Left>                    # narrower window  @resize
<C-Right>                   # wider window  @resize
<C-w><space>                # window hydra mode: keep pressing window keys (which-key)

## tabs
<leader><tab><tab>          # new tab
<leader><tab>]              # next tab
<leader><tab>[              # previous tab
<leader><tab>d              # close tab
<leader><tab>o              # close other tabs
<leader><tab>f              # first tab
<leader><tab>l              # last tab

## harpoon
; Harpoon = a short list of files you jump between all day.
<leader>a                   # add this file to the harpoon list  @bookmark @mark
<C-e>                       # harpoon picker; previous file is pre-selected, <CR> jumps back  @list
<C-d>                       # (in harpoon picker, insert) remove the selected mark  @delete
<leader>h1                  # jump to harpoon file 1 (h1 .. h9)  @slot

## sessions
; persistence.nvim saves a session per start dir. `nvim` with no args restores it.
<leader>qs                  # restore the session of this dir  @load
<leader>qS                  # pick a session to restore
<leader>ql                  # restore the last session
<leader>qd                  # do not save the current session on exit  @stop
~/.local/state/nvim/sessions # where session files live

; ===============  scratch
## scratch (draft files)
; A scratch buffer is a draft file per filetype. It saves on its own.
<leader>.                   # toggle the scratch buffer for this filetype (auto-saved)  @draft @notes
<leader>S                   # list saved scratch buffers  @draft @select
<C-x>                       # (in <leader>S list) delete the selected scratch file  @remove @draft
<C-n>                       # (in <leader>S list) new scratch buffer
R                           # (in a scratch window) reset (clear) the buffer
~/.local/share/nvim/scratch/ # where scratch files live  @draft
:lua Snacks.scratch({ win = { width = 0, height = 0 } })  # open scratch full screen  @fullpage @maximize

; ===============  editing
## editing-move-and-jump
s                           # flash: type 2 chars, jump anywhere on screen  @motion @leap
S                           # flash treesitter: select a code node  @select
r                           # (operator) remote flash, e.g. yr to yank far text
R                           # (operator/visual) treesitter search
<A-j>                       # move line or selection down  @swap
<A-k>                       # move line or selection up
[<space>                    # add empty line above
]<space>                    # add empty line below

## editing-comments
; Comments come from built-in gc + ts-comments.nvim. Comment.nvim is NOT installed (no gb).
gcc                         # toggle comment on this line  @comment @uncomment
gc                          # toggle comment on motion or selection, e.g. gcap, gc2j  @comment
gco                         # add a comment below  @comment
gcO                         # add a comment above  @comment
]t                          # next TODO / FIXME / SMA comment  @todo
[t                          # previous TODO comment
<leader>st                  # search all TODO comments  @todo
<leader>xt                  # TODO comments in Trouble  @todo

## editing-text-objects
; mini.ai text objects. Use with d, c, y, v: e.g. daf, cia, vif.
af                          # around function (if = inside)  @textobject
ac                          # around class (ic = inside)  @textobject
aa                          # around argument (ia = inside)  @textobject @parameter
ao                          # around block / loop / if (io = inside)  @textobject
at                          # around HTML tag (it = inside)  @textobject
ag                          # whole buffer  @textobject @all
ih                          # inside git hunk, e.g. dih, yih, vih  @textobject @git
<C-space>                   # treesitter: start / grow selection  @incremental
an                          # (visual) select parent node
in                          # (visual) select child node

## editing-misc
:Tabularize /=              # align lines on a char (tabular plugin)  @align @columns
gq                          # wrap text at 80 columns (built-in, not LSP)  @format @wrap
:lua MiniTrailspace.trim()  # remove trailing spaces (no auto trim on save)  @whitespace
<leader>u                   # (which-key) all UI toggles: wrap, spell, numbers...  @toggle

## completion
; blink.cmp completion. Enter accepts.
<CR>                        # accept completion  @blink
<Tab>                       # next item / jump to next snippet field
<S-Tab>                     # previous item / previous snippet field
<C-space>                   # (insert) open completion menu
<C-e>                       # (insert) close completion menu
<C-k>                       # (insert) signature help

; ===============  code
## lsp
; LSP gives go to definition, rename, references... clangd for C.
gd                          # go to definition  @jump
gr                          # list references  @usages
gI                          # go to implementation
gy                          # go to type definition
gD                          # go to declaration (C/C++)
K                           # hover docs  @documentation
gK                          # signature help
<leader>ca                  # code action  @fix @quickfix
<leader>cA                  # source action
<leader>cr                  # rename symbol in the whole project  @refactor
<leader>cR                  # rename file
<leader>ch                  # switch C source / header (.c <-> .h)  @clangd
<leader>cl                  # LSP info  @lspinfo
<leader>cs                  # symbols outline (aerial)
<leader>cS                  # LSP references / definitions in Trouble
<leader>ss                  # go to symbol (aerial)
<leader>sS                  # go to symbol in workspace
:LspRestart                 # restart the language server
:LspLog                     # open the LSP log

## outline
<F8>                        # toggle code outline sidebar (aerial)  @symbols @tagbar

## format
; Formatting is manual. C/C++/DTS files auto-format on save ONLY with a style line.
<leader>cf                  # format buffer or selection (conform)  @clang-format
<leader>cF                  # format injected languages
// clang-format-style: kernel # put in first 10 lines: links ~/.clang-format to that style and formats on save  @auto
clang-format styles         # kernel: linux, barebox, chromium, google, llvm (in nvim/clang-format-styles/)  @style
<leader>uf                  # toggle LazyVim autoformat

## diagnostics
]d                          # next diagnostic  @error @warning
[d                          # previous diagnostic
]e                          # next error
[e                          # previous error
]w                          # next warning
[w                          # previous warning
<leader>cd                  # show diagnostics of this line  @float
<leader>xx                  # all diagnostics in Trouble  @problems
<leader>xX                  # buffer diagnostics in Trouble
<leader>sd                  # search diagnostics
<leader>sD                  # search buffer diagnostics
<leader>ud                  # toggle diagnostics  @hide

## quickfix
; nvim-bqf makes the quickfix list better: preview and fzf filter.
]q                          # next quickfix / Trouble item
[q                          # previous quickfix / Trouble item
<leader>xq                  # quickfix list in Trouble
<leader>xl                  # location list in Trouble
<leader>sq                  # search the quickfix list
zf                          # (in quickfix) filter the list with fzf  @bqf
z,                          # (in quickfix) toggle preview mode  @bqf

## debug
; nvim-dap with gdb (--interpreter=dap) for C/C++, debugpy for Python.
<leader>db                  # toggle breakpoint  @dap @gdb
<leader>dc                  # start / continue  @run
<leader>di                  # step into
<leader>do                  # step over  @next
<leader>dO                  # step out  @finish
<leader>dr                  # open debug REPL
<leader>du                  # toggle debug UI  @dapui

; ===============  git
## git
; gitsigns + diff-so-fancy. Note: <F9> calls :Git blame, but vim-fugitive is not installed.
]h                          # next hunk  @change @diff
[h                          # previous hunk
]H                          # last hunk
[H                          # first hunk
<leader>gp                  # preview hunk in a popup  @diff
<leader>gb                  # blame this line (full commit)  @who
<leader>gd                  # diff this file vs index
<leader>gD                  # diff this file vs HEAD~
<leader>gt                  # toggle showing deleted lines
<leader>gx                  # toggle inline diff in all buffers (diff-so-fancy)  @word-diff
:FancyDiff --staged         # any git diff in a float, e.g. :FancyDiff HEAD~3  @diff
<leader>gs                  # git status picker
<leader>gc                  # git commits picker  @log
<leader>gS                  # git stash picker
<leader>uG                  # toggle git signs

; ===============  ai
## ai-claude-popup
; Select text, ask Claude, read the answer in a popup. Runs `claude -p`.
<C-S-l>                     # (visual) ask Claude about the selection (under tmux: <C-l>)  @claude @ask
:ClaudeAISettings           # Claude popup settings: model, effort, args (also normal <C-S-l>)  @model
q                           # (in popup) close
r                           # (in popup) ask again
s                           # (in popup) change settings, then ask again
<CR>                        # (in popup) open the link on this line  @gx

## ai-google
<C-S-k>                     # (visual) Google AI overview of the selection (under tmux: <C-k>)  @search
o                           # (in popup) open in browser
:GoogleAILogin              # sign the backend browser into Google / solve CAPTCHA

## ai-99
; 99 runs the `claude` CLI and writes the result into the buffer or quickfix.
<leader>9s                  # search the project with AI, results in quickfix  @99
<leader>9v                  # (visual) rewrite the selection with AI  @99
<leader>9b                  # vibe: let AI work over the whole buffer  @99
<leader>9o                  # open the last result
<leader>9w                  # set the current work item
<leader>9W                  # search what is left of the work item
<leader>9m                  # pick model
<leader>9p                  # pick provider
<leader>9x                  # stop all requests  @cancel
<leader>9l                  # view logs
<leader>9i                  # info
<leader>9c                  # clear previous results

; ===============  cheatsheet
## cheatsheet-plugin
; My own plugin: search these .sheet files from nvim.
<leader>kk                  # search every sheet  @cheat
<leader>ks                  # pick a shelf, then search it
<leader>kf                  # search this or a picked sheet
<leader>kj                  # jump to a section
<leader>kw                  # search every sheet for the word under cursor
<leader>kd                  # popup with description + link of word under cursor
<leader>kn                  # new sheet (shelf/sheet)
<leader>kl                  # lint this sheet
<C-y>                       # (in cheat picker) yank the KEY
<C-o>                       # (in cheat picker) open the link

; ===============  ui
## ui-toggles
<leader>uw                  # toggle line wrap
<leader>us                  # toggle spell check
<leader>ul                  # toggle line numbers
<leader>uL                  # toggle relative numbers
<leader>uh                  # toggle inlay hints
<leader>ug                  # toggle indent guides
<leader>uz                  # toggle zen mode  @focus
<leader>un                  # dismiss notifications
<leader>n                   # notification history  @messages
:IBLToggle                  # toggle indent guides (indent-blankline)
<leader>ft                  # terminal (root dir)  @shell
<C-/>                       # toggle floating terminal

; ===============  plugin-manager
## lazy
; :Lazy is the plugin manager. <leader>l opens it.
:Lazy                       # open plugin manager UI  @plugins
:Lazy sync                  # clean + install + update all plugins
:Lazy update                # update all plugins
:Lazy clean                 # remove unused plugins
:Lazy check                 # check for updates
:Lazy profile               # show startup time  @slow @performance
I U S X C                   # (in Lazy UI) install, update, sync, clean, check

## mason
; Mason installs LSP servers, debuggers, linters and formatters.
<leader>cm                  # open Mason  @install
:MasonInstall clangd clang-format codelldb  # install packages
:MasonUninstall PKG         # uninstall a package
:MasonUpdate                # update registry
:MasonLog                   # Mason log, check when install fails
i                           # (in Mason) install package under cursor
u                           # (in Mason) update package under cursor
U                           # (in Mason) update all packages
X                           # (in Mason) uninstall package under cursor
~/.local/share/nvim/mason/bin/ # where Mason binaries live

