title: binary ninja ui (binaryninjaui)
url:   https://api.binary.ninja/cpp/
tags:  binaryninja binja bn python api binaryninjaui ui gui qt pyside6 widget sidebar pane action hotkey menu view

; UI only: binaryninjaui is missing in headless scripts. The C++ docs translate almost 1:1 to Python.
; ctx = UIActionContext, frame = ViewFrame, view = View. UPPERCASE words are placeholders.

## setup and rules
import binaryninjaui                # import before PySide6 so the right Qt loads and the plugin skips headless runs  @pyside @crash  <https://docs.binary.ninja/dev/plugins.html#ui-plugins>
from binaryninjaui import UIContext, UIAction, UIActionHandler, Menu  # common imports for a UI plugin  @import
execute_on_main_thread(FN)          # touch Qt widgets only from the main thread; plugin code runs on a worker  @thread @crash  <https://api.binary.ninja/binaryninja.mainthread-module.html#binaryninja.mainthread.execute_on_main_thread>
dir(binaryninjaui)                  # list what the UI module exposes, since the Python docs are thin  @explore @help  <https://docs.binary.ninja/dev/concepts.html#ui-elements>
api.binary.ninja/cpp                # read the C++ UI headers docs; Python names and args match  @docs @reference  <https://api.binary.ninja/cpp/>
/src/binaryninja-api/ui/*.h         # read the UI headers in the API source for every method  @source @header  <file:/src/binaryninja-api/ui/uicontext.h>
python/examples/hellosidebar.py     # sample sidebar widget plugin  @example  <file:/src/binaryninja-api/python/examples/hellosidebar.py>
python/examples/hellopane.py        # sample pane plugin opened from a menu action  @example  <file:/src/binaryninja-api/python/examples/hellopane.py>
python/examples/helloglobalarea.py  # sample bottom global area widget  @example  <file:/src/binaryninja-api/python/examples/helloglobalarea.py>
python/examples/triage/             # sample full custom ViewType (Triage Summary)  @example  <file:/src/binaryninja-api/python/examples/triage/view.py>
python/examples/ui_notifications.py  # sample of every UIContextNotification callback  @example @events  <file:/src/binaryninja-api/python/examples/ui_notifications.py>

## console ui variables
current_ui_context                  # the UIContext of the window the console belongs to  @console @window
current_ui_view_frame               # the ViewFrame (tab or pane) that has focus  @console @frame
current_ui_view                     # the View widget (linear, graph, hex...) that has focus  @console
current_ui_view_location            # the ViewLocation: view type, offset, function, IL type  @console @cursor
current_ui_action_handler           # the UIActionHandler of the focused view  @console
current_ui_action_context           # the UIActionContext the view would pass to an action  @console @ctx
current_ui_token_state              # the HighlightTokenState of the clicked token  @console @token

## ui context (window)
UIContext.activeContext()           # get the UIContext of the active main window  @window @current  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
UIContext.allContexts()             # get every open main window  @windows  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
UIContext.contextForWidget(W)       # get the UIContext that owns a widget  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
UIContext.currentViewFrameForWidget(W)  # get the best ViewFrame for a widget in a pane or popout  @frame  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
uic.getCurrentViewFrame()           # get the focused ViewFrame of a window  @frame  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
uic.getCurrentView()                # get the focused View of a window  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
uic.getCurrentActionHandler()       # get the action handler of the focused view  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
uic.getAvailableBinaryViews()       # list (BinaryView, name) for all open tabs  @tabs @bv  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
uic.navigateForBinaryView(bv, ADDR)  # jump to ADDR in the tab showing bv  @goto @navigate  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
uic.openFilename("PATH")            # open a file in a new tab, like File > Open  @load  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
uic.openFileContext(FileContext(bv.file, bv, "NAME"))  # show a BinaryView you made in Python in a new tab  @open @tab  <https://docs.binary.ninja/dev/cookbook.html>
    data = BinaryView.new(b'\x00\x00\x01')
    execute_on_main_thread(lambda: UIContext.activeContext().openFileContext(FileContext(data.file, data, '')))
uic.createTabForWidget("NAME", W)   # show any QWidget as a new tab  @tab  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
uic.openPane(PANE)                  # split the current tab and show PANE next to it  @split  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
uic.getTabs() / uic.activateTab(T) / uic.closeTab(T)  # list, switch to or close tabs  @tab  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
uic.splitToNewTabAndNavigateToLocation(ADDR)  # open ADDR in a new tab  @split  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
uic.refreshCurrentViewContents()    # redraw the current view after you changed data  @refresh @redraw  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
uic.mainWindow()                    # get the QMainWindow, e.g. as a dialog parent  @parent @qt  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
uic.sidebar() / uic.globalArea()    # get the sidebar or the bottom global area of a window  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>

## view frame and view (the current tab)
frame.getCurrentBinaryView()        # get the BinaryView shown in this frame  @bv  <https://api.binary.ninja/cpp/group__viewframe.html#class_view_frame>
frame.getCurrentOffset()            # get the cursor address in this frame  @here @address  <https://api.binary.ninja/cpp/group__viewframe.html#class_view_frame>
frame.getSelectionOffsets()         # get the selected range (start, end)  @range  <https://api.binary.ninja/cpp/group__viewframe.html#class_view_frame>
frame.getCurrentView()              # get the view type name, e.g. "Linear:ELF"  @type  <https://api.binary.ninja/cpp/group__viewframe.html#class_view_frame>
frame.getCurrentViewInterface()     # get the View object of this frame  <https://api.binary.ninja/cpp/group__viewframe.html#class_view_frame>
frame.getViewLocation()             # get the ViewLocation (type, offset, function, IL type)  @cursor  <https://api.binary.ninja/cpp/group__viewframe.html#class_view_frame>
frame.navigate("Graph:ELF", ADDR)   # jump to ADDR in a given view type  @goto  <https://api.binary.ninja/cpp/group__viewframe.html#class_view_frame>
frame.navigate(bv, ADDR)            # jump to ADDR in the current view type  @goto  <https://api.binary.ninja/cpp/group__viewframe.html#class_view_frame>
frame.navigateToFunction(func, ADDR)  # jump to ADDR inside a given function  @goto  <https://api.binary.ninja/cpp/group__viewframe.html#class_view_frame>
frame.setViewType("Linear:ELF")     # switch the frame to another view type  @graph @linear @hex  <https://api.binary.ninja/cpp/group__viewframe.html#class_view_frame>
frame.back() / frame.forward()      # go back or forward in navigation history  @history  <https://api.binary.ninja/cpp/group__viewframe.html#class_view_frame>
frame.getSidebar()                  # get the sidebar for this frame  <https://api.binary.ninja/cpp/group__viewframe.html#class_view_frame>
ViewFrame.viewFrameForWidget(W)     # get the ViewFrame that contains a widget  <https://api.binary.ninja/cpp/group__viewframe.html#class_view_frame>
view.getData()                      # get the BinaryView of a View  @bv  <https://api.binary.ninja/cpp/group__viewframe.html#class_view>
view.getCurrentOffset()             # get the cursor address of a View  @here  <https://api.binary.ninja/cpp/group__viewframe.html#class_view>
view.setSelectionOffsets(RANGE)     # select a range in a View  @select  <https://api.binary.ninja/cpp/group__viewframe.html#class_view>
view.navigate(ADDR)                 # move a View to ADDR  @goto  <https://api.binary.ninja/cpp/group__viewframe.html#class_view>
view.getCurrentFunction()           # get the function under the cursor of a View  <https://api.binary.ninja/cpp/group__viewframe.html#class_view>
view.getCurrentHighLevelILFunction()  # get the HLIL function shown in a View (also LowLevel, MediumLevel)  @il  <https://api.binary.ninja/cpp/group__viewframe.html#class_view>
view.getCurrentILInstructionIndex()  # get the IL instruction index under the cursor  @il  <https://api.binary.ninja/cpp/group__viewframe.html#class_view>
View.getViewFromWidget(W)           # get the View interface of a view widget  <https://api.binary.ninja/cpp/group__viewframe.html#class_view>
loc.getOffset() / loc.getFunction() / loc.getViewType()  # read a ViewLocation  @cursor  <https://api.binary.ninja/cpp/group__viewframe.html#class_view_location>

## actions and hotkeys
UIAction.registerAction("NAME", QKeySequence("Ctrl+Shift+H"))  # create a named action with a default hotkey  @shortcut @keybinding  <https://api.binary.ninja/cpp/group__action.html#struct_u_i_action>
UIActionHandler.globalActions().bindAction("NAME", UIAction(FN))  # run FN(ctx) when the action fires anywhere  @bind  <https://api.binary.ninja/cpp/group__action.html#class_u_i_action_handler>
UIAction(FN, IS_VALID)              # action that is greyed out unless IS_VALID(ctx) is True  @enable @disable  <https://api.binary.ninja/cpp/group__action.html#struct_u_i_action>
    UIAction.registerAction("Hello Pane")
    UIActionHandler.globalActions().bindAction("Hello Pane", UIAction(create_pane, lambda ctx: ctx.binaryView is not None))
ctx.binaryView / ctx.address / ctx.length  # data an action gets: bv, cursor address, selection size  @context  <https://api.binary.ninja/cpp/group__action.html#struct_u_i_action_context>
ctx.function / ctx.highLevelILFunction / ctx.instrIndex  # function and IL position an action gets  @context  <https://api.binary.ninja/cpp/group__action.html#struct_u_i_action_context>
ctx.context / ctx.view / ctx.widget  # UIContext, View and widget an action was fired from  @context  <https://api.binary.ninja/cpp/group__action.html#struct_u_i_action_context>
ctx.token                           # the HighlightTokenState under the cursor (token.addr, token.localVar...)  @context  <https://api.binary.ninja/cpp/group__action.html#struct_u_i_action_context>
UIAction.unregisterAction("NAME")   # remove a registered action  @delete  <https://api.binary.ninja/cpp/group__action.html#struct_u_i_action>
UIAction.getAllRegisteredActions()  # list every action name, built-in and plugin  @list  <https://api.binary.ninja/cpp/group__action.html#struct_u_i_action>
UIAction.getKeyBinding("NAME")      # get the hotkeys bound to an action  @shortcut  <https://api.binary.ninja/cpp/group__action.html#struct_u_i_action>
UIAction.setUserKeyBinding("NAME", [QKeySequence("F5")])  # change the hotkey of an action from code  @rebind  <https://api.binary.ninja/cpp/group__action.html#struct_u_i_action>
handler.executeAction("NAME")       # run any action (built-in too) by name from code  @invoke @trigger  <https://api.binary.ninja/cpp/group__action.html#class_u_i_action_handler>
UIActionHandler.actionHandlerFromWidget(W)  # get the action handler that owns a widget  <https://api.binary.ninja/cpp/group__action.html#class_u_i_action_handler>
self.actionHandler = UIActionHandler(); self.actionHandler.setupActionHandler(self)  # give your widget its own action handler  @widget  <https://api.binary.ninja/cpp/group__action.html#class_u_i_action_handler>
python/examples/list_keybindings.py  # print or export every action and its hotkey  @shortcut @keys  <file:/src/binaryninja-api/python/examples/list_keybindings.py>

## menus
Menu.mainMenu("Plugins").addAction("NAME", "GROUP")  # put a registered action in a top menu  @menubar  <https://api.binary.ninja/cpp/group__action.html#class_menu>
Menu.mainMenu("Plugins").removeAction("NAME")  # take an action out of a top menu  @delete  <https://api.binary.ninja/cpp/group__action.html#class_menu>
Menu.getMainMenus()                 # list the top menu names  <https://api.binary.ninja/cpp/group__action.html#class_menu>
self.m_contextMenuManager.show(self.m_menu, self.actionHandler)  # show the right-click menu in a SidebarWidget  @contextmenu @rightclick  <file:/src/binaryninja-api/python/examples/hellosidebar.py>
OnContextMenuCreated(self, context, view, menu)  # notification to add items to a view's right-click menu  @contextmenu  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context_notification>

## events (UIContextNotification)
class N(UIContextNotification)      # get called on UI events: file open, view change, cursor move  @hook @callback @listen  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context_notification>
    class N(UIContextNotification):
        def __init__(self):
            UIContextNotification.__init__(self); UIContext.registerNotification(self)
        def OnAddressChange(self, context, frame, view, location):
            print(hex(location.getOffset()))
    n = N()   # keep a reference or it is garbage collected
UIContext.registerNotification(N) / UIContext.unregisterNotification(N)  # start or stop getting UI events  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
OnAddressChange(self, context, frame, view, location)  # called when the cursor moves  @cursor @navigate
OnViewChange(self, context, frame, type)  # called when the tab or view type changes  @switch
OnAfterOpenFile(self, context, file, frame)  # called after a file opens in a tab  @load
OnBeforeOpenFile(self, context, file)  # called before a file opens; return False to stop it  @load @block
OnBeforeSaveFile / OnAfterSaveFile(self, context, file, frame)  # called around saving; Before returns bool  @save
OnBeforeCloseFile / OnAfterCloseFile(self, context, file, frame)  # called around closing a tab; Before returns bool  @close
OnAfterOpenDatabase(self, context, metadata, data)  # called after a .bndb opens  @bndb
OnContextOpen / OnContextClose(self, context)  # called when a main window opens or closes  @window
OnTokenDoubleClicked(self, context, frame, view, location, token)  # called on token double click; return True to replace the default  @click
OnActionExecutedImmutable(self, context, handler, name, ctx)  # called after any action runs; log what the user does  @trace @audit
widget.destroyed.connect(lambda: UIContext.unregisterNotification(n))  # stop events when the widget dies; __del__ is not called  @cleanup @leak  <file:/src/binaryninja-api/python/examples/hellopane.py>

## sidebar widgets
Sidebar.addSidebarWidgetType(MyType())  # register a new sidebar panel with an icon  @panel @dock  <https://api.binary.ninja/cpp/group__sidebar.html>
class MyType(SidebarWidgetType)     # sidebar panel type: icon, name, createWidget  <https://api.binary.ninja/cpp/group__sidebar.html>
    class MyType(SidebarWidgetType):
        def __init__(self):
            SidebarWidgetType.__init__(self, QImage(56, 56, QImage.Format_RGB32), "Hello")  # 56x56 grayscale, white = shape
        def createWidget(self, frame, data):
            return MyWidget("Hello", frame, data)
        def defaultLocation(self):
            return SidebarWidgetLocation.RightContent
        def contextSensitivity(self):
            return SidebarContextSensitivity.SelfManagedSidebarContext
class MyWidget(SidebarWidget)       # sidebar panel content; call SidebarWidget.__init__(self, NAME)  <https://api.binary.ninja/cpp/group__sidebar.html>
notifyOffsetChanged(self, offset)   # SidebarWidget callback: the cursor moved  @cursor
notifyViewChanged(self, view_frame)  # SidebarWidget callback: the tab or view changed; view_frame may be None  @switch
notifyViewLocationChanged(self, view, location)  # SidebarWidget callback: full location changed (function, IL)  @cursor
SidebarWidgetLocation.LeftContent / RightContent / LeftBottom / RightBottom / LeftReference / RightReference  # where a sidebar panel goes  @position @side
SidebarContextSensitivity.SelfManagedSidebarContext  # one widget for all tabs; you track view changes  @instance
SidebarContextSensitivity.PerTabSidebarContext / PerViewTypeSidebarContext / PerPaneSidebarContext  # one widget per tab, view type or pane  @instance
Sidebar.current().activate("NAME")  # open a sidebar panel by name  @show @open  <https://api.binary.ninja/cpp/group__sidebar.html>
sidebar.toggle("NAME") / sidebar.deactivate("NAME")  # toggle or close a sidebar panel  @hide  <https://api.binary.ninja/cpp/group__sidebar.html>
sidebar.widget("NAME")              # get the live widget of a sidebar panel  @find  <https://api.binary.ninja/cpp/group__sidebar.html>

## panes, global area, custom views
WidgetPane(W, "TITLE")              # wrap a QWidget as a pane for uic.openPane  @split  <https://api.binary.ninja/cpp/group__pane.html>
    ctx.context.openPane(WidgetPane(MyWidget(ctx.binaryView), "Hello"))
GlobalArea.addWidget(lambda ctx: MyArea("NAME"))  # add a tab to the bottom area (next to Log, Console)  @bottom @panel  <https://api.binary.ninja/cpp/group__globalarea.html>
class MyArea(GlobalAreaWidget)      # bottom area widget; same notifyOffsetChanged / notifyViewChanged as sidebar  <https://api.binary.ninja/cpp/group__globalarea.html>
ViewType.registerViewType(MyViewType())  # add a new view type to the view picker (like Triage, Hex)  @customview  <https://api.binary.ninja/cpp/group__viewtype.html>
class MyViewType(ViewType)          # implement getPriority(data, filename) and create(data, view_frame)  @customview  <file:/src/binaryninja-api/python/examples/triage/view.py#L183>
    class MyViewType(ViewType):
        def __init__(self): super().__init__("Mine", "My View")
        def getPriority(self, data, filename): return 1   # higher wins as the default view
        def create(self, data, view_frame): return MyView(view_frame, data)
class MyView(QScrollArea, View)     # custom view widget; call View.__init__ and self.setupView(self)  @customview  <file:/src/binaryninja-api/python/examples/triage/view.py>
getData / getCurrentOffset / navigate / getFont  # methods every custom View must implement  @override @abstract  <https://api.binary.ninja/cpp/group__viewframe.html#class_view>
ViewType.getTypes() / ViewType.getTypeByName("NAME")  # list or find view types  <https://api.binary.ninja/cpp/group__viewtype.html>

## look and feel
binaryninjaui.getMonospaceFont(W)   # get the user's code font for a widget  @font  <file:/src/binaryninja-api/ui/fontsettings.h#L42>
binaryninjaui.getApplicationFont(W)  # get the user's normal UI font  @font  <file:/src/binaryninja-api/ui/fontsettings.h#L29>
binaryninjaui.getThemeColor(ThemeColor.AddressColor)  # get a QColor from the current theme  @color @dark  <file:/src/binaryninja-api/ui/theme.h#L69>
UIContext.getScaledWindowSize(X, Y)  # scale a window size for the screen DPI  @hidpi  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
