; ===============  basics.sheet
; title: binary ninja basics
; url:   https://api.binary.ninja/
; tags:  binaryninja binja bn python api headless script console reverse-engineering disassembler decompiler

; bv = BinaryView, f = Function. UPPERCASE words are placeholders.

## load and open
; Opening a file is the first step of every script. You get a BinaryView (bv),
; the main object for everything in the file. It works with or without the UI.
from binaryninja import *          # import the whole API in a script or headless run  <https://api.binary.ninja/index.html#binaryninja.load>
bv = load(PATH)                    # open a binary or .bndb and wait for analysis to finish  @headless  <https://api.binary.ninja/index.html#binaryninja.load>
bv = load(PATH, update_analysis=False)  # open fast without analysis, call bv.update_analysis_and_wait() later  @lazy  <https://api.binary.ninja/index.html#binaryninja.load>
bv = load(PATH, options={"loader.imageBase": 0x400000})  # open with load settings, e.g. a new image base  @rebase  <https://api.binary.ninja/index.html#binaryninja.load>
bv = load(DATA, options={"loader.platform": "x86"})  # load raw bytes or shellcode with a forced platform  @blob  <https://api.binary.ninja/index.html#binaryninja.load>
bv = load(PATH, options={"analysis.mode": "basic"})  # open with less analysis (controlFlow, basic, intermediate, full)  @speed  <https://docs.binary.ninja/guide/settings.html#analysis.mode>
bv = load(PATH, progress_func=CB)  # open a .bndb and report progress, CB(cur, total) must return True  <https://api.binary.ninja/index.html#binaryninja.load>
with load(PATH) as bv:             # # open a view and close it automatically at the end of the block  @context @cleanup  <https://api.binary.ninja/index.html#binaryninja.load>
    with load("/bin/ls") as bv:
        print(len(list(bv.functions)))
bv.file.close()                    # release a view opened without "with" so memory is freed  @free @leak  <https://api.binary.ninja/binaryninja.filemetadata-module.html#binaryninja.filemetadata.FileMetadata.close>
BinaryView.new(DATA)               # make a Raw view from bytes in memory, no file on disk  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.new>
BinaryView.load(SRC, update_analysis=True)  # same as load() but returns None instead of raising  @open  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.load>
BinaryViewType["ELF"]              # get a file format loader by name (ELF, PE, Mach-O, Raw...)  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryViewType>
BinaryViewType["ELF"].parse(DATA)  # parse a view header only, without full load  @format  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryViewType.parse>
BinaryViewType["ELF"].get_load_settings_for_data(DATA)  # get the load settings a format offers for this data  @options  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryViewType.get_load_settings_for_data>
bv.get_view_of_type("Raw")         # get another view of the same file, e.g. the raw file bytes  @fileoffset  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_view_of_type>
bv.file.raw                        # get the Raw view (file bytes before mapping)  <https://api.binary.ninja/binaryninja.filemetadata-module.html#binaryninja.filemetadata.FileMetadata.raw>
bv.parent_view                     # get the view this view reads its data from  @raw  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.parent_view>
bv.available_view_types            # list view types that can parse this file  @format  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.available_view_types>
bv.view_type                       # get the name of this view's format, e.g. "ELF"  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.view_type>
bv.file.filename                   # get the path of the opened file or .bndb  <https://api.binary.ninja/binaryninja.filemetadata-module.html#binaryninja.filemetadata.FileMetadata.filename>
bv.file.original_filename          # get the path of the original binary behind a .bndb  <https://api.binary.ninja/binaryninja.filemetadata-module.html#binaryninja.filemetadata.FileMetadata.original_filename>
bv.file.existing_views             # list names of all views open on this file  <https://api.binary.ninja/binaryninja.filemetadata-module.html#binaryninja.filemetadata.FileMetadata.existing_views>
shutdown()                         # stop the core cleanly at the end of a headless script  @exit @quit  <https://api.binary.ninja/index.html#binaryninja.shutdown>
disable_default_log()              # stop the headless default log output for this session  @quiet  <https://api.binary.ninja/index.html#binaryninja.disable_default_log>

## save and databases
; A .bndb file is a database that keeps all your work: names, types, comments.
; Save to a .bndb to keep your analysis, or save a new binary with your patches.
bv.create_database(PATH)  # save analysis to a new .bndb file  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.create_database>
bv.save_auto_snapshot()   # save analysis into the .bndb it was opened from  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.save_auto_snapshot>
bv.save(PATH)             # write the patched binary (not a .bndb) to PATH  @patch @export  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.save>
bv.file.has_database      # check whether the file is backed by a .bndb  <https://api.binary.ninja/binaryninja.filemetadata-module.html#binaryninja.filemetadata.FileMetadata.has_database>
bv.file.modified          # check whether there are unsaved changes  @dirty  <https://api.binary.ninja/binaryninja.filemetadata-module.html#binaryninja.filemetadata.FileMetadata.modified>
bv.file.database          # get the low level Database object of a .bndb  @snapshot  <https://api.binary.ninja/binaryninja.filemetadata-module.html#binaryninja.filemetadata.FileMetadata.database>
SaveSettings().set_option(SaveOption.TrimSnapshots)  # drop old snapshot data to make a smaller .bndb  @size @trim  <https://api.binary.ninja/binaryninja.filemetadata-module.html#binaryninja.filemetadata.SaveSettings.set_option>
bv.create_database(PATH, settings=SETTINGS)  # save a .bndb with SaveSettings options  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.create_database>

## analysis control
; Analysis is the work Binary Ninja does to find functions, types and code flow.
; Use these to start it, wait for it, stop it, or make it do less work.
bv.update_analysis_and_wait()         # run analysis and block until it is done  @sync  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.update_analysis_and_wait>
bv.update_analysis()                  # start analysis in the background and return at once  @async  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.update_analysis>
bv.reanalyze()                        # mark every function for reanalysis and start it  @refresh @rerun  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.reanalyze>
bv.abort_analysis()                   # stop running analysis (it can be resumed later)  @cancel  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.abort_analysis>
bv.analysis_progress                  # get current analysis state and progress counts  @status @percent  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.analysis_progress>
bv.analysis_state                     # get the AnalysisState enum (Idle, Disassemble, Analyze...)  @status  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.analysis_state>
bv.analysis_info                      # get analysis state and functions currently being analyzed  @status  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.analysis_info>
bv.set_analysis_hold(True)            # hold analysis so changes queue up until you release it  @pause @defer  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.set_analysis_hold>
bv.add_analysis_completion_event(CB)  # call CB() once when the current analysis finishes  @callback @done  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.add_analysis_completion_event>
bv.has_initial_analysis()             # check whether initial analysis has already run  @status  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.has_initial_analysis>
bv.max_function_size_for_analysis = N  # skip auto analysis of functions bigger than N bytes  @too-large @limit  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.max_function_size_for_analysis>
bv.new_auto_function_analysis_suppressed = True  # stop analysis of newly found functions  @suppress  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.new_auto_function_analysis_suppressed>
bv.add_analysis_option("linearsweep")  # ask analysis to run an extra pass like linear sweep  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.add_analysis_option>

## python console magic variables
; Ready-made names in the Python console of the UI. They always point to what you
; see now: the open file, the cursor address, the current function.
bv                                  # the BinaryView in the active tab  @console @current_view
here                                # the current address in the UI (same as current_address)  @console @cursor
current_address                     # the current address; assign to navigate there  @console
current_function                    # the Function under the cursor  @console
current_basic_block                 # the BasicBlock under the cursor  @console
current_llil / current_mlil / current_hlil  # the IL function of the current function  @console
current_lifted_il / current_mapped_mlil  # the lifted IL or mapped MLIL of the current function  @console
current_llil_ssa / current_mlil_ssa / current_hlil_ssa  # the SSA form of each IL level of the current function  @console
current_il_instruction              # the IL instruction under the cursor in an IL view  @console
current_il_instructions             # all IL instructions for the current line or address  @console
current_il_function / current_il_basic_block  # the IL function or IL block of the active IL view  @console
current_il_expr / current_il_index  # the IL expression or instruction index under the cursor  @console
current_selection                   # (start, end) of the selection; assign to change it  @console @range
current_raw_offset                  # the file offset of the cursor; assign to navigate  @console @fileoffset
current_symbol / current_symbols    # the Symbol(s) at the current address  @console @name
current_data_var                    # the DataVariable at the cursor  @console
current_variable                    # the IL Variable under the cursor  @console @var
current_token                       # the text token under the cursor  @console
current_comment                     # the comment at the current address; assign to set it  @console
current_segment / current_sections  # the Segment and Sections at the cursor  @console
current_project                     # the open Project, if any  @console
current_thread                      # the thread the console runs Python on
current_ui_context / current_ui_view / current_ui_view_frame  # UI objects for the current window and view  @console
PythonScriptingProvider.register_magic_variable(NAME, GET, SET)  # add your own variable to the Python console  @custom  <https://api.binary.ninja/binaryninja.scriptingprovider-module.html#binaryninja.scriptingprovider.PythonScriptingProvider.register_magic_variable>

## logging
; Write messages to the Log window (or the terminal in a headless script).
; Use them to see what your script does and to find bugs.
log_info(MSG)                         # write an info message to the log  @print  <https://api.binary.ninja/binaryninja.log-module.html#binaryninja.log.log_info>
log_debug(MSG)                        # write a debug message (shown only at debug level)  @verbose  <https://api.binary.ninja/binaryninja.log-module.html#binaryninja.log.log_debug>
log_warn(MSG)                         # write a warning to the log  <https://api.binary.ninja/binaryninja.log-module.html#binaryninja.log.log_warn>
log_error(MSG)                        # write an error to the log (focuses the log in the UI)  <https://api.binary.ninja/binaryninja.log-module.html#binaryninja.log.log_error>
log_alert(MSG)                        # write a message and show a pop-up in the UI  @popup  <https://api.binary.ninja/binaryninja.log-module.html#binaryninja.log.log_alert>
log_error_for_exception(MSG)          # log a message with the stack trace of the current exception  @traceback @except  <https://api.binary.ninja/binaryninja.log-module.html#binaryninja.log.log_error_for_exception>
log_info(MSG, logger="NAME")          # log under a named source shown in the log filter  <https://api.binary.ninja/binaryninja.log-module.html#binaryninja.log.log_info>
Logger(0, "NAME")                     # create a named logger object with .log_info/.log_warn/...  <https://api.binary.ninja/binaryninja.log-module.html#binaryninja.log.Logger>
bv.create_logger("NAME")              # create a logger tied to this view's session  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.create_logger>
log_to_stdout(LogLevel.InfoLog)       # print log messages to stdout in headless scripts  <https://api.binary.ninja/binaryninja.log-module.html#binaryninja.log.log_to_stdout>
log_to_stderr(LogLevel.WarningLog)    # print log messages to stderr  @headless  <https://api.binary.ninja/binaryninja.log-module.html#binaryninja.log.log_to_stderr>
log_to_file(LogLevel.DebugLog, PATH)  # write log messages to a file  <https://api.binary.ninja/binaryninja.log-module.html#binaryninja.log.log_to_file>
close_logs()                          # close all log files  @file  <https://api.binary.ninja/binaryninja.log-module.html#binaryninja.log.close_logs>
redirect_output_to_log()              # send Python print/stdout into the Binary Ninja log  <https://api.binary.ninja/binaryninja.log-module.html#binaryninja.log.redirect_output_to_log>

## settings
; Settings are the options of Binary Ninja, the same ones you see in the UI.
; Read them, change them, or add new options for your own plugin.
Settings()                           # get the default settings store  @config @preferences  <https://api.binary.ninja/binaryninja.settings-module.html#binaryninja.settings.Settings>
Settings().get_bool("analysis.linearSweep.autorun")  # read a bool setting by its key  @config  <https://api.binary.ninja/binaryninja.settings-module.html#binaryninja.settings.Settings.get_bool>
Settings().get_string(KEY, bv)       # read a setting as seen by this view (resource scope)  @config  <https://api.binary.ninja/binaryninja.settings-module.html#binaryninja.settings.Settings.get_string>
Settings().get_integer(KEY)          # read an integer setting  @config  <https://api.binary.ninja/binaryninja.settings-module.html#binaryninja.settings.Settings.get_integer>
Settings().get_string_list(KEY)      # read a list of strings setting  @config  <https://api.binary.ninja/binaryninja.settings-module.html#binaryninja.settings.Settings.get_string_list>
Settings().get_json(KEY)             # read any setting as a JSON string  @config  <https://api.binary.ninja/binaryninja.settings-module.html#binaryninja.settings.Settings.get_json>
Settings().get_bool_with_scope(KEY)  # read a setting and the scope it came from  @config  <https://api.binary.ninja/binaryninja.settings-module.html#binaryninja.settings.Settings.get_bool_with_scope>
Settings().set_bool(KEY, VAL)        # change a bool setting at user scope  @config @write  <https://api.binary.ninja/binaryninja.settings-module.html#binaryninja.settings.Settings.set_bool>
Settings().set_string(KEY, VAL, bv, SettingsScope.SettingsResourceScope)  # change a setting for this view only  @config  <https://api.binary.ninja/binaryninja.settings-module.html#binaryninja.settings.Settings.set_string>
Settings().set_integer(KEY, VAL)     # change an integer setting  @config  <https://api.binary.ninja/binaryninja.settings-module.html#binaryninja.settings.Settings.set_integer>
Settings().reset(KEY)                # reset a setting to its default  <https://api.binary.ninja/binaryninja.settings-module.html#binaryninja.settings.Settings.reset>
Settings().keys()                    # list all setting keys  <https://api.binary.ninja/binaryninja.settings-module.html#binaryninja.settings.Settings.keys>
Settings().contains(KEY)             # check whether a setting key exists  <https://api.binary.ninja/binaryninja.settings-module.html#binaryninja.settings.Settings.contains>
Settings().query_property_string(KEY, "description")  # read a property of a setting, e.g. its title or description  @schema  <https://api.binary.ninja/binaryninja.settings-module.html#binaryninja.settings.Settings.query_property_string>
Settings().register_group("myplugin", "My Plugin")  # add a settings group for your plugin  @schema  <https://api.binary.ninja/binaryninja.settings-module.html#binaryninja.settings.Settings.register_group>
Settings().register_setting("myplugin.enable", JSON)  # add a new setting with a JSON schema  @plugin  <https://api.binary.ninja/binaryninja.settings-module.html#binaryninja.settings.Settings.register_setting>
    Settings().register_setting("myplugin.enable", json.dumps({
        "title": "Enable", "type": "boolean", "default": True,
        "description": "Turn the plugin on"}))
Settings("my_instance")              # make a separate settings store with its own id  @custom  <https://api.binary.ninja/binaryninja.settings-module.html#binaryninja.settings.Settings>
bv.get_load_settings("ELF")          # get the load settings used for this view type  @loader @options  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_load_settings>
Settings().serialize_settings(scope=SettingsScope.SettingsUserScope)  # dump user settings as JSON  @export  <https://api.binary.ninja/binaryninja.settings-module.html#binaryninja.settings.Settings.serialize_settings>

## undo
; Group your changes so that one Ctrl+Z takes them all back.
; Use it in scripts that change many things at once.
with bv.undoable_transaction():  # group changes into one undo step, reverted if an exception escapes  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.undoable_transaction>
ID = bv.begin_undo_actions()     # start recording changes for undo  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.begin_undo_actions>
bv.commit_undo_actions(ID)       # save recorded changes as one undo step  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.commit_undo_actions>
bv.revert_undo_actions(ID)       # throw away recorded changes and roll them back  @rollback  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.revert_undo_actions>
bv.forget_undo_actions(ID)       # stop recording but keep the changes, with no undo step  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.forget_undo_actions>
bv.undo()                        # undo the last committed step  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.undo>
bv.redo()                        # redo the last undone step  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.redo>
bv.file.undo_entries             # list the undo history entries  <https://api.binary.ninja/binaryninja.filemetadata-module.html#binaryninja.filemetadata.FileMetadata.undo_entries>

## threads and workers
; Binary Ninja runs code on many threads. The UI may only change on the main thread.
; Use these to run work in the background, or to safely touch the UI.
execute_on_main_thread(FN)           # run FN on the UI main thread later  <https://api.binary.ninja/binaryninja.mainthread-module.html#binaryninja.mainthread.execute_on_main_thread>
execute_on_main_thread_and_wait(FN)  # run FN on the main thread and wait for it  @ui @sync  <https://api.binary.ninja/binaryninja.mainthread-module.html#binaryninja.mainthread.execute_on_main_thread_and_wait>
is_main_thread()                     # check whether code runs on the UI main thread  <https://api.binary.ninja/binaryninja.mainthread-module.html#binaryninja.mainthread.is_main_thread>
worker_enqueue(FN, "NAME")           # run FN on a core worker thread  @async  <https://api.binary.ninja/binaryninja.mainthread-module.html#binaryninja.mainthread.worker_enqueue>
worker_priority_enqueue(FN)          # run FN on a worker thread ahead of normal jobs  <https://api.binary.ninja/binaryninja.mainthread-module.html#binaryninja.mainthread.worker_priority_enqueue>
get_worker_thread_count()            # get the number of analysis worker threads  @cpu  <https://api.binary.ninja/binaryninja.mainthread-module.html#binaryninja.mainthread.get_worker_thread_count>
set_worker_thread_count(N)           # change the number of analysis worker threads  @cpu  <https://api.binary.ninja/binaryninja.mainthread-module.html#binaryninja.mainthread.set_worker_thread_count>

## version, license and paths
; Facts about your Binary Ninja install: version, license, and where it keeps its files.
; Use them to check that a script works on this version.
core_version()                        # get the Binary Ninja version string  <https://api.binary.ninja/index.html#binaryninja.core_version>
core_version_info()                   # get the version as major, minor, build, channel  <https://api.binary.ninja/index.html#binaryninja.core_version_info>
core_build_id()                       # get the build number  @version  <https://api.binary.ninja/index.html#binaryninja.core_build_id>
core_version_info() >= CoreVersionInfo(5, 1, 8104)  # check a minimum version before using a newer API  @compat  <https://api.binary.ninja/index.html#binaryninja.CoreVersionInfo>
core_product() / core_product_type()  # get the license product name and type  @edition  <https://api.binary.ninja/index.html#binaryninja.core_product>
core_license_count() / core_expires()  # get the license seat count and expiry  <https://api.binary.ninja/index.html#binaryninja.core_expires>
core_ui_enabled()                     # check whether running inside the UI and not headless  @gui  <https://api.binary.ninja/index.html#binaryninja.core_ui_enabled>
user_directory()                      # get the user folder (settings, plugins, repositories)  @path @config  <https://api.binary.ninja/index.html#binaryninja.user_directory>
user_plugin_path()                    # get the user plugin folder  @plugins  <https://api.binary.ninja/index.html#binaryninja.user_plugin_path>
bundled_plugin_path()                 # get the plugin folder inside the install  @plugins  <https://api.binary.ninja/index.html#binaryninja.bundled_plugin_path>
get_install_directory()               # get the folder where Binary Ninja is installed  @path  <https://api.binary.ninja/index.html#binaryninja.get_install_directory>
get_unique_identifier()               # make a new GUID string  @uuid  <https://api.binary.ninja/index.html#binaryninja.get_unique_identifier>
connect_vscode_debugger(port=5678)    # wait for VS Code to attach a Python debugger  @debug @debugpy  <https://api.binary.ninja/index.html#binaryninja.connect_vscode_debugger>
connect_pycharm_debugger(port=5678)   # attach to a PyCharm debug server  <https://api.binary.ninja/index.html#binaryninja.connect_pycharm_debugger>
get_memory_usage_info()               # count core objects in memory to find leaks  @leak  <https://api.binary.ninja/index.html#binaryninja.get_memory_usage_info>

## user interaction and reports
; Talk to the user from a script: ask for a value, a file or a choice, or show a result.
; Works in the UI. In headless mode the questions go to the terminal.
get_text_line_input("PROMPT", "TITLE")  # ask the user for a line of text, None on cancel  <https://api.binary.ninja/binaryninja.interaction-module.html#binaryninja.interaction.get_text_line_input>
get_int_input("PROMPT", "TITLE")      # ask the user for an integer  @number  <https://api.binary.ninja/binaryninja.interaction-module.html#binaryninja.interaction.get_int_input>
get_address_input("PROMPT", "TITLE")  # ask the user for an address or expression  <https://api.binary.ninja/binaryninja.interaction-module.html#binaryninja.interaction.get_address_input>
get_choice_input("PROMPT", "TITLE", ["a", "b"])  # ask the user to pick one item, returns its index  @select @combo  <https://api.binary.ninja/binaryninja.interaction-module.html#binaryninja.interaction.get_choice_input>
get_large_choice_input("PROMPT", "TITLE", ITEMS)  # ask the user to pick from a long filterable list  @search  <https://api.binary.ninja/binaryninja.interaction-module.html#binaryninja.interaction.get_large_choice_input>
get_open_filename_input("PROMPT", "*.json")  # ask the user for a file to open  @dialog  <https://api.binary.ninja/binaryninja.interaction-module.html#binaryninja.interaction.get_open_filename_input>
get_save_filename_input("PROMPT", "json", "out.json")  # ask the user for a file to save to  @dialog  <https://api.binary.ninja/binaryninja.interaction-module.html#binaryninja.interaction.get_save_filename_input>
get_directory_name_input("PROMPT")    # ask the user for a folder  <https://api.binary.ninja/binaryninja.interaction-module.html#binaryninja.interaction.get_directory_name_input>
get_checkbox_input("PROMPT", "TITLE", default=False)  # ask the user a yes/no question with a checkbox  @bool  <https://api.binary.ninja/binaryninja.interaction-module.html#binaryninja.interaction.get_checkbox_input>
get_form_input([FIELD, ...], "TITLE")  # show a dialog with many fields, values land in FIELD.result  @prompt  <https://api.binary.ninja/binaryninja.interaction-module.html#binaryninja.interaction.get_form_input>
    a = TextLineField("Name"); n = IntegerField("Count")
    c = ChoiceField("Mode", ["fast", "full"]); f = OpenFileNameField("Input")
    if get_form_input([a, SeparatorField(), n, c, f], "Options"):
        print(a.result, n.result, c.result, f.result)
show_message_box("TITLE", "TEXT", MessageBoxButtonSet.YesNoButtonSet)  # show a message box and return the button pressed  @popup  <https://api.binary.ninja/binaryninja.interaction-module.html#binaryninja.interaction.show_message_box>
show_plain_text_report("TITLE", TEXT)  # show text in a new tab (prints in headless)  @output  <https://api.binary.ninja/binaryninja.interaction-module.html#binaryninja.interaction.show_plain_text_report>
show_markdown_report("TITLE", MD)     # show rendered markdown in a new tab  <https://api.binary.ninja/binaryninja.interaction-module.html#binaryninja.interaction.show_markdown_report>
show_html_report("TITLE", HTML)       # show an HTML page in a new tab  <https://api.binary.ninja/binaryninja.interaction-module.html#binaryninja.interaction.show_html_report>
show_graph_report("TITLE", GRAPH)     # show a FlowGraph in a new tab  <https://api.binary.ninja/binaryninja.interaction-module.html#binaryninja.interaction.show_graph_report>
show_report_collection("TITLE", REPORTS)  # show several reports in one tab  <https://api.binary.ninja/binaryninja.interaction-module.html#binaryninja.interaction.show_report_collection>
open_url(URL)                         # open a link in the user's web browser  <https://api.binary.ninja/binaryninja.interaction-module.html#binaryninja.interaction.open_url>
run_progress_dialog("TITLE", True, TASK)  # run TASK(progress_cb) in the background with a progress dialog  <https://api.binary.ninja/binaryninja.interaction-module.html#binaryninja.interaction.run_progress_dialog>
bv.navigate(bv.view, ADDR)            # move the UI to an address in the current view  @goto @jump  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.navigate>
bv.file.navigate(bv.view, ADDR)       # move the UI to an address  @goto @jump  <https://api.binary.ninja/binaryninja.filemetadata-module.html#binaryninja.filemetadata.FileMetadata.navigate>

## guides and references
; The official places to read more when a one-line note is not enough.
https://api.binary.ninja/  # open the Python API reference  @docs  <https://api.binary.ninja/>
https://docs.binary.ninja/dev/cookbook.html  # open the official snippets cookbook  @recipes @examples  <https://docs.binary.ninja/dev/cookbook.html>
https://docs.binary.ninja/dev/concepts.html  # read the core concepts (views, functions, analysis)  @learn  <https://docs.binary.ninja/dev/concepts.html>
https://docs.binary.ninja/dev/bnil-overview.html  # read the BNIL (LLIL/MLIL/HLIL) overview  @il @learn  <https://docs.binary.ninja/dev/bnil-overview.html>
https://docs.binary.ninja/dev/annotation.html  # read how to apply symbols, tags and types  @learn  <https://docs.binary.ninja/dev/annotation.html>
https://docs.binary.ninja/dev/batch.html  # read how to run headless batch scripts  <https://docs.binary.ninja/dev/batch.html>
https://docs.binary.ninja/dev/workflows.html  # read the workflows and activities guide  @workflow  <https://docs.binary.ninja/dev/workflows.html>
https://docs.binary.ninja/guide/settings.html  # list every setting key with its meaning  @config  <https://docs.binary.ninja/guide/settings.html>

; ===============  binaryview.sheet
; title: binary ninja binaryview
; url:   https://api.binary.ninja/binaryninja.binaryview-module.html
; tags:  binaryninja binja bn python api bv binaryview memory bytes symbols xrefs strings sections segments

; bv = BinaryView. ADDR = virtual address. UPPERCASE words are placeholders.

## file facts
; Basic facts about the open file: where it starts and ends, its entry point,
; its format and its CPU.
bv.start / bv.end               # # get the lowest and highest+1 mapped address  @range @bounds  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.start>
bv.length                       # # get the size of the mapped address range (end - start)  @len  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.length>
bv.entry_point                  # # get the entry point address  @main @start  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.entry_point>
bv.entry_function               # get the Function at the entry point  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.entry_function>
bv.entry_functions              # list all entry functions (entry, init arrays, TLS callbacks...)  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.entry_functions>
bv.image_base                   # get the base address the file was loaded at  @rebase  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.image_base>
bv.original_image_base          # get the base address written in the file header  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.original_image_base>
bv.arch                         # get the default Architecture of the view  @cpu @isa  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.arch>
bv.platform                     # # get the default Platform (arch + OS) of the view  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.platform>
bv.endianness                   # get the byte order (Endianness.LittleEndian / BigEndian)  @endian  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.endianness>
bv.address_size                 # get the pointer size in bytes  @bits @32 @64  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.address_size>
bv.executable / bv.relocatable  # check whether the file is executable or position independent  @pie @pic  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.relocatable>
bv.libraries                    # list the shared libraries the file imports  @dll @so @needed  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.libraries>
bv.session_data                 # get a dict for plugin data that lives until the file closes  @cache @state  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.session_data>
bv.rebase(ADDR)                 # rebase to a new image base and return the new view  @relocate  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.rebase>

## read bytes and values
; Read raw bytes or numbers from the file at an address, the same way the program
; would see them in memory.
bv.read(ADDR, N)                      # # read N bytes at ADDR  @memory  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.read>
bv[ADDR:ADDR+N]                       # read a byte slice at ADDR  @bytes  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView>
bv.read_int(ADDR, 4, sign=False)      # # read an integer of a given size with the view's endianness  @dword @u32  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.read_int>
bv.read_pointer(ADDR)                 # # read a pointer-sized value  @ptr @qword  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.read_pointer>
bv.read_uuid(ADDR)                    # read a 16 byte GUID/UUID  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.read_uuid>
bv.get_ascii_string_at(ADDR, min_length=4)  # read a C string at ADDR, None if not one  @cstring  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_ascii_string_at>
bv.typed_data_accessor(ADDR, TYPE).value  # read memory decoded as a Type (struct fields, arrays...)  @parse @decode  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.typed_data_accessor>
bv.typed_data_accessor(ADDR, TYPE)["FIELD"]  # read one struct field as a typed accessor  @member  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.TypedDataAccessor>
bv.get_data_var_at(ADDR).value        # read the decoded value of a defined data variable  @global  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.DataVariable.value>
br = bv.reader(ADDR)                  # make a BinaryReader that reads forward from ADDR  @stream @cursor  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.reader>
br.read32() / br.read64()             # read an int and advance (also read8, read16, read32le, read64be...)  @stream  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryReader.read32>
br.read(N)                            # read N bytes and advance  @stream  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryReader.read>
br.seek(ADDR) / br.seek_relative(N)   # move the reader cursor  @stream @offset  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryReader.seek>
br.offset                             # get or set the reader position  @stream  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryReader.offset>
BinaryReader(bv, Endianness.BigEndian)  # make a reader with a forced byte order  @endian  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryReader>
bv.get_entropy(ADDR, N)               # compute Shannon entropy for blocks of a range  @packed @encrypted @compressed  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_entropy>
bv.get_disassembly(ADDR)              # get the disassembly text of one instruction  @asm  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_disassembly>
bv.get_instruction_length(ADDR)       # get the size in bytes of the instruction at ADDR  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_instruction_length>
bv.instructions                       # iterate (tokens, addr) of every instruction in all functions  @asm  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.instructions>
bv.eval("main + 0x10")                # evaluate an address expression (symbols, math, [deref]) to an int  @parse  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.eval>
bv.parse_expression(EXPR, here=ADDR)  # evaluate an address expression relative to ADDR  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.parse_expression>

## write and patch
; Change the bytes of the file. Use it to patch code or data,
; then save a new binary.
bv.write(ADDR, DATA)                 # overwrite bytes at ADDR, returns the count written  @patch @modify  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.write>
bv[ADDR] = b"\x90"                   # overwrite bytes at ADDR with slice syntax  @patch  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView>
bv.insert(ADDR, DATA)                # insert bytes and shift the rest (raw views only)  @patch @grow  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.insert>
bv.remove(ADDR, N)                   # delete N bytes and shift the rest (raw views only)  @patch @cut  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.remove>
bw = bv.writer(ADDR)                 # make a BinaryWriter that writes forward from ADDR  @stream  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.writer>
bw.write32(VAL)                      # write an int and advance (also write8, write16le, write64be...)  @stream  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryWriter.write32>
bv.write(ADDR, bv.arch.assemble("nop; ret", ADDR))  # assemble text and patch it in  @asm  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture.assemble>
bv.convert_to_nop(ADDR)              # replace the instruction at ADDR with nops  @patch  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.convert_to_nop>
bv.always_branch(ADDR)               # patch a conditional branch to always jump  @jmp  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.always_branch>
bv.never_branch(ADDR)                # patch a conditional branch to never jump  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.never_branch>
bv.invert_branch(ADDR)               # patch a conditional branch to its opposite (je <-> jne)  @flip  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.invert_branch>
bv.skip_and_return_value(ADDR, VAL)  # patch a call so it sets the return register to VAL  @stub  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.skip_and_return_value>
bv.is_invert_branch_patch_available(ADDR)  # check whether the branch at ADDR can be inverted  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.is_invert_branch_patch_available>
bv.get_modification(ADDR, N)         # list ModificationStatus for each byte (Original, Changed, Inserted)  @diff  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_modification>
bv.save(PATH)                        # write the patched file to disk  @export @patch  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.save>

## address checks
; Ask questions about an address: is it in the file? Can it be read, written
; or run? Is it code or data?
ADDR in bv                           # check whether ADDR is mapped  @valid  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView>
bv.is_valid_offset(ADDR)             # check whether ADDR is mapped  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.is_valid_offset>
bv.is_offset_readable(ADDR)          # check whether ADDR is readable  @permission @r  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.is_offset_readable>
bv.is_offset_writable(ADDR)          # check whether ADDR is writable  @permission @w  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.is_offset_writable>
bv.is_offset_executable(ADDR)        # check whether ADDR is executable  @permission @x @code  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.is_offset_executable>
bv.is_offset_backed_by_file(ADDR)    # check whether ADDR has file bytes (not .bss)  @zero  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.is_offset_backed_by_file>
bv.is_offset_code_semantics(ADDR)    # check whether ADDR is in a code section  @text  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.is_offset_code_semantics>
bv.is_offset_extern_semantics(ADDR)  # check whether ADDR is in an extern section  @import  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.is_offset_extern_semantics>
bv.is_offset_readonly_semantics(ADDR)  # check whether ADDR is in a read-only data section  @rodata @const  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.is_offset_readonly_semantics>
bv.get_next_valid_offset(ADDR)       # get the next mapped address at or after ADDR  @skip @gap  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_next_valid_offset>
bv.mapped_address_ranges             # list mapped address ranges  @memory  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.mapped_address_ranges>
bv.backed_address_ranges             # list address ranges backed by file data  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.backed_address_ranges>

## segments, sections, memory map
; How the file is placed in memory. Segments are the big memory areas with
; permissions. Sections are named parts like .text or .data.
bv.segments                           # list the Segments (memory mappings from the file)  @program-headers @phdr  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.segments>
bv.get_segment_at(ADDR)               # get the Segment that holds ADDR  @mapping  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_segment_at>
seg.start, seg.end, seg.readable, seg.writable, seg.executable  # read the range and permissions of a Segment  @rwx  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.Segment>
seg.data_offset / seg.data_length     # get the file offset and size behind a Segment  @fileoffset  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.Segment.data_offset>
bv.sections                           # get a dict of Section by name  @section-headers @shdr  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.sections>
bv.sections[".text"]                  # get one section by name  @code  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.sections>
bv.get_section_by_name(".data")       # get one section by name, None if missing  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_section_by_name>
bv.get_sections_at(ADDR)              # list the sections that hold ADDR  @section  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_sections_at>
sec.name, sec.start, sec.end, sec.semantics  # read a Section's name, range and SectionSemantics  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.Section>
bv.get_address_for_data_offset(OFF)   # map a file offset to a virtual address  @fileoffset @va @convert  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_address_for_data_offset>
bv.get_data_offset_for_address(ADDR)  # map a virtual address to a file offset  @fileoffset @rva @convert  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_data_offset_for_address>
bv.add_user_segment(ADDR, LEN, OFF, DLEN, FLAGS)  # map file bytes at OFF to ADDR as a new segment  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.add_user_segment>
    bv.add_user_segment(0x1000, 0x2000, 0, 0x2000,
        SegmentFlag.SegmentReadable | SegmentFlag.SegmentExecutable)
bv.remove_user_segment(ADDR)          # remove a segment you added  @unmap @delete  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.remove_user_segment>
bv.add_user_section(NAME, ADDR, LEN, SectionSemantics.ReadOnlyCodeSectionSemantics)  # mark a range as a named code section  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.add_user_section>
bv.remove_user_section(NAME)          # remove a section you added  @delete  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.remove_user_section>
bv.memory_map                         # get the MemoryMap of regions layered over the view  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.memory_map>
bv.memory_map.add_memory_region(NAME, ADDR, DATA)  # add a memory region filled from bytes, a file or a view  @overlay  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.MemoryMap.add_memory_region>
bv.memory_map.add_memory_region(NAME, ADDR, length=N, fill=0)  # add a zero-filled region, e.g. RAM or MMIO  @bss  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.MemoryMap.add_memory_region>
bv.memory_map.remove_memory_region(NAME)  # remove a memory region by name  @unmap  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.MemoryMap.remove_memory_region>
bv.memory_map.regions                 # list all memory regions  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.MemoryMap.regions>
bv.relocations_at(ADDR)               # list relocations that patch ADDR  @reloc @fixup  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.relocations_at>
bv.relocation_ranges                  # list (start, end) of every relocated range  @reloc  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.relocation_ranges>

## functions
; Find, list, add and remove the functions Binary Ninja found in the file.
bv.functions                       # iterate every Function in the view  @all @list  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.functions>
for f in bv:                       # iterate every Function in the view  @loop  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView>
len(bv.functions)                  # count the functions  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.functions>
bv.get_function_at(ADDR)           # get the Function that starts at ADDR  @lookup  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_function_at>
bv.get_functions_containing(ADDR)  # list Functions whose code holds ADDR  @lookup @owner  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_functions_containing>
bv.get_functions_by_name("main")   # # list Functions with this name  @lookup @find  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_functions_by_name>
bv.get_functions_at(ADDR)          # list Functions at ADDR, one per platform  @lookup  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_functions_at>
bv.create_user_function(ADDR)      # make a function at ADDR as a user action  @define @add  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.create_user_function>
bv.add_function(ADDR)              # make an auto function at ADDR (for loaders/plugins)  @define  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.add_function>
bv.remove_user_function(F)         # delete a function as a user action  @undefine  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.remove_user_function>
bv.add_entry_point(ADDR)           # add an extra address to start analysis from  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.add_entry_point>
bv.get_next_function_start_after(ADDR)  # get the start address of the next function  @walk  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_next_function_start_after>
bv.get_previous_function_start_before(ADDR)  # get the start address of the previous function  @walk @prev  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_previous_function_start_before>
bv.get_basic_blocks_at(ADDR)       # list BasicBlocks that hold ADDR  @block  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_basic_blocks_at>
bv.get_basic_blocks_starting_at(ADDR)  # list BasicBlocks that start at ADDR  @block  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_basic_blocks_starting_at>
bv.basic_blocks                    # iterate every BasicBlock in the view  @block @all  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.basic_blocks>
bv.llil_instructions / bv.mlil_instructions / bv.hlil_instructions  # iterate every IL instruction of every function  @all  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.hlil_instructions>
bv.hlil_functions()                # iterate HLIL of all functions, generated in the background for speed  @il @fast  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.hlil_functions>
bv.mlil_functions()                # iterate MLIL of all functions, generated in the background for speed  @il @fast  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.mlil_functions>

## symbols and names
; A symbol is a name for an address, like a function or a global variable name.
; Use these to find things by name or to rename them.
bv.symbols                            # get a mapping name -> list of Symbols  @names @all  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.symbols>
bv.get_symbol_at(ADDR)                # get the Symbol at ADDR  @name @label  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_symbol_at>
bv.get_symbols_by_name("printf")      # list Symbols with this name  @lookup @find  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_symbols_by_name>
bv.get_symbol_by_raw_name(MANGLED)    # get a Symbol by its raw (mangled) name  @lookup  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_symbol_by_raw_name>
bv.get_symbols(ADDR, LEN)             # list Symbols in a range  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_symbols>
bv.get_symbols_of_type(SymbolType.ImportedFunctionSymbol)  # list Symbols of one kind, e.g. imports  @exports  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_symbols_of_type>
bv.define_user_symbol(Symbol(SymbolType.FunctionSymbol, ADDR, "name"))  # name an address as a user action  @rename  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.define_user_symbol>
bv.define_user_symbol(Symbol(SymbolType.DataSymbol, ADDR, "g_var"))  # name a global data address  @rename  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.define_user_symbol>
bv.undefine_user_symbol(SYM)          # remove a user symbol  @delete @unname  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.undefine_user_symbol>
bv.define_auto_symbol(SYM)            # add an auto symbol (for loaders/plugins)  @loader  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.define_auto_symbol>
bv.define_auto_symbol_and_var_or_function(SYM, TYPE)  # add a symbol and create the function or data var with its type  @loader  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.define_auto_symbol_and_var_or_function>
with bv.bulk_modify_symbols():        # add or remove many symbols fast  @speed @batch  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.bulk_modify_symbols>
sym.name / sym.full_name / sym.raw_name  # read a Symbol's short, full and raw (mangled) name  @demangle  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.CoreSymbol.full_name>
sym.type / sym.address / sym.binding  # read a Symbol's SymbolType, address and binding  @kind  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.CoreSymbol.type>
bv.namespaces                         # list symbol namespaces (one per imported library on some formats)  @namespace  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.namespaces>

## data variables and strings
; Data variables are typed values in memory, like globals and tables.
; Strings are the text Binary Ninja found in the file.
bv.data_vars                        # get a dict addr -> DataVariable  @globals  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.data_vars>
bv.get_data_var_at(ADDR)            # get the DataVariable at ADDR  @global @lookup  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_data_var_at>
bv.define_user_data_var(ADDR, TYPE, "name")  # type (and optionally name) a global as a user action  @apply-type  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.define_user_data_var>
bv.define_user_data_var(ADDR, "uint32_t[4]")  # type a global with a C type string  @array  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.define_user_data_var>
bv.undefine_user_data_var(ADDR)     # remove a user data variable  @delete  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.undefine_user_data_var>
bv.define_data_var(ADDR, TYPE)      # add an auto data variable (for loaders/plugins)  @loader  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.define_data_var>
dv.name / dv.type / dv.value        # read or set a DataVariable's name, type and decoded value  @rename @retype  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.DataVariable>
dv.code_refs / dv.data_refs         # list code and data references to a DataVariable  @xrefs  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.DataVariable.code_refs>
bv.get_next_data_var_after(ADDR)    # get the next DataVariable after ADDR  @walk  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_next_data_var_after>
bv.get_previous_data_var_before(ADDR)  # get the previous DataVariable before ADDR  @walk  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_previous_data_var_before>
bv.strings                          # list every found string as StringReference  @all  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.strings>
bv.get_strings(ADDR, LEN)           # list strings found in a range  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_strings>
bv.get_string_at(ADDR)              # # get the StringReference at ADDR, None if none  @lookup  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_string_at>
s.value, s.start, s.length, s.type  # # read a StringReference's text, address, size and StringType  @ascii @utf16  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.StringReference>
bv.derived_strings                  # list strings built by code, e.g. stack strings or decoded strings  @deobfuscate  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.derived_strings>

## search
; Find bytes, text or constant values anywhere in the file.
bv.find_next_data(ADDR, b"\x7fELF")   # find the next exact byte match at or after ADDR  @bytes @grep  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.find_next_data>
bv.find_all_data(START, END, DATA)    # iterate (addr, DataBuffer) of every byte match in a range  @bytes @findall  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.find_all_data>
bv.find_next_text(ADDR, "TEXT")       # find text in the disassembly/IL output after ADDR  @string @grep  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.find_next_text>
bv.find_all_text(START, END, "TEXT")  # iterate every match of text in the rendered output  @string @findall  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.find_all_text>
bv.find_next_constant(ADDR, 0xDEADBEEF)  # find the next instruction using a constant  @immediate @magic  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.find_next_constant>
bv.find_all_constant(START, END, CONST)  # iterate every use of a constant in a range  @immediate  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.find_all_constant>
bv.search("E8 ?? ?? ?? ??")           # search bytes with wildcards, YARA hex or regex, yields (addr, match)  @pattern  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.search>
bv.search("[\x20-\x7e]{8,}", mode="regex")  # search with a forced regex mode  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.search>
bv.search(PATTERN, start=A, end=B, limit=N)  # search only part of the view and stop after N hits  @range  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.search>
BinaryView.detect_search_mode(PATTERN)  # show which mode search() would use for a pattern  @debug  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.detect_search_mode>

## cross references
; Cross references (xrefs) tell you who uses an address.
; Use them to see where a function is called or where data is read.
bv.get_code_refs(ADDR)               # iterate code locations that reference ADDR (ReferenceSource)  @xrefs @to @callers  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_code_refs>
ref.function, ref.address, ref.arch  # read where a ReferenceSource comes from  @xrefs  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.ReferenceSource>
ref.llil / ref.mlil / ref.hlil       # get the IL instruction at a reference site  @xrefs  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.ReferenceSource.hlil>
bv.get_code_refs_from(ADDR)          # list addresses referenced by the instruction at ADDR  @xrefs  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_code_refs_from>
bv.get_data_refs(ADDR)               # iterate data addresses (pointers) that reference ADDR  @xrefs @to @pointer  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_data_refs>
bv.get_data_refs_from(ADDR)          # list addresses referenced by data at ADDR  @xrefs  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_data_refs_from>
bv.get_callers(ADDR)                 # iterate call sites that call ADDR  @xrefs @calls  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_callers>
bv.get_callees(ADDR)                 # list addresses called by the call at ADDR  @xrefs @calls  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_callees>
bv.get_code_refs_for_type("struct_name")  # iterate code that uses a type  @xrefs  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_code_refs_for_type>
bv.get_code_refs_for_type_field("struct_name", OFFSET)  # iterate code that touches one struct field  @xrefs @member  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_code_refs_for_type_field>
bv.get_data_refs_for_type("struct_name")  # list data addresses typed with a type  @xrefs  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_data_refs_for_type>
bv.get_type_refs_for_type("struct_name")  # list other types that use a type  @xrefs  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_type_refs_for_type>
bv.add_user_data_ref(FROM, TO)       # add a manual data xref  @xrefs  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.add_user_data_ref>
bv.remove_user_data_ref(FROM, TO)    # delete a manual data xref  @xrefs  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.remove_user_data_ref>

## comments
; Notes you attach to an address. They show next to the code in the UI.
bv.set_comment_at(ADDR, "TEXT")  # set a comment at an address (data or code, not tied to a function)  @annotate @note  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.set_comment_at>
bv.get_comment_at(ADDR)          # read the address comment at ADDR  @annotate  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_comment_at>
bv.address_comments              # get a dict addr -> comment of address comments  @all  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.address_comments>

## tags and bookmarks
; Tags are labels with an icon that you put on addresses or functions.
; Use them to mark interesting places and find them again later.
bv.tag_types                        # get a dict name -> TagType  @tags  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.tag_types>
bv.create_tag_type("Crypto", "🔑")   # make a new tag type with a name and emoji icon  @tags  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.create_tag_type>
bv.get_tag_type("Bookmarks")        # get a tag type by name  @tags  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_tag_type>
bv.add_tag(ADDR, "Bookmarks", "TEXT")  # put a data tag at an address  @bookmark @mark  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.add_tag>
bv.tags                             # list (addr, Tag) for all data tags  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.tags>
bv.tags_all_scopes                  # list (addr, Tag) for data, function and address tags  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.tags_all_scopes>
bv.get_tags_at(ADDR)                # list data tags at ADDR  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_tags_at>
bv.tags_by_type(bv.get_tag_type("Bookmarks"))  # list (addr, Tag) of one tag type  @filter  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.tags_by_type>
bv.remove_user_data_tag(ADDR, TAG)  # delete one data tag  @tags  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.remove_user_data_tag>
bv.remove_user_data_tags_of_type(ADDR, "Bookmarks")  # delete all data tags of a type at ADDR  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.remove_user_data_tags_of_type>
bv.remove_tag_type("Crypto")        # delete a tag type and all its tags  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.remove_tag_type>

## metadata storage
; Save your own data (numbers, text, lists) inside the .bndb file.
; Use it to keep the results of a plugin between sessions.
bv.store_metadata("key", VALUE)  # save a value (int, str, bytes, list, dict) into the .bndb  @persist @plugin-data  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.store_metadata>
bv.query_metadata("key")         # read stored metadata, raises KeyError if missing  @persist @load  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.query_metadata>
bv.get_metadata("key", DEFAULT)  # read stored metadata or a default  @persist  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_metadata>
bv.remove_metadata("key")        # delete stored metadata  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.remove_metadata>
bv.metadata                      # get all stored metadata as a dict-like Metadata  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.metadata>
bv.session_data["key"] = VALUE   # keep plugin data for this session only (not saved)  @cache @ephemeral  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.session_data>

## components (folders for functions)
; Components are folders. Use them to put related functions and data in groups
; so a big binary is easier to read.
bv.root_component                 # get the top component (folder tree in the sidebar)  @folders @group @organize  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.root_component>
bv.create_component("NAME")       # make a new component under the root  @folder  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.create_component>
comp.add_function(F)              # put a function into a component  @folder @group  <https://api.binary.ninja/binaryninja.component-module.html#binaryninja.component.Component.add_function>
comp.add_data_variable(DV)        # put a data variable into a component  @folder  <https://api.binary.ninja/binaryninja.component-module.html#binaryninja.component.Component.add_data_variable>
comp.functions / comp.components  # iterate the functions and sub-components of a component  @folder  <https://api.binary.ninja/binaryninja.component-module.html#binaryninja.component.Component.functions>
bv.get_component_by_path("a/b")   # get a component by its path  @folder @lookup  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_component_by_path>
bv.remove_component(COMP)         # delete a component (its functions stay)  @folder  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.remove_component>

## external libraries and links
; Record which libraries the file imports from, and link an import to
; the real function in another file.
bv.add_external_library("libc.so.6", PROJECT_FILE)  # record a linked library, optionally backed by a project file  @imports  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.add_external_library>
bv.add_external_location(SYM, LIB, "target", TARGET_ADDR)  # point an import at a symbol/address in another library  @imports  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.add_external_location>
bv.get_external_libraries()  # list ExternalLibrary objects  @imports  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_external_libraries>
bv.get_external_locations()  # list ExternalLocation links  @imports  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_external_locations>

## linear disassembly
; The linear view shows the whole file from top to bottom as text.
; Use it to print or export everything at once.
bv.linear_disassembly                # iterate every line of the linear view as text lines  @dump @listing  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.linear_disassembly>
bv.get_linear_disassembly(SETTINGS)  # iterate linear view lines with custom DisassemblySettings  @listing  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_linear_disassembly>
LinearViewObject.language_representation(bv)  # build a linear view of pseudo C for the whole file  @decompile @export  <https://api.binary.ninja/binaryninja.lineardisassembly-module.html#binaryninja.lineardisassembly.LinearViewObject.language_representation>
LinearViewCursor(LinearViewObject.disassembly(bv))  # make a cursor that walks the linear view  @listing  <https://api.binary.ninja/binaryninja.lineardisassembly-module.html#binaryninja.lineardisassembly.LinearViewCursor>
    obj = LinearViewObject.language_representation(bv)
    cur = LinearViewCursor(obj)
    while True:
        for line in cur.lines: print(line)
        if not cur.next(): break

## events and notifications
; Get a call from Binary Ninja when something in the file changes,
; for example a new function, a new name or patched bytes.
bv.register_notification(OBJ)    # get callbacks when functions, symbols, data vars, types... change  @events @listen  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.register_notification>
    class Watch(BinaryDataNotification):
        def __init__(self):
            super().__init__(NotificationType.FunctionUpdated | NotificationType.SymbolUpdated)
        def function_updated(self, view, func): log_info(f"changed {func.name}")
        def symbol_updated(self, view, sym): log_info(f"renamed {sym.name}")
    bv.register_notification(Watch())
bv.unregister_notification(OBJ)  # stop receiving notifications  @events  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.unregister_notification>
BinaryDataNotification.data_written(view, offset, length)  # callback for patched bytes  @events @write  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryDataNotification.data_written>
BinaryDataNotification.function_added(view, func)  # callback for new functions (also function_removed)  @events  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryDataNotification.function_added>
BinaryDataNotification.data_var_added(view, var)  # callback for new data variables  @events  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryDataNotification.data_var_added>
BinaryDataNotification.type_defined(view, name, type)  # callback for new or changed types  @events  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryDataNotification.type_defined>
BinaryDataNotification.tag_added(view, tag, ref_type, auto, arch, func, addr)  # callback for new tags  @events  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryDataNotification.tag_added>
BinaryDataNotification.notification_barrier(view)  # batch callback, return ms until the next one (0 to pause)  @events  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryDataNotification.notification_barrier>
BinaryViewType.add_binaryview_initial_analysis_completion_event(CB)  # run CB(bv) when any view finishes first analysis  @events  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryViewType.add_binaryview_initial_analysis_completion_event>
BinaryViewType.add_binaryview_finalized_event(CB)  # run CB(bv) when any view finishes loading  @events @global  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryViewType.add_binaryview_finalized_event>

; ===============  function.sheet
; title: binary ninja function
; url:   https://api.binary.ninja/binaryninja.function-module.html
; tags:  binaryninja binja bn python api function basicblock variables callers callees decompile

; f = Function, bb = BasicBlock, v = Variable. UPPERCASE words are placeholders.

## identity
; Basic facts about one function: its name, address, CPU and size.
f.name                                # get the function name; assign to rename it  @symbol  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.name>
f.start                               # get the start address  @entry  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.start>
f.symbol                              # get the Symbol of the function  @name  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.symbol>
f.arch / f.platform                   # get the Architecture and Platform of the function  @cpu @os  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.platform>
f.view                                # get the BinaryView that owns the function  @bv  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.view>
f.lowest_address / f.highest_address  # get the lowest and highest address the function covers  @range @bounds  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.highest_address>
f.address_ranges                      # list AddressRange(start, end) covered by the function  @range @chunks  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.address_ranges>
f.total_bytes                         # get the total size of all basic blocks  @length  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.total_bytes>
f.auto                                # check whether analysis found it (False = user made)  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.auto>
f.is_exported                         # check whether the function is exported  @export  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.is_exported>
f.is_thunk                            # check whether the function is just a jump to another one  @stub @trampoline  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.is_thunk>
f.can_return                          # get or set whether the function returns (False = noreturn)  @exit  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.can_return>
f.is_pure                             # get or set whether the function has no side effects  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.is_pure>
f.too_large                           # check whether analysis skipped it for being too big  @skip @size  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.too_large>
f.analysis_skipped                    # get or set whether analysis was skipped; set False to force analysis  @skip  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.analysis_skipped>
f.analysis_skip_override = FunctionAnalysisSkipOverride.NeverSkipFunctionAnalysis  # always analyze this function, even if large  @force  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.analysis_skip_override>
f.needs_update                        # check whether the function is waiting for reanalysis  @stale  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.needs_update>

## prototype and type
; The prototype is the function's C signature: return type, name and parameters.
; Read it or change it to make the decompiled code better.
f.type                           # get the FunctionType; assign a C prototype string or Type to change it  @signature  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.type>
f.type = "int32_t main(int32_t argc, char** argv)"  # set the prototype (and name) from C  @signature @retype  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.type>
f.set_user_type(TYPE)            # set the prototype without renaming  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.set_user_type>
f.return_type                    # get or set the return Type  @ret  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.return_type>
f.parameter_vars                 # list the Variables used as parameters  @args @arguments @params  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.parameter_vars>
f.calling_convention             # get or set the CallingConvention  @cc @abi @cdecl @stdcall @fastcall  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.calling_convention>
f.calling_convention = f.arch.calling_conventions["stdcall"]  # change the calling convention by name  @cc  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.calling_convention>
f.has_variable_arguments         # get or set whether the function is varargs  @...  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.has_variable_arguments>
f.stack_adjustment               # get or set bytes the callee pops on return  @callee-cleanup  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.stack_adjustment>
f.clobbered_regs                 # get or set the registers the function changes  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.clobbered_regs>
f.return_regs                    # list registers that hold the return value  @ret  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.return_regs>
f.type_tokens                    # get the prototype as text tokens  @render  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.type_tokens>
f.inline_during_analysis = True  # inline this function's IL into its callers  @wrapper  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.inline_during_analysis>
bv.get_function_at(ADDR).apply_imported_types(SYM)  # apply type info from type libraries for a symbol  @imports  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.apply_imported_types>

## il and decompiled output
; Get the function as IL (Binary Ninja's own simple code) at low, medium or high level.
; High level IL is the decompiled code you see as pseudo C.
f.llil                       # get the LowLevelILFunction  @il @lowlevel  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.llil>
f.mlil                       # get the MediumLevelILFunction  @il @mediumlevel  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.mlil>
f.hlil                       # get the HighLevelILFunction (decompiler output)  @il @decompile @highlevel  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.hlil>
f.lifted_il                  # get the raw lifted LLIL before any cleanup  @lift  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.lifted_il>
f.mmlil                      # get the mapped MLIL (MLIL before dead store removal)  @il  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.mmlil>
f.llil.ssa_form / f.mlil.ssa_form / f.hlil.ssa_form  # get the SSA form of an IL level  @phi  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.mlil>
f.hlil_if_available          # get HLIL only if already generated, else None (no work triggered)  @fast @cache  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.hlil_if_available>
str(f.hlil)                  # get the decompiled function as text  @decompile @pseudocode @print  <https://api.binary.ninja/binaryninja.highlevelil-module.html#binaryninja.highlevelil.HighLevelILFunction>
f.hlil.root.lines            # list the HLIL text lines of the whole function  @decompile  <https://api.binary.ninja/binaryninja.highlevelil-module.html#binaryninja.highlevelil.HighLevelILInstruction.lines>
f.pseudo_c.get_linear_lines(f.hlil.root)  # get the Pseudo C lines of the function  @decompile @pseudocode  <https://api.binary.ninja/binaryninja.languagerepresentation-module.html#binaryninja.languagerepresentation.LanguageRepresentationFunction.get_linear_lines>
    for line in f.pseudo_c.get_linear_lines(f.hlil.root):
        print(str(line))
f.language_representation("Pseudo Rust")  # get another decompiler language output (Pseudo Rust, Pseudo Python...)  @decompile  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.language_representation>
f.get_llil_at(ADDR)          # get the LLIL instruction at ADDR  @il @lookup  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.get_llil_at>
f.get_llils_at(ADDR)         # list all LLIL instructions at ADDR  @il @lookup  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.get_llils_at>
f.get_lifted_il_at(ADDR)     # get the lifted IL instruction at ADDR  @lookup  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.get_lifted_il_at>
f.get_llil_at(ADDR).hlil     # get the HLIL that came from the instruction at ADDR  @il @map @decompile  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILInstruction.hlil>
f.instructions               # iterate (tokens, addr) of each assembly instruction  @asm @disassembly  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.instructions>
f.get_instruction_containing_address(ADDR)  # get the start of the instruction that holds ADDR  @asm  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.get_instruction_containing_address>
f.is_call_instruction(ADDR)  # check whether the instruction at ADDR is a call  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.is_call_instruction>

## basic blocks and control flow
; A basic block is a piece of code that runs from start to end with no jumps inside.
; Blocks and the edges between them make the function's graph.
f.basic_blocks                      # list the assembly BasicBlocks  @cfg  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.basic_blocks>
f.get_basic_block_at(ADDR)          # get the BasicBlock that holds ADDR  @lookup  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.get_basic_block_at>
f.llil.basic_blocks / f.mlil.basic_blocks / f.hlil.basic_blocks  # list the IL basic blocks  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.basic_blocks>
bb.start / bb.end / bb.length       # get the range of a BasicBlock (end is exclusive)  <https://api.binary.ninja/binaryninja.basicblock-module.html#binaryninja.basicblock.BasicBlock.start>
bb.index                            # get the position of a block in its function  @id  <https://api.binary.ninja/binaryninja.basicblock-module.html#binaryninja.basicblock.BasicBlock.index>
for tokens, size in bb:             # # iterate (tokens, size) of each instruction in an assembly block  @asm  <https://api.binary.ninja/binaryninja.basicblock-module.html#binaryninja.basicblock.BasicBlock>
for insn in il_bb:                  # iterate the IL instructions of an IL block  <https://api.binary.ninja/binaryninja.basicblock-module.html#binaryninja.basicblock.BasicBlock>
bb.outgoing_edges / bb.incoming_edges  # list BasicBlockEdge to successors / from predecessors  @cfg  <https://api.binary.ninja/binaryninja.basicblock-module.html#binaryninja.basicblock.BasicBlock.outgoing_edges>
edge.type, edge.source, edge.target, edge.back_edge  # read an edge's BranchType, ends and whether it is a loop back edge  @branch  <https://api.binary.ninja/binaryninja.basicblock-module.html#binaryninja.basicblock.BasicBlockEdge>
bb.dominators / bb.post_dominators  # list blocks that dominate / post-dominate this block  @dominance @graph  <https://api.binary.ninja/binaryninja.basicblock-module.html#binaryninja.basicblock.BasicBlock.dominators>
bb.immediate_dominator              # get the closest dominator of a block  @dominance @idom  <https://api.binary.ninja/binaryninja.basicblock-module.html#binaryninja.basicblock.BasicBlock.immediate_dominator>
bb.dominance_frontier               # list the dominance frontier of a block  @phi  <https://api.binary.ninja/binaryninja.basicblock-module.html#binaryninja.basicblock.BasicBlock.dominance_frontier>
bb.dominator_tree_children          # list child blocks in the dominator tree  @dominance  <https://api.binary.ninja/binaryninja.basicblock-module.html#binaryninja.basicblock.BasicBlock.dominator_tree_children>
bb.can_exit                         # check whether the block can return (False after a noreturn call)  <https://api.binary.ninja/binaryninja.basicblock-module.html#binaryninja.basicblock.BasicBlock.can_exit>
bb.has_undetermined_outgoing_edges  # check whether the block ends in an unresolved jump  @indirect @switch  <https://api.binary.ninja/binaryninja.basicblock-module.html#binaryninja.basicblock.BasicBlock.has_undetermined_outgoing_edges>
bb.source_block                     # get the assembly block behind an IL block  @map  <https://api.binary.ninja/binaryninja.basicblock-module.html#binaryninja.basicblock.BasicBlock.source_block>
bb.disassembly_text                 # list the DisassemblyTextLine of a block  @render  <https://api.binary.ninja/binaryninja.basicblock-module.html#binaryninja.basicblock.BasicBlock.disassembly_text>
f.indirect_branches                 # list indirect jump sites and their targets  @switch @jumptable  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.indirect_branches>
f.set_user_indirect_branches(ADDR, [(ARCH, TARGET), ...])  # set the targets of an indirect jump by hand  @switch  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.set_user_indirect_branches>
f.add_guided_source_blocks([(ARCH, ADDR)])  # mark blocks for guided analysis (only analyze chosen paths)  @obfuscation  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.add_guided_source_blocks>
f.create_graph()                    # build a FlowGraph of the function (pass FunctionGraphType for IL)  @cfg  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.create_graph>

## variables
; The local variables and parameters of a function.
; Read them, rename them, or change their types.
f.vars                                # list all Variables of the function  @locals @stack  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.vars>
f.hlil.vars                           # list variables used in HLIL (what the decompiler shows)  @locals  <https://api.binary.ninja/binaryninja.highlevelil-module.html#binaryninja.highlevelil.HighLevelILFunction.vars>
f.hlil.aliased_vars                   # list variables whose address is taken  @alias @pointer  <https://api.binary.ninja/binaryninja.highlevelil-module.html#binaryninja.highlevelil.HighLevelILFunction.aliased_vars>
f.get_variable_by_name("var_10")      # get a Variable by name  @lookup  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.get_variable_by_name>
f.stack_layout                        # list stack variables sorted by offset  @frame  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.stack_layout>
v.name = "len"                        # rename a variable  <https://api.binary.ninja/binaryninja.variable-module.html#binaryninja.variable.Variable.name>
v.type = Type.int(4)                  # retype a variable (also takes a C string like "char*")  <https://api.binary.ninja/binaryninja.variable-module.html#binaryninja.variable.Variable.type>
v.set_name_and_type_async("len", "size_t")  # rename and retype without waiting for analysis (fast in loops)  @bulk  <https://api.binary.ninja/binaryninja.variable-module.html#binaryninja.variable.Variable.set_name_and_type_async>
v.source_type                         # get where a var lives: StackVariableSourceType, RegisterVariableSourceType...  @kind  <https://api.binary.ninja/binaryninja.variable-module.html#binaryninja.variable.CoreVariable.source_type>
v.storage                             # get the stack offset or register index of a variable  <https://api.binary.ninja/binaryninja.variable-module.html#binaryninja.variable.CoreVariable>
v.is_parameter_variable               # check whether a variable is a parameter  @args  <https://api.binary.ninja/binaryninja.variable-module.html#binaryninja.variable.Variable.is_parameter_variable>
v.offset_to_next_variable             # get the bytes until the next stack variable (rough max size)  @overflow  <https://api.binary.ninja/binaryninja.variable-module.html#binaryninja.variable.Variable.offset_to_next_variable>
f.create_user_var(VAR, TYPE, "name")  # set name and type of a variable as a user action  @define  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.create_user_var>
f.create_user_stack_var(OFFSET, TYPE, "name")  # make a stack variable at a frame offset  @define  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.create_user_stack_var>
f.delete_user_stack_var(OFFSET)       # delete a user stack variable  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.delete_user_stack_var>
f.get_stack_var_at_frame_offset(OFFSET, ADDR)  # get the stack variable at an offset, seen at ADDR  @lookup  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.get_stack_var_at_frame_offset>
f.merge_vars(TARGET, [SRC, ...])      # merge several variables into one  @combine  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.merge_vars>
f.split_var(VAR)                      # split a variable at its definition into a new variable  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.split_var>
f.get_mlil_var_refs(VAR)              # list MLIL places that use a variable  @xrefs @uses  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.get_mlil_var_refs>
f.get_hlil_var_refs(VAR)              # list HLIL places that use a variable  @xrefs @uses  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.get_hlil_var_refs>
v.dead_store_elimination = DeadStoreElimination.PreventDeadStoreElimination  # keep writes to a variable that look unused  @dse  <https://api.binary.ninja/binaryninja.variable-module.html#binaryninja.variable.Variable.dead_store_elimination>

## values and dataflow
; Ask what value a register, stack slot or argument has at one point in the code.
; Binary Ninja works this out for you.
f.get_reg_value_at(ADDR, "rdi")       # get what analysis knows about a register before ADDR  @dataflow @constant  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.get_reg_value_at>
f.get_reg_value_after(ADDR, "eax")    # get a register value after the instruction at ADDR  @dataflow  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.get_reg_value_after>
f.get_stack_contents_at(ADDR, OFFSET, SIZE)  # get a stack slot value before ADDR  @dataflow  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.get_stack_contents_at>
f.get_parameter_at(ADDR, None, N)     # get the value of argument N at the call at ADDR  @args @dataflow  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.get_parameter_at>
f.get_regs_read_by(ADDR) / f.get_regs_written_by(ADDR)  # list registers read / written by an instruction  @uses @defs  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.get_regs_read_by>
f.get_constants_referenced_by(ADDR)   # list constants used by the instruction at ADDR  @immediate  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.get_constants_referenced_by>
f.get_stack_vars_referenced_by(ADDR)  # list stack variables used by the instruction at ADDR  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.get_stack_vars_referenced_by>
val.type / val.value                  # read a RegisterValue kind (ConstantValue, StackFrameOffset...) and value  @dataflow  <https://api.binary.ninja/binaryninja.variable-module.html#binaryninja.variable.RegisterValue>
f.set_user_var_value(VAR, DEF_ADDR, PossibleValueSet.constant(5))  # tell analysis a variable's value at its definition  @dataflow  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.set_user_var_value>
f.clear_user_var_value(VAR, DEF_ADDR)  # remove a user variable value  @dataflow  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.clear_user_var_value>
f.set_call_type_adjustment(ADDR, TYPE)  # override the prototype used at one call site  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.set_call_type_adjustment>
f.set_call_stack_adjustment(ADDR, N)  # override the stack change at one call site  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.set_call_stack_adjustment>

## calls and references
; Who calls this function, and which functions it calls.
f.callers                         # list Functions that call this function  @xrefs @incoming  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.callers>
f.caller_sites                    # list ReferenceSource of each place that calls this function  @xrefs  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.caller_sites>
    for site in f.caller_sites:
        print(hex(site.address), site.hlil)
f.callees                         # list Functions this function calls  @outgoing  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.callees>
f.callee_addresses                # list addresses this function calls  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.callee_addresses>
f.call_sites                      # list ReferenceSource of each call inside this function  @calls  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.call_sites>
max(bv.functions, key=lambda f: len(f.callers + f.callees))  # find the most connected function  @recipe @callgraph  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.callers>
f.add_user_code_ref(FROM, TO)     # add a manual code xref from an instruction  @xrefs  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.add_user_code_ref>
f.remove_user_code_ref(FROM, TO)  # delete a manual code xref  @xrefs  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.remove_user_code_ref>
f.add_user_type_ref(FROM, "struct_name")  # add a manual xref from code to a type  @xrefs  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.add_user_type_ref>
f.add_user_type_field_ref(FROM, "struct_name", OFFSET)  # add a manual xref from code to a struct field  @xrefs @member  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.add_user_type_field_ref>

## comments, tags, highlight
; Mark up one function: add comments, tags and colors to its code.
f.comment                             # get or set the function comment  @annotate @note  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.comment>
f.set_comment_at(ADDR, "TEXT")        # set a comment on an instruction in this function  @annotate  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.set_comment_at>
f.get_comment_at(ADDR)                # read the comment on an instruction  @annotate  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.get_comment_at>
f.comments                            # get a dict addr -> comment for this function  @annotate @all  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.comments>
f.add_tag("Important", "TEXT")        # put a function tag on the function  @tags @bookmark  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.add_tag>
f.add_tag("Bug", "TEXT", ADDR)        # put an address tag on an instruction  @tags @bookmark  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.add_tag>
f.tags                                # list (arch, addr, Tag) of address tags in the function  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.tags>
f.get_tags_at(ADDR)                   # list tags on one instruction  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.get_tags_at>
f.get_function_tags()                 # list tags on the function itself  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.get_function_tags>
f.remove_user_address_tag(ADDR, TAG)  # delete one address tag  @tags  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.remove_user_address_tag>
f.remove_user_function_tag(TAG)       # delete one function tag  @tags  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.remove_user_function_tag>
f.set_user_instr_highlight(ADDR, HighlightStandardColor.RedHighlightColor)  # color one instruction  @mark  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.set_user_instr_highlight>
f.set_user_instr_highlight(ADDR, HighlightColor(red=255, green=0, blue=0))  # color one instruction with RGB  <https://api.binary.ninja/binaryninja.highlight-module.html#binaryninja.highlight.HighlightColor>
bb.set_user_highlight(HighlightStandardColor.GreenHighlightColor)  # color a whole basic block  @coverage  <https://api.binary.ninja/binaryninja.basicblock-module.html#binaryninja.basicblock.BasicBlock.set_user_highlight>
f.get_instr_highlight(ADDR)           # read the color of an instruction  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.get_instr_highlight>
f.set_int_display_type(ADDR, VAL, OP, IntegerDisplayType.CharacterConstantDisplayType)  # show an immediate as char, hex, signed...  @format  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.set_int_display_type>
f.store_metadata("key", VALUE)        # save plugin data on this function in the .bndb  @persist  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.store_metadata>
f.query_metadata("key")               # read plugin data stored on this function  @persist  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.query_metadata>
f.session_data                        # get a dict for plugin data on this function for this session  @cache  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.session_data>

## function analysis control
; Tell Binary Ninja to analyze one function again, or change how it is analyzed.
f.reanalyze()                         # mark the function for reanalysis and start it  @refresh @update  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.reanalyze>
f.analyze()                           # analyze the function now if it is out of date  @update  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.analyze>
f.mark_updates_required()             # queue the function for the next analysis update  @refresh  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.mark_updates_required>
f.mark_caller_updates_required()      # queue all callers for reanalysis  @refresh  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.mark_caller_updates_required>
f.request_debug_report("stack")       # show an internal analysis report for this function  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.request_debug_report>
f.workflow                            # get the Workflow used to analyze this function  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.workflow>
f.set_condition_inverted(ADDR, True)  # flip an if/else in HLIL output  @decompile @invert  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.set_condition_inverted>
f.set_expr_folding(ADDR, ExprFolding.PreventExprFolding)  # stop an HLIL expression being folded into its users  @decompile  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.set_expr_folding>
f.set_early_return(ADDR, EarlyReturn.TrueSideEarlyReturn)  # choose which side of an HLIL if becomes the early return  @decompile  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.set_early_return>
f.set_switch_recovery(ADDR, SwitchRecovery.PreventSwitchRecovery)  # stop HLIL turning an if-chain into a switch  @decompile  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.set_switch_recovery>
f.collapse_region(HASH) / f.expand_all()  # collapse or expand HLIL regions in the UI  @fold  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.collapse_region>

## disassembly text settings
; Turn code into text lines, and choose what is shown (addresses, bytes...).
; Use it to print or export a function's code.
DisassemblySettings()       # make settings that control how code is rendered  @render @options  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.DisassemblySettings>
s.set_option(DisassemblyOption.ShowAddress)  # turn on a render option, e.g. addresses or opcode bytes  @opcodes  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.DisassemblySettings.set_option>
DisassemblyTextRenderer(f)  # render assembly or IL of a function into lines with comments  @text  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.DisassemblyTextRenderer>
str(LINE)                   # turn a DisassemblyTextLine into plain text  @render @string  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.DisassemblyTextLine>

; ===============  il.sheet
; title: binary ninja il (llil mlil hlil)
; url:   https://api.binary.ninja/binaryninja.mediumlevelil-module.html
; tags:  binaryninja binja bn python api il bnil llil mlil hlil ssa intermediate-language decompiler dataflow

; i = an IL instruction (any level), il = an IL function. UPPERCASE words are placeholders.
; Guide: https://docs.binary.ninja/dev/bnil-overview.html

## get il functions
; IL (BNIL) is Binary Ninja's own simple language. Every CPU is translated into it,
; so one script works on x86, ARM, MIPS and more. Get it here at each level.
f.llil / f.mlil / f.hlil     # get the Low, Medium or High Level IL of a function  @bnil  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.hlil>
f.lifted_il                  # get the lifted IL (LLIL before flag and stack cleanup)  @lift @raw  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.lifted_il>
f.mmlil                      # get the mapped MLIL (keeps stores that MLIL drops)  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.mmlil>
il.ssa_form                  # get the SSA form of an IL function  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.ssa_form>
il.non_ssa_form              # get the normal form back from an SSA IL function  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.non_ssa_form>
il.source_function           # get the Function an IL function belongs to  @owner  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.source_function>
il.llil / il.mlil / il.hlil  # move between IL levels of the same function  @map @level  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.hlil>
il.view / il.arch            # get the BinaryView and Architecture of an IL function  @bv  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.view>
str(f.hlil)                  # print the whole decompiled function  @decompile @text  <https://api.binary.ninja/binaryninja.highlevelil-module.html#binaryninja.highlevelil.HighLevelILFunction>
f.hlil.root                  # get the top HLIL instruction (the function body block)  @ast @tree  <https://api.binary.ninja/binaryninja.highlevelil-module.html#binaryninja.highlevelil.HighLevelILFunction.root>

## walk instructions
; Loop over the IL instructions of a function, block by block or one by one.
il.instructions           # iterate every top-level IL instruction of a function  @loop  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.instructions>
for bb in il:             # iterate the IL basic blocks of a function  @loop  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction>
for i in bb:              # iterate the instructions of an IL basic block  @loop  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILBasicBlock>
il[N]                     # get instruction number N (an instruction index)  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction>
len(il)                   # count the top-level instructions  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction>
bv.hlil_instructions      # iterate every HLIL instruction in the whole binary  @all @global  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.hlil_instructions>
il.traverse(CB)           # walk every instruction and sub-expression, yield what CB returns (non None)  @find  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.traverse>
    def find_consts(i):
        if isinstance(i, Constant):
            return i.constant
    print(list(current_mlil.traverse(find_consts)))
i.traverse(CB, ARGS...)   # walk one instruction's expression tree depth-first, yield CB results  @recursive  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILInstruction.traverse>
i.visit(CB)               # call CB(name, inst, type, parent) on each sub-instruction; return False to stop going deeper  @walk  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILInstruction.visit>
i.visit_operands(CB)      # call CB on every leaf operand (vars, constants...)  @walk  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILInstruction.visit_operands>
i.prefix_operands / i.postfix_operands  # list all operands of the tree in prefix / postfix order  @flatten  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILInstruction.prefix_operands>
il.get_basic_block_at(N)  # get the IL block that holds instruction N  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.get_basic_block_at>
il.get_expr(EXPR_INDEX)   # get an IL expression by expression index  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.get_expr>
il.get_expr_count()       # count all expressions in the IL function  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.get_expr_count>

## instruction basics
; Facts about one IL instruction: what kind it is, its address and its parts.
i.operation          # get the operation enum, e.g. MediumLevelILOperation.MLIL_CALL  @op @opcode @kind  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILInstruction.operation>
i.operation.name     # get the operation name as text, e.g. "HLIL_ASSIGN"  @op  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILInstruction.operation>
i.address            # get the assembly address this IL came from (approximate)  @addr @location  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILInstruction.address>
i.size               # get the result size in bytes  @width  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILInstruction.size>
i.instr_index        # get the index of the top-level instruction that holds this expression  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILInstruction>
i.expr_index         # get the expression index inside the IL function  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILInstruction>
i.function           # get the IL function that owns the instruction  @owner  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILInstruction>
i.il_basic_block     # get the IL block that holds the instruction  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILInstruction.il_basic_block>
i.operands           # list the operands (sub-expressions, vars, ints...)  @args @children  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILInstruction.operands>
i.detailed_operands  # list (name, value, type) for each operand  @args @names @debug  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILInstruction.detailed_operands>
i.tokens             # get the instruction as text tokens  @render  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILInstruction.tokens>
str(i)               # get the instruction as text  @render @print  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILInstruction>
i.lines              # get the HLIL text lines of an instruction (HLIL only)  @render  <https://api.binary.ninja/binaryninja.highlevelil-module.html#binaryninja.highlevelil.HighLevelILInstruction.lines>
i.expr_type          # get the Type of an MLIL/HLIL expression  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILInstruction.expr_type>
i.attributes         # get the set of ILInstructionAttribute flags on an instruction  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILInstruction.attributes>
i.parent             # get the parent expression in the HLIL tree  @ast @up  <https://api.binary.ninja/binaryninja.highlevelil-module.html#binaryninja.highlevelil.HighLevelILInstruction.parent>
i.instr              # get the HLIL statement that holds an expression  @ast  <https://api.binary.ninja/binaryninja.highlevelil-module.html#binaryninja.highlevelil.HighLevelILInstruction.instr>
i.has_side_effects   # check whether an HLIL expression has side effects  @pure  <https://api.binary.ninja/binaryninja.highlevelil-module.html#binaryninja.highlevelil.HighLevelILInstruction.has_side_effects>
MediumLevelILInstruction.show_mlil_hierarchy()  # open a graph of all MLIL classes (also show_llil_ / show_hlil_hierarchy)  @learn  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILInstruction.show_mlil_hierarchy>

## match by kind
; Find the instructions you care about, like calls, constants or assignments,
; by checking their kind.
isinstance(i, Call)               # match any call at any level (commonil class)  @filter  <https://api.binary.ninja/binaryninja.commonil-module.html#binaryninja.commonil.Call>
isinstance(i, Localcall) / isinstance(i, Tailcall) / isinstance(i, Syscall)  # match normal calls, tail calls or syscalls  @call  <https://api.binary.ninja/binaryninja.commonil-module.html#binaryninja.commonil.Localcall>
isinstance(i, Constant)           # match any constant expression  @const @immediate  <https://api.binary.ninja/binaryninja.commonil-module.html#binaryninja.commonil.Constant>
isinstance(i, BinaryOperation) / isinstance(i, UnaryOperation)  # match two-operand or one-operand math  @arith  <https://api.binary.ninja/binaryninja.commonil-module.html#binaryninja.commonil.BinaryOperation>
isinstance(i, Comparison)         # match compare expressions (==, <, ...)  @cmp @condition  <https://api.binary.ninja/binaryninja.commonil-module.html#binaryninja.commonil.Comparison>
isinstance(i, Load) / isinstance(i, Store)  # match memory reads / writes  @deref  <https://api.binary.ninja/binaryninja.commonil-module.html#binaryninja.commonil.Load>
isinstance(i, SetVar)             # match variable assignments  @assign  <https://api.binary.ninja/binaryninja.commonil-module.html#binaryninja.commonil.SetVar>
isinstance(i, Return) / isinstance(i, Terminal)  # match returns / block-ending instructions  @ret  <https://api.binary.ninja/binaryninja.commonil-module.html#binaryninja.commonil.Return>
isinstance(i, ControlFlow) / isinstance(i, Loop)  # match branches, ifs, loops  @flow  <https://api.binary.ninja/binaryninja.commonil-module.html#binaryninja.commonil.ControlFlow>
isinstance(i, Phi)                # match SSA phi nodes  <https://api.binary.ninja/binaryninja.commonil-module.html#binaryninja.commonil.Phi>
isinstance(i, Intrinsic)          # match CPU intrinsics  @builtin  <https://api.binary.ninja/binaryninja.commonil-module.html#binaryninja.commonil.Intrinsic>
isinstance(i, FloatingPoint)      # match float operations  <https://api.binary.ninja/binaryninja.commonil-module.html#binaryninja.commonil.FloatingPoint>
isinstance(i, MediumLevelILCall)  # match one exact operation class  @call @mlil  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILCall>
i.operation == HighLevelILOperation.HLIL_CALL  # match one exact operation by enum  @op  <https://api.binary.ninja/binaryninja.highlevelil-module.html#binaryninja.highlevelil.HighLevelILInstruction.operation>
match i: case HighLevelILCall(dest=HighLevelILConstPtr(constant=ADDR)):  # pattern-match IL with keyword patterns (Python 3.10+)  <https://api.binary.ninja/binaryninja.highlevelil-module.html#binaryninja.highlevelil.HighLevelILCall>
    match i:
        case HighLevelILCall(dest=HighLevelILConstPtr(constant=c), params=[_, n, *_]):
            print(hex(c), n)
        case HighLevelILAssign(dest=HighLevelILVar(var=v)):
            print("write", v)

## common operands
; The parts of the most used instructions, like the target and arguments of a call,
; or the two sides of an assignment.
call.dest / call.params               # get a call's target and argument list  @args @arguments  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILCall>
call.output                           # list the variables a MLIL call writes  @return  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILCall.output>
set_var.dest / set_var.src            # get the target variable and value of an MLIL assignment  @assign  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILSetVar>
assign.dest / assign.src              # get both sides of an HLIL assignment (also HLIL_VAR_INIT)  <https://api.binary.ninja/binaryninja.highlevelil-module.html#binaryninja.highlevelil.HighLevelILAssign>
if_.condition / if_.true / if_.false  # get an if's condition and both targets/bodies  @branch  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILIf>
load.src                              # get the address expression of a memory read  @deref  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILLoad>
store.dest / store.src                # get the address and value of a memory write  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILStore>
const.constant                        # get the integer of a constant or constant pointer  @immediate @value  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILConstPtr>
const_ptr.string                      # get (text, StringType) if a constant pointer points at a string  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILConstPtr>
var_expr.var / var_expr.src           # get the Variable read by a var expression (src on MLIL, var on HLIL)  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILVar>
binop.left / binop.right              # get both sides of a binary operation  @math @operands  <https://api.binary.ninja/binaryninja.commonil-module.html#binaryninja.commonil.BinaryOperation>
unop.src                              # get the operand of a unary operation (neg, not, zx, sx, deref...)  @math  <https://api.binary.ninja/binaryninja.commonil-module.html#binaryninja.commonil.UnaryOperation>
ret.src                               # list the returned values  @return  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILRet>
jump_to.dest / jump_to.targets        # get a switch jump's address and dict of case -> target  @jumptable  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILJumpTo>
deref_field.src / .offset / .member_index  # get the base, byte offset and member of HLIL p->field  @struct  <https://api.binary.ninja/binaryninja.highlevelil-module.html#binaryninja.highlevelil.HighLevelILDerefField>
struct_field.src / .offset            # get the base and offset of HLIL s.field  @member  <https://api.binary.ninja/binaryninja.highlevelil-module.html#binaryninja.highlevelil.HighLevelILStructField>
array_index.src / array_index.index   # get the array and index of HLIL a[i]  <https://api.binary.ninja/binaryninja.highlevelil-module.html#binaryninja.highlevelil.HighLevelILArrayIndex>
loop.condition / loop.body            # get a while/do-while loop's test and body  <https://api.binary.ninja/binaryninja.highlevelil-module.html#binaryninja.highlevelil.HighLevelILWhile>
for_.init / .condition / .update / .body  # get the parts of an HLIL for loop  <https://api.binary.ninja/binaryninja.highlevelil-module.html#binaryninja.highlevelil.HighLevelILFor>
switch.condition / switch.cases / switch.default  # get the parts of an HLIL switch  @case  <https://api.binary.ninja/binaryninja.highlevelil-module.html#binaryninja.highlevelil.HighLevelILSwitch>
addr_of.src                           # get the variable whose address is taken (&var)  @pointer  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILAddressOf>
intrinsic.intrinsic / intrinsic.params  # get an intrinsic's ILIntrinsic and its arguments  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILIntrinsic>
llil_set_reg.dest / llil_set_reg.src  # get the register and value of an LLIL register write  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILSetReg>
llil_reg.src.name                     # get the register name read by LLIL_REG  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.ILRegister.name>

## variables in il
; Which variables an instruction reads or writes, and where a variable is used.
i.vars_read / i.vars_written          # list variables an instruction reads / writes  @uses @defs @dataflow  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILInstruction.vars_read>
i.vars_address_taken                  # list variables whose address the instruction takes  @alias  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILInstruction.vars_address_taken>
il.vars                               # list variables used in this IL function  @locals  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.vars>
il.aliased_vars                       # list variables whose address is taken and used elsewhere  @alias @pointer  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.aliased_vars>
il.get_var_definitions(VAR)           # list instructions that assign a variable  @defs @dataflow  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.get_var_definitions>
il.get_var_uses(VAR)                  # list instructions that read a variable  @dataflow  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.get_var_uses>
il.is_var_live_at(VAR, INSTR)         # check whether a variable is live at an instruction  @liveness  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.is_var_live_at>
il.get_live_instructions_for_var(VAR)  # list instructions where a variable is live  @liveness  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.get_live_instructions_for_var>
i.get_var_for_reg("rdi")              # get the MLIL variable that holds a register at an instruction  @map  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILInstruction.get_var_for_reg>
i.get_var_for_stack_location(OFFSET)  # get the MLIL variable at a stack offset at an instruction  @map  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILInstruction.get_var_for_stack_location>

## ssa
; SSA is a form of IL where each variable is written only once.
; This makes it easy to follow where a value comes from.
il.ssa_form                           # get the SSA version of the IL  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.ssa_form>
i.ssa_form / i.non_ssa_form           # move one instruction into or out of SSA form  @map  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILInstruction.ssa_form>
ssa_var.var / ssa_var.version         # get the Variable and version of an SSAVariable  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.SSAVariable>
il.ssa_vars                           # list SSAVariables of the function  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.ssa_vars>
il.ssa_form.get_ssa_var_definition(SSA_VAR)  # get the one instruction that defines an SSA variable  @def @source  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.get_ssa_var_definition>
il.ssa_form.get_ssa_var_uses(SSA_VAR)  # list instructions that use an SSA variable  @sink  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.get_ssa_var_uses>
ssa_var.def_site / ssa_var.use_sites  # get the definition / uses straight from an SSAVariable  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.SSAVariable.def_site>
    arg = call.params[0].ssa_form            # <mlil: x0#3>
    d = arg.function.get_ssa_var_definition(arg.src)
    # if d is a phi (MediumLevelILVarPhi), follow each d.src version in a worklist
il.get_ssa_var_value(SSA_VAR)         # get the RegisterValue analysis found for an SSA variable  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.get_ssa_var_value>
il.is_ssa_var_live(SSA_VAR)           # check whether an SSA variable is used at all  @dead  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.is_ssa_var_live>
i.ssa_memory_version                  # get the memory version at an SSA instruction  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILInstruction.ssa_memory_version>
il.get_ssa_memory_definition(VERSION)  # get the instruction that makes a memory version  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.get_ssa_memory_definition>
llil.ssa_form.get_ssa_reg_definition(SSA_REG)  # get the LLIL instruction that defines an SSA register  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.get_ssa_reg_definition>
llil.ssa_form.get_ssa_reg_uses(SSA_REG)  # list LLIL instructions that use an SSA register  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.get_ssa_reg_uses>
llil.ssa_form.get_ssa_flag_definition(SSA_FLAG)  # get the LLIL instruction that sets an SSA flag  @flags  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.get_ssa_flag_definition>

## map between levels
; Go from an instruction at one IL level to the same code at another level,
; or back to its assembly address.
i.llil / i.mlil / i.hlil        # map an instruction to the closest one at another level (may be None)  @translate  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILInstruction.hlil>
i.llils / i.mlils / i.hlils     # list all instructions at another level that make up this one (more exact)  @map  <https://api.binary.ninja/binaryninja.highlevelil-module.html#binaryninja.highlevelil.HighLevelILInstruction.mlils>
i.mmlil                         # map LLIL to the mapped MLIL  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILInstruction.mmlil>
f.get_llil_at(ADDR).hlil        # find the HLIL for an assembly address  @lookup  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.get_llil_at>
f.get_llils_at(ADDR)            # list LLIL instructions for an address (one address can lift to many)  @lookup  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.get_llils_at>
llil.get_instructions_at(ADDR)  # list LLIL instruction indexes for an address  @lookup @index  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.get_instructions_at>
il.get_instruction_start(ADDR)  # get the first IL instruction index for an address  @lookup  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.get_instruction_start>
mlil.get_low_level_il_instruction_index(N)  # map an MLIL instruction index to LLIL  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.get_low_level_il_instruction_index>
mlil.get_high_level_il_instruction_index(N)  # map an MLIL instruction index to HLIL  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.get_high_level_il_instruction_index>
ref.hlil                        # get the HLIL at a cross reference (ReferenceSource)  @xrefs  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.ReferenceSource.hlil>

## il values and dataflow
; Ask what value an IL expression has. Binary Ninja may know one constant,
; a range, or a list of possible values.
i.value                             # get the RegisterValue analysis found for an expression  @constant @dataflow  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILInstruction.value>
i.value.type == RegisterValueType.ConstantValue  # check whether an expression is a known constant  <https://api.binary.ninja/binaryninja.variable-module.html#binaryninja.variable.RegisterValue>
i.possible_values                   # get the PossibleValueSet (ranges, sets, tables) of an expression  @range @dataflow  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILInstruction.possible_values>
pvs.type / pvs.value / pvs.ranges / pvs.values  # read the kind and contents of a PossibleValueSet  @range @set  <https://api.binary.ninja/binaryninja.variable-module.html#binaryninja.variable.PossibleValueSet>
i.get_reg_value("rax")              # get a register value at an instruction  @dataflow  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILInstruction.get_reg_value>
i.get_possible_reg_values_after("rax")  # get the possible values of a register after an instruction  @range  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILInstruction.get_possible_reg_values_after>
i.get_stack_contents(OFFSET, SIZE)  # get the value of a stack slot at an instruction  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILInstruction.get_stack_contents>
i.get_flag_value("z")               # get a flag value at an LLIL/MLIL instruction  @flags  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILInstruction.get_flag_value>
i.branch_dependence                 # get which branch sides must be taken to reach an MLIL instruction  @control-dependence  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILInstruction.branch_dependence>
PossibleValueSet.constant(5)        # make a constant value set (also unsigned_range_value, in_set_of_values...)  @create  <https://api.binary.ninja/binaryninja.variable-module.html#binaryninja.variable.PossibleValueSet.constant>
bv.parse_possiblevalueset("[0x10, 0x20]", RegisterValueType.UnsignedRangeValue)  # build a value set from text  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.parse_possiblevalueset>

## llil specifics
; Things only low level IL has: CPU registers, flags and the stack.
llil.regs / llil.flags             # list registers / flags used in an LLIL function  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.regs>
llil.ssa_regs                      # list SSA registers with versions  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.ssa_regs>
ILRegister.name / ILRegister.temp  # get a register's name and whether it is an IL temp  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.ILRegister>
i.flags                            # get the flag write type of an LLIL instruction (which flags it sets)  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILInstruction.flags>
LowLevelILFlagCondition.LLFC_E     # name a flag condition (E, NE, SLT, ULT, ...) in LLIL_FLAG_COND  @flags  <https://api.binary.ninja/binaryninja.enums-module.html>
llil.get_exits_for_instr(N)        # list exit points for an LLIL instruction index  @flow  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.get_exits_for_instr>

## graphs
; Show an IL function as a graph, like the graph view in the UI.
il.create_graph()  # build a FlowGraph of the IL function  @cfg  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.create_graph>
show_graph_report("MLIL", f.mlil.create_graph())  # show an IL graph in a new tab  @ui  <https://api.binary.ninja/binaryninja.interaction-module.html#binaryninja.interaction.show_graph_report>
f.create_graph(FunctionGraphType.HighLevelILFunctionGraph)  # build a FlowGraph for a chosen IL view  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.create_graph>

; ===============  types.sheet
; title: binary ninja types
; url:   https://docs.binary.ninja/dev/annotation.html#types
; tags:  binaryninja binja bn python api types struct structure enum typedef pointer typelibrary typearchive symbols demangle debuginfo

; t = a Type. UPPERCASE words are placeholders. Type objects are immutable; *Builder objects are mutable.

## make simple types
; Make basic types in Python: ints, chars, pointers, arrays and function types.
Type.int(4) / Type.int(4, False)    # make int32_t / uint32_t  @integer @signed @unsigned  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.Type.int>
Type.char()                         # make char (a 1 byte signed integer)  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.Type.char>
Type.wide_char(2)                   # make wchar16 (2) or wchar32 (4)  @unicode @wchar  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.Type.wide_char>
Type.bool()                         # make bool  @boolean  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.Type.bool>
Type.float(4) / Type.float(8)       # make float / double  @fpu  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.Type.float>
Type.void()                         # make void  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.Type.void>
Type.pointer(bv.arch, Type.char())  # make char* sized for the architecture  @ptr  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.Type.pointer>
Type.pointer_of_width(8, T)         # make a pointer of an exact size  @ptr @64bit  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.Type.pointer_of_width>
Type.array(Type.char(), 16)         # make char[16]  @buffer  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.Type.array>
Type.function(Type.int(4), [Type.int(4), Type.pointer(arch, Type.char())])  # make a function type: return + param types  @prototype  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.Type.function>
Type.function(RET, [FunctionParameter(T, "argc")], variable_arguments=True)  # make a varargs function type with named params  @prototype  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.FunctionParameter>
Type.function(RET, PARAMS, calling_convention=CC)  # make a function type with a calling convention  @prototype  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.Type.function>
Type.fragment(T, WIDTH, OFFSET)     # make a bit slice of a larger type (for split registers/bitfields)  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.Type.fragment>
T.const = True                      # make a const variant of a builder type  @qualifier  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.TypeBuilder.const>

## parse C
; Write a type as normal C text and let Binary Ninja turn it into a Type object.
; Often the easiest way to make a type.
bv.parse_type_string("struct foo* [4]")  # parse one C type, returns (Type, name)  @declaration  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.parse_type_string>
t, name = bv.parse_type_string("int32_t (*cb)(void*)")  # parse a declaration and get its name too  @function-pointer  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.parse_type_string>
bv.parse_types_from_string(C_SOURCE)  # parse many C definitions, returns .types .variables .functions  @header  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.parse_types_from_string>
    res = bv.parse_types_from_string("struct a { int x; }; enum e { A = 1 };")
    bv.define_user_types([(n, t) for n, t in res.types.items()], None)
bv.platform.parse_types_from_source_file(PATH, include_dirs=[DIR])  # parse a C header file for a platform  @import  <https://api.binary.ninja/binaryninja.platform-module.html#binaryninja.platform.Platform.parse_types_from_source_file>
TypeParser.default.parse_types_from_source(SRC, "x.h", PLATFORM, [], ARGS)  # parse source with clang args (-x c, -isystem)  @header  <https://api.binary.ninja/binaryninja.typeparser-module.html#binaryninja.typeparser.TypeParser.parse_types_from_source>
TypeParser.default.preprocess_source(SRC, "x.h", PLATFORM)  # run only the C preprocessor on source  @macro  <https://api.binary.ninja/binaryninja.typeparser-module.html#binaryninja.typeparser.TypeParser.preprocess_source>
bv.type_container.parse_type_string(SRC)  # parse a type using all types known to the view  <https://api.binary.ninja/binaryninja.typecontainer-module.html#binaryninja.typecontainer.TypeContainer.parse_type_string>

## structures and unions
; Make and change structs and unions: a list of fields at offsets.
; Use them to describe the data a program works with.
Type.structure([(Type.int(4), "a"), (Type.char(), "b")])  # make an anonymous struct from (type, name) pairs  @create  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.Type.structure>
Type.union([(Type.int(4), "i"), (Type.float(4), "f")])  # make an anonymous union  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.Type.union>
s = StructureBuilder.create()        # start building a struct step by step  @builder  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.StructureBuilder.create>
s.append(Type.int(4), "field")       # add a member after the last one  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.StructureBuilder.append>
s.insert(OFFSET, Type.int(4), "field")  # add a member at a byte offset, overwriting what is there  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.StructureBuilder.insert>
s.add_member_at_offset("field", Type.int(4), OFFSET)  # add a member at a byte offset  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.StructureBuilder.add_member_at_offset>
s.insert(4, Type.int(4, False), "flags", bit_position=3, bit_width=5)  # add a bitfield member (bit_position 0-7)  @bits  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.StructureBuilder.insert>
s.replace(INDEX, TYPE, "name")       # replace member number INDEX  @edit  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.StructureBuilder.replace>
s.remove(INDEX)                      # delete member number INDEX  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.StructureBuilder.remove>
s.packed = True / s.width = 0x40 / s.alignment = 8  # set packing, total size and alignment  @align @pack  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.StructureBuilder.packed>
s.base_structures = [BaseStructure(NTR, 0)]  # set C++ base classes of a struct  @inheritance @class  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.StructureBuilder.base_structures>
s.pointer_offset = N                 # make pointers to this struct point N bytes into it (shifted pointers)  @adjusted  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.StructureBuilder.pointer_offset>
with StructureBuilder.builder(bv, "Foo") as s:  # build a new struct and define it on exit  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.TypeBuilder.builder>
    with StructureBuilder.builder(bv, "Foo") as s:
        s.packed = True
        s.append(Type.int(2), "kind")
        s.append(Type.pointer(bv.arch, Type.void()), "data")
with Type.builder(bv, "Foo") as s:   # edit an existing named type and save it back on exit  @modify @update  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.Type.builder>
t.members                            # list StructureMember (type, name, offset) of a struct type  @fields  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.StructureType.members>
t["field"]                           # get one member by name  @lookup  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.StructureType>
t.member_at_offset(OFFSET)           # get the member at a byte offset  @field  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.StructureType.member_at_offset>
t.members_including_inherited(bv)    # list members including those from base classes  @inheritance  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.StructureType.members_including_inherited>
bv.create_structure_from_offset_access("Foo")  # build a struct from field accesses seen in code  @auto-struct @infer  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.create_structure_from_offset_access>
bv.get_all_fields_referenced("Foo")  # list offsets of Foo that code touches  @infer  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_all_fields_referenced>

## enumerations
; Make and change enums: names for constant values.
; Use them to make magic numbers easy to read.
Type.enumeration(members=[("A", 1), ("B", 2)], width=4)  # make an anonymous enum  @create  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.Type.enumeration>
e = EnumerationBuilder.create(width=4)  # start building an enum step by step  @builder  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.EnumerationBuilder.create>
e.append("NAME", VALUE)  # add an enum member (value None = next)  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.EnumerationBuilder.append>
e.replace(INDEX, "NAME", VALUE) / e.remove(INDEX)  # change or delete an enum member  @edit  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.EnumerationBuilder.replace>
t.members                # list EnumerationMember (name, value) of an enum type  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.EnumerationType.members>
f.set_int_display_type(ADDR, VAL, OP, EnumerationDisplayType, enum_display_typeid=ID)  # show an immediate as an enum name  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.set_int_display_type>

## named types in the view
; The types saved in this file under a name, like struct Foo.
; Add, find, rename or remove them.
bv.types                          # get a mapping name -> Type of all types in the view  @list  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.types>
bv.types["Foo"]                   # get a defined type by name  @lookup  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.types>
bv.get_type_by_name("Foo")        # get a defined type by name, None if missing  @lookup  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_type_by_name>
bv.define_user_type("Foo", T)     # add or replace a named type as a user action  @typedef  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.define_user_type>
bv.define_user_types([(NAME, T), ...], None)  # add many named types at once  @bulk  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.define_user_types>
bv.undefine_user_type("Foo")      # delete a user type  @remove  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.undefine_user_type>
bv.rename_type("Old", "New")      # rename a type and update all users  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.rename_type>
bv.define_type(Type.generate_auto_type_id("src", NAME), NAME, T)  # add an auto type (for loaders/plugins)  @loader  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.define_type>
Type.named_type_from_registered_type(bv, "Foo")  # make a reference to a named type (like "struct Foo")  @ntr @typedef  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.Type.named_type_from_registered_type>
Type.named_type_reference(NamedTypeReferenceClass.StructNamedTypeClass, "Foo")  # reference a type that may not exist yet  @forward  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.Type.named_type_reference>
ntr.target(bv)                    # get the real type behind a named type reference  @resolve @deref  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.NamedTypeReferenceType.target>
t.deref_named_type_reference(bv)  # follow typedefs until a concrete type  @resolve @typedef  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.Type.deref_named_type_reference>
bv.dependency_sorted_types        # list types ordered so dependencies come first  @order @export  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.dependency_sorted_types>
bv.is_type_auto_defined("Foo")    # check whether a type was added by analysis, not the user  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.is_type_auto_defined>
bv.get_code_refs_for_type("Foo")  # find code that uses a type  @xrefs  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_code_refs_for_type>
QualifiedName(["std", "string"])  # make a namespaced name (std::string)  @namespace @cpp  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.QualifiedName>

## inspect a type
; Look inside a type: what kind it is, its size, its fields, its C text.
t.type_class                   # get the TypeClass (StructureTypeClass, PointerTypeClass...)  @kind  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.Type.type_class>
t.width / t.alignment          # get the size and alignment in bytes  @sizeof  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.Type.width>
str(t) / t.get_string()        # get the type as C text  @print @render  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.Type.get_string>
t.get_string_before_name() + NAME + t.get_string_after_name()  # print a declaration with a name in the right place  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.Type.get_string_before_name>
t.tokens                       # get the type as text tokens  @render  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.Type.tokens>
t.target                       # get what a pointer points to  @deref  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.PointerType.target>
t.element_type / t.count       # get an array's element type and length  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.ArrayType.element_type>
t.return_value / t.parameters  # get a function type's return type and parameter list  @prototype  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.FunctionType.parameters>
t.signed                       # check whether an integer type is signed  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.IntegerType.signed>
t.mutable_copy()               # get a builder copy of a type to change it  @edit  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.Type.mutable_copy>
b.immutable_copy()             # turn a builder back into a Type  @finish  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.TypeBuilder.immutable_copy>
t.with_confidence(255)         # set how sure analysis should be of this type (0-255)  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.Type.with_confidence>
t.registered_name              # get the name a type was defined under, if any  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.Type.registered_name>
TypePrinter.default.print_all_types(bv.types.items(), bv)  # export all types as a C header  <https://api.binary.ninja/binaryninja.typeprinter-module.html#binaryninja.typeprinter.TypePrinter.print_all_types>
TypePrinter.default.get_type_lines(T, bv, NAME)  # get multi-line C for one type  @print  <https://api.binary.ninja/binaryninja.typeprinter-module.html#binaryninja.typeprinter.TypePrinter.get_type_lines>

## apply types
; Put a type on something: a function, a variable or an address.
; This makes the decompiled code clear.
f.type = Type.function(Type.void(), [])  # set a function's prototype  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.type>
f.parameter_vars[0].type = Type.pointer(bv.arch, Type.char())  # retype a parameter  @arg @variable  <https://api.binary.ninja/binaryninja.variable-module.html#binaryninja.variable.Variable.type>
bv.get_data_var_at(ADDR).type = Type.char()  # retype an existing global  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.DataVariable.type>
bv.define_user_data_var(ADDR, Type.named_type_from_registered_type(bv, "Foo"))  # put a struct at an address  @global  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.define_user_data_var>
bv.typed_data_accessor(ADDR, bv.types["Foo"])["field"].value  # read a struct field from memory  @parse  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.TypedDataAccessor>

## symbols
; Make symbols: names for functions, data and imports at an address.
Symbol(SymbolType.FunctionSymbol, ADDR, "name")  # make a function symbol  @label  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.Symbol>
Symbol(SymbolType.DataSymbol, ADDR, "name")  # make a data symbol  @global  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.Symbol>
Symbol(SymbolType.ImportedFunctionSymbol, ADDR, "name")  # make an imported function symbol (also ImportAddressSymbol)  @import  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.Symbol>
Symbol(TYPE, ADDR, SHORT, FULL, RAW, binding=SymbolBinding.GlobalBinding)  # make a symbol with all name forms and a binding  @mangled  <https://api.binary.ninja/binaryninja.types-module.html#binaryninja.types.Symbol>
bv.define_user_symbol(SYM)  # add a symbol to the view as a user action  @rename  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.define_user_symbol>

## demangle
; Turn mangled C++ (or Rust, Swift) names back into readable names.
demangle_any("_ZN3foo3barEv")        # demangle any known scheme, returns (Type, QualifiedName)  @c++ @mangled  <https://api.binary.ninja/binaryninja.demangle-module.html#binaryninja.demangle.demangle_any>
demangle_gnu3(bv.arch, "_ZN3foo3barEv")  # demangle an Itanium/GNU C++ name, returns (Type, QualifiedName)  @gcc @clang  <https://api.binary.ninja/binaryninja.demangle-module.html#binaryninja.demangle.demangle_gnu3>
demangle_ms(bv.arch, "?foo@@YAHXZ")  # demangle an MSVC C++ name  @windows  <https://api.binary.ninja/binaryninja.demangle-module.html#binaryninja.demangle.demangle_ms>
demangle_llvm("_RNvC...")            # demangle with the LLVM demangler (Rust, Swift, D...)  <https://api.binary.ninja/binaryninja.demangle-module.html#binaryninja.demangle.demangle_llvm>
simplify_demangled_template_name(NAME)  # shorten std:: template spellings like basic_string<...>  <https://api.binary.ninja/binaryninja.demangle-module.html#binaryninja.demangle.simplify_demangled_template_name>
Demangler.register()                 # add your own demangler class  @custom @plugin  <https://api.binary.ninja/binaryninja.demangle-module.html#binaryninja.demangle.Demangler.register>

## type libraries (.bntl)
; A type library holds the types and prototypes of one system library, like libc.
; Binary Ninja uses it to type imported functions for you.
bv.type_libraries                    # list type libraries loaded in this view  @typelib @bntl  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.type_libraries>
TypeLibrary.load_from_file(PATH)     # open a .bntl file  @typelib  <https://api.binary.ninja/binaryninja.typelibrary-module.html#binaryninja.typelibrary.TypeLibrary.load_from_file>
bv.add_type_library(LIB)             # make a type library's types usable in this view  @typelib @import  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.add_type_library>
bv.import_library_type("FILE")       # copy a type from loaded type libraries into the view  @typelib  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.import_library_type>
bv.import_library_object("CreateFileA")  # import a function/variable prototype from type libraries  @typelib  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.import_library_object>
lib = TypeLibrary.new(bv.arch, "libfoo.so.1")  # make an empty type library  @typelib @create  <https://api.binary.ninja/binaryninja.typelibrary-module.html#binaryninja.typelibrary.TypeLibrary.new>
lib.add_named_type("Foo", T)         # add a type to a new type library  @typelib  <https://api.binary.ninja/binaryninja.typelibrary-module.html#binaryninja.typelibrary.TypeLibrary.add_named_type>
lib.add_named_object("foo_init", FUNC_TYPE)  # add a function or variable prototype to a type library  @typelib @export  <https://api.binary.ninja/binaryninja.typelibrary-module.html#binaryninja.typelibrary.TypeLibrary.add_named_object>
bv.export_type_to_library(LIB, "Foo", T)  # copy a type and its dependencies into a library  @typelib  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.export_type_to_library>
bv.export_object_to_library(LIB, "foo_init", f.type)  # copy a function prototype and its types into a library  @typelib  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.export_object_to_library>
lib.add_platform(bv.platform)        # say which platforms the library applies to  @typelib  <https://api.binary.ninja/binaryninja.typelibrary-module.html#binaryninja.typelibrary.TypeLibrary.add_platform>
lib.finalize(); lib.write_to_file(PATH)  # finish a type library and save it as .bntl  @typelib  <https://api.binary.ninja/binaryninja.typelibrary-module.html#binaryninja.typelibrary.TypeLibrary.write_to_file>
lib.named_types / lib.named_objects  # list types and prototypes in a type library  @typelib @dump  <https://api.binary.ninja/binaryninja.typelibrary-module.html#binaryninja.typelibrary.TypeLibrary.named_types>
Platform["windows-x86_64"].get_type_libraries_by_name("kernel32.dll")  # find type libraries for a DLL/so name  @typelib  <https://api.binary.ninja/binaryninja.platform-module.html#binaryninja.platform.Platform.get_type_libraries_by_name>

## type archives (.bnta) and containers
; A type archive is a file that shares your types between many binaries.
; Change a type once and use it everywhere.
TypeArchive.create(PATH, bv.platform)  # make a new type archive file to share types across files  @bnta  <https://api.binary.ninja/binaryninja.typearchive-module.html#binaryninja.typearchive.TypeArchive.create>
TypeArchive.open(PATH)            # open a type archive file  @bnta  <https://api.binary.ninja/binaryninja.typearchive-module.html#binaryninja.typearchive.TypeArchive.open>
bv.attach_type_archive(ARCHIVE)   # connect a type archive to this view  @link  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.attach_type_archive>
bv.push_types_to_archive(ARCHIVE, ["Foo"])  # copy types (and dependencies) from the view into an archive  @export @sync  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.push_types_to_archive>
bv.pull_types_from_archive(ARCHIVE, ["Foo"])  # copy types from an archive into the view  @import @sync  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.pull_types_from_archive>
archive.add_type("Foo", T) / archive.get_type_by_name("Foo")  # add or read types in an archive directly  <https://api.binary.ninja/binaryninja.typearchive-module.html#binaryninja.typearchive.TypeArchive.add_type>
bv.type_container                 # get a TypeContainer over all types in the view  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.type_container>
bv.user_type_container / bv.auto_type_container  # get containers of only user / only auto types  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.user_type_container>
container.add_types([(NAME, T)])  # add or update types in any container (view, library, archive, platform)  @bulk  <https://api.binary.ninja/binaryninja.typecontainer-module.html#binaryninja.typecontainer.TypeContainer.add_types>
bv.platform.type_container        # get the types that come with a platform  @builtin  <https://api.binary.ninja/binaryninja.platform-module.html#binaryninja.platform.Platform.type_container>

## debug info (dwarf, pdb)
; Debug info (DWARF, PDB) has the real names and types from the compiler.
; Load it to get much better analysis for free.
bv.debug_info            # get the DebugInfo parsed for this view  @dwarf @pdb @symbols  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.debug_info>
DebugInfoParser.get_parsers_for_view(bv)  # list debug info parsers that accept this file  @dwarf @pdb  <https://api.binary.ninja/binaryninja.debuginfo-module.html#binaryninja.debuginfo.DebugInfoParser>
DebugInfoParser["DWARF"].parse_debug_info(bv, DEBUG_BV)  # parse debug info from a separate debug file view  @split-debug  <https://api.binary.ninja/binaryninja.debuginfo-module.html#binaryninja.debuginfo.DebugInfoParser.parse_debug_info>
bv.apply_debug_info(DI)  # apply a DebugInfo's types, functions and globals to the view  @import  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.apply_debug_info>
di.types / di.functions / di.data_variables  # iterate what the debug info provides  @dwarf @dump  <https://api.binary.ninja/binaryninja.debuginfo-module.html#binaryninja.debuginfo.DebugInfo.functions>
load(PATH, options={"analysis.debugInfo.external": DBG_PATH})  # load a binary with a separate debug info file  @dwarf  <https://docs.binary.ninja/guide/settings.html#analysis.debugInfo.external>

; ===============  arch.sheet
; title: binary ninja architecture, platform, calling convention
; url:   https://api.binary.ninja/binaryninja.architecture-module.html
; tags:  binaryninja binja bn python api arch architecture cpu isa platform os abi calling-convention disassemble assemble registers

; arch = Architecture, plat = Platform, cc = CallingConvention. UPPERCASE words are placeholders.

## find architectures and platforms
; An architecture is a CPU, like x86_64 or ARM. A platform is a CPU plus an OS,
; like linux-x86_64. Get them by name here.
Architecture["x86_64"]           # get an architecture by name (x86, x86_64, armv7, thumb2, aarch64, mips32, ppc...)  @cpu  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture>
list(Architecture)               # list all registered architectures  @cpu  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture>
"aarch64" in Architecture        # check whether an architecture is available  @exists  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture>
Platform["linux-x86_64"]         # get a platform (OS + arch) by name  @abi @lookup  <https://api.binary.ninja/binaryninja.platform-module.html#binaryninja.platform.Platform>
list(Platform)                   # list all registered platforms  @os  <https://api.binary.ninja/binaryninja.platform-module.html#binaryninja.platform.Platform>
Platform.get_list(os="windows")  # list platforms for one OS (or arch=ARCH)  @filter  <https://api.binary.ninja/binaryninja.platform-module.html#binaryninja.platform.Platform.get_list>
arch.standalone_platform         # get the OS-less platform of an architecture  @baremetal @firmware  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture.standalone_platform>
bv.arch / bv.platform / f.arch / f.platform  # get the architecture and platform of a view or function  @current  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.platform>
bv.platform = Platform["linux-armv7"]  # set the default platform of a view  @change @retarget  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.platform>
plat.get_related_platform(Architecture["thumb2"])  # get the matching platform for another arch (ARM <-> Thumb)  @interworking  <https://api.binary.ninja/binaryninja.platform-module.html#binaryninja.platform.Platform.get_related_platform>
bv.create_user_function(ADDR, plat=Platform["linux-thumb2"])  # make a function using a specific platform (e.g. Thumb)  @mixed  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.create_user_function>

## architecture facts
; Facts about a CPU: its registers, pointer size, byte order and flags.
arch.name                           # get the architecture name  @id  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture>
arch.address_size / arch.default_int_size  # get pointer size and default int size in bytes  @bits @width  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture>
arch.endianness                     # get the byte order  @endian  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture>
arch.max_instr_length / arch.instr_alignment  # get the longest instruction size and instruction alignment  @align  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture>
arch.regs                           # get a dict name -> RegisterInfo (full_width_reg, size, offset)  @registers @list  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture>
arch.full_width_regs                # list full-width register names (rax, not eax)  @registers  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture.full_width_regs>
arch.stack_pointer / arch.link_reg  # get the stack pointer and link register names  @sp @lr @registers  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture>
arch.flags / arch.flag_roles        # list flag names and what each flag means  @eflags @cpsr  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture>
arch.intrinsics                     # get a dict of CPU intrinsics with input/output types  @intrinsic @builtin  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture>
arch.reg_stacks                     # get register stacks (x87 FPU stack)  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture>
arch.get_reg_name(INDEX) / arch.get_reg_index("rax")  # convert between register index and name  @registers @id  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture.get_reg_name>
arch.get_modified_regs_on_write("eax")  # list registers changed when one is written (eax -> rax)  @alias @subregister  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture.get_modified_regs_on_write>
arch.calling_conventions            # get a dict name -> CallingConvention for the arch  @cc @abi  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture.calling_conventions>
arch.can_assemble                   # check whether the arch can assemble text  @assembler  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture.can_assemble>
arch.type_libraries                 # list type libraries for the architecture  @typelib  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture.type_libraries>

## disassemble and assemble bytes
; Turn raw bytes into assembly text, or assembly text into bytes,
; without opening a file.
arch.get_instruction_text(DATA, ADDR)  # disassemble bytes, returns (tokens, length)  @decode @asm  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture.get_instruction_text>
"".join(str(t) for t in arch.get_instruction_text(DATA, ADDR)[0])  # turn decoded tokens into one text line  @disassemble  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.InstructionTextToken>
arch.get_instruction_info(DATA, ADDR)  # get an InstructionInfo with .length and .branches  @decode @branch  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture.get_instruction_info>
info.branches                    # list InstructionBranch (type, target) of a decoded instruction  @branch  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.InstructionInfo>
arch.get_low_level_il_from_bytes(DATA, ADDR)  # lift one instruction from bytes to LLIL  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture.get_low_level_il_from_bytes>
arch.assemble("mov eax, 1; ret", ADDR)  # assemble text to bytes  @asm @patch  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture.assemble>
arch.convert_to_nop(DATA, ADDR)  # get nop bytes the same length as an instruction  @patch  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture.convert_to_nop>
arch.invert_branch(DATA, ADDR)   # get bytes for the inverted branch  @patch @flip  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture.invert_branch>
arch.always_branch(DATA, ADDR)   # get bytes for an unconditional version of a branch  @patch  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture.always_branch>
bv.get_disassembly(ADDR)         # disassemble the instruction at an address in a view  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.get_disassembly>
InstructionTextToken(InstructionTextTokenType.RegisterToken, "eax")  # make one disassembly text token  @render  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.InstructionTextToken>
tok.type / tok.text / tok.value  # read a token's kind (RegisterToken, IntegerToken...), text and value  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.InstructionTextToken>

## platform
; A platform is a CPU plus an OS. It knows the calling conventions
; and the system types of that OS.
plat.name / plat.arch                # get the platform name and architecture  @os  <https://api.binary.ninja/binaryninja.platform-module.html#binaryninja.platform.Platform.name>
plat.default_calling_convention      # get the default calling convention  @cc @abi  <https://api.binary.ninja/binaryninja.platform-module.html#binaryninja.platform.Platform.default_calling_convention>
plat.cdecl_calling_convention (also stdcall_, fastcall_)  # get a named calling convention  @cc  <https://api.binary.ninja/binaryninja.platform-module.html#binaryninja.platform.Platform.cdecl_calling_convention>
plat.system_call_convention          # get the calling convention for syscalls  @syscall  <https://api.binary.ninja/binaryninja.platform-module.html#binaryninja.platform.Platform.system_call_convention>
plat.calling_conventions             # list all calling conventions of the platform  @cc  <https://api.binary.ninja/binaryninja.platform-module.html#binaryninja.platform.Platform.calling_conventions>
plat.types                           # get a dict of types that come with the platform  @builtin  <https://api.binary.ninja/binaryninja.platform-module.html#binaryninja.platform.Platform.types>
plat.get_type_by_name("FILE")        # get a platform type by name  @types @lookup  <https://api.binary.ninja/binaryninja.platform-module.html#binaryninja.platform.Platform.get_type_by_name>
plat.get_function_by_name("printf")  # get a platform function prototype by name  @libc  <https://api.binary.ninja/binaryninja.platform-module.html#binaryninja.platform.Platform.get_function_by_name>
plat.system_calls                    # get a dict number -> syscall prototype  <https://api.binary.ninja/binaryninja.platform-module.html#binaryninja.platform.Platform.system_calls>
plat.get_system_call_name(N)         # get the name of syscall number N  @lookup  <https://api.binary.ninja/binaryninja.platform-module.html#binaryninja.platform.Platform.get_system_call_name>
plat.get_system_call_type(N)         # get the prototype of syscall number N  <https://api.binary.ninja/binaryninja.platform-module.html#binaryninja.platform.Platform.get_system_call_type>
plat.type_libraries                  # list type libraries the platform can use  @typelib  <https://api.binary.ninja/binaryninja.platform-module.html#binaryninja.platform.Platform.type_libraries>
plat.parse_types_from_source(C_SRC)  # parse C for this platform (sizes, ABI)  @header  <https://api.binary.ninja/binaryninja.platform-module.html#binaryninja.platform.Platform.parse_types_from_source>
plat.os_list                         # list OS names the platform is registered for  <https://api.binary.ninja/binaryninja.platform-module.html#binaryninja.platform.Platform.os_list>

## calling conventions
; A calling convention says how a function gets its arguments and gives back
; its result: which registers, which stack slots.
cc.name                               # get the calling convention name  <https://api.binary.ninja/binaryninja.callingconvention-module.html#binaryninja.callingconvention.CallingConvention>
cc.int_arg_regs / cc.float_arg_regs   # list registers used for integer / float arguments  @args @abi  <https://api.binary.ninja/binaryninja.callingconvention-module.html#binaryninja.callingconvention.CallingConvention>
cc.int_return_reg / cc.float_return_reg  # get the register holding the return value  @abi  <https://api.binary.ninja/binaryninja.callingconvention-module.html#binaryninja.callingconvention.CallingConvention>
cc.caller_saved_regs / cc.callee_saved_regs  # list volatile / preserved registers  @clobber @abi  <https://api.binary.ninja/binaryninja.callingconvention-module.html#binaryninja.callingconvention.CallingConvention>
cc.stack_adjusted_on_return           # check whether the callee pops the stack args  @stdcall @cleanup  <https://api.binary.ninja/binaryninja.callingconvention-module.html#binaryninja.callingconvention.CallingConvention>
f.calling_convention = bv.platform.calling_conventions[N]  # change a function's calling convention  @set  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.calling_convention>
arch.register_calling_convention(cc)  # add your own calling convention to an architecture  @custom  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture.register_calling_convention>

## write a new architecture
; Teach Binary Ninja a new CPU. You tell it how to read, show and lift
; each instruction.
class MyArch(Architecture):        # start a CPU plugin; set name, address_size, regs, stack_pointer, flags...  @custom  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture>
    class MyArch(Architecture):
        name = "myarch"; address_size = 4; default_int_size = 4; max_instr_length = 4
        regs = {"r0": RegisterInfo("r0", 4), "sp": RegisterInfo("sp", 4)}
        stack_pointer = "sp"
        def get_instruction_info(self, data, addr):
            info = InstructionInfo(); info.length = 4; return info
        def get_instruction_text(self, data, addr):
            return [InstructionTextToken(InstructionTextTokenType.InstructionToken, "nop")], 4
        def get_instruction_low_level_il(self, data, addr, il):
            il.append(il.nop()); return 4
    MyArch.register()
get_instruction_info(self, data, addr)  # decode length and branches, return InstructionInfo  @required  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture.get_instruction_info>
info.add_branch(BranchType.TrueBranch, TARGET)  # say where an instruction can go (TrueBranch, CallDestination, FunctionReturn...)  @cfg  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.InstructionInfo.add_branch>
get_instruction_text(self, data, addr)  # return (list of InstructionTextToken, length)  @render @required  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture.get_instruction_text>
get_instruction_low_level_il(self, data, addr, il)  # append LLIL for one instruction and return its length  @lift  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture.get_instruction_low_level_il>
RegisterInfo("eax", 4, 0, ImplicitRegisterExtend.ZeroExtendToFullWidth)  # describe a sub-register: full reg, size, offset  @registers  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.RegisterInfo>
flag_write_types / flags_written_by_flag_write_type  # say which flags each "flags=" group sets  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture>
flag_roles = {"z": FlagRole.ZeroFlagRole}  # say what each flag means so conditions can be built  @flags  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture>
flags_required_for_flag_condition  # say which flags each LowLevelILFlagCondition reads  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture>
assemble(self, code, addr)         # implement text -> bytes for patching  @assembler  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture.assemble>
analyze_basic_blocks(self, func, context)  # replace the core block discovery for odd CPUs (delay slots, VLIW)  @advanced  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture.analyze_basic_blocks>
MyArch.register()                  # make the architecture available  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.Architecture.register>
arch.standalone_platform.default_calling_convention = cc  # set the default cc used for bare files  <https://api.binary.ninja/binaryninja.platform-module.html#binaryninja.platform.Platform.default_calling_convention>

## hook an existing architecture
; Change how a built-in CPU works without writing a new one,
; for example to fix or add a few instructions.
class Hook(ArchitectureHook):         # wrap a built-in architecture to change some instructions  @patch @override  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.ArchitectureHook>
    class RetHook(ArchitectureHook):
        def get_instruction_text(self, data, addr):
            toks, n = super().get_instruction_text(data, addr)
            if toks and toks[0].text == "retn": toks[0].text = "ret"
            return toks, n
    RetHook(Architecture["x86"]).register()
Hook(Architecture["x86"]).register()  # install an architecture hook  <https://api.binary.ninja/binaryninja.architecture-module.html#binaryninja.architecture.ArchitectureHook.register>

## custom platform and calling convention
; Add your own OS platform or calling convention, for odd firmware or
; custom compilers.
class MyCC(CallingConvention):  # define a calling convention (name, int_arg_regs, int_return_reg...)  @cc @abi @custom  <https://api.binary.ninja/binaryninja.callingconvention-module.html#binaryninja.callingconvention.CallingConvention>
    class MyCC(CallingConvention):
        name = "mycc"; int_arg_regs = ["r0", "r1", "r2"]; int_return_reg = "r0"
        caller_saved_regs = ["r0", "r1", "r2", "r3"]
    arch.register_calling_convention(MyCC(arch, "mycc"))
class MyPlat(Platform):         # define a platform: name and arch; register it for an OS  @custom  <https://api.binary.ninja/binaryninja.platform-module.html#binaryninja.platform.Platform>
MyPlat(arch).register("linux")  # register a platform for an OS name  <https://api.binary.ninja/binaryninja.platform-module.html#binaryninja.platform.Platform.register>
BinaryViewType["ELF"].register_arch(MACHINE_ID, Endianness.LittleEndian, arch)  # map an ELF e_machine number to your arch  @loader  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryViewType.register_arch>
BinaryViewType["ELF"].register_platform(OS_ID, arch, plat)  # map an ELF OS ABI id to your platform  @loader  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryViewType.register_platform>
BinaryViewType["Mapped"].register_default_platform(arch, plat)  # choose the platform used when opening raw files with this arch  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryViewType.register_default_platform>

; ===============  lifting.sheet
; title: binary ninja lifting, il building and workflows
; url:   https://docs.binary.ninja/dev/workflows.html
; tags:  binaryninja binja bn python api lift lifter il-builder workflow activity analysiscontext deobfuscate rewrite

; il = an IL function you build into. ctx = AnalysisContext. UPPERCASE words are placeholders.
; Builders return an ExpressionIndex; nothing is in the function until you il.append() it.

## llil building basics
; Lifting means turning one CPU instruction into IL.
; Use these to build low level IL step by step, for example in your own architecture.
il.append(EXPR)                # add an expression as the next LLIL instruction  @emit  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.append>
il.append(il.set_reg(4, "eax", il.const(4, 0)))  # write "eax = 0"  @mov @assign @register  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.set_reg>
il.reg(4, "eax")               # read a register  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.reg>
il.const(4, VAL) / il.const_pointer(8, ADDR)  # make an integer constant / a constant pointer  @immediate  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.const>
il.load(4, ADDR_EXPR)          # read 4 bytes from memory  @deref  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.load>
il.append(il.store(4, ADDR_EXPR, VAL_EXPR))  # write 4 bytes to memory  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.store>
il.push(4, EXPR) / il.pop(4)   # push to / pop from the stack  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.push>
il.add(4, A, B, flags="*")     # add and set the flags in flag write type "*"  @math  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.add>
il.sub / il.mult / il.div_unsigned / il.mod_signed  # build arithmetic (size, a, b)  @math  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.sub>
il.and_expr / il.or_expr / il.xor_expr / il.not_expr  # build bitwise ops (and/or/xor take size, a, b)  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.xor_expr>
il.shift_left / il.logical_shift_right / il.arith_shift_right / il.rotate_left  # build shifts and rotates  @shl @shr  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.shift_left>
il.sign_extend(8, EXPR) / il.zero_extend(8, EXPR) / il.low_part(1, EXPR)  # widen or truncate a value  @movsx @movzx  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.sign_extend>
il.compare_equal(4, A, B)      # build a == compare (also compare_signed_less_than, ...)  @cmp @condition  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.compare_equal>
il.flag("z") / il.set_flag("z", EXPR)  # read or write one flag  @flags  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.flag>
il.flag_condition(LowLevelILFlagCondition.LLFC_E)  # build a condition from flags (je, jl...)  @branch  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.flag_condition>
il.append(il.jump(EXPR))       # jump to an address expression  @jmp @branch  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.jump>
il.append(il.call(il.const_pointer(8, ADDR)))  # call a function  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.call>
il.append(il.ret(il.pop(8)))   # return to a popped address  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.ret>
il.append(il.tailcall(EXPR))   # jump to another function as a tail call  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.tailcall>
il.append(il.no_ret())         # mark that execution stops here  @noreturn @halt  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.no_ret>
il.append(il.system_call())    # emit a syscall  @svc @int80  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.system_call>
il.append(il.intrinsic([OUT_REGS], "NAME", [PARAMS]))  # emit an architecture intrinsic for odd instructions  @builtin  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.intrinsic>
il.append(il.trap(N)) / il.append(il.breakpoint())  # emit a trap or breakpoint  @int3 @interrupt  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.trap>
il.append(il.unimplemented())  # mark an instruction that is not lifted yet  @todo @stub  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.unimplemented>
il.unimplemented_memory_ref(4, ADDR_EXPR)  # mark an unlifted instruction that still touches memory  @todo  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.unimplemented_memory_ref>
il.append(il.nop())            # emit a no-op  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.nop>
il.float_add / il.float_const_double / il.int_to_float  # build floating point expressions  @fpu  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.float_add>
il.set_reg_split(4, "edx", "eax", EXPR)  # write a value split across two registers (edx:eax)  @pair @64bit  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.set_reg_split>

## llil branches and labels
; Build jumps and if/else in low level IL with labels.
LowLevelILLabel()                     # make a label to jump to inside the IL  @goto @branch  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILLabel>
il.append(il.if_expr(COND, T_LABEL, F_LABEL))  # branch on a condition to two labels  @jcc  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.if_expr>
    t, f = LowLevelILLabel(), LowLevelILLabel()
    il.append(il.if_expr(il.flag_condition(LowLevelILFlagCondition.LLFC_E), t, f))
    il.mark_label(t); il.append(il.jump(il.const_pointer(8, target)))
    il.mark_label(f)
il.mark_label(LABEL)                  # place a label at the current spot  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.mark_label>
il.append(il.goto(LABEL))             # jump to a label  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.goto>
il.get_label_for_address(ARCH, ADDR)  # get the label of an already lifted address, None if not lifted  @branch  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.get_label_for_address>
il.add_label_for_address(ARCH, ADDR)  # make a label for an address in this function  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.add_label_for_address>
il.current_address = ADDR             # set the address the next emitted instruction belongs to  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.current_address>
il.operand(N, EXPR)                   # tag an expression as operand N for UI highlighting  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.operand>

## mlil and hlil building
; Build medium and high level IL yourself, for example to rewrite code
; in a workflow.
mlil.set_var(SIZE, VAR, EXPR)     # build an MLIL assignment to a Variable  @assign  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.set_var>
mlil.var(SIZE, VAR)               # build an MLIL variable read  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.var>
mlil.const(SIZE, VAL) / mlil.const_pointer(SIZE, ADDR)  # build MLIL constants  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.const>
mlil.call(OUTPUTS, DEST, PARAMS)  # build an MLIL call with outputs and params  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.call>
mlil.load(SIZE, SRC) / mlil.store(SIZE, DEST, SRC)  # build MLIL memory read / write  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.load>
mlil.goto(LABEL) / mlil.if_expr(COND, T, F)  # build MLIL control flow with MediumLevelILLabel  @branch  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.goto>
hlil.assign(SIZE, DEST, SRC)      # build an HLIL assignment  <https://api.binary.ninja/binaryninja.highlevelil-module.html#binaryninja.highlevelil.HighLevelILFunction.assign>
hlil.call(DEST, PARAMS)           # build an HLIL call  <https://api.binary.ninja/binaryninja.highlevelil-module.html#binaryninja.highlevelil.HighLevelILFunction.call>
hlil.if_expr(COND, T, F) / hlil.while_expr(COND, BODY)  # build HLIL if / while statements  @ast  <https://api.binary.ninja/binaryninja.highlevelil-module.html#binaryninja.highlevelil.HighLevelILFunction.if_expr>
hlil.block([EXPRS])               # build an HLIL block of statements  @ast  <https://api.binary.ninja/binaryninja.highlevelil-module.html#binaryninja.highlevelil.HighLevelILFunction.block>
il.expr(OPERATION, A, B, size=N)  # build any expression from a raw operation and operands  @generic  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.expr>

## changing existing il
; Change IL that already exists: replace, copy or rewrite instructions.
; Use it to clean up obfuscated code.
il.replace_expr(OLD, NEW)             # swap one expression for another in place (keeps instruction count)  @patch  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.replace_expr>
il.copy_expr(INSTR)                   # copy an expression inside the same IL function, returns its index  @clone  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.copy_expr>
INSTR.copy_to(NEW_IL)                 # deep copy an expression into another IL function  @clone  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILInstruction.copy_to>
il.translate(HANDLER)                 # clone an IL function; HANDLER(new_il, block, instr) returns each new expr  @rewrite  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.translate>
il.finalize()                         # rebuild the basic blocks after changes  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.finalize>
il.generate_ssa_form()                # rebuild SSA and dataflow after changes  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.generate_ssa_form>
MediumLevelILFunction(ARCH, low_level_il=ctx.llil)  # make an empty MLIL function to copy into  @new @copy-transform  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction>
new.prepare_to_copy_function(OLD)     # start copying OLD into NEW (sets up labels)  @copy-transform  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.prepare_to_copy_function>
new.prepare_to_copy_block(OLD_BLOCK)  # start copying one block (call before its instructions)  @copy-transform  <https://api.binary.ninja/binaryninja.mediumlevelil-module.html#binaryninja.mediumlevelil.MediumLevelILFunction.prepare_to_copy_block>
new.append(EXPR, ILSourceLocation.from_instruction(OLD_INSTR))  # add an instruction and keep its link to the original  @mapping  <https://api.binary.ninja/binaryninja.commonil-module.html#binaryninja.commonil.ILSourceLocation.from_instruction>
    def rewrite(ctx):
        old = ctx.mlil
        new = MediumLevelILFunction(old.arch, low_level_il=ctx.llil)
        new.prepare_to_copy_function(old)
        for bb in old.basic_blocks:
            new.prepare_to_copy_block(bb)
            for i in range(bb.start, bb.end):
                ins = old[i]
                new.set_current_address(ins.address, bb.arch)
                new.append(ins.copy_to(new), ILSourceLocation.from_instruction(ins))
        new.finalize(); new.generate_ssa_form()
        ctx.mlil = new
il.set_expr_attributes(EXPR, {ILInstructionAttribute.ATTR})  # put attributes on an expression while lifting  <https://api.binary.ninja/binaryninja.lowlevelil-module.html#binaryninja.lowlevelil.LowLevelILFunction.set_expr_attributes>

## workflows and activities
; A workflow is the list of steps analysis runs on each function.
; An activity is one step. Add your own step to change how code is analyzed.
Workflow("core.function.metaAnalysis")  # get a registered workflow by name  @pipeline  <https://api.binary.ninja/binaryninja.workflow-module.html#binaryninja.workflow.Workflow>
list(Workflow)                    # list all registered workflows  <https://api.binary.ninja/binaryninja.workflow-module.html#binaryninja.workflow.Workflow>
wf = Workflow("core.function.metaAnalysis").clone("my.workflow")  # copy a workflow so you can change it  @custom  <https://api.binary.ninja/binaryninja.workflow-module.html#binaryninja.workflow.Workflow.clone>
wf.register_activity(Activity(CONFIG_JSON, action=FN))  # add a new step; FN(ctx) runs per function or per view  <https://api.binary.ninja/binaryninja.workflow-module.html#binaryninja.workflow.Workflow.register_activity>
    cfg = json.dumps({"name": "plugin.myStep", "title": "My Step",
        "description": "does X", "eligibility": {"auto": {"default": False}}})
    wf = Workflow("core.function.metaAnalysis").clone()
    wf.register_activity(Activity(cfg, action=lambda ctx: do_it(ctx)))
    wf.insert("core.function.generateHighLevelIL", ["plugin.myStep"])
    wf.register()
wf.insert("core.function.generateHighLevelIL", ["my.step"])  # run your steps before a given step  @order  <https://api.binary.ninja/binaryninja.workflow-module.html#binaryninja.workflow.Workflow.insert>
wf.insert_after("core.function.generateMediumLevelIL", ["my.step"])  # run your steps after a given step  @order  <https://api.binary.ninja/binaryninja.workflow-module.html#binaryninja.workflow.Workflow.insert_after>
wf.remove("ACTIVITY") / wf.replace("OLD", "NEW")  # drop or swap a step in a cloned workflow  @edit  <https://api.binary.ninja/binaryninja.workflow-module.html#binaryninja.workflow.Workflow.remove>
wf.register()                     # make the workflow usable (it becomes read-only)  @enable  <https://api.binary.ninja/binaryninja.workflow-module.html#binaryninja.workflow.Workflow.register>
wf.subactivities()                # list all steps of a workflow  <https://api.binary.ninja/binaryninja.workflow-module.html#binaryninja.workflow.Workflow.subactivities>
wf.configuration()                # get the workflow graph as JSON  @debug  <https://api.binary.ninja/binaryninja.workflow-module.html#binaryninja.workflow.Workflow.configuration>
wf.show_topology()                # show the workflow graph in the UI  <https://api.binary.ninja/binaryninja.workflow-module.html#binaryninja.workflow.Workflow.show_topology>
"eligibility": {"runOnce": True}  # run a module step only once per view  @config  <https://docs.binary.ninja/dev/workflows.html#activity-eligibility>
"eligibility": {"auto": {"default": False}}  # add an on/off setting for the step, off by default  @toggle @config  <https://docs.binary.ninja/dev/workflows.html#activity-eligibility>
Settings().set_string("analysis.workflows.functionWorkflow", "my.workflow", bv)  # use a workflow for all functions in bv  @select  <https://docs.binary.ninja/dev/workflows.html#workflow-selection>
Settings().set_string("analysis.workflows.functionWorkflow", "my.workflow", f)  # use a workflow for one function only  @select  <https://docs.binary.ninja/dev/workflows.html#workflow-selection>
f.workflow / bv.workflow          # get the workflow used by a function / view  @current  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.workflow>
bv.workflow.machine.status()      # show the workflow machine state for a view  @debug  <https://api.binary.ninja/binaryninja.workflow-module.html#binaryninja.workflow.WorkflowMachine.status>
f.workflow.machine.cli()          # open an interactive shell to step and inspect a workflow  @debug  <https://api.binary.ninja/binaryninja.workflow-module.html#binaryninja.workflow.WorkflowMachine.cli>

## analysis context (inside an activity)
; The analysis context is what your activity gets: the function and its IL
; right now. Read it, change it and give it back.
ctx.function                  # get the Function being analyzed  @activity  <https://api.binary.ninja/binaryninja.workflow-module.html#binaryninja.workflow.AnalysisContext.function>
ctx.view                      # get the BinaryView being analyzed  @activity  <https://api.binary.ninja/binaryninja.workflow-module.html#binaryninja.workflow.AnalysisContext.view>
ctx.lifted_il / ctx.llil / ctx.mlil / ctx.hlil  # read the current IL of this step (use these, not f.llil)  @activity  <https://api.binary.ninja/binaryninja.workflow-module.html#binaryninja.workflow.AnalysisContext.mlil>
ctx.mlil = NEW_IL             # hand a rewritten IL function back to analysis  @activity @rewrite  <https://api.binary.ninja/binaryninja.workflow-module.html#binaryninja.workflow.AnalysisContext.mlil>
ctx.llil = NEW_IL             # hand rewritten LLIL back to analysis  @activity @rewrite  <https://api.binary.ninja/binaryninja.workflow-module.html#binaryninja.workflow.AnalysisContext.llil>
ctx.basic_blocks              # get the function's assembly blocks  @activity  <https://api.binary.ninja/binaryninja.workflow-module.html#binaryninja.workflow.AnalysisContext.basic_blocks>
ctx.get_setting_bool(KEY)     # read a cached setting cheaply inside an activity  @settings  <https://api.binary.ninja/binaryninja.workflow-module.html#binaryninja.workflow.AnalysisContext.get_setting_bool>
ctx.is_offset_readable(ADDR)  # check memory permissions from the cached map (thread safe)  @activity  <https://api.binary.ninja/binaryninja.workflow-module.html#binaryninja.workflow.AnalysisContext.is_offset_readable>
ctx.get_sections_at(ADDR)     # get sections from the cached section map  @activity  <https://api.binary.ninja/binaryninja.workflow-module.html#binaryninja.workflow.AnalysisContext.get_sections_at>

; ===============  plugins.sheet
; title: binary ninja plugins and extensions
; url:   https://docs.binary.ninja/dev/plugins.html
; tags:  binaryninja binja bn python api plugin extension command menu background-task binaryview-type loader render-layer flowgraph transform

; UPPERCASE words are placeholders. Plugins live in user_plugin_path(); restart to load new ones.

## plugin layout
; A plugin is a folder with Python code that Binary Ninja loads at start.
; This is what goes in that folder.
MYPLUGIN/__init__.py                # entry file run when Binary Ninja loads the plugin folder  @layout  <https://docs.binary.ninja/dev/plugins.html#creating-the-plugin>
MYPLUGIN/plugin.json                # metadata for the extension manager (name, version, minimumbinaryninjaversion...)  @manifest  <https://docs.binary.ninja/dev/plugins.html#plugin-description-display>
MYPLUGIN/requirements.txt           # Python packages the extension manager installs for the plugin  @pip @dependencies  <https://docs.binary.ninja/dev/plugins.html#creating-the-plugin>
user_plugin_path()                  # get the folder for your own plugins  @install  <https://api.binary.ninja/index.html#binaryninja.user_plugin_path>
importlib.reload(MOD); MOD.run(bv)  # reload plugin code in the console while you work on it  @iterate @test  <https://docs.binary.ninja/dev/plugins.html#testing>
https://github.com/Vector35/sample_plugin  # template plugin to start from  @example  <https://github.com/Vector35/sample_plugin>
https://github.com/Vector35/binaryninja-api/tree/dev/python/examples  # official Python plugin examples  <https://github.com/Vector35/binaryninja-api/tree/dev/python/examples>

## plugin commands (menu entries)
; Add your own command to the menus and the command palette.
; It runs your function on the file, an address, a range or a function.
PluginCommand.register("Menu\\Name", "DESC", FN)  # add a menu command; FN(bv)  @action  <https://api.binary.ninja/binaryninja.plugin-module.html#binaryninja.plugin.PluginCommand.register>
PluginCommand.register_for_address("NAME", "DESC", FN)  # add a command run on the cursor address; FN(bv, addr)  @menu  <https://api.binary.ninja/binaryninja.plugin-module.html#binaryninja.plugin.PluginCommand.register_for_address>
PluginCommand.register_for_range("NAME", "DESC", FN)  # add a command run on the selection; FN(bv, addr, length)  @menu  <https://api.binary.ninja/binaryninja.plugin-module.html#binaryninja.plugin.PluginCommand.register_for_range>
PluginCommand.register_for_function("NAME", "DESC", FN)  # add a command run on the current function; FN(bv, func)  @menu  <https://api.binary.ninja/binaryninja.plugin-module.html#binaryninja.plugin.PluginCommand.register_for_function>
PluginCommand.register_for_high_level_il_instruction(N, D, FN)  # add a command on an HLIL instruction; FN(bv, instr)  @menu  <https://api.binary.ninja/binaryninja.plugin-module.html#binaryninja.plugin.PluginCommand.register_for_high_level_il_instruction>
PluginCommand.register_for_medium_level_il_function(N, D, FN)  # add a command on an MLIL function; FN(bv, mlil)  @menu  <https://api.binary.ninja/binaryninja.plugin-module.html#binaryninja.plugin.PluginCommand.register_for_medium_level_il_function>
PluginCommand.register_global("NAME", "DESC", FN)  # add a command that needs no open file; FN() takes no args  @menu  <https://api.binary.ninja/binaryninja.plugin-module.html#binaryninja.plugin.PluginCommand.register_global>
PluginCommand.register_for_project("NAME", "DESC", FN)  # add a command run on a project; FN(project)  @menu  <https://api.binary.ninja/binaryninja.plugin-module.html#binaryninja.plugin.PluginCommand.register_for_project>
PluginCommand.register("NAME", "DESC", FN, is_valid=CHECK)  # show a command only when CHECK(bv) is True  @enable  <https://api.binary.ninja/binaryninja.plugin-module.html#binaryninja.plugin.PluginCommand.register>
"Group\\Sub\\Name"  # put a command in a sub menu by using backslashes in its name  @submenu @folder  <https://api.binary.ninja/binaryninja.plugin-module.html#binaryninja.plugin.PluginCommand.register>
PluginCommand.get_valid_list(PluginCommandContext(bv))  # list commands valid in a context, by name  @invoke @call  <https://api.binary.ninja/binaryninja.plugin-module.html#binaryninja.plugin.PluginCommand.get_valid_list>
    ctx = PluginCommandContext(bv); ctx.address = here
    PluginCommand.get_valid_list(ctx)["My Plugin"].execute(ctx)
UIAction.registerAction("NAME", QKeySequence("F3"))  # make a UI action with a hotkey (binaryninjaui, UI only)  @shortcut  <https://docs.binary.ninja/dev/cookbook.html#apply-a-hotkey-to-a-register_-plugin>
UIActionHandler.globalActions().bindAction("NAME", UIAction(FN))  # bind code to a UI action; FN(ctx) gets ctx.binaryView  @hotkey  <https://docs.binary.ninja/dev/cookbook.html#apply-a-hotkey-to-a-register_-plugin>
Menu.mainMenu("Plugins").addAction("NAME", "GROUP")  # put a UI action into a menu  <https://docs.binary.ninja/dev/cookbook.html#apply-a-hotkey-to-a-register_-plugin>

## background work
; Run long work in the background so the UI does not freeze.
; It shows progress in the status bar and can be cancelled.
class Task(BackgroundTaskThread):    # run long work off the UI thread with a status bar entry  @async @progress  <https://api.binary.ninja/binaryninja.plugin-module.html#binaryninja.plugin.BackgroundTaskThread>
    class Task(BackgroundTaskThread):
        def __init__(self, bv):
            super().__init__("Working...", can_cancel=True); self.bv = bv
        def run(self):
            for i, f in enumerate(self.bv.functions):
                if self.cancelled: break
                self.progress = f"Working... {i}"
            self.finish()
    Task(bv).start()
task.progress = "TEXT"               # update the text shown in the status bar  <https://api.binary.ninja/binaryninja.plugin-module.html#binaryninja.plugin.BackgroundTask.progress>
task.cancelled                       # check whether the user pressed cancel  @stop  <https://api.binary.ninja/binaryninja.plugin-module.html#binaryninja.plugin.BackgroundTask.cancelled>
task.finish()                        # mark the task as done and remove it from the status bar  <https://api.binary.ninja/binaryninja.plugin-module.html#binaryninja.plugin.BackgroundTask.finish>
task.join()                          # wait for a BackgroundTaskThread to finish  @headless  <https://api.binary.ninja/binaryninja.plugin-module.html#binaryninja.plugin.BackgroundTaskThread.join>
BackgroundTask("TEXT", can_cancel=True)  # make a status bar task you update yourself (no thread)  @progress  <https://api.binary.ninja/binaryninja.plugin-module.html#binaryninja.plugin.BackgroundTask>
execute_on_main_thread_and_wait(FN)  # run UI code safely from a worker thread  <https://api.binary.ninja/binaryninja.mainthread-module.html#binaryninja.mainthread.execute_on_main_thread_and_wait>
with bv.undoable_transaction():      # group a plugin's changes into one undo step  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.undoable_transaction>

## custom file format (binaryview type)
; Teach Binary Ninja to load a new file format.
; You tell it where code and data go in memory.
class MyView(BinaryView):     # start a loader for a new file format; set name and long_name  @parser  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView>
    class MyView(BinaryView):
        name = "MyFmt"; long_name = "My Format"
        def __init__(self, data):
            BinaryView.__init__(self, parent_view=data, file_metadata=data.file)
            self.platform = Architecture["armv7"].standalone_platform
        @classmethod
        def is_valid_for_data(cls, data):
            return data.read(0, 4) == b"MYFT"
        def init(self):
            self.add_auto_segment(0x8000, 0x1000, 0x40, 0x1000,
                SegmentFlag.SegmentReadable | SegmentFlag.SegmentExecutable)
            self.add_auto_section(".text", 0x8000, 0x1000, SectionSemantics.ReadOnlyCodeSectionSemantics)
            self.add_entry_point(0x8000)
            return True
        def perform_get_entry_point(self): return 0x8000
        def perform_is_executable(self): return True
    MyView.register()
is_valid_for_data(cls, data)  # return True if the raw data is your format (check magic bytes)  @detect  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryViewType.is_valid_for_data>
init(self)                    # build segments, sections, symbols and entry points; return True on success  @loader  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.init>
self.add_auto_segment(ADDR, LEN, FILE_OFF, FILE_LEN, FLAGS)  # map file bytes into memory from a loader  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.add_auto_segment>
self.add_auto_section(NAME, ADDR, LEN, SEMANTICS)  # add a section from a loader  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.add_auto_section>
self.define_auto_symbol(Symbol(SymbolType.FunctionSymbol, ADDR, "name"))  # add a symbol from a loader  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.define_auto_symbol>
self.add_entry_point(ADDR)    # add an analysis start point from a loader  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.add_entry_point>
perform_get_entry_point / perform_is_executable / perform_get_address_size  # override basic file facts in a custom view  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.perform_get_entry_point>
MyView.register()             # make the format show up in the open-with list  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.register>
get_load_settings_for_data(cls, data)  # offer load options (image base, arch) for your format  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryViewType.get_load_settings_for_data>
bv.record_imported_object_library(LIB, NAME, ADDR)  # record which type library an import came from (in loaders)  @imports  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.record_imported_object_library>

## render layers (change how code looks)
; A render layer changes the lines of code just before they are shown.
; Use it to hide, add or color lines without changing the analysis.
class Layer(RenderLayer):           # change rendered lines of disassembly/IL; set name, override apply_to_*  @render  <https://api.binary.ninja/binaryninja.renderlayer-module.html#binaryninja.renderlayer.RenderLayer>
    class HighlightRet(RenderLayer):
        name = "Highlight Returns"
        def apply_to_high_level_il_body(self, function, lines):
            for line in lines:
                if any(t.text == "return" for t in line.contents.tokens):
                    line.contents.highlight = HighlightColor(red=0, green=80, blue=0)
            return lines
    HighlightRet.register()
apply_to_block(self, block, lines)  # change lines of any basic block (asm, LLIL, MLIL)  @render  <https://api.binary.ninja/binaryninja.renderlayer-module.html#binaryninja.renderlayer.RenderLayer.apply_to_block>
apply_to_high_level_il_body(self, function, lines)  # change lines of a whole HLIL function  @render  <https://api.binary.ninja/binaryninja.renderlayer-module.html#binaryninja.renderlayer.RenderLayer.apply_to_high_level_il_body>
apply_to_flow_graph(self, graph)    # change nodes and edges of a graph view  @render  <https://api.binary.ninja/binaryninja.renderlayer-module.html#binaryninja.renderlayer.RenderLayer.apply_to_flow_graph>
Layer.register()                    # make a render layer available (users enable it per view)  <https://api.binary.ninja/binaryninja.renderlayer-module.html#binaryninja.renderlayer.RenderLayer.register>

## data renderers (custom data display)
; Show data of a certain type your own way in the linear view.
class R(DataRenderer):        # render data of a type your own way in linear view  @struct @display  <https://api.binary.ninja/binaryninja.datarender-module.html#binaryninja.datarender.DataRenderer>
    class BarRenderer(DataRenderer):
        def perform_is_valid_for_data(self, ctxt, view, addr, type, context):
            return DataRenderer.is_type_of_struct_name(type, "BAR", context)
        def perform_get_lines_for_data(self, ctxt, view, addr, type, prefix, width, context):
            prefix.append(InstructionTextToken(InstructionTextTokenType.TextToken, "BAR!"))
            return [DisassemblyTextLine(prefix, addr)]
    BarRenderer().register_type_specific()
R().register_type_specific()  # use the renderer before the generic ones  <https://api.binary.ninja/binaryninja.datarender-module.html#binaryninja.datarender.DataRenderer.register_type_specific>
R().register_generic()        # use the renderer as a fallback for any type  <https://api.binary.ninja/binaryninja.datarender-module.html#binaryninja.datarender.DataRenderer.register_generic>

## flow graphs
; Draw your own graph of boxes and arrows and show it in a tab.
; Good for call graphs, state machines or any diagram.
g = FlowGraph()                # make an empty custom graph  @diagram  <https://api.binary.ninja/binaryninja.flowgraph-module.html#binaryninja.flowgraph.FlowGraph>
n = FlowGraphNode(g); n.lines = ["TEXT"]; g.append(n)  # add a node with text lines  <https://api.binary.ninja/binaryninja.flowgraph-module.html#binaryninja.flowgraph.FlowGraphNode>
a.add_outgoing_edge(BranchType.UnconditionalBranch, b)  # connect two nodes (TrueBranch, FalseBranch... set the color)  @arrow  <https://api.binary.ninja/binaryninja.flowgraph-module.html#binaryninja.flowgraph.FlowGraphNode.add_outgoing_edge>
a.add_outgoing_edge(TYPE, b, EdgeStyle(EdgePenStyle.DashLine, 2, COLOR))  # connect nodes with a custom line style  <https://api.binary.ninja/binaryninja.flowgraph-module.html#binaryninja.flowgraph.EdgeStyle>
n.highlight = HighlightStandardColor.BlueHighlightColor  # color a graph node  <https://api.binary.ninja/binaryninja.flowgraph-module.html#binaryninja.flowgraph.FlowGraphNode.highlight>
show_graph_report("TITLE", g)  # show a graph in a new tab  @ui  <https://api.binary.ninja/binaryninja.interaction-module.html#binaryninja.interaction.show_graph_report>
g.layout_and_wait()            # compute node positions without the UI (e.g. to export)  @headless  <https://api.binary.ninja/binaryninja.flowgraph-module.html#binaryninja.flowgraph.FlowGraph.layout_and_wait>
f.create_graph()               # get the built-in graph of a function to inspect or show  @cfg  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.create_graph>

## transforms (encode, decode, hash, unpack)
; A transform changes bytes from one form to another.
; Binary Ninja has many built in: Base64, Zlib, XOR, AES, SHA256...
; Use them to decode, decompress, decrypt or hash data you find in a binary.
; You can also write your own.
;
; TransformSession: opens a file that is packed inside other files
;   (zip, tar, gzip, base64...) and unpacks it layer by layer,
;   until it finds a file you can load and analyze.
; TransformContext: one step of that unpacking. The steps make a tree,
;   because one archive can hold many files.
list(Transform)                      # list transforms (Base64, Zlib, XOR, AES, SHA256, RawHex...)  @encode @decode  <https://api.binary.ninja/binaryninja.transform-module.html#binaryninja.transform.Transform>
Transform["Base64"].decode(DATA)     # decode bytes with a transform  <https://api.binary.ninja/binaryninja.transform-module.html#binaryninja.transform.Transform.decode>
Transform["Zlib"].decode(DATA)       # decompress zlib data  @inflate  <https://api.binary.ninja/binaryninja.transform-module.html#binaryninja.transform.Transform.decode>
Transform["XOR"].decode(DATA, {"key": b"KEY"})  # xor-decode bytes with a key  @decrypt  <https://api.binary.ninja/binaryninja.transform-module.html#binaryninja.transform.Transform.decode>
Transform["SHA256"].encode(DATA)     # hash bytes (MD5, SHA1, SHA256...)  @digest  <https://api.binary.ninja/binaryninja.transform-module.html#binaryninja.transform.Transform.encode>
Transform["AES-128 CBC"].parameters  # list the parameter names a transform needs (key, iv...)  @decrypt @options  <https://api.binary.ninja/binaryninja.transform-module.html#binaryninja.transform.Transform>
class MyT(Transform):                # add your own transform; override perform_decode / perform_encode  @custom  <https://api.binary.ninja/binaryninja.transform-module.html#binaryninja.transform.Transform>
TransformSession(PATH)               # open a container (zip, tar.gz, base64...) and extract down to a loadable file  @archive  <https://api.binary.ninja/binaryninja.transform-module.html#binaryninja.transform.TransformSession>
    s = TransformSession("archive.tar.gz")
    if s.process():
        s.set_selected_contexts(s.current_context)
        with load(s.current_view) as bv:
            print(bv.file.virtual_path)   # Gzip(...)::Tar()::file
ctx.set_transform_name("Base64"); s.process_from(ctx)  # force a transform when auto-detect fails  @container @manual  <https://api.binary.ninja/binaryninja.transform-module.html#binaryninja.transform.TransformContext.set_transform_name>
ctx.available_files / ctx.set_requested_files([NAMES])  # list and pick files inside an archive context  @container  <https://api.binary.ninja/binaryninja.transform-module.html#binaryninja.transform.TransformContext.set_requested_files>
DataBuffer(DATA).base64_decode()     # decode base64 with a DataBuffer  <https://api.binary.ninja/binaryninja.databuffer-module.html#binaryninja.databuffer.DataBuffer.base64_decode>
DataBuffer(DATA).zlib_decompress()   # inflate zlib data with a DataBuffer  <https://api.binary.ninja/binaryninja.databuffer-module.html#binaryninja.databuffer.DataBuffer.zlib_decompress>

## extension manager
; The extension manager finds, installs and updates plugins from online lists.
; Use it from Python to manage plugins by script.
RepositoryManager()  # get the plugin repositories manager  @extensions @install  <https://api.binary.ninja/binaryninja.extensionmanager-module.html#binaryninja.extensionmanager.RepositoryManager>
RepositoryManager().default_repository.plugins  # list plugins in the official repository  @extensions  <https://api.binary.ninja/binaryninja.extensionmanager-module.html#binaryninja.extensionmanager.Repository.plugins>
RepositoryManager().default_repository["PLUGIN_PATH"].install()  # install a plugin from a repository  <https://api.binary.ninja/binaryninja.extensionmanager-module.html#binaryninja.extensionmanager.Extension.install>
plugin.enabled = False / plugin.enable()  # turn an installed plugin off or on  @toggle  <https://api.binary.ninja/binaryninja.extensionmanager-module.html#binaryninja.extensionmanager.Extension.enabled>
RepositoryManager().check_for_updates()  # check repositories for plugin updates  @update  <https://api.binary.ninja/binaryninja.extensionmanager-module.html#binaryninja.extensionmanager.RepositoryManager.check_for_updates>

; ===============  project.sheet
; title: binary ninja projects, databases, metadata
; url:   https://api.binary.ninja/binaryninja.project-module.html
; tags:  binaryninja binja bn python api project bndb database snapshot metadata kvs

; UPPERCASE words are placeholders.

## projects (.bnpr)
; A project is a folder that holds many related files, like a program and its
; libraries, so you can work on them together.
Project.open_project(PATH)            # open a project folder  @bnpr  <https://api.binary.ninja/binaryninja.project-module.html#binaryninja.project.Project.open_project>
Project.create_project(PATH, "NAME")  # make a new project  @bnpr  <https://api.binary.ninja/binaryninja.project-module.html#binaryninja.project.Project.create_project>
proj.files                            # list ProjectFile objects in a project  <https://api.binary.ninja/binaryninja.project-module.html#binaryninja.project.Project.files>
proj.folders                          # list ProjectFolder objects in a project  <https://api.binary.ninja/binaryninja.project-module.html#binaryninja.project.Project.folders>
proj.create_file_from_path(PATH, FOLDER, "NAME")  # copy a file from disk into a project (FOLDER None = root)  @import  <https://api.binary.ninja/binaryninja.project-module.html#binaryninja.project.Project.create_file_from_path>
proj.create_file(DATA, FOLDER, "NAME")  # add bytes as a new project file  @memory  <https://api.binary.ninja/binaryninja.project-module.html#binaryninja.project.Project.create_file>
proj.create_folder(PARENT, "NAME")    # make a folder in a project  @mkdir  <https://api.binary.ninja/binaryninja.project-module.html#binaryninja.project.Project.create_folder>
proj.create_folder_from_path(DIR)     # import a whole folder tree from disk  @bulk  <https://api.binary.ninja/binaryninja.project-module.html#binaryninja.project.Project.create_folder_from_path>
proj.get_file_by_id(ID) / proj.get_files_by_path_in_project("a/b")  # find a project file  @lookup  <https://api.binary.ninja/binaryninja.project-module.html#binaryninja.project.Project.get_files_by_path_in_project>
proj.delete_file(PF) / proj.delete_folder(FOLDER)  # remove files or folders from a project  <https://api.binary.ninja/binaryninja.project-module.html#binaryninja.project.Project.delete_file>
with proj.bulk_operation():           # speed up many project changes at once  <https://api.binary.ninja/binaryninja.project-module.html#binaryninja.project.Project.bulk_operation>
proj.store_metadata("key", VALUE) / proj.query_metadata("key")  # save or read plugin data on a project  @persist  <https://api.binary.ninja/binaryninja.project-module.html#binaryninja.project.Project.store_metadata>
proj.close()                          # close an open project  <https://api.binary.ninja/binaryninja.project-module.html#binaryninja.project.Project.close>
pf.name / pf.path_on_disk / pf.folder  # read a project file's name, real path and folder  <https://api.binary.ninja/binaryninja.project-module.html#binaryninja.project.ProjectFile>
pf.export(DEST)                       # copy a project file out to disk  <https://api.binary.ninja/binaryninja.project-module.html#binaryninja.project.ProjectFile.export>
pf.add_dependency(OTHER_PF)           # record that one project file depends on another (e.g. a DLL)  @link  <https://api.binary.ninja/binaryninja.project-module.html#binaryninja.project.ProjectFile.add_dependency>
load(PF)                              # open a ProjectFile as a BinaryView  <https://api.binary.ninja/index.html#binaryninja.load>
bv.project / bv.project_file          # get the Project and ProjectFile a view came from  @current  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.project>
current_project                       # the open project in the Python console  <https://api.binary.ninja/binaryninja.project-module.html#binaryninja.project.Project>

## database and snapshots (.bndb internals)
; A .bndb keeps a history of snapshots, one for each save.
; Use these to look at old versions or the raw data inside.
bv.file.database                     # get the Database behind an opened .bndb  <https://api.binary.ninja/binaryninja.filemetadata-module.html#binaryninja.filemetadata.FileMetadata.database>
Database.open_existing(PATH)         # open a .bndb as a raw Database without loading analysis  <https://api.binary.ninja/binaryninja.database-module.html#binaryninja.database.Database.open_existing>
db.snapshots                         # list Snapshots (one per save)  @history @versions  <https://api.binary.ninja/binaryninja.database-module.html#binaryninja.database.Database.snapshots>
db.current_snapshot                  # get the snapshot that is loaded now  <https://api.binary.ninja/binaryninja.database-module.html#binaryninja.database.Database.current_snapshot>
snap.name / snap.id / snap.parents   # read a snapshot's name, id and parents  @history  <https://api.binary.ninja/binaryninja.database-module.html#binaryninja.database.Snapshot>
snap.file_contents                   # get the raw file bytes saved in a snapshot  @original  <https://api.binary.ninja/binaryninja.database-module.html#binaryninja.database.Snapshot.file_contents>
snap.undo_entries                    # list undo history stored in a snapshot  <https://api.binary.ninja/binaryninja.database-module.html#binaryninja.database.Snapshot.undo_entries>
db.trim_snapshot(ID)                 # drop a snapshot's contents to save space, keep its place in history  @size  <https://api.binary.ninja/binaryninja.database-module.html#binaryninja.database.Database.trim_snapshot>
db.remove_snapshot(ID)               # delete a snapshot completely  <https://api.binary.ninja/binaryninja.database-module.html#binaryninja.database.Database.remove_snapshot>
db.write_global("key", "VALUE") / db.read_global("key")  # store or read a string in the database globals  @kvs  <https://api.binary.ninja/binaryninja.database-module.html#binaryninja.database.Database.write_global>
db.write_global_data("key", DataBuffer(DATA))  # store raw bytes in the database globals  @kvs @binary  <https://api.binary.ninja/binaryninja.database-module.html#binaryninja.database.Database.write_global_data>
bv.file.reopen_moved_database(PATH)  # point a view at its .bndb after moving the file  @move  <https://api.binary.ninja/binaryninja.filemetadata-module.html#binaryninja.filemetadata.FileMetadata.reopen_moved_database>

## metadata values
; Metadata is your own data saved inside the .bndb, like numbers, text,
; lists and dicts.
bv.store_metadata("key", {"a": [1, 2], "b": b"\x00"})  # save nested dict/list/int/str/bytes values into the .bndb  @persist  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.store_metadata>
bv.query_metadata("key")          # read stored metadata back as Python values  @persist  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.query_metadata>
bv.store_metadata("key", VALUE, isAuto=True)  # store metadata as auto (owned by analysis, not the user)  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.store_metadata>
Metadata(VALUE)                   # wrap a Python value as a core Metadata object  <https://api.binary.ninja/binaryninja.metadata-module.html#binaryninja.metadata.Metadata>
md.value / md.get_dict() / md.get_json_string()  # turn a Metadata object into Python values or JSON  @convert  <https://api.binary.ninja/binaryninja.metadata-module.html#binaryninja.metadata.Metadata.value>
f.store_metadata("key", VALUE)    # save metadata on one function  @persist  <https://api.binary.ninja/binaryninja.function-module.html#binaryninja.function.Function.store_metadata>
lib.store_metadata("key", VALUE)  # save metadata into a type library  @persist @typelib  <https://api.binary.ninja/binaryninja.typelibrary-module.html#binaryninja.typelibrary.TypeLibrary.store_metadata>

## external links between files
; Link an import in one file to the real function in another file of the project,
; so you can follow calls across files.
bv.add_external_library("libc.so.6", PF)  # say which project file backs an imported library  @imports @link  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.add_external_library>
bv.add_external_location(IMPORT_SYM, LIB, "printf", None)  # link an import to a symbol in another file  @imports  <https://api.binary.ninja/binaryninja.binaryview-module.html#binaryninja.binaryview.BinaryView.add_external_location>
loc.library / loc.target_symbol / loc.target_address  # read where an ExternalLocation points  @imports  <https://api.binary.ninja/binaryninja.externallibrary-module.html#binaryninja.externallibrary.ExternalLocation>

; ===============  ui.sheet
; title: binary ninja ui (binaryninjaui)
; url:   https://api.binary.ninja/cpp/
; tags:  binaryninja binja bn python api binaryninjaui ui gui qt pyside6 widget sidebar pane action hotkey menu view

; UI only: binaryninjaui is missing in headless scripts. The C++ docs translate almost 1:1 to Python.
; ctx = UIActionContext, frame = ViewFrame, view = View. UPPERCASE words are placeholders.

## setup and rules
; The UI API (binaryninjaui) lets Python change the Binary Ninja window, using Qt.
; It only works in the UI, not in headless scripts. Follow these rules to avoid crashes.
import binaryninjaui                # import before PySide6 so the right Qt loads and the plugin skips headless runs  @pyside @crash  <https://docs.binary.ninja/dev/plugins.html#ui-plugins>
from binaryninjaui import UIContext, UIAction, UIActionHandler, Menu  # common imports for a UI plugin  @import
execute_on_main_thread(FN)          # touch Qt widgets only from the main thread; plugin code runs on a worker  @thread @crash  <https://api.binary.ninja/binaryninja.mainthread-module.html#binaryninja.mainthread.execute_on_main_thread>
dir(binaryninjaui)                  # list what the UI module exposes, since the Python docs are thin  @explore @help  <https://docs.binary.ninja/dev/concepts.html#ui-elements>
api.binary.ninja/cpp                # read the C++ UI headers docs; Python names and args match  @docs @reference  <https://api.binary.ninja/cpp/>
/src/binaryninja-api/ui/*.h         # read the UI headers in the API source for every method  @source @header  <file:/src/binaryninja-api/ui/uicontext.h>
python/examples/hellosidebar.py     # sample sidebar widget plugin  @example  <file:/src/binaryninja-api/python/examples/hellosidebar.py>
python/examples/hellopane.py        # sample pane plugin opened from a menu action  @example  <file:/src/binaryninja-api/python/examples/hellopane.py>
python/examples/helloglobalarea.py  # sample bottom global area widget  @example  <file:/src/binaryninja-api/python/examples/helloglobalarea.py>
python/examples/triage/             # sample full custom ViewType (Triage Summary)  @example  <file:/src/binaryninja-api/python/examples/triage/view.py>
python/examples/ui_notifications.py  # sample of every UIContextNotification callback  @example @events  <file:/src/binaryninja-api/python/examples/ui_notifications.py>

## console ui variables
; Ready-made names in the Python console for the UI parts you see now:
; the window, the tab and the view.
current_ui_context                  # the UIContext of the window the console belongs to  @console @window
current_ui_view_frame               # the ViewFrame (tab or pane) that has focus  @console @frame
current_ui_view                     # the View widget (linear, graph, hex...) that has focus  @console
current_ui_view_location            # the ViewLocation: view type, offset, function, IL type  @console @cursor
current_ui_action_handler           # the UIActionHandler of the focused view  @console
current_ui_action_context           # the UIActionContext the view would pass to an action  @console @ctx
current_ui_token_state              # the HighlightTokenState of the clicked token  @console @token

## ui context (window)
; A UIContext is one main Binary Ninja window.
; Start here to reach the tabs, views and the open files.
UIContext.activeContext()           # get the UIContext of the active main window  @window @current  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
UIContext.allContexts()             # get every open main window  @windows  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
UIContext.contextForWidget(W)       # get the UIContext that owns a widget  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
UIContext.currentViewFrameForWidget(W)  # get the best ViewFrame for a widget in a pane or popout  @frame  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
uic.getCurrentViewFrame()           # get the focused ViewFrame of a window  @frame  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
uic.getCurrentView()                # get the focused View of a window  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
uic.getCurrentActionHandler()       # get the action handler of the focused view  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
uic.getAvailableBinaryViews()       # list (BinaryView, name) for all open tabs  @tabs @bv  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
uic.navigateForBinaryView(bv, ADDR)  # jump to ADDR in the tab showing bv  @goto @navigate  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
uic.openFilename("PATH")            # open a file in a new tab, like File > Open  @load  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
uic.openFileContext(FileContext(bv.file, bv, "NAME"))  # show a BinaryView you made in Python in a new tab  @open @tab  <https://docs.binary.ninja/dev/cookbook.html>
    data = BinaryView.new(b'\x00\x00\x01')
    execute_on_main_thread(lambda: UIContext.activeContext().openFileContext(FileContext(data.file, data, '')))
uic.createTabForWidget("NAME", W)   # show any QWidget as a new tab  @tab  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
uic.openPane(PANE)                  # split the current tab and show PANE next to it  @split  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
uic.getTabs() / uic.activateTab(T) / uic.closeTab(T)  # list, switch to or close tabs  @tab  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
uic.splitToNewTabAndNavigateToLocation(ADDR)  # open ADDR in a new tab  @split  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
uic.refreshCurrentViewContents()    # redraw the current view after you changed data  @refresh @redraw  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
uic.mainWindow()                    # get the QMainWindow, e.g. as a dialog parent  @parent @qt  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
uic.sidebar() / uic.globalArea()    # get the sidebar or the bottom global area of a window  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>

## view frame and view (the current tab)
; A ViewFrame is one tab. A View is what the tab shows: linear, graph, hex...
; Use them to get the cursor, the selection, or to move around.
frame.getCurrentBinaryView()        # get the BinaryView shown in this frame  @bv  <https://api.binary.ninja/cpp/group__viewframe.html#class_view_frame>
frame.getCurrentOffset()            # get the cursor address in this frame  @here @address  <https://api.binary.ninja/cpp/group__viewframe.html#class_view_frame>
frame.getSelectionOffsets()         # get the selected range (start, end)  @range  <https://api.binary.ninja/cpp/group__viewframe.html#class_view_frame>
frame.getCurrentView()              # get the view type name, e.g. "Linear:ELF"  @type  <https://api.binary.ninja/cpp/group__viewframe.html#class_view_frame>
frame.getCurrentViewInterface()     # get the View object of this frame  <https://api.binary.ninja/cpp/group__viewframe.html#class_view_frame>
frame.getViewLocation()             # get the ViewLocation (type, offset, function, IL type)  @cursor  <https://api.binary.ninja/cpp/group__viewframe.html#class_view_frame>
frame.navigate("Graph:ELF", ADDR)   # jump to ADDR in a given view type  @goto  <https://api.binary.ninja/cpp/group__viewframe.html#class_view_frame>
frame.navigate(bv, ADDR)            # jump to ADDR in the current view type  @goto  <https://api.binary.ninja/cpp/group__viewframe.html#class_view_frame>
frame.navigateToFunction(func, ADDR)  # jump to ADDR inside a given function  @goto  <https://api.binary.ninja/cpp/group__viewframe.html#class_view_frame>
frame.setViewType("Linear:ELF")     # switch the frame to another view type  @graph @linear @hex  <https://api.binary.ninja/cpp/group__viewframe.html#class_view_frame>
frame.back() / frame.forward()      # go back or forward in navigation history  @history  <https://api.binary.ninja/cpp/group__viewframe.html#class_view_frame>
frame.getSidebar()                  # get the sidebar for this frame  <https://api.binary.ninja/cpp/group__viewframe.html#class_view_frame>
ViewFrame.viewFrameForWidget(W)     # get the ViewFrame that contains a widget  <https://api.binary.ninja/cpp/group__viewframe.html#class_view_frame>
view.getData()                      # get the BinaryView of a View  @bv  <https://api.binary.ninja/cpp/group__viewframe.html#class_view>
view.getCurrentOffset()             # get the cursor address of a View  @here  <https://api.binary.ninja/cpp/group__viewframe.html#class_view>
view.setSelectionOffsets(RANGE)     # select a range in a View  @select  <https://api.binary.ninja/cpp/group__viewframe.html#class_view>
view.navigate(ADDR)                 # move a View to ADDR  @goto  <https://api.binary.ninja/cpp/group__viewframe.html#class_view>
view.getCurrentFunction()           # get the function under the cursor of a View  <https://api.binary.ninja/cpp/group__viewframe.html#class_view>
view.getCurrentHighLevelILFunction()  # get the HLIL function shown in a View (also LowLevel, MediumLevel)  @il  <https://api.binary.ninja/cpp/group__viewframe.html#class_view>
view.getCurrentILInstructionIndex()  # get the IL instruction index under the cursor  @il  <https://api.binary.ninja/cpp/group__viewframe.html#class_view>
View.getViewFromWidget(W)           # get the View interface of a view widget  <https://api.binary.ninja/cpp/group__viewframe.html#class_view>
loc.getOffset() / loc.getFunction() / loc.getViewType()  # read a ViewLocation  @cursor  <https://api.binary.ninja/cpp/group__viewframe.html#class_view_location>

## actions and hotkeys
; An action is a named command that can have a hotkey.
; Register it once, then put it in menus or bind it to keys.
UIAction.registerAction("NAME", QKeySequence("Ctrl+Shift+H"))  # create a named action with a default hotkey  @shortcut @keybinding  <https://api.binary.ninja/cpp/group__action.html#struct_u_i_action>
UIActionHandler.globalActions().bindAction("NAME", UIAction(FN))  # run FN(ctx) when the action fires anywhere  @bind  <https://api.binary.ninja/cpp/group__action.html#class_u_i_action_handler>
UIAction(FN, IS_VALID)              # action that is greyed out unless IS_VALID(ctx) is True  @enable @disable  <https://api.binary.ninja/cpp/group__action.html#struct_u_i_action>
    UIAction.registerAction("Hello Pane")
    UIActionHandler.globalActions().bindAction("Hello Pane", UIAction(create_pane, lambda ctx: ctx.binaryView is not None))
ctx.binaryView / ctx.address / ctx.length  # data an action gets: bv, cursor address, selection size  @context  <https://api.binary.ninja/cpp/group__action.html#struct_u_i_action_context>
ctx.function / ctx.highLevelILFunction / ctx.instrIndex  # function and IL position an action gets  @context  <https://api.binary.ninja/cpp/group__action.html#struct_u_i_action_context>
ctx.context / ctx.view / ctx.widget  # UIContext, View and widget an action was fired from  @context  <https://api.binary.ninja/cpp/group__action.html#struct_u_i_action_context>
ctx.token                           # the HighlightTokenState under the cursor (token.addr, token.localVar...)  @context  <https://api.binary.ninja/cpp/group__action.html#struct_u_i_action_context>
UIAction.unregisterAction("NAME")   # remove a registered action  @delete  <https://api.binary.ninja/cpp/group__action.html#struct_u_i_action>
UIAction.getAllRegisteredActions()  # list every action name, built-in and plugin  @list  <https://api.binary.ninja/cpp/group__action.html#struct_u_i_action>
UIAction.getKeyBinding("NAME")      # get the hotkeys bound to an action  @shortcut  <https://api.binary.ninja/cpp/group__action.html#struct_u_i_action>
UIAction.setUserKeyBinding("NAME", [QKeySequence("F5")])  # change the hotkey of an action from code  @rebind  <https://api.binary.ninja/cpp/group__action.html#struct_u_i_action>
handler.executeAction("NAME")       # run any action (built-in too) by name from code  @invoke @trigger  <https://api.binary.ninja/cpp/group__action.html#class_u_i_action_handler>
UIActionHandler.actionHandlerFromWidget(W)  # get the action handler that owns a widget  <https://api.binary.ninja/cpp/group__action.html#class_u_i_action_handler>
self.actionHandler = UIActionHandler(); self.actionHandler.setupActionHandler(self)  # give your widget its own action handler  @widget  <https://api.binary.ninja/cpp/group__action.html#class_u_i_action_handler>
python/examples/list_keybindings.py  # print or export every action and its hotkey  @shortcut @keys  <file:/src/binaryninja-api/python/examples/list_keybindings.py>

## menus
; Put your actions into the main menu or the right-click menu.
Menu.mainMenu("Plugins").addAction("NAME", "GROUP")  # put a registered action in a top menu  @menubar  <https://api.binary.ninja/cpp/group__action.html#class_menu>
Menu.mainMenu("Plugins").removeAction("NAME")  # take an action out of a top menu  @delete  <https://api.binary.ninja/cpp/group__action.html#class_menu>
Menu.getMainMenus()                 # list the top menu names  <https://api.binary.ninja/cpp/group__action.html#class_menu>
self.m_contextMenuManager.show(self.m_menu, self.actionHandler)  # show the right-click menu in a SidebarWidget  @contextmenu @rightclick  <file:/src/binaryninja-api/python/examples/hellosidebar.py>
OnContextMenuCreated(self, context, view, menu)  # notification to add items to a view's right-click menu  @contextmenu  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context_notification>

## events (UIContextNotification)
; Get a call when something happens in the UI: a file opens,
; the tab changes, the cursor moves.
class N(UIContextNotification)      # get called on UI events: file open, view change, cursor move  @hook @callback @listen  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context_notification>
    class N(UIContextNotification):
        def __init__(self):
            UIContextNotification.__init__(self); UIContext.registerNotification(self)
        def OnAddressChange(self, context, frame, view, location):
            print(hex(location.getOffset()))
    n = N()   # keep a reference or it is garbage collected
UIContext.registerNotification(N) / UIContext.unregisterNotification(N)  # start or stop getting UI events  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
OnAddressChange(self, context, frame, view, location)  # called when the cursor moves  @cursor @navigate
OnViewChange(self, context, frame, type)  # called when the tab or view type changes  @switch
OnAfterOpenFile(self, context, file, frame)  # called after a file opens in a tab  @load
OnBeforeOpenFile(self, context, file)  # called before a file opens; return False to stop it  @load @block
OnBeforeSaveFile / OnAfterSaveFile(self, context, file, frame)  # called around saving; Before returns bool  @save
OnBeforeCloseFile / OnAfterCloseFile(self, context, file, frame)  # called around closing a tab; Before returns bool  @close
OnAfterOpenDatabase(self, context, metadata, data)  # called after a .bndb opens  @bndb
OnContextOpen / OnContextClose(self, context)  # called when a main window opens or closes  @window
OnTokenDoubleClicked(self, context, frame, view, location, token)  # called on token double click; return True to replace the default  @click
OnActionExecutedImmutable(self, context, handler, name, ctx)  # called after any action runs; log what the user does  @trace @audit
widget.destroyed.connect(lambda: UIContext.unregisterNotification(n))  # stop events when the widget dies; __del__ is not called  @cleanup @leak  <file:/src/binaryninja-api/python/examples/hellopane.py>

## sidebar widgets
; Add your own panel to the sidebar, next to Symbols and Types.
; Good for tools that follow the cursor.
Sidebar.addSidebarWidgetType(MyType())  # register a new sidebar panel with an icon  @panel @dock  <https://api.binary.ninja/cpp/group__sidebar.html>
class MyType(SidebarWidgetType)     # sidebar panel type: icon, name, createWidget  <https://api.binary.ninja/cpp/group__sidebar.html>
    class MyType(SidebarWidgetType):
        def __init__(self):
            SidebarWidgetType.__init__(self, QImage(56, 56, QImage.Format_RGB32), "Hello")  # 56x56 grayscale, white = shape
        def createWidget(self, frame, data):
            return MyWidget("Hello", frame, data)
        def defaultLocation(self):
            return SidebarWidgetLocation.RightContent
        def contextSensitivity(self):
            return SidebarContextSensitivity.SelfManagedSidebarContext
class MyWidget(SidebarWidget)       # sidebar panel content; call SidebarWidget.__init__(self, NAME)  <https://api.binary.ninja/cpp/group__sidebar.html>
notifyOffsetChanged(self, offset)   # SidebarWidget callback: the cursor moved  @cursor
notifyViewChanged(self, view_frame)  # SidebarWidget callback: the tab or view changed; view_frame may be None  @switch
notifyViewLocationChanged(self, view, location)  # SidebarWidget callback: full location changed (function, IL)  @cursor
SidebarWidgetLocation.LeftContent / RightContent / LeftBottom / RightBottom / LeftReference / RightReference  # where a sidebar panel goes  @position @side
SidebarContextSensitivity.SelfManagedSidebarContext  # one widget for all tabs; you track view changes  @instance
SidebarContextSensitivity.PerTabSidebarContext / PerViewTypeSidebarContext / PerPaneSidebarContext  # one widget per tab, view type or pane  @instance
Sidebar.current().activate("NAME")  # open a sidebar panel by name  @show @open  <https://api.binary.ninja/cpp/group__sidebar.html>
sidebar.toggle("NAME") / sidebar.deactivate("NAME")  # toggle or close a sidebar panel  @hide  <https://api.binary.ninja/cpp/group__sidebar.html>
sidebar.widget("NAME")              # get the live widget of a sidebar panel  @find  <https://api.binary.ninja/cpp/group__sidebar.html>

## panes, global area, custom views
; Other places for your own widgets: split panes, the bottom area (next to Log),
; or a whole new kind of view.
WidgetPane(W, "TITLE")              # wrap a QWidget as a pane for uic.openPane  @split  <https://api.binary.ninja/cpp/group__pane.html>
    ctx.context.openPane(WidgetPane(MyWidget(ctx.binaryView), "Hello"))
GlobalArea.addWidget(lambda ctx: MyArea("NAME"))  # add a tab to the bottom area (next to Log, Console)  @bottom @panel  <https://api.binary.ninja/cpp/group__globalarea.html>
class MyArea(GlobalAreaWidget)      # bottom area widget; same notifyOffsetChanged / notifyViewChanged as sidebar  <https://api.binary.ninja/cpp/group__globalarea.html>
ViewType.registerViewType(MyViewType())  # add a new view type to the view picker (like Triage, Hex)  @customview  <https://api.binary.ninja/cpp/group__viewtype.html>
class MyViewType(ViewType)          # implement getPriority(data, filename) and create(data, view_frame)  @customview  <file:/src/binaryninja-api/python/examples/triage/view.py#L183>
    class MyViewType(ViewType):
        def __init__(self): super().__init__("Mine", "My View")
        def getPriority(self, data, filename): return 1   # higher wins as the default view
        def create(self, data, view_frame): return MyView(view_frame, data)
class MyView(QScrollArea, View)     # custom view widget; call View.__init__ and self.setupView(self)  @customview  <file:/src/binaryninja-api/python/examples/triage/view.py>
getData / getCurrentOffset / navigate / getFont  # methods every custom View must implement  @override @abstract  <https://api.binary.ninja/cpp/group__viewframe.html#class_view>
ViewType.getTypes() / ViewType.getTypeByName("NAME")  # list or find view types  <https://api.binary.ninja/cpp/group__viewtype.html>

## look and feel
; Match the user's fonts, theme colors and screen size so your widgets look native.
binaryninjaui.getMonospaceFont(W)   # get the user's code font for a widget  @font  <file:/src/binaryninja-api/ui/fontsettings.h#L42>
binaryninjaui.getApplicationFont(W)  # get the user's normal UI font  @font  <file:/src/binaryninja-api/ui/fontsettings.h#L29>
binaryninjaui.getThemeColor(ThemeColor.AddressColor)  # get a QColor from the current theme  @color @dark  <file:/src/binaryninja-api/ui/theme.h#L69>
UIContext.getScaledWindowSize(X, Y)  # scale a window size for the screen DPI  @hidpi  <https://api.binary.ninja/cpp/group__uicontext.html#class_u_i_context>
