; -> See "extensionmanager module". Change old code:  from binaryninja.pluginmanager import ...
;                                                  ->  from binaryninja.extensionmanager import ...

binaryninja.pluginmanager                  # old alias, do not use                                    @binja @api @deprecated  <file:/opt/binaryninja/python/binaryninja/pluginmanager.py>


## project module (Project, ProjectFile, ProjectFolder)
; ------------------------------------------------------------------
; A Project = a FOLDER of many files that you analyze together:
;   an exe and its DLLs, a firmware and its extracted parts, a malware family (many samples) ...
; Binja stores the project as a ".bnpr" folder. Files inside can be binaries AND .bndb databases.
;
; Why use it:
;   - keep all related files in one place, with folders and descriptions
;   - link imports to the real library files (see externallibrary module)
;   - save notes for the whole project (project metadata)
;   - file DEPENDENCIES: "a.exe needs b.dll"
;
; Every file and folder has a unique id. Files have a path IN the project and a path ON DISK.

Project.create_project(path, name)         # make a new project                                        @binja @api @project  <file:/opt/binaryninja/python/binaryninja/project.py:443>
Project.open_project(path)                 # open an existing project                                  @binja @api @project  <file:/opt/binaryninja/python/binaryninja/project.py:428>
p.name / p.path / p.is_open / p.close()    # basics                                                    @binja @api @project
p.files / p.folders                        # all files / folders                                       @binja @api @project
p.create_folder(parent, name, desc="")     # new folder (parent None = top)                            @binja @api @project  <file:/opt/binaryninja/python/binaryninja/project.py:621>
p.create_folder_from_path(disk_path)       # import a whole folder from disk                           @binja @api @project
p.create_file_from_path(disk_path, folder, name)   # import one file from disk                         @binja @api @project  <file:/opt/binaryninja/python/binaryninja/project.py:688>
p.create_file(bytes, folder, name)         # make a file from bytes                                    @binja @api @project  <file:/opt/binaryninja/python/binaryninja/project.py:714>
p.get_files_in_folder(folder)              # files in one folder                                       @binja @api @project
p.get_files_by_path_in_project(path)       # find by project path                                      @binja @api @project
p.get_file_by_id(id) / get_folder_by_id(id)   # find by id                                             @binja @api @project
p.delete_file(f) / p.delete_folder(d)      # delete                                                    @binja @api @project
p.bulk_operation()                         # "with" block: MUCH faster for many changes                @binja @api @project  <file:/opt/binaryninja/python/binaryninja/project.py:825>
p.store_metadata(k, v) / get_metadata(k)   # notes for the whole project                               @binja @api @project
f.name / f.description / f.folder / f.id   # file info                                                 @binja @api @project  <file:/opt/binaryninja/python/binaryninja/project.py:58>
f.get_path_on_disk() / f.get_path_in_project()   # where it is                                         @binja @api @project
f.export(dest)                             # copy the file out to disk                                 @binja @api @project
f.add_dependency(other) / get_dependencies() / get_required_by()   # links between files               @binja @api @project
binaryninja.load(project_file)             # open a project file for analysis                         @binja @api @project
bv.project / bv.file.project_file          # project of an open binary / its ProjectFile              @binja @api @project

; All examples need a license (I tested: create_project raises "License is not valid" without one).

; --- Example 1: make a project from a folder of samples
;
;     from pathlib import Path
;     from binaryninja.project import Project
;     p = Project.create_project("/tmp/family_x", "Malware family X")
;     samples = p.create_folder(None, "samples", "raw samples")
;     with p.bulk_operation():
;         for path in Path("/home/me/samples").iterdir():
;             if path.is_file():
;                 p.create_file_from_path(str(path), samples, path.name)
;     print(len(p.files), "files")


; --- Example 2: analyze every file in a project (headless) and save notes
;
;     import binaryninja
;     from binaryninja.project import Project
;     p = Project.open_project("/tmp/family_x")
;     summary = {}
;     for f in p.files:
;         with binaryninja.load(f) as bv:               # load accepts a ProjectFile
;             summary[f.name] = {"functions": len(bv.functions), "arch": bv.arch.name if bv.arch else None}
;     p.store_metadata("summary", summary)
;     print(p.get_metadata("summary"))


; --- Example 3: dependencies (exe needs dll)
;
;     from binaryninja.project import Project
;     p = Project.open_project("/tmp/app_project")
;     exe = p.get_files_by_path_in_project("app.exe")[0]
;     dll = p.get_files_by_path_in_project("crypto.dll")[0]
;     exe.add_dependency(dll)
;     print([x.name for x in exe.get_dependencies()])     # ['crypto.dll']
;     print([x.name for x in dll.get_required_by()])      # ['app.exe']


; --- Example 4: inside the GUI, list the project of the open binary
; bv = the binary you have open (the console gives you this variable).
;
;     p = bv.project
;     if p is None:
;         print("not in a project")
;     else:
;         for folder in p.folders:
;             print("[folder]", folder.name)
;         for f in p.files:
;             print(f.get_path_in_project(), "| on disk:", f.get_path_on_disk())


; --- Notes
; - Use bulk_operation() when you add/delete MANY files: changes are written in chunks (much faster).
; - Errors raise ProjectException (exceptions module).
; - Deleting a project file deletes its copy in the project folder on disk.
; - I did not run these examples.


## renderlayer module (RenderLayer)
; ------------------------------------------------------------------
; A RenderLayer CHANGES THE LINES before the GUI shows them (Linear view and Graph view).
; You can ADD lines, CHANGE lines (text, colors), or REMOVE lines. The analysis does NOT change.
; In the GUI, each layer can be turned on/off (View menu / "Render Layers"), depending on default_enable_state.
;
; Ideas: highlight return lines, show argument names at calls, show register values as comments,
;        add an empty line after each call, hide boring lines ...
;
; Official examples in /opt/binaryninja/examples/python/:
;   highlight_returns_render_layer.py   args_render_layer.py   follow_reg_render_layer.py   newline_render_layer.py
;
; Methods you can write (all return the NEW list of lines):
;   apply_to_disassembly_block(block, lines)        assembly blocks
;   apply_to_low_level_il_block / medium_level_il_block / high_level_il_block(block, lines)
;   apply_to_block(block, lines)                    ANY block (default: calls the 4 above)
;   apply_to_high_level_il_body(function, lines)    the WHOLE HLIL body (lines are LinearDisassemblyLine -> use line.contents)
;   apply_to_misc_linear_lines(obj, prev, next, lines)   lines outside functions (data, headers) in Linear view
;   apply_to_flow_graph(graph)                      change a whole graph
;
; default_enable_state (RenderLayerDefaultEnableState):
;   DisabledByDefault...  (default)   EnabledByDefault...   AlwaysEnabled... (always on, not shown in the UI list)

RenderLayer                                # base class                                               @binja @api @render  <file:/opt/binaryninja/python/binaryninja/renderlayer.py:76>
MyLayer.register()                         # turn it on (class method)                                @binja @api @render
name = "My Layer"                          # class variable, shown in the UI                          @binja @api @render
list(RenderLayer) / RenderLayer[name]      # all layers / one by name                                 @binja @api @render
graph.add_render_layer(layer) / cursor.add_render_layer(layer)   # apply a layer in your own graph / linear cursor  @binja @api @render
/opt/binaryninja/examples/python/highlight_returns_render_layer.py   # official example                   @binja @example @render  <file:/opt/binaryninja/examples/python/highlight_returns_render_layer.py>

; --- Example 1: color every line that contains a call (all IL levels + assembly)
;
;     from binaryninja import RenderLayer, HighlightColor, InstructionTextTokenType
;     from binaryninja.enums import HighlightStandardColor, RenderLayerDefaultEnableState
;
;     class CallColorLayer(RenderLayer):
;         name = "Color calls"
;         default_enable_state = RenderLayerDefaultEnableState.EnabledByDefaultRenderLayerDefaultEnableState
;         color = HighlightColor(HighlightStandardColor.OrangeHighlightColor, alpha=80)
;
;         def apply_to_block(self, block, lines):
;             for line in lines:
;                 text = "".join(t.text for t in line.tokens)
;                 if "call" in text:
;                     line.highlight = self.color
;             return lines
;
;         def apply_to_high_level_il_body(self, function, lines):
;             for line in lines:
;                 if any(t.type == InstructionTextTokenType.CodeSymbolToken for t in line.contents.tokens) and "(" in str(line):
;                     line.contents.highlight = self.color
;             return lines
;
;     CallColorLayer.register()


; --- Example 2: add a comment line with the address after each assembly line that writes memory
;
;     from binaryninja import RenderLayer, DisassemblyTextLine, InstructionTextToken, InstructionTextTokenType
;
;     class StoreNoteLayer(RenderLayer):
;         name = "Note memory writes"
;         def apply_to_disassembly_block(self, block, lines):
;             out = []
;             for line in lines:
;                 out.append(line)
;                 text = "".join(t.text for t in line.tokens)
;                 if text.lstrip().startswith("mov") and ", " in text and "[" in text.split(",")[0]:
;                     tok = InstructionTextToken(InstructionTextTokenType.CommentToken, "    ; ^ writes memory")
;                     out.append(DisassemblyTextLine([tok], line.address))
;             return out
;
;     StoreNoteLayer.register()


; --- Example 3: list layers
;
;     from binaryninja import RenderLayer
;     print([l.name for l in RenderLayer])


; --- Notes
; - Your methods run EVERY time the view redraws. Keep them FAST.
; - Change and return the list. If you return a different list, keep DisassemblyTextLine objects (not strings).
; - In apply_to_high_level_il_body the items are LinearDisassemblyLine: change line.contents, not line.
; - I did not run these examples.


## requirementcheck module (pip dependencies of plugins)
; ------------------------------------------------------------------
; INTERNAL helper for the plugin manager. It reads the "dependencies" of a plugin
; (pip packages like "requests>=2.0") and checks: are they installed? do they conflict with other plugins?
; You only need it if you build plugin tools. Works WITHOUT a license. Outputs below are REAL.
;
; Dependency text can be:
;   - requirements.txt style text (comments with # are removed)
;   - JSON: {"pip": ["pkg1", "pkg2"]}

pip_requirements_from_dependency_metadata(bytes)        # -> list of requirement strings              @binja @api @plugins  <file:/opt/binaryninja/python/binaryninja/requirementcheck.py:28>
pip_requirements_satisfied(list)                        # -> True if all are installed (right versions) @binja @api @plugins  <file:/opt/binaryninja/python/binaryninja/requirementcheck.py:87>
pip_requirements_excluding_packages(bytes, names)       # -> list without some packages              @binja @api @plugins
pip_dependency_conflicts(name, deps, installed_plugins) # -> conflicts with installed plugins         @binja @api @plugins  <file:/opt/binaryninja/python/binaryninja/requirementcheck.py:212>

; --- Example 1: parse and check  (REAL output)
;
;     from binaryninja.requirementcheck import *
;     print(pip_requirements_from_dependency_metadata(b"requests>=2.0  # http\n# comment\nlief\n"))
;     # ['requests>=2.0', 'lief']
;     print(pip_requirements_from_dependency_metadata(b'{"pip": ["capstone==5.0", "yara-python"]}'))
;     # ['capstone==5.0', 'yara-python']
;     print(pip_requirements_satisfied(["pip>=1.0"]), pip_requirements_satisfied(["surely-not-installed-pkg"]))
;     # True False
;     print(pip_requirements_excluding_packages(b"requests\nlief", ["lief"]))
;     # ['requests']


; --- Example 2: check your OWN plugin's requirements.txt before you load it
;
;     from binaryninja.requirementcheck import pip_requirements_from_dependency_metadata, pip_requirements_satisfied
;     reqs = pip_requirements_from_dependency_metadata(open("/path/to/plugin/requirements.txt", "rb").read())
;     print("OK" if pip_requirements_satisfied(reqs) else f"missing something from: {reqs}")


## scriptingprovider module (the Python console + "magic variables")
; ------------------------------------------------------------------
; This module RUNS the Python console in the Binja GUI (and other script languages if a plugin adds them).
; The most useful part for you: the MAGIC VARIABLES. The console fills them before every command,
; with what you see / click in the GUI right now. (That is why "bv" and "current_function" just exist there.)
;
; Writable ones: "here" / "current_address" (set it -> the GUI jumps there), "current_selection" (set -> selects).
;
; Magic variables found in the source (scriptingprovider.py register_magic_variable calls):
;   bv / current_view            the open BinaryView
;   here / current_address       the address under the cursor (SET it to navigate)
;   current_raw_offset           the file offset of the cursor
;   current_selection            (start, end) of the selection (you can set it)
;   current_function             the Function at the cursor
;   current_basic_block          the BasicBlock at the cursor
;   current_symbol / current_symbols     symbol(s) at the cursor
;   current_data_var             the data variable at the cursor
;   current_comment              the comment at the cursor
;   current_variable             the variable under the cursor (clicked token)
;   current_token                the clicked token
;   current_segment / current_sections   memory segment / sections at the cursor
;   current_llil / current_mlil / current_hlil (+ _ssa)   IL functions of current_function
;   current_lifted_il / current_mapped_mlil (+ _ssa)
;   current_il_function          the IL function of the CURRENT VIEW (if you look at MLIL, it is MLIL)
;   current_il_instruction       the IL instruction at the cursor (current view's IL)
;   current_il_instructions      all IL instructions at the cursor
;   current_il_index / current_il_expr / current_il_expr_index / current_il_basic_block
;   current_project              the project
;   current_ui_context / current_ui_view / current_ui_view_frame / current_ui_view_location / current_ui_action_context ...   (Qt UI objects)
;   current_thread               (debugger)   current_similarity_session (similarity)
; Also: write_at_cursor(data) and get_selected_data() are functions in the console.
; Tip: type a name and "?" (like  bv.read?) to see its docs (bninspect).

PythonScriptingProvider.register_magic_variable(name, get_value, set_value=None, depends_on=None)   # add your own magic variable  @binja @api @console  <file:/opt/binaryninja/python/binaryninja/scriptingprovider.py:1469>
PythonScriptingProvider.unregister_magic_variable(name)    # remove it                                 @binja @api @console
ScriptingProvider / ScriptingInstance                      # base classes to add ANOTHER language console  @binja @api @console  <file:/opt/binaryninja/python/binaryninja/scriptingprovider.py:465>

; All examples run in the Binja GUI Python console.

; --- Example 1: the most used magic variables
;
;     print(bv.file.filename)
;     print(hex(here), current_function.name if current_function else None)
;     print(current_hlil)                          # HLIL of the function at the cursor
;     print(current_il_instruction)                # the IL line under the cursor (in the IL you are looking at)
;     print(current_selection)                     # (start, end)


; --- Example 2: jump somewhere by setting "here"
;
;     here = bv.entry_point                        # the GUI moves to the entry point


; --- Example 3: read the selected bytes and decode them
;
;     data = bv.read(current_selection[0], current_selection[1] - current_selection[0])
;     print(bytes(b ^ 0x41 for b in data))         # xor-decode the selection


; --- Example 4: your own magic variable (for example: the HLIL statement at the cursor, as text)
; Put this in a plugin file so it exists in every console.
;
;     from binaryninja.scriptingprovider import PythonScriptingProvider
;
;     def get_hlil_text(instance):
;         il = instance.interpreter.locals.get("current_il_instruction")
;         return str(il) if il is not None else None
;
;     PythonScriptingProvider.register_magic_variable("current_line_text", get_hlil_text,
;                                                     depends_on=["current_il_instruction"])
;     # in the console:  print(current_line_text)


; --- Notes
; - Magic variables exist ONLY in the GUI console. In a headless script or a plugin action you get bv / func as arguments.
; - They are updated BEFORE each command. If you click somewhere else, run the command again.
; - Setting a read-only magic variable prints a warning.
; - Extra subpackages add more magic variables: debugger (current_thread ...), sharedcache, kernelcache.


## secretsprovider module (SecretsProvider)
; ------------------------------------------------------------------
; A place to store SECRETS (passwords, API tokens, keys) safely, not in plain text settings.
; Binja uses it for things like collaboration/enterprise login. A provider uses the OS keychain or similar.
; Your plugin can use it to keep an API key (for example a VirusTotal key) out of your code.
;
; Interface: has_data(key) / get_data(key) / store_data(key, data) / delete_data(key)
; To make your own provider: inherit SecretsProvider, set name, write perform_has_data / perform_get_data /
;                            perform_store_data / perform_delete_data, then .register().

list(SecretsProvider)                      # all providers (needs a license: plugins must be loaded)   @binja @api @secrets  <file:/opt/binaryninja/python/binaryninja/secretsprovider.py:80>
SecretsProvider[name]                      # one provider by name                                      @binja @api @secrets
sp.store_data(key, data) / sp.get_data(key) / sp.has_data(key) / sp.delete_data(key)                   @binja @api @secrets  <file:/opt/binaryninja/python/binaryninja/secretsprovider.py:141>

; --- Example 1: keep an API key safe for your plugin (GUI console)
;
;     from binaryninja.secretsprovider import SecretsProvider
;     sp = list(SecretsProvider)[0]                 # first available provider
;     print("provider:", sp.name)
;     if not sp.has_data("myplugin.vt_key"):
;         sp.store_data("myplugin.vt_key", "PASTE-YOUR-KEY")
;     key = sp.get_data("myplugin.vt_key")


; --- Notes
; - Use a prefix in keys ("myplugin.xxx").
; - Never print a secret into the log.
; - I did not run this (list(SecretsProvider) needs a license).


## settings module (Settings)
; ------------------------------------------------------------------
; ALL Binja options (the Settings window) are in one system. Keys look like "group.name":
;   "analysis.mode", "analysis.linearSweep.autorun", "loader.imageBase", "loader.platform",
;   "network.httpsProxy", "files.universal.architecturePreference", "python.interpreter" ... (seen in the source)
;
; A setting can have a value at 4 LEVELS (scopes). The higher one wins:
;   Default   (lowest)  -> in the schema
;   User                -> <user dir>/settings.json         (your normal choice in the Settings window)
;   Project             -> <project dir>/settings.json
;   Resource  (highest) -> inside ONE binary / .bndb         (setting for this file only)
; Note (from the source): settings that change analysis are COPIED into the Resource scope when a binary is first
; analyzed, so a .bndb opens later with the same settings.
;
; Your plugin can ADD its own settings (register_group + register_setting). They appear in the Settings window.

Settings()                                 # the default settings                                     @binja @api @settings  <file:/opt/binaryninja/python/binaryninja/settings.py:31>
s.keys()                                   # all setting keys                                         @binja @api @settings
s.contains(key)                            # True if it exists                                        @binja @api @settings
s.get_bool / get_integer / get_double / get_string / get_string_list / get_json(key, resource=None)   # read. resource=bv -> value for that file  @binja @api @settings
s.get_bool_with_scope(key, bv)             # -> (value, scope where it came from)                     @binja @api @settings
s.set_bool / set_integer / set_string ... (key, value, resource=None, scope=SettingsScope.X)          # write  @binja @api @settings
s.reset(key, resource, scope) / reset_all(...)   # back to default                                    @binja @api @settings
s.query_property_string(key, "description")      # read the schema (title, description, type ...)    @binja @api @settings
s.register_group(group, title)             # your plugin's group                                      @binja @api @settings  <file:/opt/binaryninja/python/binaryninja/settings.py:204>
s.register_setting(key, json_properties)   # your plugin's setting                                    @binja @api @settings  <file:/opt/binaryninja/python/binaryninja/settings.py:220>
binaryninja.load(path, options={key: value})   # set settings for ONE load (headless)                 @binja @api @settings

; All examples need a license (Settings() raised "License is not valid" in my test).

; --- Example 1: search settings by a word
;
;     from binaryninja.settings import Settings
;     s = Settings()
;     for k in s.keys():
;         if "linearSweep" in k:
;             print(k, "=", s.get_json(k), "|", s.query_property_string(k, "description"))


; --- Example 2: open a raw firmware with base address and platform (headless)
;
;     import binaryninja
;     opts = {"loader.imageBase": 0x08000000, "loader.platform": "thumb2"}
;     with binaryninja.load("/path/firmware.bin", options=opts) as bv:
;         print(hex(bv.start), bv.platform)


; --- Example 3: a setting for ONE binary only (Resource scope)
; bv = the binary you have open (the console gives you this variable).
;
;     from binaryninja.settings import Settings
;     from binaryninja.enums import SettingsScope
;     s = Settings()
;     s.set_string("analysis.mode", "basic", bv, SettingsScope.SettingsResourceScope)
;     print(s.get_string_with_scope("analysis.mode", bv))     # (value, scope)


; --- Example 4: your plugin's own setting (from the docs, made simple)
;
;     import json
;     from binaryninja.settings import Settings
;     s = Settings()
;     s.register_group("myPlugin", "My Plugin")
;     props = {"title": "Enable deep scan", "description": "Scan all functions with HLIL.",
;              "type": "boolean", "default": False}
;     s.register_setting("myPlugin.deepScan", json.dumps(props))
;     # read it in your plugin:
;     if Settings().get_bool("myPlugin.deepScan", bv):
;         print("deep scan on")
;
; For UI-only settings, add "ignore": ["SettingsProjectScope", "SettingsResourceScope"] to the properties.


; --- Notes
; - Give resource=bv when you read a setting that can be different per file.
; - load(..., options=...) is the easy way to set analysis/loader settings in headless scripts.
; - The full list of keys depends on your version and plugins: use s.keys().


## similarity module (SimilaritySession, providers, resolvers)  — ULTIMATE ONLY
; ------------------------------------------------------------------
; "Binary similarity" = find which functions in binary B are the SAME (or almost the same) as functions in binary A.
; Typical uses:
;   - PATCH DIFFING: old version (A) vs new version (B) -> what changed? where is the security fix?
;   - PORT YOUR WORK: A has your names/types/comments (or symbols). B is stripped. Copy the names to B.
;   - match a library (e.g. OpenSSL with symbols) inside a stripped malware sample.
;
; Words:
;   SimilaritySession         the whole job
;   SimilaritySessionNode     ONE binary in the job (from an open bv, or from a file)
;   entity                    a thing to match. Today: functions (SimilarityEntityType.SimilarityEntityFunction)
;   SimilarityProvider        an algorithm that finds candidates: "B.func_7 looks like A.func_3, similarity 230, confidence 200"
;   SimilarityResult          one candidate: .provider_id .similarity (0-255) .confidence (0-255) .target (node_id, entity_id)
;   SimilaritySessionResolver picks the BEST result for each entity
;   SimilaritySessionGraph    the ORDER of nodes: edge A -> B = "A runs before B" (A is the source of knowledge). No cycles.
;   SimilaritySessionCompletion   progress, stop, finished
;   DiffRenderer / SimilarityRenderContext   show the match side by side with added/removed/changed ranges
;   apply                     copy metadata (name, type ...) from the matched target to your function
;
; In the GUI console: current_similarity_session is a magic variable.

SimilaritySession()                                    # new session                                 @binja @api @similarity  <file:/opt/binaryninja/python/binaryninja/similarity.py:1641>
SimilaritySessionNode(view=bv) / (file=filemetadata)   # one binary                                  @binja @api @similarity  <file:/opt/binaryninja/python/binaryninja/similarity.py:1215>
session.graph.add_node(node) / add_edge(a, b)          # add binaries, set order (a before b)        @binja @api @similarity  <file:/opt/binaryninja/python/binaryninja/similarity.py:1485>
list(SimilarityProviderType)                           # available algorithms                        @binja @api @similarity  <file:/opt/binaryninja/python/binaryninja/similarity.py:472>
ptype.create(ptype.get_default_settings())             # make a provider                             @binja @api @similarity
session.add_provider(p)                                # use it                                      @binja @api @similarity
list(SimilaritySessionResolverType)                    # available resolvers                         @binja @api @similarity  <file:/opt/binaryninja/python/binaryninja/similarity.py:861>
rtype.create(session, rtype.get_default_settings())    # make a resolver                             @binja @api @similarity
session.add_resolver(r)                                # use it                                      @binja @api @similarity
completion = session.run()                             # start (background)                          @binja @api @similarity  <file:/opt/binaryninja/python/binaryninja/similarity.py:1767>
completion.is_finished / progress / request_stop()     # follow / stop                               @binja @api @similarity  <file:/opt/binaryninja/python/binaryninja/similarity.py:1587>
node.entities                                          # list of entity ids                          @binja @api @similarity
node.get_entity(id) -> SimilarityEntityInfo            # .type .address .name                        @binja @api @similarity
node.get_entity_function(id)                           # the Function of an entity                   @binja @api @similarity
node.get_results(id) / node.get_result(result_id)      # candidates for an entity                    @binja @api @similarity
node.get_resolved_result(id)                           # the chosen candidate (result id) or None    @binja @api @similarity
node.set_resolved_result(id, result_id)                # choose by hand                              @binja @api @similarity
provider.apply(node, entity, result)                   # copy metadata from target to this entity    @binja @api @similarity

; The flow:   nodes -> edges -> providers -> resolvers -> run -> wait -> read resolved results -> apply

; --- Example 1: see what algorithms you have (GUI console, Ultimate)
;
;     from binaryninja.similarity import SimilarityProviderType, SimilaritySessionResolverType
;     print("providers:", [p.name for p in SimilarityProviderType])
;     print("resolvers:", [r.name for r in SimilaritySessionResolverType])


; --- Example 2: match functions of an OLD version (with names) into a NEW stripped version  (SKETCH)
; Headless with an Ultimate license.
;
;     import time, binaryninja
;     from binaryninja.similarity import (SimilaritySession, SimilaritySessionNode,
;                                         SimilarityProviderType, SimilaritySessionResolverType)
;     old_bv = binaryninja.load("/samples/app_v1")          # has symbols
;     new_bv = binaryninja.load("/samples/app_v2_stripped")
;
;     session = SimilaritySession()
;     a = SimilaritySessionNode(view=old_bv)
;     b = SimilaritySessionNode(view=new_bv)
;     session.graph.add_node(a)
;     session.graph.add_node(b)
;     session.graph.add_edge(a, b)                            # a is processed first, b is matched against it
;
;     ptype = list(SimilarityProviderType)[0]
;     session.add_provider(ptype.create(ptype.get_default_settings()))
;     rtype = list(SimilaritySessionResolverType)[0]
;     session.add_resolver(rtype.create(session, rtype.get_default_settings()))
;
;     done = session.run()
;     while not done.is_finished:
;         print(f"progress {done.progress:.0%}")
;         time.sleep(1)
;
;     for ent in b.entities:
;         rid = b.get_resolved_result(ent)
;         if rid is None:
;             continue
;         r = b.get_result(rid)
;         me = b.get_entity(ent)
;         other = session.graph.get_node(r.target.node_id).get_entity(r.target.entity_id)
;         print(f"{me.address:#x} {me.name:20} <- {other.name:30} sim={r.similarity} conf={r.confidence}")


; --- Example 3: patch diff idea – functions that matched but are NOT identical
;   In Example 2's loop, print only results with  r.similarity < 255  -> these functions CHANGED.
;   Sort by similarity (lowest first) and look at them: the security fix is often there.


; --- Notes
; - Ultimate edition only (CoreSimilarityProviderType.create returns None outside Ultimate).
; - The graph can NOT have cycles. Changes during a run are ignored.
; - similarity and confidence are 0..255 (255 = strongest).
; - This is a NEW API; names may change between versions. Check the source file for your version.
; - I did not run these examples. Example 2 is a sketch based on the source code.


## stringrecognizer module (StringRecognizer, CustomStringType, DerivedString)
; ------------------------------------------------------------------
; A StringRecognizer finds strings that are NOT normal strings, and shows them in HLIL as strings.
; Examples:
;   - ENCODED strings (xor / add / sub with a key)   -> HLIL shows the decoded text: "http://evil"_enc
;   - "stack strings": a big number that is really text  (0x6c6c6568 -> "hell")
;   - Rust / Go strings (pointer + length, no zero at the end)
;
; Binja calls your recognizer for constants in HLIL. You return a DerivedString, or None.
;
; Pieces:
;   CustomStringType.register(name, prefix, postfix)   a new KIND of string. Postfix "_enc" shows "text"_enc
;   DerivedString(value, location, custom_type)         the string you found
;   DerivedStringLocation(DerivedStringLocationType.DataBackedStringLocation, address, length)   where it is (optional)
;
; Methods you can write (all optional):
;   is_valid_for_type(func, type)                 fast filter (ALWAYS write it: Python recognizers are slow)
;   recognize_constant(instr, type, val)          number, not a pointer
;   recognize_constant_pointer(instr, type, val)  pointer to data
;   recognize_extern_pointer(instr, type, val, offset)   pointer to an external symbol
;   recognize_import(instr, type, val)            imported symbol
;   recognize_constant_data(instr)                HLIL_CONST_DATA
;   recognize_struct_init(instr, type, vals)      struct initializer

StringRecognizer                                   # base class; set recognizer_name                  @binja @api @strings  <file:/opt/binaryninja/python/binaryninja/stringrecognizer.py:163>
MyRecognizer().register()                          # turn it on                                       @binja @api @strings
CustomStringType.register(name, prefix, postfix)   # a new string kind                                @binja @api @strings  <file:/opt/binaryninja/python/binaryninja/stringrecognizer.py:98>
DerivedString(value, location, custom_type)        # result                                           @binja @api @strings  <file:/opt/binaryninja/python/binaryninja/binaryview.py:727>
/opt/binaryninja/examples/python/encoded_strings.py   # official: xor/add/sub strings, key from a type attribute  @binja @example @strings  <file:/opt/binaryninja/examples/python/encoded_strings.py>
/opt/binaryninja/examples/python/rust_string.py       # official: Rust strings                        @binja @example @strings
https://docs.binary.ninja/dev/customstrings.html      # official docs                                 @binja @docs @strings  <https://docs.binary.ninja/dev/customstrings.html>

; --- Example 1: show xor-0x5A encoded strings in one data region as text
; Malware keeps strings xor-ed in .data. You know the region and the key.
;
;     from binaryninja import (StringRecognizer, CustomStringType, DerivedString,
;                              DerivedStringLocation, DerivedStringLocationType, PointerType)
;     XOR_KEY = 0x5A
;     START, END = 0x404000, 0x404800                      # region with encoded strings (change it)
;     xor_type = CustomStringType.register("Xor5A", "", "_x")
;
;     class Xor5ARecognizer(StringRecognizer):
;         recognizer_name = "xor_5a_strings"
;
;         def is_valid_for_type(self, func, type):
;             return isinstance(type, PointerType)          # only pointers (fast path)
;
;         def recognize_constant_pointer(self, instr, type, val):
;             if not (START <= val < END):
;                 return None
;             data = instr.function.view.read(val, 256)
;             out = bytearray()
;             for b in data:
;                 c = b ^ XOR_KEY
;                 if c == 0:
;                     break
;                 if not (0x20 <= c < 0x7f):
;                     return None                          # not text -> not ours
;                 out.append(c)
;             if len(out) < 3:
;                 return None
;             loc = DerivedStringLocation(DerivedStringLocationType.DataBackedStringLocation, val, len(out))
;             return DerivedString(bytes(out), loc, xor_type)
;
;     Xor5ARecognizer().register()
;     # HLIL before:  puts(&data_404010)      after:  puts("http://example.com"_x)


; --- Example 2: stack strings – 4/8-byte numbers that are ASCII
;
;     from binaryninja import StringRecognizer, CustomStringType, DerivedString, IntegerType
;     stack_type = CustomStringType.register("StackStr", "", "_s")
;
;     class StackStringRecognizer(StringRecognizer):
;         recognizer_name = "stack_strings"
;         def is_valid_for_type(self, func, type):
;             return isinstance(type, IntegerType) and type.width in (4, 8)
;         def recognize_constant(self, instr, type, val):
;             b = (val & ((1 << (type.width * 8)) - 1)).to_bytes(type.width, "little").rstrip(b"\x00")
;             if len(b) >= 3 and all(0x20 <= c < 0x7f for c in b):
;                 return DerivedString(b, None, stack_type)      # location is optional
;             return None
;
;     StackStringRecognizer().register()


; --- Notes
; - Python recognizers run for EVERY constant in EVERY function. Always filter in is_valid_for_type.
; - Return None when it is not your case (other recognizers can try).
; - For big binaries, the docs say: write it in C++ (there is a C++ version of encoded_strings in examples/).
; - Compare: a ConstantRenderer (constantrenderer module) only changes the TEXT; a StringRecognizer makes a real
;   "string" that Binja knows (it can show in string lists / cross-references).
; - I did not run these examples.


## transform module (Transform, TransformSession, TransformContext)
; ------------------------------------------------------------------
; Two jobs:
;
; 1. TRANSFORMS = encoders / decoders / hashes / ciphers for bytes. The same list as the GUI
;    "Transform" right-click menu (select bytes -> Transform -> Decode/Encode).
;    Built-in (from the docs): Zlib, StringEscape, RawHex, HexDump, Base64, Reverse, CArray*, IntList*,
;    MD4, MD5, SHA1, SHA224, SHA256, SHA384, SHA512, AES-128/256 ECB/CBC, DES, Triple DES, RC2, Blowfish,
;    CAST, RC4, XOR.  Ciphers take parameters: {"key": ...} and for CBC also {"iv": ...}.
;
; 2. CONTAINERS (TransformSession): open a file INSIDE an archive (ZIP, TAR, IMG4 ...), also nested
;    (zip inside zip), and get a BinaryView of the inner file.
;
; decode / encode take bytes (or str / DataBuffer) and return bytes, or None if it fails.

list(Transform)                            # all transforms                                            @binja @api @transform  <file:/opt/binaryninja/python/binaryninja/transform.py:108>
Transform["Base64"]                        # one by name                                               @binja @api @transform
t.decode(data, params={})                  # -> bytes or None                                          @binja @api @transform  <file:/opt/binaryninja/python/binaryninja/transform.py:297>
t.encode(data, params={})                  # -> bytes or None                                          @binja @api @transform  <file:/opt/binaryninja/python/binaryninja/transform.py:320>
t.parameters                               # list of TransformParameter (.name .long_name .fixed_length)  @binja @api @transform
t.can_decode(input)                        # True if this transform can decode it (detection)          @binja @api @transform
TransformSession(path_or_bv, mode=None, options={})   # open a container                               @binja @api @transform  <file:/opt/binaryninja/python/binaryninja/transform.py:881>
session.process()                          # extract (True = done, False = needs a choice)             @binja @api @transform
session.current_view / current_context / root_context   # result / where you are                      @binja @api @transform
ctx.available_files / ctx.set_requested_files([...])   # list files / choose files                     @binja @api @transform
ctx.children / ctx.parent / ctx.filename   # the extraction tree                                       @binja @api @transform
ctx.set_transform_parameter("password", b"infected")   # password for an encrypted container          @binja @api @transform

; All examples need a license (list(Transform) raised "License is not valid" in my test).

; --- Example 1: hash and hex  (from the docs)
;
;     from binaryninja.transform import Transform
;     sha = Transform["SHA256"]
;     hx  = Transform["RawHex"]
;     print(hx.encode(sha.encode(b"test string")))


; --- Example 2: XOR with a key  (from the docs)
;
;     from binaryninja.transform import Transform
;     xor = Transform["XOR"]
;     enc = xor.encode(b"Original Data", {"key": b"XORKEY"})
;     print(Transform["RawHex"].encode(enc))           # b'173d3b2c2c373923720f242d39'
;     print(xor.decode(enc, {"key": b"XORKEY"}))       # b'Original Data'
;     # NOTE: key must be bytes/str, NOT an int. Use bytes([0x41]) for a 1-byte key.


; --- Example 3: decrypt an AES-CBC blob found in the binary
; bv = the binary you have open (the console gives you this variable).
;
;     from binaryninja.transform import Transform
;     blob = bv.read(0x404100, 0x40)                   # the encrypted data (change the address/size)
;     key  = bv.read(0x404000, 16)                     # key found in the binary
;     iv   = bv.read(0x404010, 16)
;     plain = Transform["AES-128 CBC"].decode(blob, {"key": key, "iv": iv})
;     print(plain)


; --- Example 4: decompress zlib data inside the binary
;
;     from binaryninja.transform import Transform
;     out = Transform["Zlib"].decode(bv.read(0x405000, 0x800))
;     print(out[:64] if out else "not zlib")


; --- Example 5: list transforms and their parameters
;
;     from binaryninja.transform import Transform
;     for t in Transform:
;         print(t.name, [p.name for p in t.parameters])


; --- Example 6: open a binary inside a zip (headless)
;
;     import binaryninja
;     from binaryninja.transform import TransformSession
;     s = TransformSession("/samples/malware.zip")
;     if not s.process():                              # needs a choice or a password
;         ctx = s.current_context
;         if ctx.parent and ctx.parent.has_available_files:
;             print("files:", ctx.parent.available_files)
;             ctx.parent.set_transform_parameter("password", b"infected")
;             ctx.parent.set_requested_files([ctx.parent.available_files[0]])
;             s.process_from(ctx.parent)
;     with binaryninja.load(s.current_view) as bv:
;         print(bv.view_type, len(bv.functions))


; --- Notes
; - decode/encode return None on failure (wrong key, bad data). Check it.
; - Parameter values must be bytes / str / DataBuffer (an int raises TypeError with a helpful message).
; - You can write your own Transform (subclass + register) to add it to the GUI menu.
; - I did not run these examples.


## typearchive module (TypeArchive)
; ------------------------------------------------------------------
; A Type Archive = a FILE (.bnta) full of TYPES (structs, enums, typedefs, function types) that you can
; SHARE between many binaries and many people.
; Example: you reverse a malware family and build "struct config", "struct packet" ... Put them in an archive.
; Next sample: attach the archive, pull the types -> done in seconds.
;
; It has a HISTORY (snapshots): every change makes a new snapshot, like git commits.
; A binary can be ATTACHED to archives. Then:
;   PULL = copy types from the archive into your binary (and keep them linked)
;   PUSH = send your binary's types into the archive
;
; Every type in the archive has a stable id (string) and a name.

TypeArchive.create(path, platform)         # new archive file (.bnta)                                 @binja @api @types  <file:/opt/binaryninja/python/binaryninja/typearchive.py:90>
TypeArchive.open(path)                     # open an existing archive                                 @binja @api @types  <file:/opt/binaryninja/python/binaryninja/typearchive.py:77>
ta.path / ta.id / ta.platform              # basics                                                   @binja @api @types
ta.add_type(name, type) / ta.add_types([(name, type), ...])   # add (dependencies must be added too)  @binja @api @types  <file:/opt/binaryninja/python/binaryninja/typearchive.py:223>
ta.types                                   # dict name -> Type (current snapshot)                      @binja @api @types
ta.type_names / ta.type_ids                # names / ids                                              @binja @api @types
ta.get_type_by_name(name) / get_type_id(name) / get_type_by_id(id)   # lookups                        @binja @api @types
ta.rename_type(old, new) / ta.delete_type(name)   # change                                            @binja @api @types
ta.current_snapshot_id / all_snapshot_ids  # history                                                  @binja @api @types
ta.get_types(snapshot_id)                  # types at an OLD snapshot                                 @binja @api @types
ta.get_outgoing_recursive_references(id)   # all types this type needs                                @binja @api @types
ta.get_incoming_direct_references(id)      # types that use this type                                 @binja @api @types
ta.store_metadata(k, v) / get_metadata(k)  # your notes in the archive                                @binja @api @types
bv.attach_type_archive(ta) / detach_type_archive(ta)   # link to a binary                             @binja @api @types  <file:/opt/binaryninja/python/binaryninja/binaryview.py:9451>
bv.attached_type_archives                  # dict id -> path                                          @binja @api @types
bv.pull_types_from_archive(ta, [names])    # archive -> binary                                        @binja @api @types  <file:/opt/binaryninja/python/binaryninja/binaryview.py:9749>
bv.push_types_to_archive(ta, [names])      # binary -> archive (with dependencies)                    @binja @api @types  <file:/opt/binaryninja/python/binaryninja/binaryview.py:9802>
bv.get_type_archives_for_type_name(name)   # which archives have this type                            @binja @api @types

; All examples need a license (TypeArchive calls _init_plugins).
; bv = the binary you have open (the console gives you this variable).

; --- Example 1: make an archive and add a struct
;
;     from binaryninja.typearchive import TypeArchive
;     ta = TypeArchive.create("/tmp/family_x.bnta", bv.platform)
;     t, name = bv.parse_type_string("struct config { char c2[64]; int port; int sleep_ms; }")
;     ta.add_type(name, t)
;     print(ta.type_names)


; --- Example 2: push your types from one binary, pull them into another
;
;     from binaryninja.typearchive import TypeArchive
;     ta = TypeArchive.open("/tmp/family_x.bnta")
;     bv.attach_type_archive(ta)
;     bv.push_types_to_archive(ta, ["config", "packet"])    # send my types (and the types they use)
;     # ... in another binary (another bv):
;     # bv2.attach_type_archive(ta)
;     # bv2.pull_types_from_archive(ta, ["config"])


; --- Example 3: what changed between two snapshots?
;
;     from binaryninja.typearchive import TypeArchive
;     ta = TypeArchive.open("/tmp/family_x.bnta")
;     ids = ta.all_snapshot_ids
;     if len(ids) >= 2:
;         old = ta.get_types(ids[0])
;         new = ta.get_types(ids[-1])
;         print("added:  ", set(map(str, new)) - set(map(str, old)))
;         print("removed:", set(map(str, old)) - set(map(str, new)))


; --- Example 4: which types depend on "config"?
;
;     from binaryninja.typearchive import TypeArchive
;     ta = TypeArchive.open("/tmp/family_x.bnta")
;     tid = ta.get_type_id("config")
;     for ref_id in ta.get_incoming_direct_references(tid):
;         print(ta.get_type_name_by_id(ref_id))


; --- Notes
; - add_type: all types it USES must already be in the archive (push_types_to_archive does this for you).
; - Type archive vs type library: archives are EDITABLE and shared with history; type libraries (typelibrary module)
;   describe a system library's functions/types (like libc) and are mostly read-only.
; - I did not run these examples.


## typecontainer module (TypeContainer)
; ------------------------------------------------------------------
; A TypeContainer is ONE common interface for every "box of types" in Binja:
;   bv.type_container          all types of the binary (user + auto)
;   bv.user_type_container     only types YOU made
;   bv.auto_type_container     only types Binja made automatically
;   platform.type_container    types the platform knows
;   typelibrary.type_container types of a type library
;   debug_info.get_type_container(parser_name)
; So one script can read / add / rename / delete types in any of them the same way.
; Every type has a unique id (str) AND a unique name.

bv.type_container / user_type_container / auto_type_container    # get one                           @binja @api @types  <file:/opt/binaryninja/python/binaryninja/binaryview.py:8799>
tc.name / tc.container_type / tc.mutable / tc.platform    # info (mutable = can add/rename/delete)   @binja @api @types  <file:/opt/binaryninja/python/binaryninja/typecontainer.py:36>
tc.types                                   # dict id -> (name, Type)                                  @binja @api @types
tc.type_names / tc.type_ids / tc.type_count   # lists / count                                         @binja @api @types
tc.get_type_by_name(name) / get_type_by_id(id) / get_type_id(name) / get_type_name(id)   # lookups      @binja @api @types
tc.add_types({name: type, ...})            # add or REPLACE types -> {name: id} or None               @binja @api @types  <file:/opt/binaryninja/python/binaryninja/typecontainer.py:123>
tc.rename_type(id, new_name) / tc.delete_type(id)   # change                                          @binja @api @types
tc.parse_type_string("struct x {...}")     # -> ((name, type), errors)  — knows the types in the container  @binja @api @types  <file:/opt/binaryninja/python/binaryninja/typecontainer.py:340>
tc.parse_types_from_source(src)            # many declarations -> (result, errors)                    @binja @api @types
; NOTE: the docstring of parse_type_string says "(type, name)", but the code returns (name, type).

; All examples need a license. bv = the binary you have open (the console gives you this variable).

; --- Example 1: count and list your own types
;
;     tc = bv.user_type_container
;     print(tc.name, "| types:", tc.type_count, "| mutable:", tc.mutable)
;     for name in list(tc.type_names)[:20]:
;         print(name)


; --- Example 2: parse a struct that uses an EXISTING type, then add it
;
;     tc = bv.type_container
;     result, errors = tc.parse_type_string("struct session { FILE* log; uint32_t id; char key[16]; }")
;     if result is None:
;         print("errors:", errors)
;     else:
;         name, t = result
;         print(tc.add_types({name: t}))                # {QualifiedName: id}


; --- Example 3: rename a type everywhere
;
;     tc = bv.user_type_container
;     tid = tc.get_type_id("struct_1")
;     if tid:
;         tc.rename_type(tid, "net_packet")             # all uses update


; --- Example 4: same code for a platform container (read only)
;
;     tc = bv.platform.type_container
;     print(tc.mutable)                                 # usually False
;     print(tc.get_type_by_name("FILE"))


; --- Notes
; - add_types REPLACES a type with the same name and updates references.
; - Not every container is mutable (platform / library ones are read-only).
; - I did not run these examples.


## typelibrary module (TypeLibrary)
; ------------------------------------------------------------------
; A Type Library (.bntl file) describes a SYSTEM LIBRARY: the function prototypes and types of
; libc.so.6, kernel32.dll, advapi32.dll, a macOS framework ...
; When a binary IMPORTS "CreateFileW", Binja looks in the type libraries and gives the import the right
; prototype -> correct arguments in HLIL. This is why imports have good types automatically.
;
; Binja ships MANY: /opt/binaryninja/typelib/<arch>/   (x86_64 has 673 files on this machine,
; for example advapi32.dll.bntl, amsi.dll.bntl, Accelerate.mac-x86_64.4.0.0.bntl ...)
;
; Inside a library:
;   named_types    types (structs, enums, typedefs)
;   named_objects  functions and exported variables (name -> type)
;
; You can make your OWN library: for a private DLL / firmware SDK, so every binary that imports it gets types.

TypeLibrary.load_from_file(path)           # open a .bntl                                             @binja @api @typelib  <file:/opt/binaryninja/python/binaryninja/typelibrary.py:60>
TypeLibrary.from_name(arch, name)          # find a registered library by name                       @binja @api @typelib
TypeLibrary.new(arch, name)                # make a new empty library                                 @binja @api @typelib  <file:/opt/binaryninja/python/binaryninja/typelibrary.py:48>
lib.name / lib.guid / lib.arch / lib.alternate_names / lib.platform_names   # info                    @binja @api @typelib
lib.named_types / lib.named_objects        # dict name -> Type                                        @binja @api @typelib
lib.get_named_type(name) / get_named_object(name)   # one                                             @binja @api @typelib
lib.add_named_type(name, t) / add_named_object(name, t)   # add (before finalize)                     @binja @api @typelib
lib.add_platform(platform) / lib.add_alternate_name(n)   # where it applies / other names            @binja @api @typelib
lib.finalize() / lib.write_to_file(path) / lib.register()   # finish / save / make available now     @binja @api @typelib
lib.type_container                         # TypeContainer of its types                               @binja @api @typelib
bv.type_libraries                          # libraries used by this binary                            @binja @api @typelib  <file:/opt/binaryninja/python/binaryninja/binaryview.py:4209>
bv.add_type_library(lib)                   # use a library in this binary                             @binja @api @typelib
bv.import_library_type(name, lib=None)     # copy a type from a library into the binary               @binja @api @typelib  <file:/opt/binaryninja/python/binaryninja/binaryview.py:9184>
bv.import_library_object(name, lib=None)   # get a function prototype: (lib, type)                    @binja @api @typelib
bv.export_type_to_library(lib, name, type) / export_object_to_library(...)   # binary -> library      @binja @api @typelib
/opt/binaryninja/typelib/                  # bundled libraries per arch                               @binja @files @typelib  <file:/opt/binaryninja/typelib/>

; All examples need a license.

; --- Example 1: look inside a bundled library
;
;     from binaryninja.typelibrary import TypeLibrary
;     lib = TypeLibrary.load_from_file("/opt/binaryninja/typelib/x86_64/advapi32.dll.bntl")
;     print(lib.name, len(lib.named_objects), "objects,", len(lib.named_types), "types")
;     print(lib.get_named_object("RegOpenKeyExW"))


; --- Example 2: which libraries does my binary use, and fix one import type
; bv = the binary you have open (the console gives you this variable).
;
;     for lib in bv.type_libraries:
;         print(lib.name)
;     r = bv.import_library_object("CreateFileW")
;     if r:
;         lib, t = r
;         print(lib.name, t)


; --- Example 3: make your OWN library for a private DLL
;
;     from binaryninja import Type
;     from binaryninja.typelibrary import TypeLibrary
;     from binaryninja.architecture import Architecture
;     from binaryninja.platform import Platform
;     arch = Architecture["x86_64"]
;     lib = TypeLibrary.new(arch, "mysdk.dll")
;     lib.add_platform(Platform["windows-x86_64"])
;     ftype = Type.function(Type.int(4), [Type.pointer(arch, Type.char()), Type.int(4)])
;     lib.add_named_object("Sdk_Connect", ftype)
;     lib.finalize()
;     lib.write_to_file("/tmp/mysdk.dll.bntl")
;     # copy it into your user typelib folder so Binja finds it for every binary that imports mysdk.dll


; --- Notes
; - Type library = system/SDK prototypes (mostly read-only). Type archive (typearchive module) = your editable shared types.
; - After finalize() you can not change platforms or names.
; - I did not run these examples.


## typeparser module (TypeParser, ParsedType, TypeParserError)
; ------------------------------------------------------------------
; Turn C TEXT into Binja TYPES:  "struct pkt { int len; char data[64]; };"  ->  a StructureType.
; The default parser is clang-based (it understands real C headers, #include, #define ...).
;
; Easy ways (use these first):
;   bv.parse_type_string("int (*)(char*)")          -> (Type, name)           one type, knows your bv's types
;   bv.parse_types_from_string(source)               -> types, variables, functions   many declarations
;   bv.define_user_type(name, type_or_string)        -> add a type to your binary
; The TypeParser class is the lower level (choose platform, existing types, options, include dirs),
; and you can register your OWN parser (for another language, like Rust or Go type syntax).
;
; Results:
;   TypeParserResult: .types / .variables / .functions  -> lists of ParsedType (.name .type .is_user)
;   errors: list of TypeParserError (.severity .message .file_name .line .column)

bv.parse_type_string(text)                 # -> (Type, QualifiedName). Raises SyntaxError on error    @binja @api @types  <file:/opt/binaryninja/python/binaryninja/binaryview.py:8643>
bv.parse_types_from_string(text, options=None, include_dirs=None)   # -> BasicTypeParserResult (.types .variables .functions dicts)  @binja @api @types  <file:/opt/binaryninja/python/binaryninja/binaryview.py:8679>
bv.define_user_type(name, type_or_str)     # save a type in the binary                                @binja @api @types  <file:/opt/binaryninja/python/binaryninja/binaryview.py:8992>
bv.define_user_types([(name, type), ...], progress)   # many at once                                  @binja @api @types
TypeParser.default                         # the parser chosen in settings                            @binja @api @types  <file:/opt/binaryninja/python/binaryninja/typeparser.py:229>
list(TypeParser) / TypeParser[name]        # all parsers / one by name                                @binja @api @types
p.parse_type_string(src, platform, existing_types=None)   # -> ((name, type) or None, errors)         @binja @api @types  <file:/opt/binaryninja/python/binaryninja/typeparser.py:493>
p.parse_types_from_source(src, file_name, platform, existing_types, options, include_dirs)   # -> (TypeParserResult or None, errors)  @binja @api @types  <file:/opt/binaryninja/python/binaryninja/typeparser.py:473>
p.preprocess_source(src, file_name, platform, ...)   # run only the preprocessor (#define, #include)  @binja @api @types

; All examples need a license. bv = the binary you have open (the console gives you this variable).

; --- Example 1: one type, then apply it to a variable at an address
;
;     t, name = bv.parse_type_string("struct config { char c2[64]; uint16_t port; uint32_t sleep; }")
;     bv.define_user_type(name, t)
;     bv.define_user_data_var(0x404000, bv.get_type_by_name(name))   # data at 0x404000 is a "struct config"


; --- Example 2: a whole header at once
;
;     src = '''
;     typedef enum { CMD_PING = 1, CMD_EXEC = 2, CMD_EXIT = 3 } cmd_t;
;     struct packet { uint32_t magic; cmd_t cmd; uint32_t len; uint8_t data[]; };
;     int handle_packet(struct packet* p);
;     '''
;     r = bv.parse_types_from_string(src)
;     for name, t in r.types.items():
;         bv.define_user_type(name, t)
;     print(list(r.types), list(r.functions))
;     # then set the prototype:  bv.get_functions_by_name("sub_401200")[0].type = r.functions["handle_packet"]


; --- Example 3: parse a REAL header file with include dirs and a define
;
;     src = open("/path/to/sdk/net.h").read()
;     r = bv.parse_types_from_string(src, options=["-DUSE_V2=1"], include_dirs=["/path/to/sdk"])
;     print(len(r.types), "types")


; --- Example 4: low-level parser, get the errors instead of an exception
;
;     from binaryninja.typeparser import TypeParser
;     p = TypeParser.default
;     result, errors = p.parse_type_string("struct bad { int x }", bv.platform, bv.type_container)   # missing ;
;     if result is None:
;         for e in errors:
;             print(e)                                  # "error: ..." with line and column
;     else:
;         name, t = result


; --- Notes
; - bv.parse_type_string returns (Type, name). TypeParser.parse_type_string returns ((name, type), errors). Different order!
; - Give existing_types (bv.type_container) so your text can use types the binary already has.
; - Platform matters: int/long/pointer sizes come from it.
; - I did not run these examples.


## typeprinter module (TypePrinter)
; ------------------------------------------------------------------
; The opposite of the parser: turn a Binja TYPE into TEXT (C-like), as one line, as tokens, or as many lines.
; Use it to EXPORT your types as a C header, or to print types in your own format.
; You can also register your own printer (for example to print types in Rust syntax).
;
; Easy ways:  str(t)   t.get_string()   t.get_lines(bv, name)   (types module)
; TypePrinter gives more control and print_all_types (a full header).

TypePrinter.default                        # the printer chosen in settings                           @binja @api @types  <file:/opt/binaryninja/python/binaryninja/typeprinter.py:92>
list(TypePrinter) / TypePrinter[name]      # all printers                                             @binja @api @types
tp.get_type_string(type, platform, name)   # one line: "struct pkt* p"                                @binja @api @types  <file:/opt/binaryninja/python/binaryninja/typeprinter.py:371>
tp.get_type_string_before_name / after_name   # "int (*" ... ")(char*)" parts around a name           @binja @api @types
tp.get_type_tokens(type, platform, name)   # same as tokens (with colors / links in the UI)           @binja @api @types
tp.get_type_lines(type, container, name, padding_cols=64, collapsed=False)   # full multi-line definition  @binja @api @types  <file:/opt/binaryninja/python/binaryninja/typeprinter.py:416>
tp.print_all_types([(name, type), ...], bv, padding_cols=64)   # one big header text                  @binja @api @types  <file:/opt/binaryninja/python/binaryninja/typeprinter.py:430>

; All examples need a license. bv = the binary you have open (the console gives you this variable).

; --- Example 1: export ALL your types as a C header file
;
;     from binaryninja.typeprinter import TypePrinter
;     types = [(name, t) for name, t in bv.types.items()]
;     header = TypePrinter.default.print_all_types(types, bv)
;     open("/tmp/types.h", "w").write(header)


; --- Example 2: print one struct with offsets (multi-line)
;
;     from binaryninja.typeprinter import TypePrinter
;     name = "config"                                   # one of your types
;     t = bv.get_type_by_name(name)
;     for line in TypePrinter.default.get_type_lines(t, bv.type_container, name):
;         print(line)


; --- Example 3: a variable declaration as one line
;
;     from binaryninja.typeprinter import TypePrinter
;     from binaryninja import Type
;     t = Type.pointer(bv.arch, Type.function(Type.int(4), [Type.pointer(bv.arch, Type.char())]))
;     print(TypePrinter.default.get_type_string(t, bv.platform, "callback"))   # int32_t (* callback)(char*)


; --- Notes
; - The output of print_all_types is usually parsable again by the type parser (a round trip).
; - padding_cols controls how many padding bytes are shown per line for structs with holes.
; - I did not run these examples.


## types module (Type, TypeBuilder, StructureBuilder, EnumerationBuilder, QualifiedName, Symbol ...)
; ------------------------------------------------------------------
; The Binja TYPE SYSTEM. Every type is an object:
;   IntegerType (int32_t), CharType, BoolType, FloatType (double), VoidType, PointerType, ArrayType (char[16]),
;   StructureType (struct / union / class), EnumerationType, FunctionType, NamedTypeReferenceType ("struct pkt" by name),
;   WideCharType, FragmentType (bit fields)
;
; IMMUTABLE vs BUILDER:
;   Type            = read-only (what bv / functions give you)
;   TypeBuilder     = editable (StructureBuilder, EnumerationBuilder, FunctionBuilder ...)
;   t.mutable_copy() -> builder;  builder.immutable_copy() -> Type
;
; Other useful classes here:
;   QualifiedName   a name with parts: ns::Class::f  -> ["ns", "Class", "f"]
;   Symbol          a name at an address (function, data, import ...). Symbol(SymbolType.X, addr, "name")
;   FunctionParameter, ReturnValue, ValueLocation (see callingconvention notes)
;
; GOOD NEWS: making types works WITHOUT a license (except pointers: they need an Architecture).
; Outputs below are REAL.

Type.int(width, signed=True)               # int32_t, uint16_t ...                                    @binja @api @types  <file:/opt/binaryninja/python/binaryninja/types.py:2299>
Type.char() / Type.bool() / Type.void() / Type.float(8)   # basic types                                @binja @api @types
Type.pointer(arch, target)                 # target* (needs arch -> needs license)                    @binja @api @types
Type.array(elem, count)                    # elem[count]                                              @binja @api @types
Type.function(ret, [params], variable_arguments=False)   # function type. param = Type or (name, Type)  @binja @api @types
Type.structure_type(builder) / Type.named_type_from_type(name, t)   # helpers                         @binja @api @types
StructureBuilder.create(type=StructureVariant.X)   # new struct (or UnionStructureType / ClassStructureType)  @binja @api @types  <file:/opt/binaryninja/python/binaryninja/types.py:1802>
sb.append(type, name) / sb.insert(offset, type, name) / sb.replace(i, type, name) / sb.remove(i)   # members  @binja @api @types
sb.width = N / sb.packed = True            # size / packed                                            @binja @api @types
EnumerationBuilder.create([(name, value), ...], width=4)   # new enum                                 @binja @api @types  <file:/opt/binaryninja/python/binaryninja/types.py:2050>
t.width / t.type_class / t.confidence      # size in bytes / kind / how sure Binja is (0-255)         @binja @api @types
t.mutable_copy() / builder.immutable_copy()   # switch editable <-> read-only                         @binja @api @types
t.with_confidence(n)                       # same type, other confidence                              @binja @api @types
st.members / st[name] / st.member_at_offset(off)   # struct members (.name .offset .type)             @binja @api @types  <file:/opt/binaryninja/python/binaryninja/types.py:3005>
ft.return_value / ft.parameters            # function type parts                                      @binja @api @types  <file:/opt/binaryninja/python/binaryninja/types.py:3502>
pt.target / at.element_type / at.count     # pointer target / array element and count                 @binja @api @types
QualifiedName(["ns", "f"])                 # a name with parts                                        @binja @api @types  <file:/opt/binaryninja/python/binaryninja/types.py:91>
Symbol(SymbolType.FunctionSymbol, addr, "name")   # make a symbol; bv.define_user_symbol(sym)         @binja @api @types  <file:/opt/binaryninja/python/binaryninja/types.py:406>
bv.types / bv.get_type_by_name(n) / bv.define_user_type(n, t)   # types in a binary                   @binja @api @types

; --- Example 1: basic types  (REAL output)
;
;     from binaryninja.types import Type
;     t = Type.int(4)
;     print(t, t.width, bool(t.signed), type(t).__name__)    # int32_t 4 True IntegerType
;     print(Type.int(2, False), Type.char(), Type.bool(), Type.void(), Type.float(8))
;     # uint16_t char bool void double
;     a = Type.array(Type.char(), 16)
;     print(a, a.count, a.width)                             # char[0x10] 16 16


; --- Example 2: build a struct  (REAL output)
;
;     from binaryninja.types import Type, StructureBuilder
;     s = StructureBuilder.create()
;     s.append(Type.int(4), "len")                           # offset 0x0
;     s.append(Type.array(Type.char(), 64), "data")          # offset 0x4
;     s.insert(0x50, Type.int(8), "id")                      # at a fixed offset
;     st = s.immutable_copy()
;     print(st.width, [(m.name, hex(m.offset), str(m.type)) for m in st.members])
;     # 88 [('len', '0x0', 'int32_t'), ('data', '0x4', 'char[0x40]'), ('id', '0x50', 'int64_t')]
;     print(st.member_at_offset(4))                          # <char[0x40] data, offset 0x4>


; --- Example 3: change an existing struct  (REAL output)
;
;     from binaryninja.types import Type, StructureBuilder
;     s = StructureBuilder.create(); s.append(Type.int(4), "len"); s.append(Type.int(4), "flags")
;     st = s.immutable_copy()
;     mb = st.mutable_copy()
;     mb.width = 0x20
;     mb.replace(1, Type.int(2), "flags16")
;     print(mb.immutable_copy().members, mb.width)
;     # [<int32_t len, offset 0x0>, <int16_t flags16, offset 0x4>] 32


; --- Example 4: union, enum, function type  (REAL output)
;
;     from binaryninja.types import Type, StructureBuilder, EnumerationBuilder, StructureVariant
;     u = StructureBuilder.create(type=StructureVariant.UnionStructureType)
;     u.append(Type.int(4), "a"); u.append(Type.float(8), "b")
;     print(u.immutable_copy(), u.width)                     # union 8
;     e = EnumerationBuilder.create([("CMD_PING", 1), ("CMD_EXEC", 2)], width=4)
;     print([(m.name, m.value) for m in e.members])          # [('CMD_PING', 1), ('CMD_EXEC', 2)]
;     f = Type.function(Type.int(4), [Type.int(4), ("name", Type.char())])
;     print(f, "| ret:", f.return_value)                     # int32_t(int32_t, char name) | ret: int32_t
;     print(Type.function(Type.void(), [], variable_arguments=True))   # void(...)


; --- Example 5: QualifiedName  (REAL output)
;
;     from binaryninja.types import QualifiedName
;     q = QualifiedName(["ns", "Class", "f"])
;     print(q, list(q))                                      # ns::Class::f ['ns', 'Class', 'f']


; --- Example 6: put your struct in the binary and use it (GUI)
; bv = the binary you have open (the console gives you this variable).
;
;     from binaryninja.types import Type, StructureBuilder
;     s = StructureBuilder.create()
;     s.append(Type.int(4), "magic")
;     s.append(Type.int(4), "size")
;     s.append(Type.pointer(bv.arch, Type.char()), "name")
;     bv.define_user_type("my_header", s.immutable_copy())
;     bv.define_user_data_var(0x404000, bv.get_type_by_name("my_header"))


; --- Example 7: rename a function with a Symbol
;
;     from binaryninja.types import Symbol
;     from binaryninja.enums import SymbolType
;     bv.define_user_symbol(Symbol(SymbolType.FunctionSymbol, 0x401136, "decrypt_config"))


; --- Notes
; - t.signed is a BoolWithConfidence: use bool(t.signed) or t.signed.value.
; - A struct that only has a NAME is a NamedTypeReferenceType; get the real one with bv.get_type_by_name(name).
; - Confidence (0-255): Binja's own guesses have low confidence; your types (user) have 255 and win.


## undo module (UndoEntry, UndoAction)
; ------------------------------------------------------------------
; Small module: READ the undo / redo history.
;   UndoEntry  = one step in the history (one Ctrl+Z). It has a list of actions.
;   UndoAction = one change inside a step. str(action) = its summary text ("Renamed function ...").
; To MAKE undo steps, use bv.undoable_transaction() / begin_undo_actions() (see filemetadata module).

bv.file.undo_entries                       # list of UndoEntry (what Ctrl+Z will undo)                @binja @api @undo  <file:/opt/binaryninja/python/binaryninja/filemetadata.py:570>
bv.file.redo_entries                       # list of UndoEntry (what Ctrl+Y will redo)                @binja @api @undo
entry.actions                              # list of UndoAction                                       @binja @api @undo  <file:/opt/binaryninja/python/binaryninja/undo.py:61>
action.summary_text / str(action)          # text of the change                                       @binja @api @undo  <file:/opt/binaryninja/python/binaryninja/undo.py:46>

; --- Example 1: print your change history (GUI)
; bv = the binary you have open (the console gives you this variable).
;
;     for n, entry in enumerate(bv.file.undo_entries):
;         for action in entry.actions:
;             print(n, action)


; --- Example 2: a simple "what did I do today" log to a file
;
;     with open("/tmp/my_changes.txt", "w") as out:
;         for entry in bv.file.undo_entries:
;             for action in entry.actions:
;                 out.write(action.summary_text + "\n")


; --- Notes
; - The history is saved in the .bndb (unless you save with SaveOption.RemoveUndoData).
; - I did not run these examples.


## unicode module
; ------------------------------------------------------------------
; 2 helpers for showing text from binaries:
;   escape_unicode_string(data, view=None)   bytes/str -> safe display text. Allowed Unicode blocks pass as UTF-8,
;                                            everything else is escaped (\xff ...). Same escaping as HLIL / Pseudo C.
;                                            Blocks come from the setting "analysis.unicode.blocks" (+ "analysis.unicode.utf8").
;   unicode_display_width(text)              how many CHARACTER CELLS the text takes on screen
;                                            (CJK = 2 cells, combining marks = 0). Binja draws text on a cell grid.

escape_unicode_string(data, view=None)     # escape for display (needs a license: loads plugins)       @binja @api @unicode  <file:/opt/binaryninja/python/binaryninja/unicode.py:29>
unicode_display_width(text)                # cell width (works WITHOUT a license)                      @binja @api @unicode  <file:/opt/binaryninja/python/binaryninja/unicode.py:63>

; --- Example 1: display width  (REAL output)
;
;     from binaryninja.unicode import unicode_display_width
;     print(unicode_display_width("abc"), unicode_display_width("日本"), unicode_display_width("é"))
;     # 3 4 1      <- "日本" is 2 chars but 4 cells; "e" + combining accent is 2 chars but 1 cell
; Use it to ALIGN columns when you build your own tokens / reports.


; --- Example 2: escape bytes from the binary for safe printing (from the docs)
;
;     from binaryninja.unicode import escape_unicode_string
;     from binaryninja.settings import Settings
;     # bv = the binary you have open (the console gives you this variable)
;     Settings().set_string_list("analysis.unicode.blocks", ["Hiragana"], bv)
;     print(escape_unicode_string("Unicode: こんにちは", bv))   # 'Unicode: こんにちは'
;     print(escape_unicode_string(b"\xff\xfe", bv))                                 # '\\xff\\xfe'


## update module (UpdateChannel, UpdateVersion, auto-update functions)
; ------------------------------------------------------------------
; Control Binja's OWN updates: which channel (stable / dev), which versions exist, update, auto-update on/off.
; Useful on servers / headless installs.
;
; REAL test (no license needed for these 3 functions):
;   are_auto_updates_enabled() -> True,  is_update_installation_pending() -> False,
;   get_time_since_last_update_check() -> 1081   (a number of seconds since the last check, I think)
; list(UpdateChannel) needs a license.

are_auto_updates_enabled() / set_auto_updates_enabled(bool)   # auto update on/off                   @binja @api @update  <file:/opt/binaryninja/python/binaryninja/update.py:266>
get_time_since_last_update_check()         # time since the last check                                @binja @api @update
is_update_installation_pending()           # True if an update is downloaded and waits                 @binja @api @update
install_pending_update()                   # install it                                               @binja @api @update
updates_checked()                          # tell Binja you checked                                   @binja @api @update
list(UpdateChannel) / UpdateChannel[name]  # channels                                                 @binja @api @update  <file:/opt/binaryninja/python/binaryninja/update.py:110>
UpdateChannel.active                       # the channel you use now                                  @binja @api @update
ch.versions / ch.latest_version / ch.updates_available   # versions in a channel                       @binja @api @update
ch.update_to_latest(progress=None)         # download the latest                                      @binja @api @update
ver.version / ver.notes / ver.time / ver.update()   # one version                                     @binja @api @update  <file:/opt/binaryninja/python/binaryninja/update.py:210>

; --- Example 1: status  (REAL output, no license)
;
;     from binaryninja.update import are_auto_updates_enabled, is_update_installation_pending, get_time_since_last_update_check
;     print(are_auto_updates_enabled(), is_update_installation_pending(), get_time_since_last_update_check())
;     # True False 1081


; --- Example 2: list channels and the latest version (needs a license)
;
;     from binaryninja.update import UpdateChannel
;     for ch in UpdateChannel:
;         print(ch.name, "| latest:", ch.latest_version.version, "| updates:", ch.updates_available)


; --- Example 3: read the release notes of the newest version
;
;     from binaryninja.update import UpdateChannel
;     v = UpdateChannel.active.latest_version
;     print(v.version, v.time)
;     print(v.notes)


; --- Notes
; - Updating changes your install. On a shared machine, ask first.
; - Examples 2-3 were not run (license).


## variable module (Variable, RegisterValue, PossibleValueSet, ValueRange, ...)
; ------------------------------------------------------------------
; Two topics:
;
; 1. VARIABLES of a function (what you see in MLIL/HLIL: var_10, arg1, rax_1 ...)
;    A Variable lives in: a register, a stack slot, or a flag  (source_type: RegisterVariableSourceType,
;    StackVariableSourceType, FlagVariableSourceType). storage = register number or stack offset.
;    You can read and CHANGE its name and type.
;
; 2. VALUES from data flow ("what is in rdi here?")
;    RegisterValue      ONE known value. Subclasses: ConstantRegisterValue <const 0x5>, ConstantPointerRegisterValue,
;                       StackFrameOffsetRegisterValue (an address on the stack), ImportedAddressRegisterValue,
;                       EntryRegisterValue (the value the register had at function entry), Undetermined ...
;    PossibleValueSet   MANY possible values: a constant, a range (0..10), a set {1,2,3}, "not in {..}", a lookup table ...
;                       Binja uses it for switch tables and conditions. You can GIVE one to Binja (set_user_var_value).
;
; GOOD NEWS: PossibleValueSet / RegisterValue objects can be made WITHOUT a license. Outputs below are REAL.

func.vars / func.parameter_vars / func.stack_layout   # variables of a function                       @binja @api @variable
func.get_variable_by_name(name)            # one variable                                             @binja @api @variable
v.name / v.type                            # read; SET them to rename / retype (slow: waits analysis)  @binja @api @variable  <file:/opt/binaryninja/python/binaryninja/variable.py:1148>
v.set_name_async(n) / set_type_async(t) / set_name_and_type_async(n, t)   # fast, for many changes     @binja @api @variable  <file:/opt/binaryninja/python/binaryninja/variable.py:1245>
v.source_type / v.storage / v.index        # where it lives                                           @binja @api @variable
v.is_parameter_variable                    # True for arguments                                       @binja @api @variable
v.offset_to_next_variable                  # bytes until the next stack variable (buffer size hint!)  @binja @api @variable  <file:/opt/binaryninja/python/binaryninja/variable.py:1222>
v.ssa_versions                             # its SSA versions                                         @binja @api @variable
v.function / v.il_function                 # owner                                                    @binja @api @variable
RegisterValue: .type .value .offset        # one value (from get_reg_value_at ...)                     @binja @api @dataflow  <file:/opt/binaryninja/python/binaryninja/variable.py:58>
PossibleValueSet.constant(5) / constant_ptr(a) / signed_range_value([...]) / unsigned_range_value([...])   @binja @api @dataflow  <file:/opt/binaryninja/python/binaryninja/variable.py:286>
PossibleValueSet.in_set_of_values([...]) / not_in_set_of_values([...]) / undetermined()               @binja @api @dataflow
pvs.type / pvs.value / pvs.ranges / pvs.values / pvs.count   # read a value set                        @binja @api @dataflow
ValueRange(start, end, step)               # a range for range value sets                             @binja @api @dataflow

; --- Example 1: make value sets  (REAL output)
;
;     from binaryninja.variable import PossibleValueSet, ValueRange, ConstantRegisterValue
;     c = PossibleValueSet.constant(5)
;     print(c, c.type.name, c.value)                         # <const 0x5> ConstantValue 5
;     print(PossibleValueSet.in_set_of_values([1, 2, 3]))    # <in set([0x1, 0x2, 0x3])>
;     print(PossibleValueSet.unsigned_range_value([ValueRange(0, 10, 1)]))   # <unsigned ranges: [<range: 0x0 to 0xa>]>
;     print(PossibleValueSet.undetermined())                 # <undetermined>
;     print(ConstantRegisterValue(5))                        # <const 0x5>


; --- Example 2: list stack variables and guess BUFFER SIZES (bug hunting)
; bv = the binary you have open (the console gives you this variable).
;
;     from binaryninja.enums import VariableSourceType
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     for v in f.vars:
;         if v.source_type == VariableSourceType.StackVariableSourceType:
;             print(f"{v.name:15} offset={v.storage:#x}  type={v.type}  room_until_next={v.offset_to_next_variable}")


; --- Example 3: rename and retype a variable
;
;     from binaryninja import Type
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     v = f.parameter_vars[0]                          # first argument
;     v.name = "argc"
;     v.type = Type.int(4)
;     # many changes? use v.set_name_and_type_async("argc", Type.int(4)) (does not wait for analysis each time)


; --- Example 4: what kind of value is in a register?
;
;     from binaryninja.variable import ConstantRegisterValue, ConstantPointerRegisterValue, StackFrameOffsetRegisterValue
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     v = f.get_reg_value_at(f.start, "rsp")
;     if isinstance(v, StackFrameOffsetRegisterValue):
;         print("stack offset", v.value)
;     elif isinstance(v, (ConstantRegisterValue, ConstantPointerRegisterValue)):
;         print("known value", hex(v.value))
;     else:
;         print("other:", v)


; --- Example 5: possible values of a switch variable (MLIL)
;
;     from binaryninja.mediumlevelil import MediumLevelILJumpTo
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     for i in f.mlil.instructions:
;         if isinstance(i, MediumLevelILJumpTo):
;             print(hex(i.address), i.dest.possible_values)   # e.g. a lookup table or a range


; --- Notes
; - v.name = ... and v.type = ... WAIT for analysis (slow in loops). Use the *_async versions for many changes.
; - Variable objects compare by (function, source_type, index, storage). Use them as dict keys.
; - get_reg_value_at returns a RegisterValue; check its class (or .type) before you use .value.


## websocketprovider module (WebsocketProvider, WebsocketClient)
; ------------------------------------------------------------------
; Like downloadprovider, but for WEBSOCKETS (a connection that stays open; both sides can send at any time).
; Binja uses it for collaboration features. Your plugin can use it to talk LIVE to another tool:
; a debugger bridge, a fuzzer dashboard, a team chat bot, a live trace from an emulator ...
;
; It is ASYNC: connect() returns at once; your callbacks are called later ON THE CONNECTION THREAD.
;   on_connected()        -> return True to keep the connection
;   on_data(bytes)        -> return True to keep the connection
;   on_disconnected()     normal close
;   on_error(str)         error (then on_disconnected is NOT called)
; GUI work inside callbacks must use execute_on_main_thread (mainthread module).

WebsocketProvider.list / list(WebsocketProvider)   # providers (needs plugins / license)               @binja @api @net  <file:/opt/binaryninja/python/binaryninja/websocketprovider.py:277>
provider.create_instance()                 # new WebsocketClient                                      @binja @api @net
client.connect(url, headers, on_connected, on_disconnected, on_error, on_data)   # start (True = started, not "connected")  @binja @api @net  <file:/opt/binaryninja/python/binaryninja/websocketprovider.py:139>
client.write(data)                         # send bytes                                               @binja @api @net  <file:/opt/binaryninja/python/binaryninja/websocketprovider.py:201>
client.disconnect()                        # close                                                    @binja @api @net

; --- Example 1: send the current address to a local tool on every run (GUI)
; bv / here = console variables (see scriptingprovider module).
;
;     from binaryninja.websocketprovider import WebsocketProvider
;     from binaryninja.log import log_info, log_error
;
;     provider = list(WebsocketProvider)[0]
;     client = provider.create_instance()
;
;     def on_connected():
;         client.write(f"hello from {bv.file.display_name}".encode())
;         return True
;     def on_data(data):
;         log_info(f"got: {data[:100]!r}", "WS")
;         return True                                   # keep open
;     def on_error(msg):
;         log_error(f"ws error: {msg}", "WS")
;
;     client.connect("ws://127.0.0.1:8765", {}, on_connected=on_connected, on_data=on_data, on_error=on_error)
;     # later: client.write(hex(here).encode());  client.disconnect()


; --- Notes
; - One WebsocketClient = one connection. connect() twice raises RuntimeError: make a new instance.
; - Returning False from on_connected / on_data CLOSES the connection.
; - I did not run this example.


## workflow module (Workflow, Activity, AnalysisContext, WorkflowMachine)
; ------------------------------------------------------------------
; Binja's ANALYSIS is a PIPELINE of steps. A Workflow = that pipeline, as a graph (DAG) of Activities.
;   Activity         one step, like "core.function.generateLiftedIL", "core.function.generateHighLevelIL"
;   Workflow         the list/graph of steps. Main ones:
;                      "core.function.metaAnalysis"   steps for EVERY function
;                      "core.module.metaAnalysis"     steps for the whole binary (module)
;   AnalysisContext  what your step gets: .view .function .lifted_il .llil .mlil .hlil .basic_blocks
;                    (lifted_il / llil / mlil / hlil are WRITABLE: you can REPLACE them)
;
; Why it is powerful: you can INSERT YOUR OWN STEP in the pipeline and CHANGE the IL before Binja continues.
; This is the right way to:
;   - DEOBFUSCATE (remove junk code, opaque predicates, control-flow flattening -> official wf_unflatten.py)
;   - REWRITE instructions (official wf_rewrite_push_pop.py turns push/pop into store/load)
;   - decode strings, fix calls, add tags automatically during analysis
;
; How:
;   1. wf = Workflow("core.function.metaAnalysis").clone("my.workflow")       copy the default pipeline
;   2. wf.register_activity(Activity(json_config, action=my_function))       define your step
;   3. wf.insert("core.function.generateHighLevelIL", ["my.step"])           place it (before a step)
;      or wf.insert_after("core.function.generateLiftedIL", ["my.step"])     (after a step)
;   4. wf.register()                                                          make it available (now immutable)
;   5. choose the workflow for a binary (setting "analysis.workflows.functionWorkflow" / load options) — or
;      clone with the SAME name as the default to change the default.
;
; The Activity configuration (JSON): "name" (unique id), "title", "description",
;   "eligibility": {"auto": {"default": False}}  (off by default; user can turn it on)  or  {"runOnce": True} ...

Workflow(name)                             # get (or create) a workflow by name                       @binja @api @workflow  <file:/opt/binaryninja/python/binaryninja/workflow.py:587>
Workflow.list / list(Workflow)             # all workflows                                            @binja @api @workflow
wf.clone(new_name)                         # editable copy                                            @binja @api @workflow  <file:/opt/binaryninja/python/binaryninja/workflow.py:694>
wf.register_activity(Activity(cfg, action=f))   # add a step                                          @binja @api @workflow  <file:/opt/binaryninja/python/binaryninja/workflow.py:708>
wf.insert(before_name, [names]) / insert_after(after_name, [names])   # place steps                   @binja @api @workflow
wf.remove(name) / wf.replace(name, new_name)   # remove / swap a step                                  @binja @api @workflow
wf.register()                              # finish (immutable after this)                            @binja @api @workflow  <file:/opt/binaryninja/python/binaryninja/workflow.py:684>
wf.subactivities() / wf.activity_roots()   # read the graph                                           @binja @api @workflow
wf.show_topology() / wf.graph(show=True)   # draw the pipeline in the GUI                             @binja @api @workflow
func.workflow / bv.workflow                # workflow used by a function / binary                     @binja @api @workflow
func.workflow.machine.show_trace() / show_metrics()   # debug: what ran, how long                      @binja @api @workflow  <file:/opt/binaryninja/python/binaryninja/workflow.py:937>
ctx.view / ctx.function / ctx.llil / ctx.mlil / ctx.hlil / ctx.lifted_il   # inside your action       @binja @api @workflow  <file:/opt/binaryninja/python/binaryninja/workflow.py:43>
ctx.lifted_il = new_il / ctx.mlil = new_il # REPLACE the IL                                           @binja @api @workflow
il.translate(handler) -> new_il; new_il.finalize()   # copy IL with changes (official pattern)        @binja @api @workflow
/opt/binaryninja/examples/python/wf_*.py   # official: wf_module_helloworld, wf_rewrite_push_pop, wf_unflatten, wf_test_copy_expr  @binja @example @workflow  <file:/opt/binaryninja/examples/python/>

; All examples run as a PLUGIN (put the file in your plugins folder) or in the console BEFORE opening a binary.

; --- Example 1: see the default function pipeline
;
;     from binaryninja.workflow import Workflow
;     print([w.name for w in Workflow])
;     wf = Workflow("core.function.metaAnalysis")
;     for name in wf.subactivities():
;         print(name)
;     # wf.show_topology()      # GUI: draw it


; --- Example 2: a step that only LOOKS (tag every function that calls "IsDebuggerPresent")
;
;     import json
;     from binaryninja.workflow import Workflow, Activity
;
;     def tag_antidebug(ctx):
;         func, bv = ctx.function, ctx.view
;         for callee in func.callees:
;             if callee.name == "IsDebuggerPresent":
;                 if bv.get_tag_type("AntiDebug") is None:
;                     bv.create_tag_type("AntiDebug", "🛡")
;                 func.add_tag("AntiDebug", "calls IsDebuggerPresent")
;
;     wf = Workflow("core.function.metaAnalysis").clone("my.antidebug.workflow")
;     wf.register_activity(Activity(json.dumps({
;         "name": "my.tagAntiDebug",
;         "title": "Tag anti-debug",
;         "description": "Tag functions that call IsDebuggerPresent.",
;         "eligibility": {"auto": {"default": True}}
;     }), action=tag_antidebug))
;     wf.insert("core.function.generateHighLevelIL", ["my.tagAntiDebug"])
;     wf.register()


; --- Example 3: a step that CHANGES the IL – remove calls to a junk function (deobfuscation)
; Many packers insert calls to a function that does nothing useful (it only confuses analysis).
; We copy the Lifted IL and replace "call(JUNK)" with a nop. Pattern from wf_rewrite_push_pop.py.
;
;     import json
;     from binaryninja.workflow import Workflow, Activity
;     from binaryninja.lowlevelil import LowLevelILOperation
;     JUNK_ADDR = 0x401500                                  # address of the junk function (change it)
;
;     def remove_junk_calls(ctx):
;         def translate(new_func, old_block, old_instr):
;             if (old_instr.operation == LowLevelILOperation.LLIL_CALL
;                     and getattr(old_instr.dest, "constant", None) == JUNK_ADDR):
;                 return new_func.nop()                     # drop the call
;             return old_instr.copy_to(new_func, lambda sub: translate(new_func, old_block, sub))
;         new_il = ctx.lifted_il.translate(translate)
;         new_il.finalize()
;         ctx.lifted_il = new_il
;
;     wf = Workflow("core.function.metaAnalysis").clone("my.dejunk.workflow")
;     wf.register_activity(Activity(json.dumps({
;         "name": "my.removeJunkCalls",
;         "title": "Remove junk calls",
;         "description": "Replace calls to the junk function with nop.",
;         "eligibility": {"auto": {"default": False}}       # user turns it on
;     }), action=remove_junk_calls))
;     wf.insert_after("core.function.generateLiftedIL", ["my.removeJunkCalls"])
;     wf.register()


; --- Example 4: a MODULE step that runs ONE time for the binary (from wf_module_helloworld.py)
;
;     import json
;     from binaryninja.workflow import Workflow, Activity
;     def hello(ctx):
;         bv = ctx.view
;         bv.add_tag(bv.entry_point, "Needs Analysis", "Hello World!")
;     wf = Workflow("core.module.metaAnalysis").clone("plugin.module.HelloWorld")
;     wf.register_activity(Activity(json.dumps({
;         "name": "analysis.helloworld", "title": "Tag Entry Point",
;         "description": "Tag the entry point.", "eligibility": {"runOnce": True},
;         "dependencies": {"downstream": ["core.module.update"]}
;     }), action=hello))
;     wf.insert("core.module.finishUpdate", ["analysis.helloworld"])
;     wf.register()


; --- Example 5: debug your workflow on one function (GUI)
; bv = the binary you have open (the console gives you this variable).
;
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     print(f.workflow.name if f.workflow else None)
;     f.workflow.machine.show_trace()                  # which steps ran, in what order
;     f.workflow.machine.show_metrics()                # how long each step took


; --- Notes
; - After register() a workflow can NOT change. Clone again to change it.
; - Inside an action, use ctx.* (not func.hlil): the analysis is RUNNING; ctx gives the current state.
; - After you build new IL: call finalize() (and generate_ssa_form() for MLIL, see wf_unflatten.py), then assign it to ctx.
; - Exceptions in your action are logged ("Unhandled Python exception in Activity._action").
; - Python activities slow analysis on big binaries; filter early (return fast if the function is not interesting).
; - I did not run these examples.


; ##################################################################
; #  BINARY NINJA API – modules skipped at the start (A–B)
; ##################################################################


## architecture module (Architecture, ArchitectureHook, InstructionInfo, InstructionTextToken, RegisterInfo)
; ------------------------------------------------------------------
; Architecture = the CPU: x86, x86_64, aarch64, armv7, thumb2, mips32, ppc, riscv ...
; It knows how to:
;   - DISASSEMBLE bytes  -> text tokens        (get_instruction_text)
;   - give INFO about an instruction: length, branches (get_instruction_info)
;   - LIFT bytes to LLIL                      (get_instruction_low_level_il)
;   - ASSEMBLE text to bytes                  (assemble)
;   - PATCH: nop, always/never branch, invert branch, skip call and return a value
; It has registers (regs, stack_pointer, link_reg), flags, intrinsics, calling conventions.
;
; You use it to:
;   1. disassemble / assemble / lift ANY bytes (not only bytes in a binary): shellcode, emulator traces ...
;   2. PATCH a binary from a script
;   3. HOOK an existing architecture (change its text or behavior)      -> ArchitectureHook
;   4. WRITE a new architecture (a CPU Binja does not know)              -> subclass Architecture (see nes.py)
;
; In the GUI: bv.arch, func.arch, Architecture["x86_64"]

list(Architecture) / Architecture["x86_64"]          # all / one CPU                                   @binja @api @arch  <file:/opt/binaryninja/python/binaryninja/architecture.py:704>
arch.name / address_size / default_int_size / endianness / max_instr_length   # basics                @binja @api @arch
arch.regs / arch.full_width_regs / arch.stack_pointer / arch.link_reg / arch.flags   # registers         @binja @api @arch
arch.get_instruction_text(data, addr)                # -> (tokens, length)                             @binja @api @arch  <file:/opt/binaryninja/python/binaryninja/architecture.py:2020>
arch.get_instruction_info(data, addr)                # -> InstructionInfo: .length .branches           @binja @api @arch  <file:/opt/binaryninja/python/binaryninja/architecture.py:1988>
arch.get_low_level_il_from_bytes(data, addr)         # -> LLIL of the bytes                            @binja @api @arch  <file:/opt/binaryninja/python/binaryninja/architecture.py:2106>
arch.assemble(code, addr=0)                          # text -> bytes                                   @binja @api @arch  <file:/opt/binaryninja/python/binaryninja/architecture.py:2460>
arch.convert_to_nop(data, addr) / always_branch / invert_branch / skip_and_return_value(data, addr, v)   # patch bytes  @binja @api @arch  <file:/opt/binaryninja/python/binaryninja/architecture.py:2592>
arch.is_*_patch_available(data, addr)                # can I patch this way?                           @binja @api @arch
arch.calling_conventions / default_calling_convention   # see callingconvention module                 @binja @api @arch
arch.standalone_platform                             # the platform with no OS                        @binja @api @arch
bv.convert_to_nop(addr) / bv.always_branch(addr) / bv.never_branch(addr) / bv.invert_branch(addr) / bv.skip_and_return_value(addr, v)   # PATCH IN THE BINARY (easier)  @binja @api @patch  <file:/opt/binaryninja/python/binaryninja/binaryview.py:7875>
bv.get_disassembly(addr)                             # one line of text                               @binja @api @arch
ArchitectureHook(Architecture["x86"])                # change an existing CPU (subclass + .register())  @binja @api @arch  <file:/opt/binaryninja/python/binaryninja/architecture.py:3443>
/opt/binaryninja/examples/python/nes.py              # official: a full new architecture (6502 / NES)  @binja @example @arch  <file:/opt/binaryninja/examples/python/nes.py>
/opt/binaryninja/examples/python/arch_hook.py        # official: ArchitectureHook                     @binja @example @arch

; All examples need a license (Architecture[...] loads plugins).

; --- Example 1: disassemble shellcode bytes (no binary needed)
;
;     from binaryninja import Architecture
;     arch = Architecture["x86_64"]
;     code = bytes.fromhex("4831c0b03b0f05")          # xor rax,rax ; mov al,0x3b ; syscall
;     addr = 0
;     while addr < len(code):
;         tokens, length = arch.get_instruction_text(code[addr:], addr)
;         print(hex(addr), "".join(t.text for t in tokens))
;         addr += length


; --- Example 2: assemble, then lift to LLIL (from the docs)
;
;     from binaryninja import Architecture
;     arch = Architecture["x86"]
;     print(arch.assemble("je 10"))                      # b'\x0f\x84\x04\x00\x00\x00'
;     print(list(arch.get_low_level_il_from_bytes(b"\xeb\xfe", 0x40DEAD)))   # jump(0x40dead)


; --- Example 3: instruction info – is it a branch? where to?
;
;     from binaryninja import Architecture
;     arch = Architecture["x86_64"]
;     info = arch.get_instruction_info(bytes.fromhex("e800000000"), 0x1000)   # call +0
;     print(info.length, [(b.type.name, hex(b.target)) for b in info.branches])   # 5 [('CallDestination', '0x1005')]


; --- Example 4: PATCH a binary (crackme style). bv = the binary you have open.
;
;     addr = 0x401156                                     # a "jne fail" instruction (change it)
;     print(bv.get_disassembly(addr))
;     if bv.is_always_branch_patch_available(addr):
;         bv.always_branch(addr)                          # or: bv.invert_branch(addr) / bv.convert_to_nop(addr)
;     print(bv.get_disassembly(addr))
;     # save the patched file:  bv.save("/tmp/patched")


; --- Example 5: write raw assembled bytes into the binary
;
;     code = bv.arch.assemble("mov eax, 1\nret", 0x401200)
;     bv.write(0x401200, code)


; --- Example 6: registers of a CPU
;
;     from binaryninja import Architecture
;     arch = Architecture["x86_64"]
;     print(arch.stack_pointer, arch.address_size)        # rsp 8
;     print(arch.regs["eax"])                             # <reg: size 4, offset 0 in rax, zero extend>


; --- Example 7: hook x86 to change the text (from arch_hook.py)
;
;     from binaryninja.architecture import Architecture, ArchitectureHook
;     class X86ReturnHook(ArchitectureHook):
;         def get_instruction_text(self, data, addr):
;             result, length = super().get_instruction_text(data, addr)
;             if len(result) > 0 and result[0].text == "retn":
;                 result[0].text = "ret"
;             return result, length
;     X86ReturnHook(Architecture["x86"]).register()


; --- Example 8: skeleton of a NEW architecture (a toy CPU: 1-byte instructions)
;   0x00 = nop, 0x01 = ret, anything else = "db"
;
;     from binaryninja import (Architecture, RegisterInfo, InstructionInfo, InstructionTextToken,
;                              InstructionTextTokenType, BranchType)
;     class ToyArch(Architecture):
;         name = "toy"
;         address_size = 2
;         default_int_size = 2
;         max_instr_length = 1
;         regs = {"sp": RegisterInfo("sp", 2)}
;         stack_pointer = "sp"
;
;         def get_instruction_info(self, data, addr):
;             info = InstructionInfo()
;             info.length = 1
;             if data[0] == 0x01:
;                 info.add_branch(BranchType.FunctionReturn)
;             return info
;
;         def get_instruction_text(self, data, addr):
;             name = {0x00: "nop", 0x01: "ret"}.get(data[0], f"db {data[0]:#x}")
;             return [InstructionTextToken(InstructionTextTokenType.InstructionToken, name)], 1
;
;         def get_instruction_low_level_il(self, data, addr, il):
;             if data[0] == 0x00:
;                 il.append(il.nop())
;             elif data[0] == 0x01:
;                 il.append(il.ret(il.pop(2)))
;             else:
;                 il.append(il.unimplemented())
;             return 1
;
;     ToyArch.register()
;     # open a raw file and choose platform/arch "toy". Real example: nes.py.


; --- Notes
; - get_instruction_text returns (tokens, length). Join token.text to get a string.
; - Patch with bv.* functions (they handle the bytes and re-analysis). arch.* patch functions only return bytes.
; - A new architecture needs: get_instruction_info (for control flow), get_instruction_text (for display),
;   get_instruction_low_level_il (for decompilation). Without LLIL, there is no MLIL/HLIL.
; - I did not run these examples.


## associateddatastore module (_AssociatedDataStore)
; ------------------------------------------------------------------
; INTERNAL helper. It is the class behind  session_data  on bv.file, bv and func.
; It is a normal Python dict, plus:
;   - you can use attributes:   sd.count   is the same as   sd["count"]
;   - DEFAULT values for all objects:   BinaryView.set_default_session_data("count", 0)
;     (also FileMetadata.set_default_session_data / Function.set_default_session_data)
;   - a missing key with no default raises KeyError (with attribute access)
; Data here is NOT saved to the .bndb (use store_metadata for that, see metadata module).
; Works WITHOUT a license. Outputs below are REAL (tested on a subclass, like Binja does).

bv.session_data / bv.file.session_data / func.session_data   # the stores you use                    @binja @api @session  <file:/opt/binaryninja/python/binaryninja/associateddatastore.py>
BinaryView.set_default_session_data(name, value)   # default for every binary                       @binja @api @session  <file:/opt/binaryninja/python/binaryninja/binaryview.py:3706>
sd.get(key, default)                       # dict.get, but uses the class default first               @binja @api @session

; --- Example 1: how it behaves  (REAL output)
;
;     from binaryninja.associateddatastore import _AssociatedDataStore
;     class Store(_AssociatedDataStore): _defaults = {}
;     Store.set_default("count", 0)
;     s = Store()
;     print(s.count, s.get("count"), s.get("missing", "x"))   # 0 0 x
;     s.count = 5; s["name"] = "abc"
;     print(s.count, s.name, dict(s))                         # 5 abc {'count': 5, 'name': 'abc'}
;     s.nothing                                               # KeyError: 'nothing'


; --- Example 2: per-function cache for your plugin (GUI)
; bv = the binary you have open (the console gives you this variable).
;
;     from binaryninja import Function
;     Function.set_default_session_data("hlil_count", None)
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     if f.session_data.hlil_count is None:
;         f.session_data.hlil_count = len(list(f.hlil.instructions))
;     print(f.session_data.hlil_count)


## basedetection module (BaseAddressDetection)
; ------------------------------------------------------------------
; Problem: a RAW firmware dump has no header. You do not know WHERE in memory it was loaded (the base address).
; With the wrong base, pointers point to nothing: no strings, no cross-references, bad analysis.
;
; BaseAddressDetection tries many base addresses and SCORES each one:
; "with base X, how many pointers in the code hit a string / a function / data?"  More hits = better.
; Then you reopen the file with the best base (setting "loader.imageBase").
;
; Results:
;   bad.preferred_base_address   best candidate
;   bad.scores                   list of (base, score)
;   bad.confidence               BaseAddressDetectionConfidence (how sure)
;   bad.get_reasons(base)        why: list of (pointer, offset, type: string/function/data)
;   bad.get_string_hits / get_function_hits / get_data_hits(base)

BaseAddressDetection(path_or_bv)           # make it for a file                                       @binja @api @firmware  <file:/opt/binaryninja/python/binaryninja/basedetection.py:44>
bad.detect_base_address(arch=None, analysis="full", min_strlen=10, alignment=1024, low_boundary=0, high_boundary=...)   # run (slow)  @binja @api @firmware  <file:/opt/binaryninja/python/binaryninja/basedetection.py:273>
bad.preferred_base_address / scores / confidence   # results                                          @binja @api @firmware
bad.get_reasons(base)                      # why this base                                            @binja @api @firmware  <file:/opt/binaryninja/python/binaryninja/basedetection.py:322>
bad.abort() / bad.aborted                  # stop a long run                                          @binja @api @firmware

; All examples need a license.

; --- Example 1: find the base of a raw ARM firmware, then load it there (headless)
;
;     import binaryninja
;     from binaryninja.basedetection import BaseAddressDetection
;     bad = BaseAddressDetection("/fw/firmware.bin")
;     if bad.detect_base_address(arch="thumb2", alignment=0x1000):
;         base = bad.preferred_base_address
;         print("best:", hex(base), "| confidence:", bad.confidence.name)
;         for addr, score in bad.scores[:5]:
;             print(f"  {addr:#x}: {score}")
;         with binaryninja.load("/fw/firmware.bin", options={"loader.imageBase": base, "loader.platform": "thumb2"}) as bv:
;             print(len(bv.functions), "functions,", len(list(bv.strings)), "strings")


; --- Example 2: why is this base a candidate?
;
;     for r in bad.get_reasons(bad.preferred_base_address)[:10]:
;         print(hex(r.pointer), hex(r.offset), r.type.name)
;     print("string hits:", bad.get_string_hits(bad.preferred_base_address))


; --- Notes
; - It can take a LONG time. Limit low_boundary / high_boundary if you know the memory map (from the chip datasheet).
; - alignment: bases are tried in steps of this size (0x1000 is common; some chips need 0x10000 or more).
; - Then use firmwareninja module for MMIO / devices.
; - I did not run these examples.


## basicblock module (BasicBlock, BasicBlockEdge) – the rest (source_block is at the top of this file)
; ------------------------------------------------------------------
; A BasicBlock = instructions that always run together: ONE way in (the start), ONE way out (the end).
; The function GRAPH is made of basic blocks (boxes) and edges (arrows).
; Same class for assembly blocks and IL blocks (LLIL/MLIL/HLIL). For IL blocks, start/end are INDEXES.
;
; Edges (BasicBlockEdge): .type (BranchType: TrueBranch, FalseBranch, UnconditionalBranch, ...),
;                         .source, .target, .back_edge (True = a LOOP goes back), .fall_through
;
; Dominators (graph theory, very useful for analysis):
;   A dominates B  = EVERY path from the function start to B goes through A.
;   post-dominates = every path from B to the end goes through A.
;   Used for: finding loops, "is this check always done before that call?", SSA phi placement.

func.basic_blocks / func.llil.basic_blocks / func.hlil.basic_blocks   # get blocks                     @binja @api @basicblock  <file:/opt/binaryninja/python/binaryninja/basicblock.py:80>
func.get_basic_block_at(addr)              # block that contains addr                                 @binja @api @basicblock
bb.start / bb.end / bb.length / bb.index / bb.instruction_count   # basics                            @binja @api @basicblock
for tokens, size in bb: ...                # iterate ASSEMBLY instructions -> (tokens, SIZE) (not address!)  @binja @api @basicblock
bb.outgoing_edges / bb.incoming_edges      # arrows out / in (BasicBlockEdge)                         @binja @api @basicblock  <file:/opt/binaryninja/python/binaryninja/basicblock.py:419>
bb.has_undetermined_outgoing_edges         # True if Binja does not know where it jumps (jump table?)  @binja @api @basicblock
bb.can_exit                                # False if it ends in a no-return call                     @binja @api @basicblock
bb.has_invalid_instructions                # bad bytes inside (data? obfuscation?)                    @binja @api @basicblock
bb.dominators / bb.post_dominators / bb.immediate_dominator / bb.dominance_frontier   # graph theory   @binja @api @basicblock  <file:/opt/binaryninja/python/binaryninja/basicblock.py:537>
bb.dominator_tree_children                 # children in the dominator tree                           @binja @api @basicblock
bb.disassembly_text / bb.get_disassembly_text(settings)   # text lines                                @binja @api @basicblock
bb.highlight / bb.set_user_highlight(color)   # color (see highlight module)                          @binja @api @basicblock
bb.is_il / is_low_level_il / is_medium_level_il / is_high_level_il   # what kind                      @binja @api @basicblock
bb.function / bb.il_function / bb.arch / bb.view   # owners                                           @binja @api @basicblock
bb.source_block                            # the assembly block of an IL block (see top of file)      @binja @api @basicblock

; All examples need a license. bv = the binary you have open (the console gives you this variable).

; --- Example 1: print the graph of a function as text
;
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     for bb in f.basic_blocks:
;         outs = [(e.type.name, hex(e.target.start)) for e in bb.outgoing_edges]
;         print(f"block {bb.index} {bb.start:#x}-{bb.end:#x}  -> {outs}")


; --- Example 2: print instructions of one block with addresses
; Iterating a block gives (tokens, size). Keep your own address counter.
;
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     bb = f.basic_blocks[0]
;     addr = bb.start
;     for tokens, size in bb:
;         print(hex(addr), "".join(t.text for t in tokens))
;         addr += size


; --- Example 3: find LOOPS (back edges)
;
;     for f in bv.functions:
;         for bb in f.basic_blocks:
;             for e in bb.outgoing_edges:
;                 if e.back_edge:
;                     print(f.name, "loop:", hex(e.source.start), "->", hex(e.target.start))


; --- Example 4: is the check ALWAYS done before the dangerous call? (dominators)
;
;     f = bv.get_functions_by_name("main")[0]          # pick a function by name
;     check_bb = f.get_basic_block_at(0x401150)        # block with the length check (change it)
;     call_bb  = f.get_basic_block_at(0x4011a0)        # block with memcpy (change it)
;     print("check always runs first:", check_bb in call_bb.dominators)


; --- Example 5: blocks with unknown jumps (maybe jump tables or obfuscation)
;
;     for f in bv.functions:
;         for bb in f.basic_blocks:
;             if bb.has_undetermined_outgoing_edges or bb.has_invalid_instructions:
;                 print(f.name, hex(bb.start), "undetermined" if bb.has_undetermined_outgoing_edges else "invalid")


; --- Example 6: complexity of each function (cyclomatic = edges - blocks + 2)
;
;     scores = []
;     for f in bv.functions:
;         blocks = len(f.basic_blocks)
;         edges = sum(len(bb.outgoing_edges) for bb in f.basic_blocks)
;         scores.append((edges - blocks + 2, f.name))
;     for s, name in sorted(scores, reverse=True)[:10]:
;         print(s, name)


; --- Notes
; - for tokens, size in bb  -> SIZE.  for tokens, addr in func.instructions -> ADDRESS. Do not mix them up.
; - For IL blocks, iterate bb directly to get IL instructions; start/end are IL indexes.
; - I did not run these examples.


## binaryview module (BinaryView, DataVariable, Section, Segment, Tag, BinaryReader/Writer, notifications ...)
; ------------------------------------------------------------------
; BinaryView (bv) = THE OPEN BINARY. The center of the whole API: everything starts from bv.
; It is a VIEW of the bytes: "Raw" (the file as it is) or a parsed view: "ELF", "PE", "Mach-O" ... (memory layout).
;
; Open one:
;   GUI console:  bv                             (magic variable)
;   headless:     with binaryninja.load(path, options={...}) as bv:    (needs a license)
;
; It is VERY big (12000+ lines). Below: the most useful parts, grouped by topic.

; --- Open, info, analysis
binaryninja.load(path_or_bytes, update_analysis=True, options={})   # open (headless)                   @binja @api @bv  <file:/opt/binaryninja/python/binaryninja/__init__.py:484>
bv.view_type / bv.arch / bv.platform / bv.endianness   # "ELF", CPU, OS+CPU                           @binja @api @bv
bv.start / bv.end / len(bv) / bv.entry_point / bv.entry_functions   # memory range / entry            @binja @api @bv
bv.update_analysis_and_wait()              # run analysis and WAIT (headless scripts)                 @binja @api @bv  <file:/opt/binaryninja/python/binaryninja/binaryview.py:5798>
bv.update_analysis() / bv.abort_analysis() / bv.analysis_progress   # async / stop / state             @binja @api @bv

; --- Bytes
bv.read(addr, n) / bv.write(addr, data)    # read / patch bytes (virtual addresses)                   @binja @api @bytes  <file:/opt/binaryninja/python/binaryninja/binaryview.py:5293>
bv.read_int(addr, size, sign=True) / bv.read_pointer(addr)   # numbers                                @binja @api @bytes
bv.insert(addr, data) / bv.remove(addr, n) # change the size (Raw view)                               @binja @api @bytes
bv.is_valid_offset(a) / is_offset_executable(a) / ...   # memory checks                               @binja @api @bytes
BinaryReader(bv) / BinaryWriter(bv)        # stream style: br.seek(a); br.read32(); br.read(n)      @binja @api @bytes  <file:/opt/binaryninja/python/binaryninja/binaryview.py:11281>
bv.typed_data_accessor(addr, type)         # read data AS a type (struct fields ...) -> .value        @binja @api @bytes  <file:/opt/binaryninja/python/binaryninja/binaryview.py:11109>
bv.save(path)                              # save the binary with patches                             @binja @api @bytes

; --- Functions
bv.functions                               # all functions                                            @binja @api @bv
bv.get_function_at(addr) / get_functions_containing(addr) / get_functions_by_name(n)   # find          @binja @api @bv  <file:/opt/binaryninja/python/binaryninja/binaryview.py:6048>
bv.create_user_function(addr) / remove_user_function(f)   # make / delete a function               @binja @api @bv  <file:/opt/binaryninja/python/binaryninja/binaryview.py:5688>
bv.get_next_function_start_after(a) / get_previous_function_start_before(a)   # walk                  @binja @api @bv

; --- Symbols
bv.symbols                                 # dict-like: name -> [Symbol]                              @binja @api @symbols
bv.get_symbol_at(addr) / get_symbol_by_raw_name(n) / get_symbols_by_name(n) / get_symbols_of_type(t)   # find  @binja @api @symbols  <file:/opt/binaryninja/python/binaryninja/binaryview.py:7064>
bv.define_user_symbol(Symbol(...)) / undefine_user_symbol(sym)   # name things                        @binja @api @symbols

; --- Cross references (xrefs)
bv.get_code_refs(addr)                     # code that uses addr -> ReferenceSource (.function .address)  @binja @api @xrefs  <file:/opt/binaryninja/python/binaryninja/binaryview.py:6156>
bv.get_data_refs(addr)                     # data that points to addr -> addresses                    @binja @api @xrefs
bv.get_code_refs_from(addr) / get_data_refs_from(addr)   # what addr uses                             @binja @api @xrefs
bv.get_callers(addr) / get_callees(addr)   # call xrefs                                               @binja @api @xrefs
bv.get_code_refs_for_type(name) / get_type_refs_for_type(name)   # who uses a struct                  @binja @api @xrefs

; --- Data and strings
bv.data_vars                               # dict addr -> DataVariable                                @binja @api @data
bv.get_data_var_at(addr) / define_user_data_var(addr, type, name=None)   # read / make data           @binja @api @data  <file:/opt/binaryninja/python/binaryninja/binaryview.py:5900>
dv.value / dv.type / dv.name / dv.address  # a DataVariable (value is read AS its type)              @binja @api @data
bv.strings / bv.get_strings(start, len) / bv.get_string_at(addr) / get_ascii_string_at(addr)   # strings (.start .length .value .type)  @binja @api @strings
detect_strings_in_block(bytes, base)       # find strings in ANY bytes (no license needed!)           @binja @api @strings  <file:/opt/binaryninja/python/binaryninja/binaryview.py:640>

; --- Search
bv.find_next_data(start, bytes) / find_all_data(start, end, bytes)   # byte search                    @binja @api @search
bv.find_next_text / find_all_text(start, end, text)   # search in DISASSEMBLY/IL text                @binja @api @search
bv.find_next_constant / find_all_constant(start, end, value)   # search a constant in code            @binja @api @search
bv.search(pattern, start, end)             # like the GUI search: FlexHex "48 8b ?? 05", regex, raw -> (addr, DataBuffer)  @binja @api @search  <file:/opt/binaryninja/python/binaryninja/binaryview.py:10285>

; --- Memory layout
bv.segments / bv.sections                  # segments (memory + rights) / sections (.text .data ...) @binja @api @memory  <file:/opt/binaryninja/python/binaryninja/binaryview.py:4248>
bv.get_segment_at(a) / get_sections_at(a)  # where is addr                                            @binja @api @memory
bv.add_user_segment(...) / add_user_section(...) / add_memory_region(...)   # add memory              @binja @api @memory
bv.memory_map                              # the full memory map (MemoryMap)                          @binja @api @memory

; --- Comments, tags, misc
bv.set_comment_at(addr, text) / get_comment_at(addr)   # data comments                                @binja @api @bv
bv.create_tag_type(name, icon) / get_tag_type(name) / add_tag(addr, type_name, data)   # tags          @binja @api @tags  <file:/opt/binaryninja/python/binaryninja/binaryview.py:7438>
bv.get_disassembly(addr)                   # one line of text                                         @binja @api @bv
bv.parse_expression("main+0x10")           # expression -> address                                   @binja @api @bv  <file:/opt/binaryninja/python/binaryninja/binaryview.py:11033>
bv.register_notification(MyNotification()) # get events: function_added, data_written ...           @binja @api @bv  <file:/opt/binaryninja/python/binaryninja/binaryview.py:5570>
bv.add_analysis_completion_event(cb)       # call cb when analysis is done                            @binja @api @bv
; Also on bv (see their own sections): types, metadata, undo, file, debug_info, components, external libraries, type archives.

; --- Example 1: headless script skeleton (needs a license)
;
;     import binaryninja
;     with binaryninja.load("/bin/ls") as bv:            # analysis runs, then waits by default
;         print(bv.view_type, bv.arch.name, hex(bv.entry_point), len(bv.functions), "functions")


; --- Example 2: all xrefs to a string (who uses "password"?)
; bv = the binary you have open (the console gives you this variable).
;
;     for s in bv.strings:
;         if "password" in s.value.lower():
;             for ref in bv.get_code_refs(s.start):
;                 print(f"{s.value!r} used in {ref.function.name} at {ref.address:#x}")


; --- Example 3: who calls a function (imports too)
;
;     for sym in bv.get_symbols_by_name("malloc"):
;         for ref in bv.get_code_refs(sym.address):
;             print(hex(ref.address), ref.function.name if ref.function else "?")


; --- Example 4: byte search with wildcards (FlexHex)
;
;     for addr, match in bv.search("48 8b ?? ?? ?? ?? 00"):  # mov reg, [rip+X] with top byte 0
;         print(hex(addr), bytes(match).hex())


; --- Example 5: read a struct from memory (typed access)
;
;     t, name = bv.parse_type_string("struct hdr { uint32_t magic; uint16_t ver; uint16_t count; }")
;     acc = bv.typed_data_accessor(0x404000, t)
;     print(acc["magic"].value, acc["count"].value)


; --- Example 6: section list with rights
;
;     for s in bv.sections.values():
;         print(f"{s.name:20} {s.start:#x}-{s.end:#x} {s.semantics.name}")
;     for seg in bv.segments:
;         print(f"seg {seg.start:#x}-{seg.end:#x} r={seg.readable} w={seg.writable} x={seg.executable}")


; --- Example 7: get notified when a function is added (plugin)
;
;     from binaryninja.binaryview import BinaryDataNotification
;     from binaryninja.log import log_info
;     class Watch(BinaryDataNotification):
;         def function_added(self, view, func):
;             log_info(f"new function {func.name}", "Watch")
;     bv.register_notification(Watch())


; --- Example 8: find strings in ANY bytes  (REAL output, no license)
;
;     from binaryninja.binaryview import detect_strings_in_block
;     data = b"\x00\x01hello world\x00\xff\xfeAB\x00secret_key_123\x00" + "wide".encode("utf-16-le") + b"\x00\x00"
;     for s in detect_strings_in_block(data, 0x1000):
;         print(s)
;     # DetectedString(type=<StringType.AsciiString: 0>, start=4098, length=11)    <- "hello world"
;     # DetectedString(type=<StringType.AsciiString: 0>, start=4115, length=14)    <- "secret_key_123"
;     # DetectedString(type=<StringType.Utf16String: 1>, start=4130, length=8)     <- "wide" (UTF-16)
;     # ("AB" was skipped: shorter than the minimum length 4)


; --- Example 9: create a function where Binja did not find one, and name it
;
;     from binaryninja.types import Symbol
;     from binaryninja.enums import SymbolType
;     addr = 0x401800                                     # code that Binja missed (change it)
;     bv.create_user_function(addr)
;     bv.update_analysis_and_wait()
;     bv.define_user_symbol(Symbol(SymbolType.FunctionSymbol, addr, "hidden_decrypt"))


; --- Notes
; - get_function_at needs the START address; get_functions_containing works for any address inside.
; - bv.read returns b"" (or shorter) for addresses that are not mapped. Check the length.
; - The "user" versions (create_user_function, define_user_data_var ...) are saved and undoable; "auto" versions are for plugins.
; - In headless scripts, call update_analysis_and_wait() after big changes before you read results.
; - Notification callbacks hold a global lock: keep them short (the source warns about deadlocks).
; - I did not run Examples 1-7 and 9 (license). Example 8 is real.


## bncompleter module (Completer)
; ------------------------------------------------------------------
; INTERNAL: the TAB-completion of Binja's Python console (a modified copy of Python's rlcompleter).
; Type "bv.get_fu" + TAB in the console -> it lists matching names. It also shows the function SIGNATURE.
; Note: to complete "a.b.c", it EVALUATES "a.b" (so completion can run code / properties).
; Works WITHOUT a license. Output below is REAL.

Completer(namespace)                       # completer for a dict of names                            @binja @api @console  <file:/opt/binaryninja/python/binaryninja/bncompleter.py>
c.complete(text, state)                    # state = 0, 1, 2 ... -> next match, None at the end       @binja @api @console

; --- Example 1  (REAL output)
;
;     import json
;     from binaryninja.bncompleter import Completer
;     c = Completer({"json": json, "data": {"a": 1}})
;     print([c.complete("json.du", i) for i in range(3)])
;     # ['json.dump(obj, fp, *, skipkeys=False, ...)', 'json.dumps(obj, *, skipkeys=False, ...)', None]
;     print([c.complete("dat", i) for i in range(2)])       # ['data', None]


## compatibility module
; ------------------------------------------------------------------
; INTERNAL: 2 tiny helpers left from the Python 2 -> 3 move. Works WITHOUT a license. Output REAL.
;   pyNativeStr(x)       bytes -> str (UTF-8, or latin-1 "charmap" if not valid UTF-8); str/None stay the same
;   valid_import(name)   True if a Python module can be imported (without importing it)

pyNativeStr(arg)                           # bytes -> str, never fails                                @binja @api @internal  <file:/opt/binaryninja/python/binaryninja/compatibility.py>
valid_import(mod_name)                     # can I import this module?                                @binja @api @internal

; --- Example 1  (REAL output)
;
;     from binaryninja.compatibility import pyNativeStr, valid_import
;     print(pyNativeStr(b"abc"), pyNativeStr(b"\xff\xfe"), valid_import("json"), valid_import("not_a_module_xyz"))
;     # abc ÿþ True False
; Use valid_import in your plugin to check an optional dependency (like "lief") before you import it.


; ##################################################################
; #  Sub-packages (not covered yet): binaryninja.debugger, .sharedcache, .kernelcache, .warp
; ##################################################################


## datarender module (DataRenderer, TypeContext)  — added late, it was skipped between databuffer and debuginfo
; ------------------------------------------------------------------
; A DataRenderer changes how DATA (not code) is SHOWN in the Linear View, for a type you choose.
; Example: data typed "struct ipv4_addr" shows as "192.168.1.10" instead of 4 numbers;
;          a "struct guid" shows as {12345678-...}; a "time_t" shows as a date.
; Only the display changes. The bytes and the type stay the same.
; (For constants inside CODE use constantrenderer; for whole lines use renderlayer.)
;
; How:
;   class MyRenderer(DataRenderer):
;       perform_is_valid_for_data(ctxt, view, addr, type, context)  -> True if you want to draw this data
;       perform_get_lines_for_data(ctxt, view, addr, type, prefix, width, context, language)  -> list of DisassemblyTextLine
;   MyRenderer().register_type_specific()   # for a specific type (wins over generic)
;   MyRenderer().register_generic()         # for a general case (can be overridden)
;
;   context = list of TypeContext (.type .offset): the chain of nested types around this data
;   prefix  = tokens already made (like the variable name). Add your tokens AFTER them.
;   Helper: DataRenderer.is_type_of_struct_name(type, "NAME", context) -> True if this is struct NAME

DataRenderer                               # base class                                               @binja @api @render  <file:/opt/binaryninja/python/binaryninja/datarender.py>
perform_is_valid_for_data(...)             # your filter                                              @binja @api @render
perform_get_lines_for_data(...)            # your lines                                               @binja @api @render
DataRenderer.is_type_of_struct_name(t, name, context)   # check the struct name                       @binja @api @render
r.register_type_specific() / r.register_generic()       # turn it on                                  @binja @api @render

; --- Example 1: show "struct ipv4" (4 bytes) as a dotted IP address
;
;     from binaryninja import DataRenderer, InstructionTextToken, InstructionTextTokenType, DisassemblyTextLine
;
;     class IPv4Renderer(DataRenderer):
;         def __init__(self):
;             DataRenderer.__init__(self)
;         def perform_is_valid_for_data(self, ctxt, view, addr, type, context):
;             return DataRenderer.is_type_of_struct_name(type, "ipv4", context)
;         def perform_get_lines_for_data(self, ctxt, view, addr, type, prefix, width, context, language):
;             b = view.read(addr, 4)
;             text = ".".join(str(x) for x in b) if len(b) == 4 else "?"
;             prefix.append(InstructionTextToken(InstructionTextTokenType.TextToken, f"  ip = {text}"))
;             return [DisassemblyTextLine(prefix, addr)]
;         def __del__(self):
;             pass
;
;     IPv4Renderer().register_type_specific()
;     # then: define the type "struct ipv4 { uint8_t b[4]; }" and set data to it (see types / typeparser modules)


; --- Notes
; - It only affects the LINEAR view of data variables.
; - Keep perform_* fast: they run every time the view draws.
; - The docs example (struct BAR) is the same pattern with a fixed text.
; - I did not run this example.
















